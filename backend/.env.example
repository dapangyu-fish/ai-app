# Backend .env 模板 — 复制为 backend/.env 并填入真实值
# backend/.env 在 .gitignore 中，永远不要 commit
# 部署时通过 scp 传到服务器：scp backend/.env root@<host>:/root/ai-app/backend/.env

# ==================== Supabase 鉴权 ====================
SUPABASE_URL=https://myapp-auth.dapangyu.work
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ==================== AI Providers ====================
DEEPSEEK_KEY=

GLM_ANTHROPIC_BASE_URL=
GLM_ANTHROPIC_AUTH_TOKEN=
GLM_ANTHROPIC_MODEL=glm-5
GLM_ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.7
GLM_ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5-turbo
GLM_ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.1
GLM_ANTHROPIC_REASONING_MODEL=glm-5.1

CC_ANTHROPIC_BASE_URL=
CC_ANTHROPIC_AUTH_TOKEN=
CC_ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7

# ==================== 字节跳动 ASR（豆包语音识别） ====================
# 火山引擎控制台申请：https://console.volcengine.com/speech/app
BYTEDANCE_ASR_APP_KEY=
BYTEDANCE_ASR_ACCESS_KEY=
BYTEDANCE_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# ==================== MinIO 对象存储 ====================
MINIO_PUBLIC_URL=https://myapp-oss-endpoint.dapangyu.work
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ==================== Postgres (jsonapp DB) ====================
DB_HOST=127.0.0.1
DB_PORT=15433
DB_NAME=jsonapp
DB_USER=jsonapp
DB_PASSWORD=

# ==================== Flask 服务 ====================
PORT=5566
SERVER_PROJECT_PATH=/root/ai-app
FLASK_SECRET_KEY=

# ==================== OpenIM ====================
OPENIM_API_URL=https://myapp-im.dapangyu.work
OPENIM_WS_URL=wss://myapp-im.dapangyu.work
OPENIM_SECRET=
OPENIM_WEBHOOK_SECRET=

# ==================== APNs（仅 iOS 推送） ====================
# .p8 私钥文件存在 /etc/apns/，权限 600，不进 git
APNS_KEY_PATH=/etc/apns/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=dapangyu.fish.myapp
APNS_USE_SANDBOX=true

# ==================== Registry ====================
REGISTRY_ADMIN_TOKEN=

# ==================== Claude CLI ====================
CLAUDE_BIN=/root/.nvm/versions/node/v22.22.2/bin/claude
