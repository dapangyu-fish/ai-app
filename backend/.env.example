# Backend .env 模板 — 复制后填入真实值
#
# 加载顺序（首个存在的文件生效）：
#   1. $BACKEND_ENV_PATH        — supervisor 通过环境变量注入（生产）
#   2. /etc/ai-app/backend.env  — 生产环境标准位置 (mode 600, root only)
#   3. backend/.env             — 仅本地开发兜底
#
# 部署到服务器：
#   scp backend/.env.example root@<host>:/etc/ai-app/backend.env
#   ssh root@<host> 'chmod 600 /etc/ai-app/backend.env && vi /etc/ai-app/backend.env'
#
# .env 在 git 工作树外，git pull / checkout 不再影响 secret 文件。

# ==================== Supabase 鉴权 ====================
# 来源：supabase studio → Settings → API
SUPABASE_URL=https://your-supabase-host.example.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ==================== AI Providers（外部第三方）====================
# DeepSeek 控制台：https://platform.deepseek.com/api_keys
DEEPSEEK_KEY=

# 智谱 GLM（兼容 Anthropic API 的代理）
GLM_ANTHROPIC_BASE_URL=
GLM_ANTHROPIC_AUTH_TOKEN=
GLM_ANTHROPIC_MODEL=glm-5
GLM_ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.7
GLM_ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5-turbo
GLM_ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.1
GLM_ANTHROPIC_REASONING_MODEL=glm-5.1

# CC（兼容 Anthropic API 的代理）
CC_ANTHROPIC_BASE_URL=
CC_ANTHROPIC_AUTH_TOKEN=
CC_ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7

# ==================== 字节跳动 ASR（豆包语音识别）====================
# 火山引擎控制台：https://console.volcengine.com/speech/app
BYTEDANCE_ASR_APP_KEY=
BYTEDANCE_ASR_ACCESS_KEY=
BYTEDANCE_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# ==================== MinIO 对象存储 ====================
# 公网 URL，客户端 / presigned URL 都用这个
MINIO_PUBLIC_URL=https://your-oss-host.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ==================== Postgres (jsonapp DB) ====================
DB_HOST=127.0.0.1
DB_PORT=15433
DB_NAME=jsonapp
DB_USER=jsonapp
DB_PASSWORD=

# ==================== Flask 服务 ====================
PORT=5566
SERVER_PROJECT_PATH=/root/ai-app
FLASK_SECRET_KEY=

# ==================== OpenIM ====================
# 客户端从 /api/im/token 拿这俩 URL，所以必须是公网可达的 https/wss
OPENIM_API_URL=https://your-im-host.example.com
OPENIM_WS_URL=wss://your-im-host.example.com
# 后端调 OpenIM admin API 用的共享 secret（与 OpenIM 容器 .env 里的 OPENIM_SECRET 一致）
OPENIM_SECRET=
# OpenIM 调我方 webhook 用的共享 secret（与 OpenIM 容器 webhooks.yml 里 ?secret=... 一致）
OPENIM_WEBHOOK_SECRET=

# ==================== APNs（仅 iOS 推送）====================
# .p8 私钥文件存在 /etc/apns/，权限 600，不进 git
APNS_KEY_PATH=/etc/apns/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.example.yourapp
APNS_USE_SANDBOX=true

# ==================== GeTui（国内推送）====================
# 真实值只放服务端环境变量文件，不提交到仓库。
GETUI_BASE_URL=https://restapi.getui.com/v2
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_APP_SECRET=
GETUI_MASTER_SECRET=
GETUI_TTL_MS=7200000

# ==================== Registry 管理 token ====================
# 用于 publish_script.py / migrate_templates.py 等服务端工具绕过 supabase 鉴权
REGISTRY_ADMIN_TOKEN=
REGISTRY_ADMIN_AUTHOR_EMAIL=2501808198@qq.com
REGISTRY_ADMIN_AUTHOR_NAME=fish
# Optional: set this to the Supabase user id if registry author profile/avatar should resolve to a real user.
REGISTRY_ADMIN_AUTHOR_ID=

# ==================== Claude CLI ====================
# nvm 装的 node 路径，按机器实际改
CLAUDE_BIN=/root/.nvm/versions/node/v22.22.2/bin/claude

# 同时运行的 AI agent 进程数，以及等待队列容量；超过队列容量会返回 429
AI_WORKER_MAX_CONCURRENCY=200
AI_WORKER_QUEUE_MAX=200
AI_WORKER_LEASE_MS=30000
AI_WORKER_HEARTBEAT_SECONDS=10
