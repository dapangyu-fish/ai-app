# OpenIM Server 部署配置
# 复制此文件为 .env 并修改各项密码

# MySQL
MYSQL_ROOT_PASSWORD=openIM_root_2024
MYSQL_PASSWORD=openIM_db_2024

# MongoDB
MONGO_PASSWORD=openIM_mongo_2024

# Redis
REDIS_PASSWORD=openIM_redis_2024

# MinIO
MINIO_ACCESS_KEY=openim_minio
MINIO_SECRET_KEY=openIM_minio_2024

# OpenIM Server Secret (用于生成 user token)
OPENIM_SECRET=openIM_secret_2024

# MinIO 外部访问地址 (改为你的公网域名)
MINIO_EXTERNAL_URL=http://127.0.0.1:10005
