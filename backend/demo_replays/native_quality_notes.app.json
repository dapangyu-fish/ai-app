    "functions": {
      "refreshList": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.filteredNotes",
              "value": {
                "filter": {
                  "and": [
                    {
                      "if": [
                        {
                          "==": [
                            {
                              "var": "global.selectedTag"
                            },
                            "全部"
                          ]
                        },
                        true,
                        {
                          "==": [
                            {
                              "var": "loop.item.tag"
                            },
                            {
                              "var": "global.selectedTag"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "or": [
                        {
                          "==": [
                            {
                              "var": "global.searchQuery"
                            },
                            ""
                          ]
                        },
                        {
                          "in": [
                            {
                              "var": "global.searchQuery"
                            },
                            {
                              "var": "loop.item.heading"
                            }
                          ]
                        },
                        {
                          "in": [
                            {
                              "var": "global.searchQuery"
                            },
                            {
                              "var": "loop.item.content"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "source": "global.notes",
                "item": "loop.item"
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.totalCount",
              "value": {
                "reduce": [
                  {
                    "var": "global.notes"
                  },
                  0,
                  {
                    "+": [
                      {
                        "var": "accumulator"
                      },
                      1
                    ]
                  },
                  "accumulator"
                ]
              }
            }
          }
        ]
      },
      "startCreate": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.editingId",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formTitle",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formContent",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formTag",
              "value": "工作"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formScreenTitle",
              "value": "{{ t('form.titleCreate') }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "note_form"
            }
          }
        ]
      },
      "startEdit": {
        "params": [
          "id"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.editingId",
              "value": "{{ params.id }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formScreenTitle",
              "value": "{{ t('form.titleEdit') }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global._editHeading",
              "value": {
                "var": {
                  "filter": {
                    "==": [
                      {
                        "var": "loop.item.id"
                      },
                      {
                        "var": "global.editingId"
                      }
                    ]
                  },
                  "source": "global.notes",
                  "item": "loop.item",
                  "first": true
                }
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formTitle",
              "value": "{{ global._editHeading.heading }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formContent",
              "value": "{{ global._editHeading.content }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formTag",
              "value": "{{ global._editHeading.tag }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "note_form"
            }
          }
        ]
      },
      "saveNote": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global._nextSeq",
              "value": {
                "+": [
                  {
                    "var": "global._nextSeq"
                  },
                  1
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global._tmpAccent",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "global.formTag"
                      },
                      "工作"
                    ]
                  },
                  "#2563EB",
                  {
                    "if": [
                      {
                        "==": [
                          {
                            "var": "global.formTag"
                          },
                          "生活"
                        ]
                      },
                      "#059669",
                      {
                        "if": [
                          {
                            "==": [
                              {
                                "var": "global.formTag"
                              },
                              "灵感"
                            ]
                          },
                          "#D97706",
                          "#7C3AED"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global._tmpTint",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "global.formTag"
                      },
                      "工作"
                    ]
                  },
                  "#EAF1FF",
                  {
                    "if": [
                      {
                        "==": [
                          {
                            "var": "global.formTag"
                          },
                          "生活"
                        ]
                      },
                      "#E8F7F0",
                      {
                        "if": [
                          {
                            "==": [
                              {
                                "var": "global.formTag"
                              },
                              "灵感"
                            ]
                          },
                          "#FFF4DE",
                          "#F3EDFF"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global._builtNote",
              "value": {
                "id": {
                  "if": [
                    {
                      "==": [
                        {
                          "var": "global.editingId"
                        },
                        ""
                      ]
                    },
                    {
                      "+": [
                        "n",
                        {
                          "var": "global._nextSeq"
                        }
                      ]
                    },
                    {
                      "var": "global.editingId"
                    }
                  ]
                },
                "heading": {
                  "var": "global.formTitle"
                },
                "tag": {
                  "var": "global.formTag"
                },
                "date": "刚刚",
                "excerpt": {
                  "substr": [
                    {
                      "var": "global.formContent"
                    },
                    0,
                    60
                  ]
                },
                "content": {
                  "var": "global.formContent"
                },
                "accent": {
                  "var": "global._tmpAccent"
                },
                "tint": {
                  "var": "global._tmpTint"
                }
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.notes",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "global.editingId"
                      },
                      ""
                    ]
                  },
                  {
                    "push": [
                      {
                        "var": "global.notes"
                      },
                      {
                        "var": "global._builtNote"
                      }
                    ]
                  },
                  {
                    "map": {
                      "source": "global.notes",
                      "item": "loop.item",
                      "body": {
                        "if": [
                          {
                            "==": [
                              {
                                "var": "loop.item.id"
                              },
                              {
                                "var": "global.editingId"
                              }
                            ]
                          },
                          {
                            "var": "global._builtNote"
                          },
                          {
                            "var": "loop.item"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "call": "@global.refreshList",
            "args": {}
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "{{ t('toast.saved') }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "home"
            }
          }
        ]
      },
      "deleteNote": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.notes",
              "value": {
                "filter": {
                  "!=": [
                    {
                      "var": "loop.item.id"
                    },
                    {
                      "var": "global.editingId"
                    }
                  ]
                },
                "source": "global.notes",
                "item": "loop.item"
              }
            }
          },
          {
            "call": "@global.refreshList",
            "args": {}
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "{{ t('toast.deleted') }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "home"
            }
          }
        ]
      }
    }
  },
