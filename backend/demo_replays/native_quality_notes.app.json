        },
        {
          "id": "n2",
          "heading": "周末阅读清单",
          "tag": "生活",
          "date": "昨天 14:20",
          "excerpt": "系统设计、交互心理学、一本短篇小说。控制在 3 小时内。",
          "content": "系统设计、交互心理学、一本短篇小说。控制在 3 小时内。\n\n读完只记录能落到实践里的结论。",
          "accent": "#059669",
          "tint": "#E8F7F0"
        },
        {
          "id": "n3",
          "heading": "旅行备忘",
          "tag": "灵感",
          "date": "6月20日",
          "excerpt": "证件、充电器、降噪耳机、备用银行卡。出发前一天再检查。",
          "content": "证件、充电器、降噪耳机、备用银行卡。出发前一天再检查。\n\n酒店确认邮件和路线截图都放到同一个文件夹。",
          "accent": "#D97706",
          "tint": "#FFF4DE"
        },
        {
          "id": "n4",
          "heading": "React 性能优化笔记",
          "tag": "学习",
          "date": "6月18日",
          "excerpt": "useMemo、useCallback 使用场景，避免不必要的重渲染。",
          "content": "useMemo、useCallback 使用场景。\n\n1. 列表虚拟化用 react-window\n2. 图片懒加载\n3. Code splitting",
          "accent": "#7C3AED",
          "tint": "#F3EDFF"
        }
      ],
      "_nextSeq": 5,
      "_tmpAccent": "#2563EB",
      "_tmpTint": "#EAF1FF"
    },
    "functions": {
      "refreshList": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.filteredNotes",
              "value": {
                "filter": {
                  "and": [
                    {
                      "if": [
                        {
                          "==": [
                            {
                              "var": "global.selectedTag"
                            },
                            "全部"
                          ]
                        },
                        true,
                        {
                          "==": [
                            {
                              "var": "loop.item.tag"
                            },
                            {
                              "var": "global.selectedTag"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "or": [
                        {
                          "==": [
                            {
                              "var": "global.searchQuery"
                            },
                            ""
                          ]
                        },
                        {
                          "in": [
                            {
                              "var": "global.searchQuery"
                            },
                            {
                              "var": "loop.item.heading"
                            }
                          ]
                        },
                        {
                          "in": [
                            {
                              "var": "global.searchQuery"
                            },
                            {
                              "var": "loop.item.content"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "source": "global.notes",
                "item": "loop.item"
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.totalCount",
              "value": {
                "reduce": [
                  {
                    "var": "global.notes"
                  },
                  0,
                  {
                    "+": [
                      {
                        "var": "accumulator"
                      },
                      1
                    ]
                  },
                  "accumulator"
                ]
              }
            }
          }
        ]
      },
      "startCreate": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.editingId",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formTitle",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formContent",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formTag",
              "value": "工作"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formScreenTitle",
              "value": "新建笔记"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "note_form"
            }
          }
        ]
      },
      "startEdit": {
        "params": [
          "id"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.editingId",
              "value": "{{ params.id }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formScreenTitle",
              "value": "编辑笔记"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global._editHeading",
              "value": {
                "var": {
                  "filter": {
                    "==": [
                      {
                        "var": "loop.item.id"
                      },
                      {
                        "var": "global.editingId"
                      }
                    ]
                  },
                  "source": "global.notes",
                  "item": "loop.item",
                  "first": true
                }
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formTitle",
              "value": "{{ global._editHeading.heading }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formContent",
              "value": "{{ global._editHeading.content }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.formTag",
              "value": "{{ global._editHeading.tag }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "note_form"
            }
          }
        ]
      },
      "saveNote": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global._nextSeq",
              "value": {
                "+": [
                  {
                    "var": "global._nextSeq"
                  },
                  1
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global._tmpAccent",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "global.formTag"
                      },
                      "工作"
                    ]
                  },
                  "#2563EB",
                  {
                    "if": [
                      {
                        "==": [
                          {
                            "var": "global.formTag"
                          },
                          "生活"
                        ]
                      },
                      "#059669",
                      {
                        "if": [
                          {
                            "==": [
                              {
                                "var": "global.formTag"
                              },
                              "灵感"
                            ]
                          },
                          "#D97706",
                          "#7C3AED"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global._tmpTint",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "global.formTag"
                      },
                      "工作"
                    ]
                  },
                  "#EAF1FF",
                  {
                    "if": [
                      {
                        "==": [
                          {
                            "var": "global.formTag"
                          },
                          "生活"
                        ]
                      },
                      "#E8F7F0",
                      {
                        "if": [
                          {
                            "==": [
                              {
                                "var": "global.formTag"
                              },
                              "灵感"
                            ]
                          },
                          "#FFF4DE",
                          "#F3EDFF"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global._builtNote",
              "value": {
                "id": {
                  "if": [
                    {
                      "==": [
                        {
                          "var": "global.editingId"
                        },
                        ""
                      ]
                    },
                    {
                      "+": [
                        "n",
                        {
                          "var": "global._nextSeq"
                        }
                      ]
                    },
                    {
                      "var": "global.editingId"
                    }
                  ]
                },
                "heading": {
                  "var": "global.formTitle"
                },
                "tag": {
                  "var": "global.formTag"
                },
                "date": "刚刚",
                "excerpt": {
                  "substr": [
                    {
                      "var": "global.formContent"
                    },
                    0,
                    60
                  ]
                },
                "content": {
                  "var": "global.formContent"
                },
                "accent": {
                  "var": "global._tmpAccent"
                },
                "tint": {
                  "var": "global._tmpTint"
                }
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.notes",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "global.editingId"
                      },
                      ""
                    ]
                  },
                  {
                    "push": [
                      {
                        "var": "global.notes"
                      },
                      {
                        "var": "global._builtNote"
                      }
                    ]
                  },
                  {
                    "map": {
                      "source": "global.notes",
                      "item": "loop.item",
                      "body": {
                        "if": [
                          {
                            "==": [
                              {
                                "var": "loop.item.id"
                              },
                              {
                                "var": "global.editingId"
                              }
                            ]
                          },
                          {
                            "var": "global._builtNote"
                          },
                          {
                            "var": "loop.item"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "call": "@global.refreshList",
            "args": {}
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "笔记已保存"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "home"
            }
          }
        ]
      },
      "deleteNote": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.notes",
              "value": {
                "filter": {
                  "!=": [
                    {
                      "var": "loop.item.id"
                    },
                    {
                      "var": "global.editingId"
                    }
                  ]
                },
                "source": "global.notes",
                "item": "loop.item"
              }
            }
          },
          {
            "call": "@global.refreshList",
            "args": {}
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "笔记已删除"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "home"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@global.refreshList",
      "args": {}
    }
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "笔记",
        "layout": "column",
        "backgroundColor": "#F4F6F8",
        "appBar": {
          "title": "笔记",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.startCreate",
                "args": {}
              },
              "icon": "add",
              "style": {
                "textColor": "#2563EB",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        },
        "children": [
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "notes",
                          "size": 18,
                          "color": "#2563EB"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "全部笔记",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "{{ global.totalCount }}",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "today",
                          "size": 18,
                          "color": "#10B981"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "本周新增",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "{{ global.weekCount }}",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              }
            ],
            "margin": 8
          },
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "icon",
                "name": "search",
                "size": 18,
                "color": "#8E8E93"
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "input",
                "placeholder": "搜索标题或内容",
                "bind": "global.searchQuery",
                "position": {
                  "type": "flex",
                  "flex": 1
                },
                "style": {
                  "fontSize": 15,
                  "borderRadius": 10
                }
              },
              {
                "type": "button",
                "label": "搜索",
                "variant": "text",
                "action": {
                  "call": "@global.refreshList",
                  "args": {}
                },
                "style": {
                  "textColor": "#2563EB",
                  "fontSize": 14
                }
              }
            ],
            "padding": 10,
            "margin": 12,
            "color": "#F7F8FA",
            "borderRadius": 14,
            "crossAxisAlignment": "center"
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "wrap",
                "spacing": 8,
                "runSpacing": 8,
                "children": [
                  {
                    "type": "chip",
                    "label": "全部",
                    "variant": "choice",
                    "bind": "global.selectedTag",
                    "value": "全部",
                    "color": "#2563EB"
                  },
                  {
                    "type": "chip",
                    "label": "工作",
                    "variant": "choice",
                    "bind": "global.selectedTag",
                    "value": "工作",
                    "color": "#2563EB"
                  },
                  {
                    "type": "chip",
                    "label": "生活",
                    "variant": "choice",
                    "bind": "global.selectedTag",
                    "value": "生活",
                    "color": "#2563EB"
                  },
                  {
                    "type": "chip",
                    "label": "灵感",
                    "variant": "choice",
                    "bind": "global.selectedTag",
                    "value": "灵感",
                    "color": "#2563EB"
                  },
                  {
                    "type": "chip",
                    "label": "学习",
                    "variant": "choice",
                    "bind": "global.selectedTag",
                    "value": "学习",
                    "color": "#2563EB"
                  }
                ]
              }
            ],
            "padding": 12,
            "margin": 8,
            "color": "#FFFFFF",
            "borderRadius": 14
          },
          {
            "type": "list",
            "source": "{{ global.filteredNotes }}",
            "emptyText": "暂无笔记，点击下方按钮创建第一条",
            "item_template": {
              "type": "card",
              "layout": "column",
              "color": "#FFFFFF",
              "padding": 14,
              "margin": 8,
              "elevation": 0,
              "borderRadius": 16,
              "children": [
                {
                  "type": "container",
                  "layout": "row",
                  "children": [
                    {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "icon",
                          "name": "notes",
                          "size": 20,
                          "color": "{{ loop.item.accent }}"
                        }
                      ],
                      "width": 42,
                      "height": 42,
                      "color": "{{ loop.item.tint }}",
                      "borderRadius": 12,
                      "mainAxisAlignment": "center",
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "width": 12
                    },
                    {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "container",
                          "layout": "row",
                          "children": [
                            {
                              "type": "text",
                              "value": "{{ loop.item.heading }}",
                              "style": {
                                "fontSize": 16,
                                "fontWeight": "bold",
                                "color": "#111827",
                                "maxLines": 1,
                                "overflow": "ellipsis"
                              },
                              "position": {
                                "type": "flex",
                                "flex": 1
                              }
                            },
                            {
                              "type": "text",
                              "value": "{{ loop.item.date }}",
                              "style": {
                                "fontSize": 12,
                                "color": "#9CA3AF"
                              }
                            }
                          ],
                          "crossAxisAlignment": "center"
                        },
                        {
                          "type": "spacer",
                          "height": 6
                        },
                        {
                          "type": "text",
                          "value": "{{ loop.item.excerpt }}",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280",
                            "lineHeight": 1.35,
                            "maxLines": 2,
                            "overflow": "ellipsis"
                          }
                        },
                        {
                          "type": "spacer",
                          "height": 10
                        },
                        {
                          "type": "container",
                          "layout": "row",
                          "children": [
                            {
                              "type": "container",
                              "layout": "column",
                              "children": [
                                {
                                  "type": "text",
                                  "value": "{{ loop.item.tag }}",
                                  "style": {
                                    "fontSize": 12,
                                    "fontWeight": "600",
                                    "color": "{{ loop.item.accent }}"
                                  }
                                }
                              ],
                              "padding": 6,
                              "borderRadius": 12,
                              "color": "{{ loop.item.tint }}"
                            },
                            {
                              "type": "spacer",
                              "position": {
                                "type": "flex",
                                "flex": 1
                              }
                            },
                            {
                              "type": "icon",
                              "name": "chevron_right",
                              "size": 16,
                              "color": "#C4C4C8"
                            }
                          ],
                          "crossAxisAlignment": "center"
                        }
                      ],
                      "position": {
                        "type": "flex",
                        "flex": 1
                      }
                    }
                  ],
                  "crossAxisAlignment": "start"
                }
              ],
              "onTap": {
                "call": "@global.startEdit",
                "args": {
                  "id": "{{ loop.item.id }}"
                }
              }
            }
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "button",
                "label": "新建笔记",
                "variant": "filled",
                "action": {
                  "call": "@global.startCreate",
                  "args": {}
                },
                "icon": "add",
                "style": {
                  "backgroundColor": "#2563EB",
                  "textColor": "#FFFFFF",
                  "borderRadius": 16,
                  "fontSize": 15,
                  "paddingV": 12
                }
              }
            ],
            "padding": 12,
            "color": "#F4F6F8"
          }
        ]
      },
      {
        "id": "note_form",
        "title": "{{ global.formScreenTitle }}",
        "layout": "column",
        "backgroundColor": "#F4F6F8",
        "appBar": {
          "title": "{{ global.formScreenTitle }}",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.deleteNote",
                "args": {}
              },
              "icon": "delete",
              "style": {
                "textColor": "#EF4444",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        },
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 18,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "text",
                "value": "标题",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "600",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "input",
                "placeholder": "输入笔记标题",
                "bind": "global.formTitle",
                "style": {
                  "fontSize": 16
                }
              },
              {
                "type": "spacer",
                "height": 16
              },
              {
                "type": "text",
                "value": "标签",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "600",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "container",
                "layout": "column",
                "children": [
                  {
                    "type": "wrap",
                    "spacing": 8,
                    "runSpacing": 8,
                    "children": [
                      {
                        "type": "chip",
                        "label": "工作",
                        "variant": "choice",
                        "bind": "global.formTag",
                        "value": "工作",
                        "color": "#2563EB"
                      },
                      {
                        "type": "chip",
                        "label": "生活",
                        "variant": "choice",
                        "bind": "global.formTag",
                        "value": "生活",
                        "color": "#2563EB"
                      },
                      {
                        "type": "chip",
                        "label": "灵感",
                        "variant": "choice",
                        "bind": "global.formTag",
                        "value": "灵感",
                        "color": "#2563EB"
                      },
                      {
                        "type": "chip",
                        "label": "学习",
                        "variant": "choice",
                        "bind": "global.formTag",
                        "value": "学习",
                        "color": "#2563EB"
                      }
                    ]
                  }
                ],
                "padding": 10,
                "color": "#F9FAFB",
                "borderRadius": 12
              },
              {
                "type": "spacer",
                "height": 16
              },
              {
                "type": "text",
                "value": "内容",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "600",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "input",
                "placeholder": "记录想法、任务或灵感…",
                "bind": "global.formContent",
                "maxLines": 10,
                "style": {
                  "fontSize": 15,
                  "minHeight": 160
                }
              },
              {
                "type": "spacer",
                "height": 20
              },
              {
                "type": "button",
                "label": "保存笔记",
                "variant": "filled",
                "action": {
                  "call": "@global.saveNote",
                  "args": {}
                },
                "icon": "save",
                "style": {
                  "backgroundColor": "#2563EB",
                  "textColor": "#FFFFFF",
                  "borderRadius": 14,
                  "fontSize": 15,
                  "paddingV": 13
                }
              }
            ]
          }
        ]
      }
    ]
  }
}