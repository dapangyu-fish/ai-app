    "functions": {
      "updateCounts": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.totalCount",
              "value": {
                "var": "global.entries",
                "method": "length"
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.todayCount",
              "value": {
                "filter": [
                  {
                    "var": "global.entries"
                  },
                  {
                    "==": [
                      {
                        "var": "item.date"
                      },
                      "{{ global.todayLabel }}"
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.todayCount",
              "value": {
                "var": "global.todayCount",
                "method": "length"
              }
            }
          }
        ]
      },
      "filterEntries": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.filteredEntries",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "global.searchQuery"
                      },
                      ""
                    ]
                  },
                  {
                    "var": "global.entries"
                  },
                  {
                    "filter": [
                      {
                        "var": "global.entries"
                      },
                      {
                        "in": [
                          {
                            "var": "global.searchQuery"
                          },
                          {
                            "var": "item.content"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "startCreate": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.formContent",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.editingId",
              "value": null
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "add_form"
            }
          }
        ]
      },
      "saveEntry": {
        "params": [],
        "logic": [
          {
            "if": [
              {
                "==": [
                  {
                    "var": "global.formContent"
                  },
                  ""
                ]
              },
              [
                {
                  "call": "@show_toast",
                  "args": {
                    "message": "{{ t('toast.emptyContent') }}"
                  }
                }
              ],
              [
                {
                  "if": [
                    {
                      "!=": [
                        {
                          "var": "global.editingId"
                        },
                        null
                      ]
                    },
                    {
                      "call": "@set",
                      "args": {
                        "var": "global.entries",
                        "value": {
                          "map": [
                            {
                              "var": "global.entries"
                            },
                            {
                              "if": [
                                {
                                  "==": [
                                    {
                                      "var": "item.id"
                                    },
                                    {
                                      "var": "global.editingId"
                                    }
                                  ]
                                },
                                {
                                  "merge": [
                                    {
                                      "var": "item"
                                    },
                                    {
                                      "content": {
                                        "var": "global.formContent"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "var": "item"
                                }
                              ]
                            }
                          ]
                        }
                      }
                    },
                    [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.entries",
                          "value": {
                            "concat": [
                              [
                                {
                                  "id": {
                                    "call": "@uuid"
                                  },
                                  "content": {
                                    "var": "global.formContent"
                                  },
                                  "date": "{{ global.todayLabel }}"
                                }
                              ],
                              {
                                "var": "global.entries"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  ]
                },
                {
                  "call": "@global.updateCounts"
                },
                {
                  "call": "@global.filterEntries"
                },
                {
                  "call": "@navigate",
                  "args": {
                    "screen": "home"
                  }
                },
                {
                  "call": "@show_toast",
                  "args": {
                    "message": "{{ t('toast.saved') }}"
                  }
                }
              ]
            ]
          }
        ]
      },
      "viewEntry": {
        "params": [
          "id",
          "content",
          "date"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentId",
              "value": "{{ params.id }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentContent",
              "value": "{{ params.content }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentDate",
              "value": "{{ params.date }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "detail"
            }
          }
        ]
      },
      "editCurrent": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.formContent",
              "value": "{{ global.currentContent }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.editingId",
              "value": "{{ global.currentId }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "add_form"
            }
          }
        ]
      },
      "deleteEntry": {
        "params": [
          "id"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.entries",
              "value": {
                "filter": [
                  {
                    "var": "global.entries"
                  },
                  {
                    "!=": [
                      {
                        "var": "item.id"
                      },
                      {
                        "var": "params.id"
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@global.updateCounts"
          },
          {
            "call": "@global.filterEntries"
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "{{ t('toast.deleted') }}"
            }
          }
        ]
      },
      "deleteCurrent": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.entries",
              "value": {
                "filter": [
                  {
                    "var": "global.entries"
                  },
                  {
                    "!=": [
                      {
                        "var": "item.id"
                      },
                      {
                        "var": "global.currentId"
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@global.updateCounts"
          },
          {
            "call": "@global.filterEntries"
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "home"
            }
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "{{ t('toast.deleted') }}"
            }
          }
        ]
      },
      "copyCurrent": {
        "params": [],
        "logic": [
          {
            "call": "@clipboard_copy",
            "args": {
              "text": "{{ global.currentContent }}"
            }
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "{{ t('toast.copied') }}"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@global.updateCounts"
    },
    {
      "call": "@global.filterEntries"
    }
  ],
