              }
            ],
            "margin": 8
          },
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "icon",
                "name": "search",
                "size": 18,
                "color": "#8E8E93"
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "input",
                "placeholder": "{{ t('home.searchPlaceholder') }}",
                "bind": "global.searchQuery",
                "position": {
                  "type": "flex",
                  "flex": 1
                },
                "style": {
                  "fontSize": 15,
                  "borderRadius": 10
                }
              }
            ],
            "padding": 10,
            "margin": 12,
            "color": "#FFFFFF",
            "borderRadius": 14,
            "crossAxisAlignment": "center"
          },
          {
            "type": "list",
            "source": "{{ global.filteredEntries }}",
            "emptyText": "{{ t('home.empty') }}",
            "item_template": {
              "type": "card",
              "layout": "column",
              "color": "#FFFFFF",
              "padding": 14,
              "margin": 8,
              "elevation": 0,
              "borderRadius": 16,
              "children": [
                {
                  "type": "text",
                  "value": "{{ loop.item.content }}",
                  "style": {
                    "fontSize": 15,
                    "color": "#1F2937",
                    "lineHeight": 1.45,
                    "maxLines": 3,
                    "overflow": "ellipsis"
                  }
                },
                {
                  "type": "spacer",
                  "height": 10
                },
                {
                  "type": "container",
                  "layout": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.date }}",
                      "style": {
                        "fontSize": 12,
                        "color": "#9CA3AF"
                      }
                    },
                    {
                      "type": "spacer",
                      "width": 8
                    },
                    {
                      "type": "expanded",
                      "flex": 1,
                      "child": {
                        "type": "container",
                        "layout": "row",
                        "children": []
                      }
                    },
                    {
                      "type": "button",
                      "label": "{{ t('home.copy') }}",
                      "variant": "text",
                      "action": {
                        "call": "@clipboard_copy",
                        "args": {
                          "text": "{{ loop.item.content }}"
                        }
                      },
                      "icon": "copy",
                      "style": {
                        "textColor": "#6366F1",
                        "fontSize": 13,
                        "paddingH": 8,
                        "paddingV": 4
                      }
                    },
                    {
                      "type": "spacer",
                      "width": 4
                    },
                    {
                      "type": "button",
                      "label": "",
                      "variant": "text",
                      "action": {
                        "call": "@global.deleteEntry",
                        "args": {
                          "id": "{{ loop.item.id }}"
                        }
                      },
                      "icon": "delete",
                      "style": {
                        "textColor": "#EF4444",
                        "fontSize": 16,
                        "paddingH": 6,
                        "paddingV": 4
                      }
                    }
                  ],
                  "crossAxisAlignment": "center"
                }
              ],
              "onTap": {
                "call": "@global.viewEntry",
                "args": {
                  "id": "{{ loop.item.id }}",
                  "content": "{{ loop.item.content }}",
                  "date": "{{ loop.item.date }}"
                }
              }
            }
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "button",
                "label": "{{ t('home.quickAdd') }}",
                "variant": "filled",
                "action": {
                  "call": "@global.startCreate",
                  "args": {}
                },
                "icon": "add",
                "style": {
                  "backgroundColor": "#6366F1",
                  "textColor": "#FFFFFF",
                  "borderRadius": 16,
                  "fontSize": 15,
                  "paddingV": 14
                }
              }
            ],
            "padding": 16,
            "color": "#F5F5F7"
          }
        ],
        "backgroundColor": "#F5F5F7",
        "appBar": {
          "title": "{{ t('home.title') }}",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.startCreate",
                "args": {}
              },
              "icon": "add",
              "style": {
                "textColor": "#6366F1",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        }
      },
      {
        "id": "add_form",
        "title": "{{ t('home.quickAdd') }}",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 18,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "text",
                "value": "{{ t('form.label') }}",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "600",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 10
              },
              {
                "type": "input",
                "placeholder": "{{ t('form.placeholder') }}",
                "bind": "global.formContent",
                "maxLines": 10,
                "style": {
                  "fontSize": 16,
                  "lineHeight": 1.55
                }
              },
              {
                "type": "spacer",
                "height": 18
              },
              {
                "type": "button",
                "label": "{{ t('form.save') }}",
                "variant": "filled",
                "action": {
                  "call": "@global.saveEntry",
                  "args": {}
                },
                "icon": "save",
                "style": {
                  "backgroundColor": "#6366F1",
                  "textColor": "#FFFFFF",
                  "borderRadius": 14,
                  "fontSize": 15,
                  "paddingV": 13
                }
              }
            ]
          }
        ],
        "backgroundColor": "#F5F5F7",
        "appBar": {
          "title": "{{ t('form.appBarTitle') }}",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.saveEntry",
                "args": {}
              },
              "icon": "check",
              "style": {
                "textColor": "#6366F1",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              },
              "tooltip": "{{ t('form.save') }}"
            }
          ]
        }
      },
      {
        "id": "detail",
        "title": "{{ t('detail.title') }}",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 18,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "icon",
                    "name": "calendar",
                    "size": 16,
                    "color": "#9CA3AF"
                  },
                  {
                    "type": "spacer",
                    "width": 6
                  },
                  {
                    "type": "text",
                    "value": "{{ global.currentDate }}",
                    "style": {
                      "fontSize": 13,
                      "color": "#9CA3AF"
                    }
                  }
                ],
                "crossAxisAlignment": "center"
              },
              {
                "type": "spacer",
                "height": 14
              },
              {
                "type": "text",
                "value": "{{ global.currentContent }}",
                "style": {
                  "fontSize": 16,
                  "color": "#1F2937",
                  "lineHeight": 1.7
                }
              },
              {
                "type": "spacer",
                "height": 20
              },
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "button",
                    "label": "{{ t('detail.copyFull') }}",
                    "variant": "filled",
                    "action": {
                      "call": "@global.copyCurrent",
                      "args": {}
                    },
                    "icon": "copy",
                    "style": {
                      "backgroundColor": "#6366F1",
                      "textColor": "#FFFFFF",
                      "borderRadius": 14,
                      "fontSize": 15,
                      "paddingV": 12
                    }
                  },
                  {
                    "type": "spacer",
                    "width": 12
                  },
                  {
                    "type": "button",
                    "label": "{{ t('detail.edit') }}",
                    "variant": "outlined",
                    "action": {
                      "call": "@global.editCurrent",
                      "args": {}
                    },
                    "icon": "edit",
                    "style": {
                      "borderColor": "#6366F1",
                      "textColor": "#6366F1",
                      "borderRadius": 14,
                      "fontSize": 15,
                      "paddingV": 12
                    }
                  },
                  {
                    "type": "spacer",
                    "width": 12
                  },
                  {
                    "type": "button",
                    "label": "{{ t('detail.delete') }}",
                    "variant": "outlined",
                    "action": {
                      "call": "@global.deleteCurrent",
                      "args": {}
                    },
                    "icon": "delete",
                    "style": {
                      "borderColor": "#EF4444",
                      "textColor": "#EF4444",
                      "borderRadius": 14,
                      "fontSize": 15,
                      "paddingV": 12
                    }
                  }
                ]
              }
            ]
          }
        ],
        "backgroundColor": "#F5F5F7",
        "appBar": {
          "title": "{{ t('detail.appBarTitle') }}",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.editCurrent",
                "args": {}
              },
              "icon": "edit",
              "style": {
                "textColor": "#6366F1",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              },
              "tooltip": "{{ t('detail.edit') }}"
            },
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.deleteCurrent",
                "args": {}
              },
              "icon": "delete",
              "style": {
                "textColor": "#EF4444",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              },
              "tooltip": "{{ t('detail.delete') }}"
            }
          ]
        }
      }
    ]
  }
}
