{
  "dsl": "3.3",
  "meta": {
    "name": "text-collector",
    "version": "1.0.0",
    "type": "app",
    "description": "快速记录、列表管理、复制",
    "author": "fish",
    "displayName": "文本收集器"
  },
  "dependencies": {},
  "global": {
    "variables": {
      "entries": [],
      "searchQuery": "",
      "filteredEntries": [],
      "formContent": "",
      "editingId": null,
      "currentId": "",
      "currentContent": "",
      "currentDate": "",
      "totalCount": 0,
      "todayCount": 0,
      "todayLabel": "今天"
    },
    "functions": {
      "updateCounts": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.totalCount",
              "value": {
                "var": "global.entries",
                "method": "length"
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.todayCount",
              "value": {
                "filter": [
                  {
                    "var": "global.entries"
                  },
                  {
                    "==": [
                      {
                        "var": "item.date"
                      },
                      "{{ global.todayLabel }}"
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.todayCount",
              "value": {
                "var": "global.todayCount",
                "method": "length"
              }
            }
          }
        ]
      },
      "filterEntries": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.filteredEntries",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "global.searchQuery"
                      },
                      ""
                    ]
                  },
                  {
                    "var": "global.entries"
                  },
                  {
                    "filter": [
                      {
                        "var": "global.entries"
                      },
                      {
                        "in": [
                          {
                            "var": "global.searchQuery"
                          },
                          {
                            "var": "item.content"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "startCreate": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.formContent",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.editingId",
              "value": null
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "add_form"
            }
          }
        ]
      },
      "saveEntry": {
        "params": [],
        "logic": [
          {
            "if": [
              {
                "==": [
                  {
                    "var": "global.formContent"
                  },
                  ""
                ]
              },
              [
                {
                  "call": "@show_toast",
                  "args": {
                    "message": "请输入文本内容"
                  }
                }
              ],
              [
                {
                  "if": [
                    {
                      "!=": [
                        {
                          "var": "global.editingId"
                        },
                        null
                      ]
                    },
                    {
                      "call": "@set",
                      "args": {
                        "var": "global.entries",
                        "value": {
                          "map": [
                            {
                              "var": "global.entries"
                            },
                            {
                              "if": [
                                {
                                  "==": [
                                    {
                                      "var": "item.id"
                                    },
                                    {
                                      "var": "global.editingId"
                                    }
                                  ]
                                },
                                {
                                  "merge": [
                                    {
                                      "var": "item"
                                    },
                                    {
                                      "content": {
                                        "var": "global.formContent"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "var": "item"
                                }
                              ]
                            }
                          ]
                        }
                      }
                    },
                    [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.entries",
                          "value": {
                            "concat": [
                              [
                                {
                                  "id": {
                                    "call": "@uuid"
                                  },
                                  "content": {
                                    "var": "global.formContent"
                                  },
                                  "date": "{{ global.todayLabel }}"
                                }
                              ],
                              {
                                "var": "global.entries"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  ]
                },
                {
                  "call": "@global.updateCounts"
                },
                {
                  "call": "@global.filterEntries"
                },
                {
                  "call": "@navigate",
                  "args": {
                    "screen": "home"
                  }
                },
                {
                  "call": "@show_toast",
                  "args": {
                    "message": "已保存"
                  }
                }
              ]
            ]
          }
        ]
      },
      "viewEntry": {
        "params": [
          "id",
          "content",
          "date"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentId",
              "value": "{{ params.id }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentContent",
              "value": "{{ params.content }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentDate",
              "value": "{{ params.date }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "detail"
            }
          }
        ]
      },
      "editCurrent": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.formContent",
              "value": "{{ global.currentContent }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.editingId",
              "value": "{{ global.currentId }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "add_form"
            }
          }
        ]
      },
      "deleteEntry": {
        "params": [
          "id"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.entries",
              "value": {
                "filter": [
                  {
                    "var": "global.entries"
                  },
                  {
                    "!=": [
                      {
                        "var": "item.id"
                      },
                      {
                        "var": "params.id"
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@global.updateCounts"
          },
          {
            "call": "@global.filterEntries"
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "已删除"
            }
          }
        ]
      },
      "deleteCurrent": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.entries",
              "value": {
                "filter": [
                  {
                    "var": "global.entries"
                  },
                  {
                    "!=": [
                      {
                        "var": "item.id"
                      },
                      {
                        "var": "global.currentId"
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "call": "@global.updateCounts"
          },
          {
            "call": "@global.filterEntries"
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "home"
            }
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "已删除"
            }
          }
        ]
      },
      "copyCurrent": {
        "params": [],
        "logic": [
          {
            "call": "@clipboard_copy",
            "args": {
              "text": "{{ global.currentContent }}"
            }
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "已复制到剪贴板"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@global.updateCounts"
    },
    {
      "call": "@global.filterEntries"
    }
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "文本收集器",
        "layout": "column",
        "children": [
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "notes",
                          "size": 18,
                          "color": "#6366F1"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "全部记录",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "{{ global.totalCount }}",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "today",
                          "size": 18,
                          "color": "#10B981"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "今天",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "{{ global.todayCount }}",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              }
            ],
            "margin": 8
          },
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "icon",
                "name": "search",
                "size": 18,
                "color": "#8E8E93"
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "input",
                "placeholder": "搜索文本内容",
                "bind": "global.searchQuery",
                "position": {
                  "type": "flex",
                  "flex": 1
                },
                "style": {
                  "fontSize": 15,
                  "borderRadius": 10
                }
              }
            ],
            "padding": 10,
            "margin": 12,
            "color": "#FFFFFF",
            "borderRadius": 14,
            "crossAxisAlignment": "center"
          },
          {
            "type": "list",
            "source": "{{ global.filteredEntries }}",
            "emptyText": "还没有记录，点击右下角按钮开始记录",
            "item_template": {
              "type": "card",
              "layout": "column",
              "color": "#FFFFFF",
              "padding": 14,
              "margin": 8,
              "elevation": 0,
              "borderRadius": 16,
              "children": [
                {
                  "type": "text",
                  "value": "{{ loop.item.content }}",
                  "style": {
                    "fontSize": 15,
                    "color": "#1F2937",
                    "lineHeight": 1.45,
                    "maxLines": 3,
                    "overflow": "ellipsis"
                  }
                },
                {
                  "type": "spacer",
                  "height": 10
                },
                {
                  "type": "container",
                  "layout": "row",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.date }}",
                      "style": {
                        "fontSize": 12,
                        "color": "#9CA3AF"
                      }
                    },
                    {
                      "type": "spacer",
                      "width": 8
                    },
                    {
                      "type": "expanded",
                      "flex": 1,
                      "child": {
                        "type": "container",
                        "layout": "row",
                        "children": []
                      }
                    },
                    {
                      "type": "button",
                      "label": "复制",
                      "variant": "text",
                      "action": {
                        "call": "@clipboard_copy",
                        "args": {
                          "text": "{{ loop.item.content }}"
                        }
                      },
                      "icon": "copy",
                      "style": {
                        "textColor": "#6366F1",
                        "fontSize": 13,
                        "paddingH": 8,
                        "paddingV": 4
                      }
                    },
                    {
                      "type": "spacer",
                      "width": 4
                    },
                    {
                      "type": "button",
                      "label": "",
                      "variant": "text",
                      "action": {
                        "call": "@global.deleteEntry",
                        "args": {
                          "id": "{{ loop.item.id }}"
                        }
                      },
                      "icon": "delete",
                      "style": {
                        "textColor": "#EF4444",
                        "fontSize": 16,
                        "paddingH": 6,
                        "paddingV": 4
                      }
                    }
                  ],
                  "crossAxisAlignment": "center"
                }
              ],
              "onTap": {
                "call": "@global.viewEntry",
                "args": {
                  "id": "{{ loop.item.id }}",
                  "content": "{{ loop.item.content }}",
                  "date": "{{ loop.item.date }}"
                }
              }
            }
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "button",
                "label": "快速记录",
                "variant": "filled",
                "action": {
                  "call": "@global.startCreate",
                  "args": {}
                },
                "icon": "add",
                "style": {
                  "backgroundColor": "#6366F1",
                  "textColor": "#FFFFFF",
                  "borderRadius": 16,
                  "fontSize": 15,
                  "paddingV": 14
                }
              }
            ],
            "padding": 16,
            "color": "#F5F5F7"
          }
        ],
        "backgroundColor": "#F5F5F7",
        "appBar": {
          "title": "文本收集器",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.startCreate",
                "args": {}
              },
              "icon": "add",
              "style": {
                "textColor": "#6366F1",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        }
      },
      {
        "id": "add_form",
        "title": "快速记录",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 18,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "text",
                "value": "文本内容",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "600",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 10
              },
              {
                "type": "input",
                "placeholder": "输入或粘贴文本...",
                "bind": "global.formContent",
                "maxLines": 10,
                "style": {
                  "fontSize": 16,
                  "lineHeight": 1.55
                }
              },
              {
                "type": "spacer",
                "height": 18
              },
              {
                "type": "button",
                "label": "保存",
                "variant": "filled",
                "action": {
                  "call": "@global.saveEntry",
                  "args": {}
                },
                "icon": "save",
                "style": {
                  "backgroundColor": "#6366F1",
                  "textColor": "#FFFFFF",
                  "borderRadius": 14,
                  "fontSize": 15,
                  "paddingV": 13
                }
              }
            ]
          }
        ],
        "backgroundColor": "#F5F5F7",
        "appBar": {
          "title": "记录",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.saveEntry",
                "args": {}
              },
              "icon": "check",
              "style": {
                "textColor": "#6366F1",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              },
              "tooltip": "保存"
            }
          ]
        }
      },
      {
        "id": "detail",
        "title": "详情",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 18,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "icon",
                    "name": "calendar",
                    "size": 16,
                    "color": "#9CA3AF"
                  },
                  {
                    "type": "spacer",
                    "width": 6
                  },
                  {
                    "type": "text",
                    "value": "{{ global.currentDate }}",
                    "style": {
                      "fontSize": 13,
                      "color": "#9CA3AF"
                    }
                  }
                ],
                "crossAxisAlignment": "center"
              },
              {
                "type": "spacer",
                "height": 14
              },
              {
                "type": "text",
                "value": "{{ global.currentContent }}",
                "style": {
                  "fontSize": 16,
                  "color": "#1F2937",
                  "lineHeight": 1.7
                }
              },
              {
                "type": "spacer",
                "height": 20
              },
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "button",
                    "label": "复制全文",
                    "variant": "filled",
                    "action": {
                      "call": "@global.copyCurrent",
                      "args": {}
                    },
                    "icon": "copy",
                    "style": {
                      "backgroundColor": "#6366F1",
                      "textColor": "#FFFFFF",
                      "borderRadius": 14,
                      "fontSize": 15,
                      "paddingV": 12
                    }
                  },
                  {
                    "type": "spacer",
                    "width": 12
                  },
                  {
                    "type": "button",
                    "label": "编辑",
                    "variant": "outlined",
                    "action": {
                      "call": "@global.editCurrent",
                      "args": {}
                    },
                    "icon": "edit",
                    "style": {
                      "borderColor": "#6366F1",
                      "textColor": "#6366F1",
                      "borderRadius": 14,
                      "fontSize": 15,
                      "paddingV": 12
                    }
                  },
                  {
                    "type": "spacer",
                    "width": 12
                  },
                  {
                    "type": "button",
                    "label": "删除",
                    "variant": "outlined",
                    "action": {
                      "call": "@global.deleteCurrent",
                      "args": {}
                    },
                    "icon": "delete",
                    "style": {
                      "borderColor": "#EF4444",
                      "textColor": "#EF4444",
                      "borderRadius": 14,
                      "fontSize": 15,
                      "paddingV": 12
                    }
                  }
                ]
              }
            ]
          }
        ],
        "backgroundColor": "#F5F5F7",
        "appBar": {
          "title": "文本详情",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.editCurrent",
                "args": {}
              },
              "icon": "edit",
              "style": {
                "textColor": "#6366F1",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              },
              "tooltip": "编辑"
            },
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.deleteCurrent",
                "args": {}
              },
              "icon": "delete",
              "style": {
                "textColor": "#EF4444",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              },
              "tooltip": "删除"
            }
          ]
        }
      }
    ]
  }
}
