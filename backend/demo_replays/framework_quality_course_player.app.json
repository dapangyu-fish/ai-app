                            "type": "container",
                            "layout": "row",
                            "crossAxisAlignment": "center",
                            "padding": 14,
                            "color": "#F9FAFB",
                            "borderRadius": 16,
                            "onTap": {
                              "call": "@global.selectLesson",
                              "args": {
                                "idx": "{{ loop.index }}"
                              }
                            },
                            "children": [
                              {
                                "type": "icon",
                                "name": "{{ loop.item.iconName }}",
                                "size": 22,
                                "color": "{{ loop.item.iconColor }}"
                              },
                              {
                                "type": "spacer",
                                "width": 12
                              },
                              {
                                "type": "expanded",
                                "flex": 1,
                                "child": {
                                  "type": "container",
                                  "layout": "column",
