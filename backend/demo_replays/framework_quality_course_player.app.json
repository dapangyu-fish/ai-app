    "functions": {
      "selectLesson": {
        "params": [
          "idx"
        ],
        "logic": [
          {
            "set": [
              "global.currentIndex",
              {
                "var": "params.idx"
              }
            ]
          },
          {
            "set": [
              "global.currentTitle",
              {
                "var": [
                  "global.lessons",
                  {
                    "var": "params.idx"
                  },
                  "title"
                ]
              }
            ]
          },
          {
            "set": [
              "global.currentDuration",
              {
                "var": [
                  "global.lessons",
                  {
                    "var": "params.idx"
                  },
                  "duration"
                ]
              }
            ]
          },
          {
            "set": [
              "global.currentProgress",
              {
                "var": [
                  "global.lessons",
                  {
                    "var": "params.idx"
                  },
                  "progress"
                ]
              }
            ]
          },
          {
            "set": [
              "global.currentStateLabel",
              {
                "var": [
                  "global.lessons",
                  {
                    "var": "params.idx"
                  },
                  "stateLabel"
                ]
              }
            ]
          }
        ]
      },
      "markComplete": {
        "params": [],
        "logic": [
          {
            "set": [
              "global.currentProgress",
              1.0
            ]
          },
          {
            "set": [
              "global.currentStateLabel",
              "已完成"
            ]
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "{{ t('toast.markComplete') }}"
            }
          }
        ]
      }
    }
  },
