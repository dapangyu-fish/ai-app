{
  "dsl": "3.3",
  "meta": {
    "name": "flappy-bird",
    "version": "1.0.0",
    "type": "app",
    "description": "点击屏幕让小鸟飞行，躲避水管，挑战高分！",
    "author": "ai",
    "displayName": "点击飞行"
  },
  "dependencies": {
    "common-ui": "^1.3.0"
  },
  "global": {
    "variables": {
      "currentScore": 0,
      "bestScore": 0,
      "_choice": null
    },
    "functions": {
      "handleScoreChanged": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentScore",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "handleGameOver": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentScore",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          },
          {
            "call": "@common-ui.choose",
            "args": {
              "title": "游戏结束",
              "message": "得分：{{ params.score }}\n最佳：{{ global.bestScore }}",
              "buttons": [
                {
                  "label": "关闭",
                  "value": null,
                  "style": "text"
                },
                {
                  "label": "再来一局",
                  "value": "restart"
                }
              ]
            },
            "assign": "global._choice"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "var": "global._choice"
                  },
                  "restart"
                ]
              },
              "then": [
                {
                  "call": "@flame_game_reset",
                  "args": {}
                }
              ]
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "点击飞行",
        "appBar": {
          "title": "点击飞行",
          "centerTitle": true,
          "backgroundColor": "#5C9FB8",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {
                "call": "@flame_game_reset",
                "args": {}
              }
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 10,
            "color": "#5C9FB8",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "得分：{{ global.currentScore }}",
                "style": {
                  "fontSize": 16,
                  "color": "#FFFFFF",
                  "fontWeight": "bold"
                },
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "最佳：{{ global.bestScore }}",
                "style": {
                  "fontSize": 14,
                  "color": "#FFF8DC"
                }
              }
            ]
          },
          {
            "type": "expanded",
            "flex": 1,
            "child": {
              "type": "flame_game",
              "world": {
                "kind": "pixel",
                "bg": "#70C5CE"
              },
              "overlay": {
                "game_over": false
              },
              "vars": {
                "gravity": 1200,
                "jump_v": -380,
                "pipe_speed": -150,
                "gap_h": 155,
                "pipe_w": 56,
                "spawn_interval": 1.7,
                "spawn_timer": 99,
                "_gap_y": 200,
                "_pid": 0
              },
              "entities": {
                "bird": {
                  "kind": "pixel",
                  "position": [
                    100,
                    300
                  ],
                  "size": [
                    44,
                    44
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "priority": 0,
                  "render": {
                    "shape": "circle",
                    "color": "#FFCC02",
                    "text": "●",
                    "text_color": "#1A1A1A",
                    "font_size": 13
                  }
                }
              },
              "init": {
                "logic": [
                  {
                    "call": "@spawn",
                    "args": {
                      "kind": "pixel",
                      "id": "ground",
                      "position": [
                        0,
                        {
                          "-": [
                            {
                              "var": "world.height"
                            },
                            56
                          ]
                        }
                      ],
                      "size": [
                        {
                          "var": "world.width"
                        },
                        56
                      ],
                      "velocity": [
                        0,
                        0
                      ],
                      "render": {
                        "shape": "rect",
                        "color": "#DEB887"
                      }
                    }
                  }
                ]
              },
              "input": {
                "tap": [
                  {
                    "call": "@pixel.set_velocity",
                    "args": {
                      "id": "bird",
                      "v": [
                        0,
                        {
                          "var": "vars.jump_v"
                        }
                      ]
                    }
                  }
                ]
              },
              "frame": {
                "logic": [
                  {
                    "call": "@pixel.add_velocity",
                    "args": {
                      "id": "bird",
                      "dv": [
                        0,
                        {
                          "*": [
                            {
                              "var": "vars.gravity"
                            },
                            {
                              "var": "event.dt"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "<": [
                          {
                            "var": "entities.bird.y"
                          },
                          -60
                        ]
                      },
                      "then": [
                        {
                          "call": "@game_over"
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "call": "@collide.rect",
                        "args": {
                          "a": "bird",
                          "b": "ground"
                        }
                      },
                      "then": [
                        {
                          "call": "@game_over"
                        }
                      ]
                    }
                  },
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars.spawn_timer",
                      "value": {
                        "+": [
                          {
                            "var": "vars.spawn_timer"
                          },
                          {
                            "var": "event.dt"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        ">=": [
                          {
                            "var": "vars.spawn_timer"
                          },
                          {
                            "var": "vars.spawn_interval"
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.spawn_timer",
                            "value": 0
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars._gap_y",
                            "value": {
                              "call": "@random_int",
                              "args": {
                                "min": 90,
                                "max": 370
                              }
                            }
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars._pid",
                            "value": {
                              "call": "@random_int",
                              "args": {
                                "min": 1000,
                                "max": 999999
                              }
                            }
                          }
                        },
                        {
                          "call": "@spawn",
                          "args": {
                            "kind": "pixel",
                            "id": "pipe_top_{{ vars._pid }}",
                            "position": [
                              {
                                "var": "world.width"
                              },
                              0
                            ],
                            "size": [
                              {
                                "var": "vars.pipe_w"
                              },
                              {
                                "var": "vars._gap_y"
                              }
                            ],
                            "velocity": [
                              {
                                "var": "vars.pipe_speed"
                              },
                              0
                            ],
                            "render": {
                              "shape": "rect",
                              "color": "#3AAA35",
                              "radius": 5
                            }
                          }
                        },
                        {
                          "call": "@spawn",
                          "args": {
                            "kind": "pixel",
                            "id": "pipe_bot_{{ vars._pid }}",
                            "position": [
                              {
                                "var": "world.width"
                              },
                              {
                                "+": [
                                  {
                                    "var": "vars._gap_y"
                                  },
                                  {
                                    "var": "vars.gap_h"
                                  }
                                ]
                              }
                            ],
                            "size": [
                              {
                                "var": "vars.pipe_w"
                              },
                              {
                                "var": "world.height"
                              }
                            ],
                            "velocity": [
                              {
                                "var": "vars.pipe_speed"
                              },
                              0
                            ],
                            "render": {
                              "shape": "rect",
                              "color": "#3AAA35",
                              "radius": 5
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@for_each_entity",
                    "args": {
                      "where_prefix": "pipe_top_",
                      "do": [
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "and": [
                                {
                                  "<": [
                                    {
                                      "var": "entities.bird.x"
                                    },
                                    {
                                      "+": [
                                        {
                                          "var": "loop.entity.x"
                                        },
                                        {
                                          "var": "vars.pipe_w"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  ">": [
                                    {
                                      "+": [
                                        {
                                          "var": "entities.bird.x"
                                        },
                                        44
                                      ]
                                    },
                                    {
                                      "var": "loop.entity.x"
                                    }
                                  ]
                                },
                                {
                                  "<": [
                                    {
                                      "var": "entities.bird.y"
                                    },
                                    {
                                      "+": [
                                        {
                                          "var": "loop.entity.y"
                                        },
                                        {
                                          "var": "loop.entity.h"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  ">": [
                                    {
                                      "+": [
                                        {
                                          "var": "entities.bird.y"
                                        },
                                        44
                                      ]
                                    },
                                    {
                                      "var": "loop.entity.y"
                                    }
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@game_over"
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "and": [
                                {
                                  "<=": [
                                    {
                                      "+": [
                                        {
                                          "var": "loop.entity.x"
                                        },
                                        {
                                          "var": "vars.pipe_w"
                                        }
                                      ]
                                    },
                                    {
                                      "var": "entities.bird.x"
                                    }
                                  ]
                                },
                                {
                                  ">": [
                                    {
                                      "+": [
                                        {
                                          "var": "loop.entity.x"
                                        },
                                        {
                                          "var": "vars.pipe_w"
                                        },
                                        {
                                          "-": [
                                            0,
                                            {
                                              "*": [
                                                {
                                                  "var": "vars.pipe_speed"
                                                },
                                                {
                                                  "var": "event.dt"
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "var": "entities.bird.x"
                                    }
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 1
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "+": [
                                    {
                                      "var": "loop.entity.x"
                                    },
                                    {
                                      "var": "vars.pipe_w"
                                    }
                                  ]
                                },
                                0
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ loop.id }}"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@for_each_entity",
                    "args": {
                      "where_prefix": "pipe_bot_",
                      "do": [
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "and": [
                                {
                                  "<": [
                                    {
                                      "var": "entities.bird.x"
                                    },
                                    {
                                      "+": [
                                        {
                                          "var": "loop.entity.x"
                                        },
                                        {
                                          "var": "vars.pipe_w"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  ">": [
                                    {
                                      "+": [
                                        {
                                          "var": "entities.bird.x"
                                        },
                                        44
                                      ]
                                    },
                                    {
                                      "var": "loop.entity.x"
                                    }
                                  ]
                                },
                                {
                                  "<": [
                                    {
                                      "var": "entities.bird.y"
                                    },
                                    {
                                      "+": [
                                        {
                                          "var": "loop.entity.y"
                                        },
                                        {
                                          "var": "loop.entity.h"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  ">": [
                                    {
                                      "+": [
                                        {
                                          "var": "entities.bird.y"
                                        },
                                        44
                                      ]
                                    },
                                    {
                                      "var": "loop.entity.y"
                                    }
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@game_over"
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "+": [
                                    {
                                      "var": "loop.entity.x"
                                    },
                                    {
                                      "var": "vars.pipe_w"
                                    }
                                  ]
                                },
                                0
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ loop.id }}"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.handleScoreChanged",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.handleGameOver",
                "args": {
                  "score": "{{ event.score }}"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "appid": "d8079aa4-1671-4d76-b8df-39167fb8c249"
}
