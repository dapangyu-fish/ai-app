{
  "dsl": "3.3",
  "meta": {
    "name": "snake",
    "version": "1.0.0",
    "type": "app",
    "description": "贪吃蛇小游戏 — 吃食物变长，撞墙结束",
    "author": "ai",
    "displayName": {
      "default": "贪吃蛇",
      "zh": "贪吃蛇",
      "en": "Snake",
      "de": "Snake",
      "es": "Snake",
      "fr": "Snake",
      "pt": "Snake",
      "ca": "Snake",
      "hi": "स्नेक",
      "ko": "스네이크",
      "ja": "スネーク",
      "it": "Snake"
    }
  },
  "dependencies": {
    "lib_database": "^1.0.0",
    "common-ui": "^1.3.0"
  },
  "global": {
    "i18n": {
      "zh": {
        "app": { "title": "贪吃蛇" },
        "score": {
          "current": "得分：{{ global.currentScore }}",
          "best": "最佳：{{ global.bestScore }}"
        },
        "gameOver": {
          "title": "本局结束",
          "message": "得分：{{ params.score }}\n最佳：{{ global.bestScore }}",
          "close": "关闭",
          "restart": "再来一局"
        },
        "history": {
          "title": "历史记录",
          "subtitle": "共 {{ global.historyCount }} 局",
          "empty": "尚无历史记录 — 玩一局试试",
          "scoreUnit": "{{ loop.item.score }} 分"
        }
      },
      "en": {
        "app": { "title": "Snake" },
        "score": {
          "current": "Score: {{ global.currentScore }}",
          "best": "Best: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "Game Over",
          "message": "Score: {{ params.score }}\nBest: {{ global.bestScore }}",
          "close": "Close",
          "restart": "Play Again"
        },
        "history": {
          "title": "History",
          "subtitle": "{{ global.historyCount }} games total",
          "empty": "No history yet — play a round to start",
          "scoreUnit": "{{ loop.item.score }} pts"
        }
      },
      "de": {
        "app": { "title": "Snake" },
        "score": {
          "current": "Punkte: {{ global.currentScore }}",
          "best": "Bestwert: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "Spiel vorbei",
          "message": "Punkte: {{ params.score }}\nBestwert: {{ global.bestScore }}",
          "close": "Schließen",
          "restart": "Nochmal spielen"
        },
        "history": {
          "title": "Verlauf",
          "subtitle": "Insgesamt {{ global.historyCount }} Spiele",
          "empty": "Noch kein Verlauf — spiele eine Runde",
          "scoreUnit": "{{ loop.item.score }} Pkt."
        }
      },
      "es": {
        "app": { "title": "Snake" },
        "score": {
          "current": "Puntos: {{ global.currentScore }}",
          "best": "Mejor: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "Fin de la partida",
          "message": "Puntos: {{ params.score }}\nMejor: {{ global.bestScore }}",
          "close": "Cerrar",
          "restart": "Jugar de nuevo"
        },
        "history": {
          "title": "Historial",
          "subtitle": "{{ global.historyCount }} partidas en total",
          "empty": "Aún no hay historial — juega una partida",
          "scoreUnit": "{{ loop.item.score }} pts"
        }
      },
      "fr": {
        "app": { "title": "Snake" },
        "score": {
          "current": "Score : {{ global.currentScore }}",
          "best": "Meilleur : {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "Partie terminée",
          "message": "Score : {{ params.score }}\nMeilleur : {{ global.bestScore }}",
          "close": "Fermer",
          "restart": "Rejouer"
        },
        "history": {
          "title": "Historique",
          "subtitle": "{{ global.historyCount }} parties au total",
          "empty": "Aucun historique — jouez une partie",
          "scoreUnit": "{{ loop.item.score }} pts"
        }
      },
      "pt": {
        "app": { "title": "Snake" },
        "score": {
          "current": "Pontos: {{ global.currentScore }}",
          "best": "Melhor: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "Fim de jogo",
          "message": "Pontos: {{ params.score }}\nMelhor: {{ global.bestScore }}",
          "close": "Fechar",
          "restart": "Jogar de novo"
        },
        "history": {
          "title": "Histórico",
          "subtitle": "{{ global.historyCount }} jogos no total",
          "empty": "Ainda sem histórico — jogue uma partida",
          "scoreUnit": "{{ loop.item.score }} pts"
        }
      },
      "ca": {
        "app": { "title": "Snake" },
        "score": {
          "current": "Punts: {{ global.currentScore }}",
          "best": "Millor: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "Fi de la partida",
          "message": "Punts: {{ params.score }}\nMillor: {{ global.bestScore }}",
          "close": "Tanca",
          "restart": "Torna a jugar"
        },
        "history": {
          "title": "Historial",
          "subtitle": "{{ global.historyCount }} partides en total",
          "empty": "Encara no hi ha historial — juga una partida",
          "scoreUnit": "{{ loop.item.score }} pts"
        }
      },
      "hi": {
        "app": { "title": "स्नेक" },
        "score": {
          "current": "स्कोर: {{ global.currentScore }}",
          "best": "सर्वश्रेष्ठ: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "खेल समाप्त",
          "message": "स्कोर: {{ params.score }}\nसर्वश्रेष्ठ: {{ global.bestScore }}",
          "close": "बंद करें",
          "restart": "फिर से खेलें"
        },
        "history": {
          "title": "इतिहास",
          "subtitle": "कुल {{ global.historyCount }} खेल",
          "empty": "अभी तक कोई इतिहास नहीं — एक बार खेलें",
          "scoreUnit": "{{ loop.item.score }} अंक"
        }
      },
      "ko": {
        "app": { "title": "스네이크" },
        "score": {
          "current": "점수: {{ global.currentScore }}",
          "best": "최고: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "게임 종료",
          "message": "점수: {{ params.score }}\n최고: {{ global.bestScore }}",
          "close": "닫기",
          "restart": "다시 하기"
        },
        "history": {
          "title": "기록",
          "subtitle": "총 {{ global.historyCount }}판",
          "empty": "아직 기록이 없습니다 — 한 판 해보세요",
          "scoreUnit": "{{ loop.item.score }}점"
        }
      },
      "ja": {
        "app": { "title": "スネーク" },
        "score": {
          "current": "スコア: {{ global.currentScore }}",
          "best": "ベスト: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "ゲームオーバー",
          "message": "スコア: {{ params.score }}\nベスト: {{ global.bestScore }}",
          "close": "閉じる",
          "restart": "もう一度"
        },
        "history": {
          "title": "履歴",
          "subtitle": "全 {{ global.historyCount }} 回",
          "empty": "まだ履歴がありません — 一度プレイしてみましょう",
          "scoreUnit": "{{ loop.item.score }} 点"
        }
      },
      "it": {
        "app": { "title": "Snake" },
        "score": {
          "current": "Punti: {{ global.currentScore }}",
          "best": "Migliore: {{ global.bestScore }}"
        },
        "gameOver": {
          "title": "Partita finita",
          "message": "Punti: {{ params.score }}\nMigliore: {{ global.bestScore }}",
          "close": "Chiudi",
          "restart": "Gioca di nuovo"
        },
        "history": {
          "title": "Cronologia",
          "subtitle": "{{ global.historyCount }} partite in totale",
          "empty": "Ancora nessuna cronologia — gioca una partita",
          "scoreUnit": "{{ loop.item.score }} pti"
        }
      }
    },
    "variables": {
      "currentScore": 0,
      "bestScore": 0,
      "history": [],
      "historyCount": 0,
      "_b": null,
      "_ts": 0,
      "_date": "",
      "_id": "",
      "_choice": null
    },
    "functions": {
      "initDB": {
        "logic": [
          {
            "call": "@lib_database.createTable",
            "args": {
              "table": "scores",
              "columns": [
                {
                  "name": "id",
                  "type": "TEXT",
                  "primary": "true"
                },
                {
                  "name": "score",
                  "type": "INTEGER"
                },
                {
                  "name": "ts",
                  "type": "INTEGER"
                },
                {
                  "name": "date",
                  "type": "TEXT"
                }
              ]
            }
          }
        ]
      },
      "loadBest": {
        "logic": [
          {
            "call": "@lib_database.kvGet",
            "args": {
              "key": "best_score"
            },
            "assign": "global._b"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "!=": [
                  {
                    "var": "global._b"
                  },
                  null
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ global._b }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "loadHistory": {
        "logic": [
          {
            "call": "@lib_database.query",
            "args": {
              "table": "scores",
              "orderBy": "ts DESC",
              "limit": 20
            },
            "assign": "global.history"
          },
          {
            "call": "@lib_database.count",
            "args": {
              "table": "scores"
            },
            "assign": "global.historyCount"
          }
        ]
      },
      "handleScoreChanged": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentScore",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "handleGameOver": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentScore",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          },
          {
            "call": "@lib_database.kvSet",
            "args": {
              "key": "best_score",
              "value": "{{ global.bestScore }}"
            }
          },
          {
            "call": "@timestamp",
            "args": {},
            "assign": "global._ts"
          },
          {
            "call": "@date_format",
            "args": {
              "timestamp": "{{ global._ts }}",
              "format": "MM-DD HH:mm"
            },
            "assign": "global._date"
          },
          {
            "call": "@uuid",
            "args": {},
            "assign": "global._id"
          },
          {
            "call": "@lib_database.insert",
            "args": {
              "table": "scores",
              "data": {
                "id": "{{ global._id }}",
                "score": "{{ params.score }}",
                "ts": "{{ global._ts }}",
                "date": "{{ global._date }}"
              }
            }
          },
          {
            "call": "@global.loadHistory",
            "args": {}
          },
          {
            "call": "@common-ui.choose",
            "args": {
              "title": "{{ t('gameOver.title') }}",
              "message": "{{ t('gameOver.message') }}",
              "buttons": [
                {
                  "label": "{{ t('gameOver.close') }}",
                  "value": null,
                  "style": "text"
                },
                {
                  "label": "{{ t('gameOver.restart') }}",
                  "value": "restart"
                }
              ]
            },
            "assign": "global._choice"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "var": "global._choice"
                  },
                  "restart"
                ]
              },
              "then": [
                {
                  "call": "@flame_game_reset",
                  "args": {}
                }
              ]
            }
          }
        ]
      },
      "showHistory": {
        "logic": [
          {
            "call": "@global.loadHistory",
            "args": {}
          },
          {
            "call": "@common-ui.showSheet",
            "args": {
              "title": "{{ t('history.title') }}",
              "subtitle": "{{ t('history.subtitle') }}",
              "content": {
                "type": "list",
                "source": "{{ global.history }}",
                "emptyText": "{{ t('history.empty') }}",
                "shrinkWrap": true,
                "item_template": {
                  "type": "container",
                  "padding": 12,
                  "layout": "row",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.date }}",
                      "style": {
                        "fontSize": 13,
                        "color": "#666666"
                      },
                      "position": {
                        "type": "flex",
                        "flex": 1
                      }
                    },
                    {
                      "type": "text",
                      "value": "{{ t('history.scoreUnit') }}",
                      "style": {
                        "fontSize": 15,
                        "fontWeight": "bold",
                        "color": "#00C800"
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@global.initDB",
      "args": {}
    },
    {
      "call": "@global.loadBest",
      "args": {}
    },
    {
      "call": "@global.loadHistory",
      "args": {}
    }
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "{{ t('app.title') }}",
        "appBar": {
          "title": "{{ t('app.title') }}",
          "centerTitle": true,
          "backgroundColor": "#1A1A2E",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {
                "call": "@flame_game_reset",
                "args": {}
              }
            },
            {
              "icon": "history",
              "action": {
                "call": "@global.showHistory",
                "args": {}
              }
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "text",
                "value": "{{ t('score.current') }}",
                "style": {
                  "fontSize": 14,
                  "color": "#FFFFFF",
                  "fontWeight": "bold"
                },
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "{{ t('score.best') }}",
                "style": {
                  "fontSize": 13,
                  "color": "#AAAAAA"
                }
              }
            ],
            "padding": 12,
            "color": "#1A1A2E",
            "crossAxisAlignment": "center"
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {
                "kind": "grid",
                "cols": 20,
                "rows": 30,
                "bg": "#1A1A2E"
              },
              "overlay": {
                "game_over": false
              },
              "vars": {
                "direction": "up",
                "next_direction": "up",
                "tick_interval": 0.16
              },
              "entities": {
                "snake": {
                  "kind": "cell_path",
                  "init": [
                    [
                      10,
                      14
                    ],
                    [
                      10,
                      15
                    ],
                    [
                      10,
                      16
                    ]
                  ],
                  "render": {
                    "shape": "rect",
                    "color": "#00C800",
                    "padding": 2,
                    "radius": 4,
                    "gradient": true
                  }
                },
                "food": {
                  "kind": "cell",
                  "init": [
                    5,
                    5
                  ],
                  "render": {
                    "shape": "circle",
                    "color": "#FF4444",
                    "padding": 4
                  }
                }
              },
              "input": {
                "swipe": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!": [
                          {
                            "in": [
                              {
                                "cat": [
                                  {
                                    "var": "vars.direction"
                                  },
                                  {
                                    "var": "event.direction"
                                  }
                                ]
                              },
                              [
                                "updown",
                                "downup",
                                "leftright",
                                "rightleft"
                              ]
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.next_direction",
                            "value": "{{ event.direction }}"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "tick": {
                "interval": "{{ vars.tick_interval }}",
                "logic": [
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars.direction",
                      "value": "{{ vars.next_direction }}"
                    }
                  },
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars._nx",
                      "value": {
                        "+": [
                          {
                            "var": "entities.snake.head.0"
                          },
                          {
                            "if": [
                              {
                                "==": [
                                  {
                                    "var": "vars.direction"
                                  },
                                  "right"
                                ]
                              },
                              1,
                              {
                                "if": [
                                  {
                                    "==": [
                                      {
                                        "var": "vars.direction"
                                      },
                                      "left"
                                    ]
                                  },
                                  -1,
                                  0
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars._ny",
                      "value": {
                        "+": [
                          {
                            "var": "entities.snake.head.1"
                          },
                          {
                            "if": [
                              {
                                "==": [
                                  {
                                    "var": "vars.direction"
                                  },
                                  "down"
                                ]
                              },
                              1,
                              {
                                "if": [
                                  {
                                    "==": [
                                      {
                                        "var": "vars.direction"
                                      },
                                      "up"
                                    ]
                                  },
                                  -1,
                                  0
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "or": [
                          {
                            "<": [
                              {
                                "var": "vars._nx"
                              },
                              0
                            ]
                          },
                          {
                            ">=": [
                              {
                                "var": "vars._nx"
                              },
                              {
                                "var": "world.cols"
                              }
                            ]
                          },
                          {
                            "<": [
                              {
                                "var": "vars._ny"
                              },
                              0
                            ]
                          },
                          {
                            ">=": [
                              {
                                "var": "vars._ny"
                              },
                              {
                                "var": "world.rows"
                              }
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@game_over"
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "and": [
                          {
                            ">=": [
                              {
                                "var": "vars._nx"
                              },
                              0
                            ]
                          },
                          {
                            "<": [
                              {
                                "var": "vars._nx"
                              },
                              {
                                "var": "world.cols"
                              }
                            ]
                          },
                          {
                            ">=": [
                              {
                                "var": "vars._ny"
                              },
                              0
                            ]
                          },
                          {
                            "<": [
                              {
                                "var": "vars._ny"
                              },
                              {
                                "var": "world.rows"
                              }
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@cell_path.advance",
                          "args": {
                            "path": "snake",
                            "direction": "{{ vars.direction }}"
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "call": "@cell_path.head_collides_self",
                              "args": {
                                "path": "snake"
                              }
                            },
                            "then": [
                              {
                                "call": "@game_over"
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "call": "@cells_equal",
                              "args": {
                                "a": {
                                  "var": "entities.snake.head"
                                },
                                "b": {
                                  "var": "entities.food.cell"
                                }
                              }
                            },
                            "then": [
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 1
                                }
                              },
                              {
                                "call": "@cell_path.grow",
                                "args": {
                                  "path": "snake"
                                }
                              },
                              {
                                "call": "@grid.random_empty",
                                "args": {
                                  "exclude": [
                                    "snake"
                                  ],
                                  "assign": "food"
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.tick_interval",
                                  "value": {
                                    "max": [
                                      0.04,
                                      {
                                        "-": [
                                          0.16,
                                          {
                                            "*": [
                                              {
                                                "var": "score"
                                              },
                                              0.003
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
