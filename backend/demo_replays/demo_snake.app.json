{
  "dsl": "3.3",
  "meta": {
    "name": "snake",
    "version": "1.0.0",
    "type": "app",
    "description": "贪吃蛇小游戏 — 吃食物变长，撞墙结束",
    "author": "ai"
  },
  "dependencies": {
    "lib_database": "^1.0.0",
    "common-ui": "^1.3.0"
  },
  "global": {
    "variables": {
      "currentScore": 0,
      "bestScore": 0,
      "history": [],
      "historyCount": 0,
      "_b": null,
      "_ts": 0,
      "_date": "",
      "_id": "",
      "_choice": null
    },
    "functions": {
      "initDB": {
        "logic": [
          {
            "call": "@lib_database.createTable",
            "args": {
              "table": "scores",
              "columns": [
                {
                  "name": "id",
                  "type": "TEXT",
                  "primary": "true"
                },
                {
                  "name": "score",
                  "type": "INTEGER"
                },
                {
                  "name": "ts",
                  "type": "INTEGER"
                },
                {
                  "name": "date",
                  "type": "TEXT"
                }
              ]
            }
          }
        ]
      },
      "loadBest": {
        "logic": [
          {
            "call": "@lib_database.kvGet",
            "args": {
              "key": "best_score"
            },
            "assign": "global._b"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "!=": [
                  {
                    "var": "global._b"
                  },
                  null
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ global._b }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "loadHistory": {
        "logic": [
          {
            "call": "@lib_database.query",
            "args": {
              "table": "scores",
              "orderBy": "ts DESC",
              "limit": 20
            },
            "assign": "global.history"
          },
          {
            "call": "@lib_database.count",
            "args": {
              "table": "scores"
            },
            "assign": "global.historyCount"
          }
        ]
      },
      "handleScoreChanged": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentScore",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "handleGameOver": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentScore",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          },
          {
            "call": "@lib_database.kvSet",
            "args": {
              "key": "best_score",
              "value": "{{ global.bestScore }}"
            }
          },
          {
            "call": "@timestamp",
            "args": {},
            "assign": "global._ts"
          },
          {
            "call": "@date_format",
            "args": {
              "timestamp": "{{ global._ts }}",
              "format": "MM-DD HH:mm"
            },
            "assign": "global._date"
          },
          {
            "call": "@uuid",
            "args": {},
            "assign": "global._id"
          },
          {
            "call": "@lib_database.insert",
            "args": {
              "table": "scores",
              "data": {
                "id": "{{ global._id }}",
                "score": "{{ params.score }}",
                "ts": "{{ global._ts }}",
                "date": "{{ global._date }}"
              }
            }
          },
          {
            "call": "@global.loadHistory",
            "args": {}
          },
          {
            "call": "@common-ui.choose",
            "args": {
              "title": "本局结束",
              "message": "得分：{{ params.score }}\n最佳：{{ global.bestScore }}",
              "buttons": [
                {
                  "label": "关闭",
                  "value": null,
                  "style": "text"
                },
                {
                  "label": "再来一局",
                  "value": "restart"
                }
              ]
            },
            "assign": "global._choice"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "var": "global._choice"
                  },
                  "restart"
                ]
              },
              "then": [
                {
                  "call": "@flame_game_reset",
                  "args": {}
                }
              ]
            }
          }
        ]
      },
      "showHistory": {
        "logic": [
          {
            "call": "@global.loadHistory",
            "args": {}
          },
          {
            "call": "@common-ui.showSheet",
            "args": {
              "title": "历史记录",
              "subtitle": "共 {{ global.historyCount }} 局",
              "content": {
                "type": "list",
                "source": "{{ global.history }}",
                "emptyText": "尚无历史记录 — 玩一局试试",
                "shrinkWrap": true,
                "item_template": {
                  "type": "container",
                  "padding": 12,
                  "layout": "row",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.date }}",
                      "style": {
                        "fontSize": 13,
                        "color": "#666666"
                      },
                      "position": {
                        "type": "flex",
                        "flex": 1
                      }
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.score }} 分",
                      "style": {
                        "fontSize": 15,
                        "fontWeight": "bold",
                        "color": "#00C800"
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@global.initDB",
      "args": {}
    },
    {
      "call": "@global.loadBest",
      "args": {}
    },
    {
      "call": "@global.loadHistory",
      "args": {}
    }
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "贪吃蛇",
        "appBar": {
          "title": "贪吃蛇",
          "centerTitle": true,
          "backgroundColor": "#1A1A2E",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {
                "call": "@flame_game_reset",
                "args": {}
              }
            },
            {
              "icon": "history",
              "action": {
                "call": "@global.showHistory",
                "args": {}
              }
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "text",
                "value": "得分：{{ global.currentScore }}",
                "style": {
                  "fontSize": 14,
                  "color": "#FFFFFF",
                  "fontWeight": "bold"
                },
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "最佳：{{ global.bestScore }}",
                "style": {
                  "fontSize": 13,
                  "color": "#AAAAAA"
                }
              }
            ],
            "padding": 12,
            "color": "#1A1A2E",
            "crossAxisAlignment": "center"
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {
                "kind": "grid",
                "cols": 20,
                "rows": 30,
                "bg": "#1A1A2E"
              },
              "overlay": {
                "game_over": false
              },
              "vars": {
                "direction": "up",
                "next_direction": "up",
                "tick_interval": 0.16
              },
              "entities": {
                "snake": {
                  "kind": "cell_path",
                  "init": [
                    [
                      10,
                      14
                    ],
                    [
                      10,
                      15
                    ],
                    [
                      10,
                      16
                    ]
                  ],
                  "render": {
                    "shape": "rect",
                    "color": "#00C800",
                    "padding": 2,
                    "radius": 4,
                    "gradient": true
                  }
                },
                "food": {
                  "kind": "cell",
                  "init": [
                    5,
                    5
                  ],
                  "render": {
                    "shape": "circle",
                    "color": "#FF4444",
                    "padding": 4
                  }
                }
              },
              "input": {
                "swipe": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!": [
                          {
                            "in": [
                              {
                                "cat": [
                                  {
                                    "var": "vars.direction"
                                  },
                                  {
                                    "var": "event.direction"
                                  }
                                ]
                              },
                              [
                                "updown",
                                "downup",
                                "leftright",
                                "rightleft"
                              ]
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.next_direction",
                            "value": "{{ event.direction }}"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "tick": {
                "interval": "{{ vars.tick_interval }}",
                "logic": [
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars.direction",
                      "value": "{{ vars.next_direction }}"
                    }
                  },
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars._nx",
                      "value": {
                        "+": [
                          {
                            "var": "entities.snake.head.0"
                          },
                          {
                            "if": [
                              {
                                "==": [
                                  {
                                    "var": "vars.direction"
                                  },
                                  "right"
                                ]
                              },
                              1,
                              {
                                "if": [
                                  {
                                    "==": [
                                      {
                                        "var": "vars.direction"
                                      },
                                      "left"
                                    ]
                                  },
                                  -1,
                                  0
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars._ny",
                      "value": {
                        "+": [
                          {
                            "var": "entities.snake.head.1"
                          },
                          {
                            "if": [
                              {
                                "==": [
                                  {
                                    "var": "vars.direction"
                                  },
                                  "down"
                                ]
                              },
                              1,
                              {
                                "if": [
                                  {
                                    "==": [
                                      {
                                        "var": "vars.direction"
                                      },
                                      "up"
                                    ]
                                  },
                                  -1,
                                  0
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "or": [
                          {
                            "<": [
                              {
                                "var": "vars._nx"
                              },
                              0
                            ]
                          },
                          {
                            ">=": [
                              {
                                "var": "vars._nx"
                              },
                              {
                                "var": "world.cols"
                              }
                            ]
                          },
                          {
                            "<": [
                              {
                                "var": "vars._ny"
                              },
                              0
                            ]
                          },
                          {
                            ">=": [
                              {
                                "var": "vars._ny"
                              },
                              {
                                "var": "world.rows"
                              }
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@game_over"
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "and": [
                          {
                            ">=": [
                              {
                                "var": "vars._nx"
                              },
                              0
                            ]
                          },
                          {
                            "<": [
                              {
                                "var": "vars._nx"
                              },
                              {
                                "var": "world.cols"
                              }
                            ]
                          },
                          {
                            ">=": [
                              {
                                "var": "vars._ny"
                              },
                              0
                            ]
                          },
                          {
                            "<": [
                              {
                                "var": "vars._ny"
                              },
                              {
                                "var": "world.rows"
                              }
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@cell_path.advance",
                          "args": {
                            "path": "snake",
                            "direction": "{{ vars.direction }}"
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "call": "@cell_path.head_collides_self",
                              "args": {
                                "path": "snake"
                              }
                            },
                            "then": [
                              {
                                "call": "@game_over"
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "call": "@cells_equal",
                              "args": {
                                "a": {
                                  "var": "entities.snake.head"
                                },
                                "b": {
                                  "var": "entities.food.cell"
                                }
                              }
                            },
                            "then": [
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 1
                                }
                              },
                              {
                                "call": "@cell_path.grow",
                                "args": {
                                  "path": "snake"
                                }
                              },
                              {
                                "call": "@grid.random_empty",
                                "args": {
                                  "exclude": [
                                    "snake"
                                  ],
                                  "assign": "food"
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.tick_interval",
                                  "value": {
                                    "max": [
                                      0.04,
                                      {
                                        "-": [
                                          0.16,
                                          {
                                            "*": [
                                              {
                                                "var": "score"
                                              },
                                              0.003
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.handleGameOver",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.handleScoreChanged",
                "args": {
                  "score": "{{ event.score }}"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "appid": "a5313f9c-397f-495d-892c-d6f8619464cf"
}
