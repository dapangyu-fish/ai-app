        "backgroundColor": "#F4F6F8",
        "appBar": {
          "title": "客户",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.startCreate",
                "args": {}
              },
              "icon": "add",
              "style": {
                "textColor": "#2563EB",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        }
      },
      {
        "id": "customer_detail",
        "title": "客户详情",
        "layout": "column",
