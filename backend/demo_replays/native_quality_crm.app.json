                "type": "icon",
                "name": "search",
                "size": 18,
                "color": "#8E8E93"
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "input",
                "placeholder": "搜索姓名、公司、电话",
                "bind": "global.searchQuery",
                "position": {
                  "type": "flex",
                  "flex": 1
                },
                "style": {
                  "fontSize": 15,
                  "borderRadius": 10
                }
              }
            ],
            "padding": 10,
            "margin": 12,
            "color": "#F7F8FA",
            "borderRadius": 14,
            "crossAxisAlignment": "center"
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "wrap",
                "spacing": 8,
                "runSpacing": 8,
                "children": [
                  {
                    "type": "chip",
                    "label": "全部",
                    "variant": "choice",
                    "bind": "global.selectedStatus",
                    "value": "全部",
                    "color": "#2563EB"
                  },
                  {
                    "type": "chip",
                    "label": "待跟进",
                    "variant": "choice",
                    "bind": "global.selectedStatus",
                    "value": "待跟进",
                    "color": "#2563EB"
                  },
                  {
                    "type": "chip",
                    "label": "洽谈中",
                    "variant": "choice",
                    "bind": "global.selectedStatus",
                    "value": "洽谈中",
                    "color": "#2563EB"
                  },
                  {
                    "type": "chip",
                    "label": "已成交",
                    "variant": "choice",
                    "bind": "global.selectedStatus",
                    "value": "已成交",
                    "color": "#2563EB"
                  }
                ]
              }
            ],
            "padding": 12,
            "margin": 8,
            "color": "#FFFFFF",
            "borderRadius": 14
          },
          {
            "type": "list",
            "source": "{{ global.customers }}",
            "emptyText": "暂无客户，先新增第一位客户",
            "item_template": {
              "type": "card",
              "layout": "column",
              "color": "#FFFFFF",
              "padding": 14,
              "margin": 8,
              "elevation": 0,
              "borderRadius": 16,
              "children": [
                {
                  "type": "container",
                  "layout": "row",
                  "children": [
                    {
                      "type": "avatar",
                      "text": "{{ loop.item.initial }}",
                      "size": 46,
                      "color": "{{ loop.item.tint }}",
                      "textColor": "{{ loop.item.accent }}"
                    },
                    {
                      "type": "spacer",
                      "width": 12
                    },
                    {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "text",
                          "value": "{{ loop.item.name }}",
                          "style": {
                            "fontSize": 16,
                            "fontWeight": "bold",
                            "color": "#111827",
                            "maxLines": 1,
                            "overflow": "ellipsis"
                          }
                        },
                        {
                          "type": "spacer",
                          "height": 5
                        },
                        {
                          "type": "text",
                          "value": "{{ loop.item.status }} · {{ loop.item.company }} · {{ loop.item.phone }}",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280",
                            "maxLines": 1,
                            "overflow": "ellipsis"
                          }
                        },
                        {
                          "type": "spacer",
                          "height": 8
                        },
                        {
                          "type": "container",
                          "layout": "row",
                          "children": [
                            {
                              "type": "icon",
                              "name": "calendar",
                              "size": 15,
                              "color": "#9CA3AF"
                            },
                            {
                              "type": "spacer",
                              "width": 5
                            },
                            {
                              "type": "text",
                              "value": "{{ loop.item.nextStep }}",
                              "style": {
                                "fontSize": 13,
                                "color": "#4B5563"
                              }
                            }
                          ],
                          "crossAxisAlignment": "center"
                        }
                      ],
                      "position": {
                        "type": "flex",
                        "flex": 1
                      }
                    }
                  ],
                  "crossAxisAlignment": "start"
                }
              ],
              "onTap": {
                "call": "@global.viewCustomer",
                "args": {
                  "customerName": "{{ loop.item.name }}",
                  "company": "{{ loop.item.company }}",
                  "phone": "{{ loop.item.phone }}",
                  "status": "{{ loop.item.status }}",
                  "nextStep": "{{ loop.item.nextStep }}",
                  "note": "{{ loop.item.note }}",
                  "accent": "{{ loop.item.accent }}",
                  "tint": "{{ loop.item.tint }}"
                }
              }
            }
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "button",
                "label": "新增客户",
                "variant": "filled",
                "action": {
                  "call": "@global.startCreate",
                  "args": {}
                },
                "icon": "add",
                "style": {
                  "backgroundColor": "#2563EB",
                  "textColor": "#FFFFFF",
                  "borderRadius": 16,
                  "fontSize": 15,
                  "paddingV": 12
                }
              }
            ],
            "padding": 12,
            "color": "#F4F6F8"
