                  {
                    "type": "icon",
                    "name": "calendar",
                    "size": 18,
                    "color": "#D97706"
                  },
                  {
                    "type": "spacer",
                    "width": 8
                  },
                  {
                    "type": "text",
                    "value": "{{ global.currentNextStep }}",
