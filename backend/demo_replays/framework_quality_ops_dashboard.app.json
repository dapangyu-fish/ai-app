        {
          "id": "1",
          "severity": "critical",
          "title": "API 网关延迟超过阈值",
          "service": "API 网关",
          "time": "10分钟前",
          "acknowledged": false
        },
        {
          "id": "2",
          "severity": "warning",
          "title": "数据库连接池使用率 85%",
          "service": "数据库",
          "time": "25分钟前",
          "acknowledged": false
        },
        {
          "id": "3",
          "severity": "warning",
          "title": "Redis 内存使用接近上限",
          "service": "缓存服务",
          "time": "1小时前",
          "acknowledged": false
        },
        {
          "id": "4",
          "severity": "info",
          "title": "定时备份任务完成",
          "service": "存储服务",
          "time": "2小时前",
          "acknowledged": true
        },
        {
          "id": "5",
          "severity": "info",
          "title": "SSL 证书将于 30 天后过期",
          "service": "API 网关",
          "time": "3小时前",
          "acknowledged": false
        }
      ]
    },
    "functions": {
      "refresh": {
        "params": [],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "数据已刷新"
            }
          }
        ]
      },
      "ackAlert": {
        "params": [
          {
            "name": "alertId",
            "type": "string"
          }
        ],
        "logic": [
          {
            "set": "global.alerts",
            "value": {
              "map": [
                {
                  "var": "global.alerts"
                },
                {
                  "if": [
                    {
                      "==": [
                        {
                          "var": "item.id"
                        },
                        {
                          "var": "params.alertId"
                        }
                      ]
                    },
                    {
                      "merge": [
                        {
                          "var": "item"
                        },
                        {
                          "acknowledged": true
                        }
                      ]
                    },
                    {
                      "var": "item"
                    }
                  ]
                },
                "item"
              ]
            }
          }
        ]
      }
    }
  },
