          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 14,
            "margin": 0,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "text",
                    "value": "CPU 使用趋势",
                    "style": {
                      "fontSize": 15,
                      "fontWeight": "bold",
                      "color": "#111827"
                    }
                  },
                  {
                    "type": "spacer",
                    "flex": 1
                  },
                  {
                    "type": "dropdown",
                    "bind": "global.range",
                    "options": [
                      "最近1小时",
                      "最近6小时",
                      "最近24小时"
                    ],
                    "prefixIcon": "schedule",
                    "color": "#2563EB"
                  }
                ],
                "crossAxisAlignment": "center"
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "chart",
                "kind": "line",
                "data": "{{ global.cpuLineData }}",
                "height": 180,
                "color": "#2563EB"
              }
            ]
          },
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 12,
            "margin": 0,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "tab_view",
                "height": 310,
                "color": "#2563EB",
                "tabs": [
                  {
                    "label": "QPS 分布",
                    "icon": "analytics",
                    "content": {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "chart",
                          "kind": "bar",
                          "data": "{{ global.qpsBarData }}",
                          "height": 200,
                          "color": "#2563EB"
                        },
                        {
                          "type": "spacer",
                          "height": 6
                        },
                        {
                          "type": "text",
                          "value": "各服务近 5 分钟平均 QPS，API 网关承载主要流量。",
                          "style": {
                            "fontSize": 12,
                            "color": "#6B7280"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "label": "资源占比",
                    "icon": "share",
                    "content": {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "chart",
                          "kind": "pie",
                          "data": "{{ global.resourcePieData }}",
                          "height": 200
                        },
                        {
                          "type": "spacer",
                          "height": 6
                        },
                        {
                          "type": "text",
                          "value": "计算资源占用最高，建议关注存储扩容窗口。",
                          "style": {
                            "fontSize": 12,
                            "color": "#6B7280"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "text",
                    "value": "告警列表",
                    "style": {
                      "fontSize": 16,
                      "fontWeight": "bold",
                      "color": "#111827"
                    }
                  },
                  {
                    "type": "spacer",
                    "flex": 1
                  },
                  {
                    "type": "text",
                    "value": "5 条告警",
                    "style": {
                      "fontSize": 13,
                      "color": "#6B7280"
                    }
                  }
                ],
                "crossAxisAlignment": "center"
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "list",
                "shrinkWrap": true,
                "source": "{{ global.alerts }}",
                "itemKey": "id",
                "separator": {
                  "type": "spacer",
                  "height": 8
                },
                "emptyText": "暂无告警",
                "item_template": {
                  "data": {
                    "ackLabel": {
                      "if": [
                        {
                          "==": [
                            {
                              "var": "item.acknowledged"
                            },
                            true
                          ]
                        },
                        "已确认",
                        "确认"
                      ]
                    },
                    "ackVariant": {
                      "if": [
                        {
                          "==": [
                            {
                              "var": "item.acknowledged"
                            },
                            true
                          ]
                        },
                        "text",
                        "filled"
                      ]
                    },
                    "ackTextColor": {
                      "if": [
                        {
                          "==": [
                            {
                              "var": "item.acknowledged"
                            },
                            true
                          ]
                        },
                        "#9CA3AF",
                        "#FFFFFF"
                      ]
                    }
                  },
                  "type": "card",
                  "layout": "row",
                  "color": {
                    "if": [
                      {
                        "==": [
                          {
                            "var": "item.acknowledged"
                          },
                          true
                        ]
                      },
                      "#F9FAFB",
                      {
                        "switch": [
                          {
                            "var": "item.severity"
                          },
                          {
                            "critical": "#FEF2F2",
                            "warning": "#FFFBEB",
                            "info": "#EFF6FF"
                          },
                          "#FFFFFF"
                        ]
                      }
                    ]
                  },
                  "padding": 12,
                  "margin": 0,
                  "elevation": 0,
                  "borderRadius": 12,
                  "children": [
                    {
                      "type": "container",
                      "layout": "column",
                      "crossAxisAlignment": "center",
                      "mainAxisAlignment": "start",
                      "children": [
                        {
                          "type": "icon",
                          "name": {
                            "switch": [
                              {
                                "var": "item.severity"
                              },
                              {
                                "critical": "error",
                                "warning": "warning_amber",
                                "info": "info"
                              },
                              "info"
                            ]
                          },
                          "size": 22,
                          "color": {
                            "switch": [
                              {
                                "var": "item.severity"
                              },
                              {
                                "critical": "#DC2626",
                                "warning": "#D97706",
                                "info": "#2563EB"
                              },
                              "#6B7280"
                            ]
                          }
                        }
                      ],
                      "width": 40
                    },
                    {
                      "type": "spacer",
                      "width": 10
                    },
                    {
                      "type": "expanded",
                      "child": {
                        "type": "container",
                        "layout": "column",
                        "children": [
                          {
                            "type": "text",
                            "value": "{{ item.title }}",
                            "style": {
                              "fontSize": 14,
                              "fontWeight": "bold",
                              "color": "#111827",
                              "maxLines": 2
                            }
                          },
                          {
                            "type": "spacer",
                            "height": 4
                          },
                          {
                            "type": "text",
                            "value": "{{ item.service }} · {{ item.time }}",
                            "style": {
                              "fontSize": 12,
                              "color": "#6B7280"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "button",
                      "label": "{{ item.ackLabel }}",
                      "variant": "{{ item.ackVariant }}",
                      "action": {
                        "call": "@global.ackAlert",
                        "args": {
                          "alertId": "{{ item.id }}"
                        }
                      },
                      "style": {
                        "textColor": "{{ item.ackTextColor }}",
                        "fontSize": 12,
                        "paddingH": 10,
                        "paddingV": 6
                      }
                    }
                  ]
                }
              }
            ],
            "margin": 0
          }
        ],
        "backgroundColor": "#F6F7FB",
        "appBar": {
          "title": "运维数据仪表盘",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.refresh",
                "args": {}
              },
              "icon": "refresh",
              "style": {
                "textColor": "#2563EB",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        }
      }
    ]
  }
}
