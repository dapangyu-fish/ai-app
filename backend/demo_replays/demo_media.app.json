      "currentVideoTitle": "",
      "currentVideoUrl": "",
      "currentPhotoSeed": "",
      "currentPhotoTitle": "",
      "currentPhotoCategory": "",
      "currentPhotoUrl": ""
    },
    "functions": {
      "playVideo": {
        "params": [
          "id",
          "title",
          "url"
        ],
        "return": "None",
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentVideoId",
              "value": "{{ params.id }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentVideoTitle",
              "value": "{{ params.title }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentVideoUrl",
              "value": "{{ params.url }}"
            }
          },
          {
            "call": "@print",
            "args": {
              "value": "开始播放: {{ params.title }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "player"
            }
          }
        ]
      },
      "openPhoto": {
        "params": [
          "seed",
          "title",
          "category"
        ],
        "return": "None",
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentPhotoSeed",
              "value": "{{ params.seed }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentPhotoTitle",
              "value": "{{ params.title }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentPhotoCategory",
              "value": "{{ params.category }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentPhotoUrl",
              "value": "https://picsum.photos/seed/{{ params.seed }}/1600/1600"
            }
          },
          {
            "call": "@print",
            "args": {
              "value": "全屏查看: {{ params.title }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "viewer"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@print",
      "args": {
        "value": "媒体展厅启动"
      }
    }
  ],
