    "functions": {
      "playMedia": {
        "params": [
          "itemId"
        ],
        "return": "None",
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.selectedItemId",
              "value": "{{ params.itemId }}"
            }
          },
          {
            "if": [
              {
                "==": [
                  {
                    "var": "global.mediaMap.{{ params.itemId }}.type"
                  },
                  "image"
                ]
              },
              [
                {
                  "call": "@navigate",
                  "args": {
                    "screen": "image_viewer"
                  }
                }
              ],
              [
                {
                  "call": "@navigate",
                  "args": {
                    "screen": "video_player"
                  }
                }
              ]
            ]
          }
        ]
      },
      "filterMedia": {
        "params": [
          "category"
        ],
        "return": "None",
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.activeCategory",
              "value": "{{ params.category }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.filteredItems",
              "value": {
                "if": [
                  {
                    "==": [
                      {
                        "var": "params.category"
                      },
                      "All"
                    ]
                  },
                  {
                    "var": "global.allItems"
                  },
                  {
                    "filter": [
                      {
                        "var": "global.allItems"
                      },
                      {
                        "==": [
                          {
                            "var": "category"
                          },
                          {
                            "var": "params.category"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@print",
      "args": {
        "value": "Media Gallery started"
      }
    }
  ],
