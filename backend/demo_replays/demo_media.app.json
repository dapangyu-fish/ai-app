                      "fontSize": 13,
                      "fontWeight": "w600",
                      "color": "{{ global.activeCategory == 'Sci-Fi' ? '#FFFFFF' : '#666666' }}"
                    }
                  }
                ],
                "padding": 10,
                "borderRadius": 20,
                "color": "{{ global.activeCategory == 'Sci-Fi' ? '#6C5CE7' : '#1E1E2A' }}",
                "margin": 4,
                "onTap": {
                  "call": "@global.filterMedia",
                  "args": {
                    "category": "Sci-Fi"
                  }
                }
              }
            ]
          },
          {
            "type": "list",
            "source": "{{ global.filteredItems }}",
            "item_template": {
              "type": "card",
              "borderRadius": 16,
              "color": "#1A1A28",
              "margin": 8,
              "children": [
                {
                  "type": "container",
                  "layout": "row",
                  "padding": 0,
                  "children": [
                    {
                      "type": "image",
                      "url": "{{ loop.item.thumb }}",
                      "width": 120,
                      "height": 90,
                      "borderRadius": 12,
                      "fit": "cover"
                    },
                    {
                      "type": "container",
                      "layout": "column",
                      "padding": 12,
                      "position": {
                        "type": "flex",
                        "flex": 1
                      },
                      "children": [
                        {
                          "type": "text",
                          "value": "{{ loop.item.title }}",
                          "style": {
                            "fontSize": 16,
                            "fontWeight": "w600",
                            "color": "#EAEAEA"
                          }
                        },
                        {
                          "type": "container",
                          "height": 4
                        },
                        {
                          "type": "container",
                          "layout": "row",
                          "children": [
                            {
                              "type": "container",
                              "padding": 4,
                              "borderRadius": 4,
                              "color": "{{ loop.item.type == 'video' ? '#3D1A1A' : '#1A1A3D' }}",
                              "children": [
                                {
                                  "type": "text",
                                  "value": "{{ loop.item.type == 'video' ? 'Video' : 'Photo' }}",
                                  "style": {
                                    "fontSize": 11,
                                    "color": "{{ loop.item.type == 'video' ? '#FF6B6B' : '#6C5CE7' }}",
                                    "fontWeight": "w600"
                                  }
                                }
                              ]
                            },
                            {
                              "type": "container",
                              "width": 8
                            },
                            {
                              "type": "text",
                              "value": "{{ loop.item.category }}",
                              "style": {
                                "fontSize": 12,
                                "color": "#666666"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "icon",
                      "name": "{{ loop.item.type == 'video' ? 'play' : 'chevron_right' }}",
                      "size": 22,
                      "color": "{{ loop.item.type == 'video' ? '#FF6B6B' : '#444444' }}"
                    }
                  ]
                }
              ],
              "onTap": {
                "call": "@global.playMedia",
                "args": {
                  "itemId": "{{ loop.item.id }}"
                }
              }
            },
            "shrinkWrap": true,
            "padding": 16
          }
        ]
      },
      {
        "id": "image_viewer",
        "title": "{{ global.mediaMap[global.selectedItemId].title }}",
        "layout": "column",
        "backgroundColor": "#000000",
        "children": [
          {
            "type": "container",
            "layout": "row",
            "padding": 12,
            "children": [
              {
                "type": "button",
                "label": "Back",
                "icon": "back",
                "variant": "text",
                "style": {
                  "textColor": "#FFFFFF"
                },
                "action": {
                  "call": "@navigate",
                  "args": {
                    "screen": "gallery"
                  }
                }
              },
              {
                "type": "container",
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "{{ global.mediaMap[global.selectedItemId].title }}",
                "style": {
                  "fontSize": 16,
                  "fontWeight": "w600",
                  "color": "#FFFFFF"
                }
              },
              {
                "type": "container",
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "image",
              "url": "{{ global.mediaMap[global.selectedItemId].url }}",
              "fit": "contain"
            }
          },
          {
            "type": "container",
            "padding": 16,
            "layout": "column",
            "children": [
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "icon",
                    "name": "image",
                    "size": 14,
                    "color": "#6C5CE7"
                  },
                  {
                    "type": "container",
                    "width": 6
                  },
                  {
                    "type": "text",
                    "value": "Photo · {{ global.mediaMap[global.selectedItemId].category }}",
                    "style": {
                      "fontSize": 13,
                      "color": "#888888"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "video_player",
        "title": "{{ global.mediaMap[global.selectedItemId].title }}",
        "layout": "column",
        "backgroundColor": "#000000",
        "children": [
          {
            "type": "container",
            "layout": "row",
            "padding": 12,
            "children": [
              {
                "type": "button",
                "label": "Back",
                "icon": "back",
                "variant": "text",
                "style": {
                  "textColor": "#FFFFFF"
                },
                "action": {
                  "call": "@navigate",
                  "args": {
                    "screen": "gallery"
                  }
                }
              },
              {
                "type": "container",
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "{{ global.mediaMap[global.selectedItemId].title }}",
                "style": {
                  "fontSize": 16,
                  "fontWeight": "w600",
                  "color": "#FFFFFF"
                }
              },
              {
                "type": "container",
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              }
            ]
          },
          {
            "type": "video",
            "url": "{{ global.mediaMap[global.selectedItemId].url }}",
            "autoplay": true,
            "looping": false,
            "aspectRatio": 1.78,
            "borderRadius": 0
          },
          {
            "type": "container",
            "padding": 16,
            "layout": "column",
            "children": [
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "icon",
                    "name": "video",
                    "size": 14,
                    "color": "#FF6B6B"
                  },
                  {
                    "type": "container",
                    "width": 6
                  },
                  {
                    "type": "text",
                    "value": "Video · {{ global.mediaMap[global.selectedItemId].category }}",
                    "style": {
                      "fontSize": 13,
                      "color": "#888888"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}