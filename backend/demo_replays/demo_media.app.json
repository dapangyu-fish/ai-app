                "type": "text",
                "value": "Media Gallery",
                "style": {
                  "fontSize": 26,
                  "fontWeight": "bold",
                  "color": "#FFFFFF"
                }
              },
              {
                "type": "text",
                "value": "Browse stunning images and videos",
                "style": {
                  "fontSize": 14,
                  "color": "#888888"
                }
              }
            ]
          },
          {
            "type": "container",
            "layout": "row",
            "scrollable": true,
            "padding": 8,
            "children": [
              {
                "type": "container",
                "layout": "column",
                "children": [
                  {
                    "type": "text",
                    "value": "All",
                    "style": {
                      "fontSize": 13,
                      "fontWeight": "w600",
                      "color": "{{ global.activeCategory == 'All' ? '#FFFFFF' : '#666666' }}"
                    }
                  }
                ],
                "padding": 10,
                "borderRadius": 20,
                "color": "{{ global.activeCategory == 'All' ? '#6C5CE7' : '#1E1E2A' }}",
                "margin": 4,
                "onTap": {
                  "call": "@global.filterMedia",
