                    ]
                  },
                  ""
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.resetFlag",
              "value": true
            }
          }
        ]
      },
      "doNegate": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.display",
              "value": {
                "cat": [
                  {
                    "*": [
                      -1,
                      {
                        "*": [
                          1,
                          {
                            "var": "global.display"
                          }
                        ]
                      }
                    ]
                  },
                  ""
                ]
              }
            }
          }
        ]
      },
      "doDot": {
        "params": [],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "!": {
                  "in": [
                    ".",
                    {
                      "var": "global.display"
                    }
                  ]
                }
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.display",
                    "value": {
                      "cat": [
                        {
                          "var": "global.display"
                        },
                        "."
                      ]
                    }
                  }
                },
                {
                  "call": "@set",
                  "args": {
                    "var": "global.resetFlag",
                    "value": false
                  }
                }
              ],
              "else": []
            }
          }
        ]
      }
    }
  },
