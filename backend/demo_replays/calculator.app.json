      "doPercent": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.display",
              "value": {
                "cat": [
                  {
                    "/": [
                      {
                        "*": [
                          1,
                          {
                            "var": "global.display"
