{
  "dsl": "3.3",
  "meta": {
    "name": "calculator",
    "version": "1.0.0",
    "type": "app",
    "description": "支持加减乘除、百分比和清除的计算器",
    "author": "fish",
    "displayName": "计算器"
  },
  "dependencies": {},
  "global": {
    "variables": {
      "display": "0",
      "expression": "",
      "prev": 0,
      "op": "",
      "resetFlag": false
    },
    "functions": {
      "digit": {
        "params": [
          "d"
        ],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "var": "global.resetFlag"
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.display",
                    "value": {
                      "cat": [
                        {
                          "var": "params.d"
                        },
                        ""
                      ]
                    }
                  }
                },
                {
                  "call": "@set",
                  "args": {
                    "var": "global.resetFlag",
                    "value": false
                  }
                }
              ],
              "else": [
                {
                  "call": "@if",
                  "args": {
                    "condition": {
                      "==": [
                        {
                          "var": "global.display"
                        },
                        "0"
                      ]
                    },
                    "then": [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.display",
                          "value": {
                            "cat": [
                              {
                                "var": "params.d"
                              },
                              ""
                            ]
                          }
                        }
                      }
                    ],
                    "else": [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.display",
                          "value": {
                            "cat": [
                              {
                                "var": "global.display"
                              },
                              {
                                "var": "params.d"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "doAdd": {
        "params": [
          "_"
        ],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "!=": [
                  {
                    "var": "global.op"
                  },
                  ""
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.prev",
                    "value": {
                      "+": [
                        {
                          "var": "global.prev"
                        },
                        {
                          "*": [
                            1,
                            {
                              "var": "global.display"
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ],
              "else": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.prev",
                    "value": {
                      "*": [
                        1,
                        {
                          "var": "global.display"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.display",
              "value": {
                "cat": [
                  {
                    "var": "global.prev"
                  },
                  ""
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.op",
              "value": "+"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.expression",
              "value": {
                "cat": [
                  {
                    "var": "global.display"
                  },
                  " ",
                  "+"
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.resetFlag",
              "value": true
            }
          }
        ]
      },
      "doSubtract": {
        "params": [
          "_"
        ],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "!=": [
                  {
                    "var": "global.op"
                  },
                  ""
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.prev",
                    "value": {
                      "-": [
                        {
                          "var": "global.prev"
                        },
                        {
                          "var": "global.display"
                        }
                      ]
                    }
                  }
                }
              ],
              "else": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.prev",
                    "value": {
                      "*": [
                        1,
                        {
                          "var": "global.display"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.display",
              "value": {
                "cat": [
                  {
                    "var": "global.prev"
                  },
                  ""
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.op",
              "value": "-"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.expression",
              "value": {
                "cat": [
                  {
                    "var": "global.display"
                  },
                  " ",
                  "−"
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.resetFlag",
              "value": true
            }
          }
        ]
      },
      "doMultiply": {
        "params": [
          "_"
        ],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "!=": [
                  {
                    "var": "global.op"
                  },
                  ""
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.prev",
                    "value": {
                      "*": [
                        {
                          "var": "global.prev"
                        },
                        {
                          "var": "global.display"
                        }
                      ]
                    }
                  }
                }
              ],
              "else": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.prev",
                    "value": {
                      "*": [
                        1,
                        {
                          "var": "global.display"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.display",
              "value": {
                "cat": [
                  {
                    "var": "global.prev"
                  },
                  ""
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.op",
              "value": "*"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.expression",
              "value": {
                "cat": [
                  {
                    "var": "global.display"
                  },
                  " ",
                  "×"
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.resetFlag",
              "value": true
            }
          }
        ]
      },
      "doDivide": {
        "params": [
          "_"
        ],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "!=": [
                  {
                    "var": "global.op"
                  },
                  ""
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.prev",
                    "value": {
                      "/": [
                        {
                          "var": "global.prev"
                        },
                        {
                          "var": "global.display"
                        }
                      ]
                    }
                  }
                }
              ],
              "else": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.prev",
                    "value": {
                      "*": [
                        1,
                        {
                          "var": "global.display"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.display",
              "value": {
                "cat": [
                  {
                    "var": "global.prev"
                  },
                  ""
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.op",
              "value": "/"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.expression",
              "value": {
                "cat": [
                  {
                    "var": "global.display"
                  },
                  " ",
                  "÷"
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.resetFlag",
              "value": true
            }
          }
        ]
      },
      "doEquals": {
        "params": [],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "!=": [
                  {
                    "var": "global.op"
                  },
                  ""
                ]
              },
              "then": [
                {
                  "call": "@if",
                  "args": {
                    "condition": {
                      "==": [
                        {
                          "var": "global.op"
                        },
                        "+"
                      ]
                    },
                    "then": [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.expression",
                          "value": {
                            "cat": [
                              {
                                "cat": [
                                  {
                                    "var": "global.prev"
                                  },
                                  ""
                                ]
                              },
                              " ",
                              "+",
                              " ",
                              {
                                "var": "global.display"
                              },
                              " ="
                            ]
                          }
                        }
                      },
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.display",
                          "value": {
                            "cat": [
                              {
                                "+": [
                                  {
                                    "var": "global.prev"
                                  },
                                  {
                                    "*": [
                                      1,
                                      {
                                        "var": "global.display"
                                      }
                                    ]
                                  }
                                ]
                              },
                              ""
                            ]
                          }
                        }
                      },
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.prev",
                          "value": 0
                        }
                      },
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.op",
                          "value": ""
                        }
                      }
                    ],
                    "else": {
                      "call": "@if",
                      "args": {
                        "condition": {
                          "==": [
                            {
                              "var": "global.op"
                            },
                            "-"
                          ]
                        },
                        "then": [
                          {
                            "call": "@set",
                            "args": {
                              "var": "global.expression",
                              "value": {
                                "cat": [
                                  {
                                    "cat": [
                                      {
                                        "var": "global.prev"
                                      },
                                      ""
                                    ]
                                  },
                                  " ",
                                  "−",
                                  " ",
                                  {
                                    "var": "global.display"
                                  },
                                  " ="
                                ]
                              }
                            }
                          },
                          {
                            "call": "@set",
                            "args": {
                              "var": "global.display",
                              "value": {
                                "cat": [
                                  {
                                    "-": [
                                      {
                                        "var": "global.prev"
                                      },
                                      {
                                        "var": "global.display"
                                      }
                                    ]
                                  },
                                  ""
                                ]
                              }
                            }
                          },
                          {
                            "call": "@set",
                            "args": {
                              "var": "global.prev",
                              "value": 0
                            }
                          },
                          {
                            "call": "@set",
                            "args": {
                              "var": "global.op",
                              "value": ""
                            }
                          }
                        ],
                        "else": {
                          "call": "@if",
                          "args": {
                            "condition": {
                              "==": [
                                {
                                  "var": "global.op"
                                },
                                "*"
                              ]
                            },
                            "then": [
                              {
                                "call": "@set",
                                "args": {
                                  "var": "global.expression",
                                  "value": {
                                    "cat": [
                                      {
                                        "cat": [
                                          {
                                            "var": "global.prev"
                                          },
                                          ""
                                        ]
                                      },
                                      " ",
                                      "×",
                                      " ",
                                      {
                                        "var": "global.display"
                                      },
                                      " ="
                                    ]
                                  }
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "global.display",
                                  "value": {
                                    "cat": [
                                      {
                                        "*": [
                                          {
                                            "var": "global.prev"
                                          },
                                          {
                                            "var": "global.display"
                                          }
                                        ]
                                      },
                                      ""
                                    ]
                                  }
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "global.prev",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "global.op",
                                  "value": ""
                                }
                              }
                            ],
                            "else": {
                              "call": "@if",
                              "args": {
                                "condition": {
                                  "==": [
                                    {
                                      "var": "global.op"
                                    },
                                    "/"
                                  ]
                                },
                                "then": [
                                  {
                                    "call": "@set",
                                    "args": {
                                      "var": "global.expression",
                                      "value": {
                                        "cat": [
                                          {
                                            "cat": [
                                              {
                                                "var": "global.prev"
                                              },
                                              ""
                                            ]
                                          },
                                          " ",
                                          "÷",
                                          " ",
                                          {
                                            "var": "global.display"
                                          },
                                          " ="
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "call": "@set",
                                    "args": {
                                      "var": "global.display",
                                      "value": {
                                        "cat": [
                                          {
                                            "/": [
                                              {
                                                "var": "global.prev"
                                              },
                                              {
                                                "var": "global.display"
                                              }
                                            ]
                                          },
                                          ""
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "call": "@set",
                                    "args": {
                                      "var": "global.prev",
                                      "value": 0
                                    }
                                  },
                                  {
                                    "call": "@set",
                                    "args": {
                                      "var": "global.op",
                                      "value": ""
                                    }
                                  }
                                ],
                                "else": []
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ],
              "else": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.expression",
                    "value": {
                      "cat": [
                        {
                          "var": "global.display"
                        },
                        " ="
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.resetFlag",
              "value": true
            }
          }
        ]
      },
      "doClear": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.display",
              "value": "0"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.expression",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.prev",
              "value": 0
