{
  "dsl": "3.3",
  "meta": {
    "name": "video-browser",
    "version": "1.0.0",
    "type": "app",
    "description": "视频浏览 App：列表 + 点进去播放",
    "author": "ai",
    "displayName": "视频浏览"
  },
  "dependencies": {},
  "global": {
    "variables": {
      "videos": [
        {
          "id": "v1",
          "title": "Big Buck Bunny",
          "desc": "经典开源动画短片，阳光明媚的草地故事",
          "duration": "10:35",
          "url": "https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/360/Big_Buck_Bunny_360_10s_1MB.mp4",
          "thumbnail": "https://upload.wikimedia.org/wikipedia/commons/thumb/c/c5/Big_buck_bunny_poster_big.jpg/320px-Big_buck_bunny_poster_big.jpg"
        },
        {
          "id": "v2",
          "title": "Tears of Steel",
          "desc": "Blender 基金会科幻短片，真人+CG 合成",
          "duration": "12:14",
          "url": "https://demo.unified-streaming.com/k8s/features/stable/video/tears-of-steel/tears-of-steel.ism/.m3u8",
          "thumbnail": "https://upload.wikimedia.org/wikipedia/commons/thumb/5/5d/Tears_of_Steel_poster.jpg/320px-Tears_of_Steel_poster.jpg"
        },
        {
          "id": "v3",
          "title": "Sintel",
          "desc": "Blender 基金会奇幻动画，少女与龙的冒险",
          "duration": "14:48",
          "url": "https://test-videos.co.uk/vids/sintel/mp4/h264/360/Sintel_360_10s_1MB.mp4",
          "thumbnail": "https://upload.wikimedia.org/wikipedia/commons/thumb/0/0d/Sintel_poster.jpg/320px-Sintel_poster.jpg"
        },
        {
          "id": "v4",
          "title": "Elephants Dream",
          "desc": "全球首部全开源 3D 动画短片",
          "duration": "10:54",
          "url": "https://test-videos.co.uk/vids/elephantsdream/mp4/h264/360/Elephants_Dream_360_10s_1MB.mp4",
          "thumbnail": "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f5/Elephants_Dream_cover.jpg/320px-Elephants_Dream_cover.jpg"
        },
        {
          "id": "v5",
          "title": "Jellyfish 水母",
          "desc": "海底水母演示片，色彩绚丽生动",
          "duration": "0:30",
          "url": "https://test-videos.co.uk/vids/jellyfish/mp4/h264/360/Jellyfish_360_10s_1MB.mp4",
          "thumbnail": "https://test-videos.co.uk/vids/jellyfish/mp4/h264/360/Jellyfish_360_10s_1MB.mp4"
        },
        {
          "id": "v6",
          "title": "Sample Video",
          "desc": "标准测试视频，兼容性良好",
          "duration": "0:10",
          "url": "https://www.w3schools.com/html/mov_bbb.mp4",
          "thumbnail": "https://www.w3schools.com/html/pic_trulli.jpg"
        }
      ],
      "currentTitle": "",
      "currentDesc": "",
      "currentDuration": "",
      "currentUrl": "",
      "currentThumbnail": ""
    },
    "functions": {
      "selectVideo": {
        "params": [
          "title",
          "desc",
          "duration",
          "url",
          "thumbnail"
        ],
        "logic": [
          {
            "call": "@set_global",
            "args": {
              "key": "currentTitle",
              "value": {
                "var": "title"
              }
            }
          },
          {
            "call": "@set_global",
            "args": {
              "key": "currentDesc",
              "value": {
                "var": "desc"
              }
            }
          },
          {
            "call": "@set_global",
            "args": {
              "key": "currentDuration",
              "value": {
                "var": "duration"
              }
            }
          },
          {
            "call": "@set_global",
            "args": {
              "key": "currentUrl",
              "value": {
                "var": "url"
              }
            }
          },
          {
            "call": "@set_global",
            "args": {
              "key": "currentThumbnail",
              "value": {
                "var": "thumbnail"
              }
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "video_player"
            }
          }
        ]
      },
      "goBack": {
        "params": [],
        "logic": [
          {
            "call": "@navigate_back",
            "args": {}
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "video_list",
        "title": "视频浏览",
        "layout": "column",
        "backgroundColor": "#F3F4F6",
        "appBar": {
          "title": "视频浏览",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0
        },
        "children": [
          {
            "type": "list",
            "source": "{{ global.videos }}",
            "item_template": {
              "type": "gesture_detector",
              "action": {
                "call": "@global.selectVideo",
                "args": {
                  "title": "{{ loop.item.title }}",
                  "desc": "{{ loop.item.desc }}",
                  "duration": "{{ loop.item.duration }}",
                  "url": "{{ loop.item.url }}",
                  "thumbnail": "{{ loop.item.thumbnail }}"
                }
              },
              "child": {
                "type": "card",
                "layout": "row",
                "color": "#FFFFFF",
                "padding": 10,
                "margin": 8,
                "elevation": 0,
                "borderRadius": 14,
                "crossAxisAlignment": "center",
                "children": [
                  {
                    "type": "container",
                    "width": 120,
                    "height": 76,
                    "borderRadius": 10,
                    "child": {
                      "type": "image",
                      "url": "{{ loop.item.thumbnail }}",
                      "fit": "cover",
                      "borderRadius": 10
                    }
                  },
                  {
                    "type": "spacer",
                    "width": 12
                  },
                  {
                    "type": "container",
                    "layout": "column",
                    "position": {
                      "type": "flex",
                      "flex": 1
                    },
                    "children": [
                      {
                        "type": "text",
                        "value": "{{ loop.item.title }}",
                        "style": {
                          "fontSize": 16,
                          "fontWeight": "bold",
                          "color": "#111827"
                        }
                      },
                      {
                        "type": "spacer",
                        "height": 4
                      },
                      {
                        "type": "text",
                        "value": "{{ loop.item.desc }}",
                        "style": {
                          "fontSize": 12,
                          "color": "#6B7280"
                        },
                        "maxLines": 1,
                        "overflow": "ellipsis"
                      },
                      {
                        "type": "spacer",
                        "height": 6
                      },
                      {
                        "type": "container",
                        "layout": "row",
                        "crossAxisAlignment": "center",
                        "children": [
                          {
                            "type": "icon",
                            "name": "play",
                            "size": 14,
                            "color": "#EA580C"
                          },
                          {
                            "type": "spacer",
                            "width": 4
                          },
                          {
                            "type": "text",
                            "value": "{{ loop.item.duration }}",
                            "style": {
                              "fontSize": 12,
                              "color": "#9CA3AF"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "id": "video_player",
        "title": "播放",
        "layout": "column",
        "backgroundColor": "#0F172A",
        "appBar": {
          "title": "{{ global.currentTitle }}",
          "centerTitle": true,
          "backgroundColor": "#0F172A",
          "color": "#FFFFFF",
          "elevation": 0,
          "leading": {
            "type": "icon_button",
            "icon": "back",
            "action": {
              "call": "@global.goBack",
              "args": {}
            },
            "color": "#FFFFFF"
          }
        },
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#000000",
            "padding": 0,
            "margin": 0,
            "elevation": 0,
            "borderRadius": 0,
            "children": [
              {
                "type": "video",
                "url": "{{ global.currentUrl }}",
                "aspectRatio": 1.78,
                "autoplay": true,
                "borderRadius": 0
              }
            ]
          },
          {
            "type": "card",
            "layout": "column",
            "color": "#1E293B",
            "padding": 16,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 16,
            "children": [
              {
                "type": "text",
                "value": "{{ global.currentTitle }}",
                "style": {
                  "fontSize": 20,
                  "fontWeight": "bold",
                  "color": "#FFFFFF"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "container",
                "layout": "row",
                "crossAxisAlignment": "center",
                "children": [
                  {
                    "type": "container",
                    "color": "#EA580C",
                    "borderRadius": 4,
                    "padding": 8,
                    "child": {
                      "type": "text",
                      "value": "{{ global.currentDuration }}",
                      "style": {
                        "fontSize": 12,
                        "color": "#FFFFFF",
                        "fontWeight": "bold"
                      }
                    }
                  },
                  {
                    "type": "spacer",
                    "width": 8
                  },
                  {
                    "type": "icon",
                    "name": "video",
                    "size": 16,
                    "color": "#94A3B8"
                  },
                  {
                    "type": "spacer",
                    "width": 4
                  },
                  {
                    "type": "text",
                    "value": "高清视频",
                    "style": {
                      "fontSize": 13,
                      "color": "#94A3B8"
                    }
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 12
              },
              {
                "type": "text",
                "value": "{{ global.currentDesc }}",
                "style": {
                  "fontSize": 14,
                  "color": "#CBD5E1",
                  "lineHeight": 1.6
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "appid": null
}