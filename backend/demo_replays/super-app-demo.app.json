                      "type": "container",
                      "layout": "column",
                      "mainAxisAlignment": "center",
                      "crossAxisAlignment": "center",
                      "color": "{{ item.bgColor }}",
                      "borderRadius": 16,
                      "padding": 14,
                      "children": [
                        {
                          "type": "icon",
                          "name": "{{ item.icon }}",
                          "size": 26,
                          "color": "{{ item.color }}"
