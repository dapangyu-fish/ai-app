                "type": "switch",
                "label": "厨房灯光",
                "bind": "global.kitchenLight"
              },
              {
                "type": "switch",
                "label": "卫生间灯",
                "bind": "global.bathroomLight"
              },
              {
                "type": "spacer",
                "height": 10
              },
              {
                "type": "divider",
                "color": "#E5E7EB"
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "text",
                "value": "全局亮度 {{ global.brightness }}%",
                "style": {
                  "fontSize": 14,
                  "color": "#4B5563"
                }
              },
              {
                "type": "slider",
                "bind": "global.brightness",
                "min": 0,
                "max": 100,
                "divisions": 20,
                "color": "#2563EB"
              }
            ]
          },
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 16,
            "margin": 0,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "container",
                "layout": "row",
                "mainAxisAlignment": "spaceBetween",
                "crossAxisAlignment": "center",
                "children": [
                  {
                    "type": "text",
                    "value": "空调控制",
                    "style": {
                      "fontSize": 17,
                      "fontWeight": "bold",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 10
              },
              {
                "type": "switch",
                "label": "空调开关",
                "bind": "global.acPower"
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "text",
                "value": "运行模式",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "bold",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 6
              },
              {
                "type": "wrap",
                "spacing": 8,
                "runSpacing": 8,
                "children": [
                  {
                    "type": "chip",
                    "label": "制冷",
                    "icon": "ac_unit",
                    "color": "#DBEAFE",
                    "action": {
                      "call": "@global.setAcCool",
                      "args": {}
                    }
                  },
                  {
                    "type": "chip",
                    "label": "制热",
                    "icon": "wb_sunny",
                    "color": "#FEF3C7",
                    "action": {
                      "call": "@global.setAcHeat",
                      "args": {}
                    }
                  },
                  {
                    "type": "chip",
                    "label": "送风",
                    "icon": "air",
                    "color": "#DCFCE7",
                    "action": {
                      "call": "@global.setAcFan",
                      "args": {}
                    }
                  },
                  {
                    "type": "chip",
                    "label": "除湿",
                    "icon": "water_drop",
                    "color": "#E0F2FE",
                    "action": {
                      "call": "@global.setAcDry",
                      "args": {}
                    }
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 12
              },
              {
                "type": "text",
                "value": "目标温度 {{ global.temperature }}°C",
                "style": {
                  "fontSize": 14,
                  "color": "#4B5563"
                }
              },
              {
                "type": "slider",
                "bind": "global.temperature",
                "min": 18,
                "max": 30,
                "divisions": 12,
                "color": "#D97706"
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "text",
                "value": "风速",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "bold",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 6
              },
              {
                "type": "wrap",
                "spacing": 8,
                "runSpacing": 8,
                "children": [
                  {
                    "type": "chip",
                    "label": "自动",
                    "icon": "settings",
                    "color": "#E8F7F0",
                    "action": {
                      "call": "@global.setFanAuto",
                      "args": {}
                    }
                  },
                  {
                    "type": "chip",
                    "label": "低风",
                    "icon": "bolt",
                    "color": "#EEF2FF",
                    "action": {
                      "call": "@global.setFanLow",
                      "args": {}
                    }
                  },
                  {
                    "type": "chip",
                    "label": "中风",
                    "icon": "bolt",
                    "color": "#FEF7E0",
                    "action": {
                      "call": "@global.setFanMedium",
                      "args": {}
                    }
                  },
                  {
                    "type": "chip",
                    "label": "高风",
                    "icon": "bolt",
                    "color": "#FEE2E2",
                    "action": {
                      "call": "@global.setFanHigh",
                      "args": {}
                    }
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "container",
                "layout": "row",
                "mainAxisAlignment": "center",
                "children": [
                  {
                    "type": "text",
                    "value": "当前：{{ global.acModeLabel }} · 风速 {{ global.fanSpeedLabel }} · {{ global.acPower ? '运行中' : '已关闭' }}",
                    "style": {
                      "fontSize": 12,
                      "color": "#9CA3AF"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 16,
            "margin": 0,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "text",
                "value": "房间状态",
                "style": {
                  "fontSize": 17,
                  "fontWeight": "bold",
                  "color": "#111827"
                }
              },
              {
                "type": "spacer",
                "height": 12
              },
              {
                "type": "grid",
                "source": "{{ global.roomTiles }}",
                "crossAxisCount": 2,
                "spacing": 10,
                "childAspectRatio": 1.6,
                "shrinkWrap": true,
                "item_template": {
                  "type": "container",
                  "layout": "column",
                  "padding": 14,
                  "color": "{{ loop.item.tint }}",
                  "borderRadius": 16,
                  "children": [
                    {
                      "type": "icon",
                      "name": "{{ loop.item.icon }}",
                      "size": 24,
                      "color": "{{ loop.item.accent }}"
                    },
                    {
                      "type": "spacer",
                      "height": 10
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.name }}",
                      "style": {
                        "fontSize": 15,
                        "fontWeight": "bold",
                        "color": "#111827"
                      }
                    },
                    {
                      "type": "spacer",
                      "height": 4
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.device }}",
                      "style": {
                        "fontSize": 12,
                        "color": "#6B7280",
                        "maxLines": 1,
                        "overflow": "ellipsis"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ],
        "appBar": {
          "title": "智能家居",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.sync",
                "args": {}
              },
              "icon": "sync",
              "style": {
                "textColor": "#2563EB",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        }
      }
    ]
  }
}
