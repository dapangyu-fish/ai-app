{
  "dsl": "3.3",
  "appid": "b3f7e201-9c4a-4d2a-bf8b-7e26e3c8d2fc",
  "meta": {
    "name": "demo-tap-white-tile",
    "version": "2.1.1",
    "type": "app",
    "description": "别踩白块儿 — 纯 JSON 实现，最高纪录与历史记录通过 lib_database 持久化",
    "author": "demo"
  },
  "dependencies": {
    "lib_database": "^1.0.0"
  },
  "global": {
    "currentScore": 0,
    "bestScore": 0,
    "lastResult": "尚未开始游戏",
    "history": [],
    "historyCount": 0,
    "_b": null,
    "_ts": 0,
    "_date": "",
    "_id": ""
  },
  "functions": {
    "initDB": {
      "logic": [
        {"call": "@lib_database.createTable", "args": {
          "table": "scores",
          "columns": [
            {"name": "id", "type": "TEXT", "primary": "true"},
            {"name": "score", "type": "INTEGER"},
            {"name": "ts", "type": "INTEGER"},
            {"name": "date", "type": "TEXT"}
          ]
        }}
      ]
    },
    "loadBest": {
      "logic": [
        {"call": "@lib_database.kvGet", "args": {"key": "best_score"}, "assign": "global._b"},
        {"call": "@if", "args": {
          "condition": {"!=": [{"var": "global._b"}, null]},
          "then": [
            {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ global._b }}"}}
          ]
        }}
      ]
    },
    "loadHistory": {
      "logic": [
        {"call": "@lib_database.query", "args": {
          "table": "scores",
          "orderBy": "ts DESC",
          "limit": 10
        }, "assign": "global.history"},
        {"call": "@lib_database.count", "args": {"table": "scores"}, "assign": "global.historyCount"}
      ]
    },
    "handleScoreChanged": {
      "params": ["score"],
      "logic": [
        {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
        {"call": "@if", "args": {
          "condition": {">": [{"var": "params.score"}, {"var": "global.bestScore"}]},
          "then": [
            {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.score }}"}}
          ]
        }}
      ]
    },
    "handleGameOver": {
      "params": ["score"],
      "logic": [
        {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
        {"call": "@if", "args": {
          "condition": {">": [{"var": "params.score"}, {"var": "global.bestScore"}]},
          "then": [
            {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.score }}"}}
          ]
        }},
        {"call": "@lib_database.kvSet", "args": {"key": "best_score", "value": "{{ global.bestScore }}"}},
        {"call": "@timestamp", "args": {}, "assign": "global._ts"},
        {"call": "@date_format", "args": {"timestamp": "{{ global._ts }}", "format": "MM-DD HH:mm"}, "assign": "global._date"},
        {"call": "@uuid", "args": {}, "assign": "global._id"},
        {"call": "@lib_database.insert", "args": {
          "table": "scores",
          "data": {
            "id": "{{ global._id }}",
            "score": "{{ params.score }}",
            "ts": "{{ global._ts }}",
            "date": "{{ global._date }}"
          }
        }},
        {"call": "@global.loadHistory", "args": {}},
        {"call": "@set", "args": {"var": "global.lastResult", "value": "本局 {{ params.score }} 分 / 最佳 {{ global.bestScore }} 分（历史 {{ global.historyCount }} 局）"}}
      ]
    }
  },
  "steps": [
    {"call": "@global.initDB", "args": {}},
    {"call": "@global.loadBest", "args": {}},
    {"call": "@global.loadHistory", "args": {}}
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "别踩白块",
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 12,
            "color": "#1A1A1A",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "实时分数：{{ global.currentScore }}",
                "style": {"fontSize": 14, "color": "#FFFFFF", "fontWeight": "bold"},
                "position": {"type": "flex", "flex": 1}
              },
              {
                "type": "text",
                "value": "最佳：{{ global.bestScore }}",
                "style": {"fontSize": 13, "color": "#AAAAAA"}
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {
                "kind": "pixel",
                "bg": "#2B2B2B"
              },
              "vars": {},
              "entities": {
                "rows": {
                  "kind": "scroll_list",
                  "direction": "down",
                  "speed": 180,
                  "safe_zone_bottom": 2,
                  "row_spec": {
                    "cells": 4,
                    "render_active": {
                      "shape": "rect",
                      "color": "#1A1A1A",
                      "padding": 2,
                      "radius": 6,
                      "tapped_color": "#4A4A4A"
                    },
                    "render_inactive": {
                      "shape": "rect",
                      "color": "#F0F0F0",
                      "padding": 2,
                      "radius": 6
                    }
                  },
                  "render": {}
                }
              },
              "input": {
                "tap": [
                  {"call": "@set", "args": {
                    "var": "vars._tap",
                    "value": {"call": "@scroll_list.tap", "args": {"id": "rows", "x": "{{ event.x }}", "y": "{{ event.y }}"}}
                  }},
                  {"call": "@if", "args": {
                    "cond": {"==": [{"var": "vars._tap"}, "hit"]},
                    "then": [
                      {"call": "@score.add", "args": {"n": 1}},
                      {"call": "@scroll_list.add_speed", "args": {"id": "rows", "by": 4, "max": 600}}
                    ]
                  }},
                  {"call": "@if", "args": {
                    "cond": {"==": [{"var": "vars._tap"}, "miss"]},
                    "then": [{"call": "@game_over"}]
                  }}
                ]
              },
              "frame": {
                "logic": [
                  {"call": "@if", "args": {
                    "cond": {"call": "@scroll_list.first_unhit_below", "args": {
                      "id": "rows",
                      "y": {"-": [{"var": "world.height"}, {"var": "entities.rows.rowHeight"}]}
                    }},
                    "then": [{"call": "@game_over"}]
                  }}
                ]
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.handleGameOver",
                "args": {"score": "{{ event.score }}"}
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.handleScoreChanged",
                "args": {"score": "{{ event.score }}"}
              }
            }
          },
          {
            "type": "container",
            "height": 160,
            "padding": 10,
            "color": "#0A0A0A",
            "layout": "column",
            "crossAxisAlignment": "stretch",
            "children": [
              {
                "type": "text",
                "value": "{{ global.lastResult }}",
                "style": {"fontSize": 13, "color": "#FFFFFF", "fontWeight": "bold"}
              },
              {
                "type": "text",
                "value": "📊 历史记录（共 {{ global.historyCount }} 局）",
                "style": {"fontSize": 11, "color": "#888888"},
                "padding": 4
              },
              {
                "type": "list",
                "source": "{{ global.history }}",
                "emptyText": "尚无历史记录 — 玩一局试试",
                "item_template": {
                  "type": "text",
                  "value": "🎯 {{ loop.item.date }}  →  {{ loop.item.score }} 分",
                  "style": {"fontSize": 11, "color": "#999999"},
                  "padding": 2
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
