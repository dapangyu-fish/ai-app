{
  "dsl": "3.3",
  "appid": "b3f7e201-9c4a-4d2a-bf8b-7a26e3c8d2fc",
  "meta": {
    "name": "demo-tap-white-tile",
    "version": "1.0.0",
    "type": "app",
    "description": "Flame 接入演示 — 别踩白块儿小游戏",
    "author": "demo"
  },
  "global": {
    "currentScore": 0,
    "bestScore": 0,
    "lastResult": ""
  },
  "functions": {
    "handleGameOver": {
      "params": ["score", "best"],
      "logic": [
        {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
        {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.best }}"}},
        {"call": "@set", "args": {"var": "global.lastResult", "value": "本局 {{ params.score }} 分 / 最佳 {{ params.best }} 分"}}
      ]
    }
  },
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "别踩白块",
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 12,
            "color": "#1A1A1A",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "实时分数：{{ global.currentScore }}",
                "style": {"fontSize": 14, "color": "#FFFFFF", "fontWeight": "bold"},
                "position": {"type": "flex", "flex": 1}
              },
              {
                "type": "text",
                "value": "最佳：{{ global.bestScore }}",
                "style": {"fontSize": 13, "color": "#AAAAAA"}
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "scene": "tap_white_tile",
              "params": {
                "columns": 4,
                "initialSpeed": 180,
                "speedAccel": 3.5,
                "maxSpeed": 600,
                "initialBest": "{{ global.bestScore }}"
              },
              "onScoreChanged": {
                "type": "call",
                "call": "@set",
                "args": {"var": "global.currentScore", "value": "{{ event.score }}"}
              },
              "onGameOver": {
                "type": "call",
                "call": "@global.handleGameOver",
                "args": {"score": "{{ event.score }}", "best": "{{ event.best }}"}
              }
            }
          },
          {
            "type": "container",
            "padding": 8,
            "color": "#0A0A0A",
            "children": [
              {
                "type": "text",
                "value": "{{ global.lastResult }}",
                "style": {"fontSize": 12, "color": "#888888"}
              }
            ]
          }
        ]
      }
    ]
  }
}
