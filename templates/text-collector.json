{
  "dsl": "3.3",
  "appid": "75a298d5-4d0f-41ac-bdbb-21027a655874",
  "meta": {
    "name": "text-collector",
    "version": "1.0.0",
    "description": "输入文本 → 实时展示 → 保存到收藏列表 → 查看/删除",
    "author": "fish",
    "type": "app"
  },
  "global": {
    "variables": {
      "inputText": "",
      "favorites": []
    },
    "functions": {
      "saveToFavorites": {
        "params": [
          "text"
        ],
        "return": "None",
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.favorites",
              "value": {
                "merge": [
                  {
                    "var": "global.favorites"
                  },
                  {
                    "var": "params.text"
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.inputText",
              "value": ""
            }
          },
          {
            "call": "@print",
            "args": {
              "value": "已保存：{{ params.text }}"
            }
          }
        ]
      },
      "deleteFromFavorites": {
        "params": [
          "index"
        ],
        "return": "None",
        "logic": [
          {
            "call": "@list_remove_at",
            "args": {
              "var": "global.favorites",
              "index": "{{ params.index }}"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@print",
      "args": {
        "value": "App 启动完成，文本收藏夹已就绪"
      }
    }
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "首页",
        "layout": "column",
        "padding": 20,
        "backgroundColor": "#FAFAFA",
        "children": [
          {
            "type": "text",
            "value": "请输入文本",
            "position": {
              "type": "relative"
            },
            "style": {
              "fontSize": 20,
              "fontWeight": "bold"
            }
          },
          {
            "type": "input",
            "placeholder": "在这里输入...",
            "bind": "global.inputText",
            "position": {
              "type": "relative"
            }
          },
          {
            "type": "text",
            "value": "实时预览：{{ global.inputText }}",
            "position": {
              "type": "relative"
            },
            "style": {
              "fontSize": 18,
              "color": "#666"
            }
          },
          {
            "type": "container",
            "position": {
              "type": "relative"
            },
            "children": [
              {
                "type": "button",
                "label": "保存",
                "position": {
                  "type": "flex",
                  "flex": 1
                },
                "action": {
                  "type": "call",
                  "call": "@global.saveToFavorites",
                  "args": {
                    "text": "{{ global.inputText }}"
                  }
                }
              },
              {
                "type": "button",
                "label": "查看收藏",
                "position": {
                  "type": "flex",
                  "flex": 1
                },
                "action": {
                  "type": "navigate",
                  "screen": "favorites"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "favorites",
        "title": "我的收藏",
        "layout": "column",
        "padding": 20,
        "backgroundColor": "#F5F5F5",
        "children": [
          {
            "type": "button",
            "label": "← 返回",
            "position": {
              "type": "relative"
            },
            "action": {
              "type": "navigate",
              "screen": "home"
            }
          },
          {
            "type": "list",
            "source": "{{ global.favorites }}",
            "position": {
              "type": "relative"
            },
            "item_template": {
              "type": "container",
              "layout": "row",
              "children": [
                {
                  "type": "text",
                  "value": "{{ loop.item }}",
                  "position": {
                    "type": "flex",
                    "flex": 4
                  },
                  "style": {
                    "fontSize": 15,
                    "color": "#1A1A1A"
                  }
                },
                {
                  "type": "button",
                  "label": "删除",
                  "position": {
                    "type": "flex",
                    "flex": 1
                  },
                  "action": {
                    "type": "call",
                    "call": "@global.deleteFromFavorites",
                    "args": {
                      "index": "{{ loop.index }}"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  }
}