{
  "dsl": "3.3",
  "appid": "bf42f194-fd73-54ee-a216-143d54c17405",
  "meta": {
    "name": "demo-bgug-runner",
    "displayName": "BGUG Runner",
    "version": "1.0.0",
    "type": "app",
    "description": "JSON-DSL port inspired by bgug (MIT). Tap left to jump and right to dive.",
    "author": "fish"
  },
  "dependencies": {
    "common-ui": "^1.3.0"
  },
  "assets": {
    "bundles": {
      "bgug": {
        "baseUrl": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-bgug/1.0/",
        "manifest": "manifest.json",
        "license": "MIT",
        "startupDownload": true,
        "description": "bgug source assets"
      }
    }
  },
  "global": {
    "variables": {
      "score": 0,
      "bestScore": 0,
      "status": "Ready",
      "_choice": null
    },
    "functions": {
      "scoreChanged": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "status": {
        "params": [
          "text"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "{{ params.text }}"
            }
          }
        ]
      },
      "over": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@common-ui.choose",
            "args": {
              "title": "BGUG Runner finished",
              "message": "Score: {{ params.score }}\nBest: {{ global.bestScore }}",
              "buttons": [
                {
                  "label": "Close",
                  "value": null,
                  "style": "text"
                },
                {
                  "label": "Restart",
                  "value": "restart"
                }
              ]
            },
            "assign": "global._choice"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "var": "global._choice"
                  },
                  "restart"
                ]
              },
              "then": [
                {
                  "call": "@flame_game_reset",
                  "args": {}
                }
              ]
            }
          }
        ]
      },
      "reset": {
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "Ready"
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "BGUG Runner",
        "appBar": {
          "title": "BGUG Runner",
          "centerTitle": true,
          "backgroundColor": "#111827",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {
                "call": "@flame_game_reset",
                "args": {}
              }
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 10,
            "color": "#111827",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "{{ global.status }}",
                "style": {
                  "fontSize": 13,
                  "color": "#D1D5DB"
                },
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "Score {{ global.score }}",
                "style": {
                  "fontSize": 13,
                  "fontWeight": "bold",
                  "color": "#FFFFFF"
                }
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {
                "kind": "pixel",
                "bg": "#111827"
              },
              "overlay": {
                "game_over": false,
                "asset_loading_text": "Loading BGUG assets..."
              },
              "vars": {
                "state": "ready",
                "ground_y": 420,
                "top_y": 84,
                "speed": -248,
                "gravity": 1750,
                "jump_v": -620,
                "dive_v": 740,
                "spawn_timer": 0.2,
                "gem_timer": 0.6,
                "coin_timer": 2.2,
                "on_ground": true,
                "_id": 0,
                "_lane": 0,
                "_hit": null
              },
              "entities": {
                "bg": {
                  "kind": "parallax",
                  "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-bgug/1.0/images/bg.png",
                  "speed_x": -90,
                  "priority": -20
                },
                "top": {
                  "kind": "pixel",
                  "position": [
                    0,
                    50
                  ],
                  "size": [
                    {
                      "var": "world.width"
                    },
                    28
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "priority": -5,
                  "render": {
                    "shape": "rect",
                    "color": "#0F172A"
                  }
                },
                "floor": {
                  "kind": "pixel",
                  "position": [
                    0,
                    {
                      "-": [
                        {
                          "var": "world.height"
                        },
                        52
                      ]
                    }
                  ],
                  "size": [
                    {
                      "var": "world.width"
                    },
                    52
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "priority": -5,
                  "render": {
                    "shape": "rect",
                    "color": "#1F2937"
                  }
                },
                "player": {
                  "kind": "animated_sprite",
                  "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-bgug/1.0/images/skins/wizard.png",
                  "position": [
                    88,
                    360
                  ],
                  "size": [
                    44,
                    58
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "priority": 20,
                  "state": {
                    "assetLoadingOverlay": true
                  },
                  "frame_size": [
                    16,
                    22
                  ],
                  "frames": 8,
                  "step_time": 0.09,
                  "frames_per_row": 11
                }
              },
              "init": {
                "logic": [
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars.ground_y",
                      "value": {
                        "-": [
                          {
                            "var": "world.height"
                          },
                          110
                        ]
                      }
                    }
                  },
                  {
                    "call": "@entity.set",
                    "args": {
                      "id": "player",
                      "field": "y",
                      "value": {
                        "var": "vars.ground_y"
                      }
                    }
                  },
                  {
                    "call": "@emit",
                    "args": {
                      "event": "status",
                      "data": {
                        "text": "Tap left to jump, right to dive"
                      }
                    }
                  }
                ]
              },
              "input": {
                "tap": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "==": [
                          {
                            "var": "vars.state"
                          },
                          "ready"
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.state",
                            "value": "running"
                          }
                        },
                        {
                          "call": "@emit",
                          "args": {
                            "event": "status",
                            "data": {
                              "text": "Run"
                            }
                          }
                        }
                      ],
                      "else": [
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "event.x"
                                },
                                {
                                  "/": [
                                    {
                                      "var": "world.width"
                                    },
                                    2
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "var": "vars.on_ground"
                                  },
                                  "then": [
                                    {
                                      "call": "@entity.set",
                                      "args": {
                                        "id": "player",
                                        "field": "vy",
                                        "value": {
                                          "var": "vars.jump_v"
                                        }
                                      }
                                    },
                                    {
                                      "call": "@set",
                                      "args": {
                                        "var": "vars.on_ground",
                                        "value": false
                                      }
                                    }
                                  ]
                                }
                              }
                            ],
                            "else": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "player",
                                  "field": "vy",
                                  "value": {
                                    "var": "vars.dive_v"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "tick": {
                "interval": 0.2,
                "logic": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "==": [
                          {
                            "var": "vars.state"
                          },
                          "running"
                        ]
                      },
                      "then": [
                        {
                          "call": "@score.add",
                          "args": {
                            "n": 1
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "frame": {
                "logic": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!=": [
                          {
                            "var": "vars.state"
                          },
                          "running"
                        ]
                      },
                      "then": [],
                      "else": [
                        {
                          "call": "@pixel.add_velocity",
                          "args": {
                            "id": "player",
                            "dv": [
                              0,
                              {
                                "*": [
                                  {
                                    "var": "vars.gravity"
                                  },
                                  {
                                    "var": "event.dt"
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">": [
                                {
                                  "var": "entities.player.y"
                                },
                                {
                                  "var": "vars.ground_y"
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "player",
                                  "field": "y",
                                  "value": {
                                    "var": "vars.ground_y"
                                  }
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "player",
                                  "field": "vy",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.on_ground",
                                  "value": true
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "entities.player.y"
                                },
                                {
                                  "var": "vars.top_y"
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "player",
                                  "field": "y",
                                  "value": {
                                    "var": "vars.top_y"
                                  }
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "player",
                                  "field": "vy",
                                  "value": 0
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@entity.add",
                          "args": {
                            "id": "player",
                            "field": "x",
                            "by": 0,
                            "min": 88,
                            "max": 88
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.spawn_timer",
                            "value": {
                              "+": [
                                {
                                  "var": "vars.spawn_timer"
                                },
                                {
                                  "var": "event.dt"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">=": [
                                {
                                  "var": "vars.spawn_timer"
                                },
                                1.05
                              ]
                            },
                            "then": [
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.spawn_timer",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars._id",
                                  "value": {
                                    "call": "@random_int",
                                    "args": {
                                      "min": 1000,
                                      "max": 999999
                                    }
                                  }
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars._lane",
                                  "value": {
                                    "call": "@random_int",
                                    "args": {
                                      "min": 0,
                                      "max": 2
                                    }
                                  }
                                }
                              },
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "==": [
                                      {
                                        "var": "vars._lane"
                                      },
                                      0
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@spawn",
                                      "args": {
                                        "id": "obstacle_{{ vars._id }}",
                                        "kind": "sprite",
                                        "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-bgug/1.0/images/obstacle.png",
                                        "position": [
                                          {
                                            "var": "world.width"
                                          },
                                          {
                                            "+": [
                                              {
                                                "var": "vars.ground_y"
                                              },
                                              18
                                            ]
                                          }
                                        ],
                                        "size": [
                                          52,
                                          52
                                        ],
                                        "velocity": [
                                          {
                                            "var": "vars.speed"
                                          },
                                          0
                                        ],
                                        "priority": 10,
                                        "src": [
                                          0,
                                          0,
                                          16,
                                          16
                                        ]
                                      }
                                    }
                                  ],
                                  "else": [
                                    {
                                      "call": "@spawn",
                                      "args": {
                                        "id": "obstacle_{{ vars._id }}",
                                        "kind": "sprite",
                                        "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-bgug/1.0/images/up_obstacle.png",
                                        "position": [
                                          {
                                            "var": "world.width"
                                          },
                                          92
                                        ],
                                        "size": [
                                          52,
                                          52
                                        ],
                                        "velocity": [
                                          {
                                            "var": "vars.speed"
                                          },
                                          0
                                        ],
                                        "priority": 10,
                                        "src": [
                                          0,
                                          0,
                                          16,
                                          16
                                        ]
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.gem_timer",
                            "value": {
                              "+": [
                                {
                                  "var": "vars.gem_timer"
                                },
                                {
                                  "var": "event.dt"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">=": [
                                {
                                  "var": "vars.gem_timer"
                                },
                                1.4
                              ]
                            },
                            "then": [
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.gem_timer",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars._id",
                                  "value": {
                                    "call": "@random_int",
                                    "args": {
                                      "min": 1000,
                                      "max": 999999
                                    }
                                  }
                                }
                              },
                              {
                                "call": "@spawn",
                                "args": {
                                  "id": "gem_{{ vars._id }}",
                                  "kind": "sprite",
                                  "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-bgug/1.0/images/gem.png",
                                  "position": [
                                    {
                                      "var": "world.width"
                                    },
                                    {
                                      "call": "@random_int",
                                      "args": {
                                        "min": 120,
                                        "max": 410
                                      }
                                    }
                                  ],
                                  "size": [
                                    28,
                                    28
                                  ],
                                  "velocity": [
                                    {
                                      "var": "vars.speed"
                                    },
                                    0
                                  ],
                                  "priority": 12
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.coin_timer",
                            "value": {
                              "+": [
                                {
                                  "var": "vars.coin_timer"
                                },
                                {
                                  "var": "event.dt"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">=": [
                                {
                                  "var": "vars.coin_timer"
                                },
                                5.5
                              ]
                            },
                            "then": [
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.coin_timer",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars._id",
                                  "value": {
                                    "call": "@random_int",
                                    "args": {
                                      "min": 1000,
                                      "max": 999999
                                    }
                                  }
                                }
                              },
                              {
                                "call": "@spawn",
                                "args": {
                                  "id": "coin_{{ vars._id }}",
                                  "kind": "animated_sprite",
                                  "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-bgug/1.0/images/coin.png",
                                  "position": [
                                    {
                                      "var": "world.width"
                                    },
                                    {
                                      "call": "@random_int",
                                      "args": {
                                        "min": 150,
                                        "max": 390
                                      }
                                    }
                                  ],
                                  "size": [
                                    36,
                                    36
                                  ],
                                  "velocity": [
                                    {
                                      "var": "vars.speed"
                                    },
                                    0
                                  ],
                                  "priority": 12,
                                  "frame_size": [
                                    16,
                                    16
                                  ],
                                  "frames": 10,
                                  "step_time": 0.09,
                                  "frames_per_row": 10
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@collision.first",
                          "args": {
                            "a": "player",
                            "where_prefix": "obstacle_"
                          },
                          "assign": "vars._hit"
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "!=": [
                                {
                                  "var": "vars._hit"
                                },
                                null
                              ]
                            },
                            "then": [
                              {
                                "call": "@game_over",
                                "args": {}
                              }
                            ]
                          }
                        },
                        {
                          "call": "@collision.first",
                          "args": {
                            "a": "player",
                            "where_prefix": "gem_"
                          },
                          "assign": "vars._hit"
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "!=": [
                                {
                                  "var": "vars._hit"
                                },
                                null
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ vars._hit }}"
                                }
                              },
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 10
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars._hit",
                                  "value": null
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@collision.first",
                          "args": {
                            "a": "player",
                            "where_prefix": "coin_"
                          },
                          "assign": "vars._hit"
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "!=": [
                                {
                                  "var": "vars._hit"
                                },
                                null
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ vars._hit }}"
                                }
                              },
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 50
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars._hit",
                                  "value": null
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@for_each_entity",
                          "args": {
                            "where_prefix": "obstacle_",
                            "do": [
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "<": [
                                      {
                                        "var": "loop.entity.x"
                                      },
                                      -80
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@despawn",
                                      "args": {
                                        "id": "{{ loop.id }}"
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@for_each_entity",
                          "args": {
                            "where_prefix": "gem_",
                            "do": [
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "<": [
                                      {
                                        "var": "loop.entity.x"
                                      },
                                      -80
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@despawn",
                                      "args": {
                                        "id": "{{ loop.id }}"
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@for_each_entity",
                          "args": {
                            "where_prefix": "coin_",
                            "do": [
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "<": [
                                      {
                                        "var": "loop.entity.x"
                                      },
                                      -80
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@despawn",
                                      "args": {
                                        "id": "{{ loop.id }}"
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.scoreChanged",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_status": {
                "type": "call",
                "call": "@global.status",
                "args": {
                  "text": "{{ event.text }}"
                }
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.over",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_reset": {
                "type": "call",
                "call": "@global.reset",
                "args": {}
              }
            }
          }
        ]
      }
    ]
  }
}
