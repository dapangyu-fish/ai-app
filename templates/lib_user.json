{
  "dsl": "3.3",
  "meta": {
    "name": "lib_user",
    "version": "1.1.0",
    "type": "library",
    "description": "用户信息组件库",
    "author": "demo",
    "exports": [
      "loadUserInfo",
      "getUserAvatar",
      "getUserEmail",
      "getUserName",
      "getAuthToken",
      "checkLogin"
    ]
  },
  "global": {
    "variables": {
      "_info": null
    },
    "functions": {
      "loadUserInfo": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@get_user_info",
            "args": {
              "bind": "{{ params.bind }}"
            }
          }
        ]
      },
      "getUserAvatar": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@get_user_info",
            "args": {
              "bind": "global._info"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "{{ params.bind }}",
              "value": "{{ global._info.avatar_url }}"
            }
          }
        ]
      },
      "getUserEmail": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@get_user_info",
            "args": {
              "bind": "global._info"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "{{ params.bind }}",
              "value": "{{ global._info.email }}"
            }
          }
        ]
      },
      "getUserName": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@get_user_info",
            "args": {
              "bind": "global._info"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "{{ params.bind }}",
              "value": "{{ global._info.username }}"
            }
          }
        ]
      },
      "getAuthToken": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@get_auth_token",
            "args": {
              "bind": "{{ params.bind }}"
            }
          }
        ]
      },
      "checkLogin": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@is_logged_in",
            "args": {
              "bind": "{{ params.bind }}"
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": []
  }
}