{
  "dsl": "3.3",
  "appid": "08ad186c-773e-430b-b8d0-7e828eeb00af",
  "meta": {
    "name": "common-ui",
    "version": "1.1.0",
    "type": "library",
    "description": "通用 UI 函数库 — toast / confirm / 数值格式化 / 进度计算",
    "author": "demo",
    "exports": [
      "showSuccess",
      "showError",
      "showInfo",
      "confirm",
      "formatSize",
      "takePhoto",
      "pickImage",
      "progress",
      "percent"
    ]
  },
  "global": {
    "variables": {
      "theme": {
        "primaryColor": "#6C5CE7",
        "successColor": "#00B894",
        "errorColor": "#D63031"
      }
    },
    "functions": {
      "showSuccess": {
        "params": [
          "message"
        ],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "✅ {{ params.message }}"
            }
          }
        ]
      },
      "showError": {
        "params": [
          "message"
        ],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "❌ {{ params.message }}"
            }
          }
        ]
      },
      "confirm": {
        "params": [
          "title",
          "message"
        ],
        "logic": [
          {
            "call": "@show_dialog",
            "args": {
              "title": "{{ params.title }}",
              "message": "{{ params.message }}"
            }
          }
        ]
      },
      "formatSize": {
        "params": [
          "bytes"
        ],
        "logic": [
          {
            "call": "@print",
            "args": {
              "value": "格式化文件大小: {{ params.bytes }}"
            }
          }
        ]
      },
      "takePhoto": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@take_photo",
            "args": {
              "bind": "{{ params.bind }}",
              "quality": 85
            }
          }
        ]
      },
      "pickImage": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@pick_image",
            "args": {
              "bind": "{{ params.bind }}",
              "quality": 85
            }
          }
        ]
      },
      "showInfo": {
        "params": [
          "message"
        ],
        "description": "信息提示 toast（蓝色 ℹ️ 前缀）",
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "ℹ️ {{ params.message }}"
            }
          }
        ]
      },
      "progress": {
        "params": [
          "current",
          "total"
        ],
        "description": "返回 current/total 的比例（0~1，可直接喂给 loading widget 的 value 字段）。total 为 0 时返回 0。",
        "logic": [
          {
            "expression": {
              "if": [
                { ">": [{ "var": "params.total" }, 0] },
                { "/": [{ "var": "params.current" }, { "var": "params.total" }] },
                0
              ]
            }
          }
        ]
      },
      "percent": {
        "params": [
          "current",
          "total"
        ],
        "description": "返回 current/total 的百分比整数（0~100）。total 为 0 时返回 0。",
        "logic": [
          {
            "expression": {
              "if": [
                { ">": [{ "var": "params.total" }, 0] },
                {
                  "*": [
                    { "/": [{ "var": "params.current" }, { "var": "params.total" }] },
                    100
                  ]
                },
                0
              ]
            }
          }
        ]
      }
    }
  }
}