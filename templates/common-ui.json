{
  "dsl": "3.3",
  "appid": "08ad186c-773e-430b-b8d0-7e828eeb00af",
  "meta": {
    "name": "common-ui",
    "version": "1.3.0",
    "type": "library",
    "description": "通用 UI 函数库 — toast / confirm / 自定义对话框 / Modal Bottom Sheet / 数值格式化 / 进度计算",
    "author": "demo",
    "exports": [
      "showSuccess",
      "showError",
      "showInfo",
      "confirm",
      "formatSize",
      "takePhoto",
      "pickImage",
      "progress",
      "percent",
      "confirmDelete",
      "choose",
      "showSheet"
    ]
  },
  "global": {
    "variables": {
      "theme": {
        "primaryColor": "#6C5CE7",
        "successColor": "#00B894",
        "errorColor": "#D63031"
      }
    },
    "functions": {
      "showSuccess": {
        "params": [
          "message"
        ],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "✅ {{ params.message }}"
            }
          }
        ]
      },
      "showError": {
        "params": [
          "message"
        ],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "❌ {{ params.message }}"
            }
          }
        ]
      },
      "confirm": {
        "params": [
          "title",
          "message"
        ],
        "logic": [
          {
            "call": "@show_dialog",
            "args": {
              "title": "{{ params.title }}",
              "message": "{{ params.message }}"
            }
          }
        ]
      },
      "formatSize": {
        "params": [
          "bytes"
        ],
        "logic": [
          {
            "call": "@print",
            "args": {
              "value": "格式化文件大小: {{ params.bytes }}"
            }
          }
        ]
      },
      "takePhoto": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@take_photo",
            "args": {
              "bind": "{{ params.bind }}",
              "quality": 85
            }
          }
        ]
      },
      "pickImage": {
        "params": [
          "bind"
        ],
        "logic": [
          {
            "call": "@pick_image",
            "args": {
              "bind": "{{ params.bind }}",
              "quality": 85
            }
          }
        ]
      },
      "showInfo": {
        "params": [
          "message"
        ],
        "description": "信息提示 toast（蓝色 ℹ️ 前缀）",
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "ℹ️ {{ params.message }}"
            }
          }
        ]
      },
      "progress": {
        "params": [
          "current",
          "total"
        ],
        "description": "返回 current/total 的比例（0~1，可直接喂给 loading widget 的 value 字段）。total 为 0 时返回 0。",
        "logic": [
          {
            "expression": {
              "if": [
                { ">": [{ "var": "params.total" }, 0] },
                { "/": [{ "var": "params.current" }, { "var": "params.total" }] },
                0
              ]
            }
          }
        ]
      },
      "percent": {
        "params": [
          "current",
          "total"
        ],
        "description": "返回 current/total 的百分比整数（0~100）。total 为 0 时返回 0。",
        "logic": [
          {
            "expression": {
              "if": [
                { ">": [{ "var": "params.total" }, 0] },
                {
                  "*": [
                    { "/": [{ "var": "params.current" }, { "var": "params.total" }] },
                    100
                  ]
                },
                0
              ]
            }
          }
        ]
      },
      "confirmDelete": {
        "params": [
          "itemName"
        ],
        "description": "标准的危险删除确认弹窗。点删除返回 'delete'，取消/关闭返回 null。",
        "logic": [
          {
            "call": "@show_choice_dialog",
            "args": {
              "title": "确认删除",
              "message": "确定要删除「{{ params.itemName }}」吗？此操作不可撤销。",
              "buttons": [
                { "label": "取消", "value": null, "style": "text" },
                { "label": "删除", "value": "delete", "style": "danger" }
              ]
            }
          }
        ]
      },
      "choose": {
        "params": [
          "title",
          "message",
          "buttons"
        ],
        "description": "通用多选项弹窗，直接转发到 @show_choice_dialog，返回被点按钮的 value。",
        "logic": [
          {
            "call": "@show_choice_dialog",
            "args": {
              "title": "{{ params.title }}",
              "message": "{{ params.message }}",
              "buttons": "{{ params.buttons }}"
            }
          }
        ]
      },
      "showSheet": {
        "params": [
          "title",
          "subtitle",
          "content"
        ],
        "description": "Modal Bottom Sheet（底部模态抽屉）— 标题栏 + divider + 内容槽。content 接任意 widget JSON（list / form / detail card 都行）。title 留空时不画头部。",
        "logic": [
          {
            "call": "@show_bottom_sheet",
            "args": {
              "content": {
                "type": "container",
                "height": 480,
                "layout": "column",
                "crossAxisAlignment": "stretch",
                "children": [
                  {
                    "type": "container",
                    "padding": 8,
                    "layout": "row",
                    "crossAxisAlignment": "center",
                    "visible": "{{ params.title }}",
                    "children": [
                      {
                        "type": "text",
                        "value": "{{ params.title }}",
                        "style": {"fontSize": 18, "fontWeight": "bold"},
                        "position": {"type": "flex", "flex": 1}
                      },
                      {
                        "type": "text",
                        "value": "{{ params.subtitle }}",
                        "style": {"fontSize": 13, "color": "#888888"}
                      }
                    ]
                  },
                  {
                    "type": "divider",
                    "visible": "{{ params.title }}"
                  },
                  {
                    "type": "expanded",
                    "child": "{{ params.content }}"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
