{
  "dsl": "3.3",
  "appid": "c4lcul4t0r1234567890abcdef1234567890",
  "meta": {
    "name": "calculator",
    "version": "1.0.0",
    "type": "app",
    "description": "计算器 - 支持加减乘除、百分比、正负切换",
    "author": "AI"
  },
  "global": {
    "variables": {
      "display": "0",
      "expressionText": "",
      "firstOperand": 0,
      "operator": "",
      "waitingForSecond": false
    },
    "functions": {
      "pressDigit": {
        "params": ["digit"],
        "return": "None",
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": { "or": [
                { "==": [{ "var": "global.waitingForSecond" }, true] },
                { "==": [{ "var": "global.display" }, "0"] },
                { "==": [{ "var": "global.display" }, "Error"] }
              ]},
              "then": [
                { "call": "@set", "args": { "var": "global.display", "value": { "to_string": [{ "var": "params.digit" }] } } },
                { "call": "@set", "args": { "var": "global.waitingForSecond", "value": false } }
              ],
              "else": [
                { "call": "@set", "args": {
                  "var": "global.display",
                  "value": { "cat": [{ "var": "global.display" }, { "to_string": [{ "var": "params.digit" }] }] }
                }}
              ]
            }
          }
        ]
      },

      "pressOperator": {
        "params": ["op"],
        "return": "None",
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": { "!=": [{ "var": "global.display" }, "Error"] },
              "then": [
                {
                  "call": "@if",
                  "args": {
                    "condition": { "and": [
                      { "!=": [{ "var": "global.operator" }, ""] },
                      { "==": [{ "var": "global.waitingForSecond" }, false] }
                    ]},
                    "then": [
                      { "call": "@global.calculate", "args": {} }
                    ],
                    "else": []
                  }
                },
                { "call": "@to_double", "args": { "value": "{{ global.display }}" }, "assign": "global.firstOperand" },
                { "call": "@set", "args": { "var": "global.expressionText", "value": "{{ global.display }} {{ params.op }}" } },
                { "call": "@set", "args": { "var": "global.operator", "value": "{{ params.op }}" } },
                { "call": "@set", "args": { "var": "global.waitingForSecond", "value": true } }
              ],
              "else": []
            }
          }
        ]
      },

      "pressEquals": {
        "params": [],
        "return": "None",
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": { "and": [
                { "!=": [{ "var": "global.display" }, "Error"] },
                { "!=": [{ "var": "global.operator" }, ""] },
                { "==": [{ "var": "global.waitingForSecond" }, false] }
              ]},
              "then": [
                { "call": "@global.calculate", "args": {} },
                { "call": "@set", "args": { "var": "global.operator", "value": "" } },
                { "call": "@set", "args": { "var": "global.expressionText", "value": "" } }
              ],
              "else": []
            }
          }
        ]
      },

      "pressClear": {
        "params": [],
        "return": "None",
        "logic": [
          { "call": "@set", "args": { "var": "global.display", "value": "0" } },
          { "call": "@set", "args": { "var": "global.expressionText", "value": "" } },
          { "call": "@set", "args": { "var": "global.firstOperand", "value": 0 } },
          { "call": "@set", "args": { "var": "global.operator", "value": "" } },
          { "call": "@set", "args": { "var": "global.waitingForSecond", "value": false } }
        ]
      },

      "pressDecimal": {
        "params": [],
        "return": "None",
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": { "!=": [{ "var": "global.display" }, "Error"] },
              "then": [
                {
                  "call": "@if",
                  "args": {
                    "condition": { "==": [{ "var": "global.waitingForSecond" }, true] },
                    "then": [
                      { "call": "@set", "args": { "var": "global.display", "value": "0." } },
                      { "call": "@set", "args": { "var": "global.waitingForSecond", "value": false } }
                    ],
                    "else": [
                      {
                        "call": "@if",
                        "args": {
                          "condition": { "!": [{ "str_contains": [{ "var": "global.display" }, "."] }] },
                          "then": [
                            { "call": "@set", "args": {
                              "var": "global.display",
                              "value": { "cat": [{ "var": "global.display" }, "."] }
                            }}
                          ],
                          "else": []
                        }
                      }
                    ]
                  }
                }
              ],
              "else": []
            }
          }
        ]
      },

      "pressBackspace": {
        "params": [],
        "return": "None",
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": { "or": [
                { "==": [{ "var": "global.display" }, "0"] },
                { "==": [{ "var": "global.display" }, "Error"] },
                { "<=": [{ "str_len": [{ "var": "global.display" }] }, 1] }
              ]},
              "then": [
                { "call": "@set", "args": { "var": "global.display", "value": "0" } }
              ],
              "else": [
                { "call": "@set", "args": {
                  "var": "global.display",
                  "value": { "substr": [{ "var": "global.display" }, 0, { "-": [{ "str_len": [{ "var": "global.display" }] }, 1] }] }
                }}
              ]
            }
          }
        ]
      },

      "toggleSign": {
        "params": [],
        "return": "None",
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": { "and": [
                { "!=": [{ "var": "global.display" }, "0"] },
                { "!=": [{ "var": "global.display" }, "Error"] }
              ]},
              "then": [
                {
                  "call": "@if",
                  "args": {
                    "condition": { "str_contains": [{ "var": "global.display" }, "-"] },
                    "then": [
                      { "call": "@set", "args": {
                        "var": "global.display",
                        "value": { "substr": [{ "var": "global.display" }, 1] }
                      }}
                    ],
                    "else": [
                      { "call": "@set", "args": {
                        "var": "global.display",
                        "value": { "cat": ["-", { "var": "global.display" }] }
                      }}
                    ]
                  }
                }
              ],
              "else": []
            }
          }
        ]
      },

      "pressPercent": {
        "params": [],
        "return": "None",
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": { "and": [
                { "!=": [{ "var": "global.display" }, "Error"] },
                { "!=": [{ "var": "global.display" }, "0"] }
              ]},
              "then": [
                { "call": "@to_double", "args": { "value": "{{ global.display }}" }, "assign": "global._pctVal" },
                { "expression": { "/": [{ "var": "global._pctVal" }, 100] }, "assign": "global._pctVal" },
                {
                  "call": "@if",
                  "args": {
                    "condition": { "==": [{ "%": [{ "var": "global._pctVal" }, 1] }, 0] },
                    "then": [
                      { "call": "@set", "args": { "var": "global.display", "value": { "to_string": [{ "to_int": [{ "var": "global._pctVal" }] }] } } }
                    ],
                    "else": [
                      { "call": "@set", "args": { "var": "global.display", "value": { "to_string": [{ "var": "global._pctVal" }] } } }
                    ]
                  }
                }
              ],
              "else": []
            }
          }
        ]
      },

      "calculate": {
        "params": [],
        "return": "None",
        "logic": [
          { "call": "@to_double", "args": { "value": "{{ global.display }}" }, "assign": "global._second" },
          { "call": "@set", "args": { "var": "global._hasError", "value": false } },
          {
            "call": "@if",
            "args": {
              "condition": { "==": [{ "var": "global.operator" }, "+"] },
              "then": [
                { "expression": { "+": [{ "var": "global.firstOperand" }, { "var": "global._second" }] }, "assign": "global._result" }
              ],
              "else": [
                {
                  "call": "@if",
                  "args": {
                    "condition": { "==": [{ "var": "global.operator" }, "-"] },
                    "then": [
                      { "expression": { "-": [{ "var": "global.firstOperand" }, { "var": "global._second" }] }, "assign": "global._result" }
                    ],
                    "else": [
                      {
                        "call": "@if",
                        "args": {
                          "condition": { "==": [{ "var": "global.operator" }, "*"] },
                          "then": [
                            { "expression": { "*": [{ "var": "global.firstOperand" }, { "var": "global._second" }] }, "assign": "global._result" }
                          ],
                          "else": [
                            {
                              "call": "@if",
                              "args": {
                                "condition": { "==": [{ "var": "global.operator" }, "/"] },
                                "then": [
                                  {
                                    "call": "@if",
                                    "args": {
                                      "condition": { "==": [{ "var": "global._second" }, 0] },
                                      "then": [
                                        { "call": "@set", "args": { "var": "global.display", "value": "Error" } },
                                        { "call": "@set", "args": { "var": "global._hasError", "value": true } },
                                        { "call": "@set", "args": { "var": "global.operator", "value": "" } },
                                        { "call": "@set", "args": { "var": "global.firstOperand", "value": 0 } },
                                        { "call": "@set", "args": { "var": "global.waitingForSecond", "value": false } }
                                      ],
                                      "else": [
                                        { "expression": { "/": [{ "var": "global.firstOperand" }, { "var": "global._second" }] }, "assign": "global._result" }
                                      ]
                                    }
                                  }
                                ],
                                "else": []
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": { "==": [{ "var": "global._hasError" }, false] },
              "then": [
                {
                  "call": "@if",
                  "args": {
                    "condition": { "==": [{ "%": [{ "var": "global._result" }, 1] }, 0] },
                    "then": [
                      { "call": "@set", "args": { "var": "global.display", "value": { "to_string": [{ "to_int": [{ "var": "global._result" }] }] } } }
                    ],
                    "else": [
                      { "call": "@set", "args": { "var": "global.display", "value": { "to_string": [{ "var": "global._result" }] } } }
                    ]
                  }
                },
                { "call": "@set", "args": { "var": "global.firstOperand", "value": { "var": "global._result" } } }
              ],
              "else": []
            }
          }
        ]
      }
    }
  },
  "steps": [],
