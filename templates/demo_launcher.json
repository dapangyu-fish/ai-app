{
  "dsl": "3.3",
  "appid": "4891e65a-8527-499b-9cd4-a0f363074e40",
  "meta": {
    "name": "demo-launcher",
    "version": "0.2.0",
    "type": "app",
    "displayName": {
      "zh": "我的启动器",
      "en": "My Launcher"
    },
    "description": "用 launcher 组件库拼出来的三 tab 启动器 demo —— 本地 / 市场 / 设置。设成默认启动 App 就完全替代了原生主页。",
    "author": "framework"
  },

  "dependencies": {
    "launcher-my-apps": "^1.0.6",
    "launcher-market": "^1.0.0",
    "launcher-settings": "^1.0.0"
  },

  "global": {
    "variables": {}
  },

  "steps": [
    { "call": "@launcher-my-apps.init", "args": {} },
    { "call": "@launcher-market.init", "args": {} },
    { "call": "@launcher-settings.init", "args": {} }
  ],

  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "我的启动器",
        "tabs": [
          {
            "label": "本地",
            "icon": "apps",
            "title": "本地 App",
            "children": [
              {
                "type": "ref",
                "from": "launcher-my-apps",
                "widget": "myAppsGrid",
                "props": {
                  "emptyText": "还没有保存任何 APP，去市场逛一下吧"
                }
              }
            ]
          },
          {
            "label": "市场",
            "icon": "store",
            "title": "应用市场",
            "children": [
              {
                "type": "ref",
                "from": "launcher-market",
                "widget": "marketBrowser",
                "props": {
                  "emptyText": "市场暂时没有内容"
                }
              }
            ]
          },
          {
            "label": "设置",
            "icon": "settings",
            "title": "设置",
            "children": [
              {
                "type": "ref",
                "from": "launcher-settings",
                "widget": "settingsPanel",
                "props": {}
              }
            ]
          }
        ]
      }
    ]
  }
}
