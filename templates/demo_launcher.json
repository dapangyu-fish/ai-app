  },

  "steps": [
    { "call": "@launcher-my-apps.init", "args": {} },
    { "call": "@launcher-market.init", "args": {} },
    { "call": "@launcher-settings.init", "args": {} }
  ],

  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "{{ t('title') }}",
        "tabs": [
          {
            "label": "{{ t('tabs.local') }}",
            "icon": "apps",
            "title": "{{ t('tabs.local_title') }}",
            "children": [
              {
                "type": "ref",
                "from": "launcher-my-apps",
                "widget": "myAppsGrid",
                "props": {
                  "emptyText": "{{ t('myapps.empty') }}"
                }
              }
            ]
          },
          {
            "label": "{{ t('tabs.market') }}",
            "icon": "store",
            "title": "{{ t('tabs.market_title') }}",
            "children": [
              {
                "type": "ref",
                "from": "launcher-market",
                "widget": "marketBrowser",
                "props": {
                  "emptyText": "{{ t('market.empty') }}"
                }
              }
            ]
          },
          {
            "label": "{{ t('tabs.settings') }}",
            "icon": "settings",
            "title": "{{ t('tabs.settings_title') }}",
            "children": [
              {
                "type": "ref",
                "from": "launcher-settings",
                "widget": "settingsPanel",
                "props": {}
              }
            ]
          }
        ]
      }
    ]
  }
}
