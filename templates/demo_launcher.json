{
  "dsl": "3.3",
  "appid": "4891e65a-8527-499b-9cd4-a0f363074e40",
  "meta": {
    "name": "demo-launcher",
    "version": "0.1.5",
    "type": "app",
    "displayName": {
      "zh": "我的启动器",
      "en": "My Launcher"
    },
    "description": "基于 launcher 组件库拼出来的启动器 demo —— 设成默认启动 App 就替代了原生主页。",
    "author": "framework"
  },

  "dependencies": {
    "launcher-my-apps": "^1.0.5"
  },

  "global": {
    "variables": {}
  },

  "steps": [
    { "call": "@launcher-my-apps.init", "args": {} }
  ],

  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "我的启动器",
        "children": [
          {
            "type": "padding",
            "paddingLeft": 16,
            "paddingRight": 16,
            "paddingTop": 12,
            "paddingBottom": 8,
            "child": {
              "type": "text",
              "value": "我的 APP",
              "style": {
                "fontSize": 18,
                "fontWeight": "w600"
              }
            }
          },
          {
            "type": "ref",
            "from": "launcher-my-apps",
            "widget": "myAppsGrid",
            "props": {
              "emptyText": "还没有保存任何 APP，去市场下载或加载 JSON 文件吧"
            }
          }
        ]
      }
    ]
  }
}
