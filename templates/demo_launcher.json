  "meta": {
    "name": "demo-launcher",
    "version": "0.3.0",
    "type": "app",
    "displayName": {
      "zh": "我的启动器",
      "en": "My Launcher",
      "de": "Mein Launcher",
      "es": "Mi launcher"
