{
  "dsl": "3.3",
  "appid": "984b6159-b97e-5f88-8dc0-eb2e957457b0",
  "meta": {
    "name": "demo-new-super-jumper",
    "displayName": "New Super Jumper",
    "version": "1.0.0",
    "type": "app",
    "description": "JSON-DSL vertical jumper inspired by new_super_jumper from flutter_games_compilation.",
    "author": "fish"
  },
  "dependencies": {
    "common-ui": "^1.3.0",
    "game-controls": "^1.0.8"
  },
  "assets": {
    "bundles": {
      "new_super_jumper": {
        "baseUrl": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-new-super-jumper/1.0/",
        "manifest": "manifest.json",
        "license": "Repository license not specified",
        "startupDownload": true,
        "description": "new_super_jumper source assets"
      }
    }
  },
  "global": {
    "variables": {
      "score": 0,
      "bestScore": 0,
      "status": "Ready",
      "_choice": null,
      "_gamepadStyle": "default",
      "_gamepadEditing": false,
      "_gamepadReset": 0
    },
    "functions": {
      "scoreChanged": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "status": {
        "params": [
          "text"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "{{ params.text }}"
            }
          }
        ]
      },
      "over": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@common-ui.choose",
            "args": {
              "title": "New Super Jumper finished",
              "message": "Score: {{ params.score }}\nBest: {{ global.bestScore }}",
              "buttons": [
                {
                  "label": "Close",
                  "value": null,
                  "style": "text"
                },
                {
                  "label": "Restart",
                  "value": "restart"
                }
              ]
            },
            "assign": "global._choice"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "var": "global._choice"
                  },
                  "restart"
                ]
              },
              "then": [
                {
                  "call": "@flame_game_reset",
                  "args": {}
                }
              ]
            }
          }
        ]
      },
      "reset": {
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "Ready"
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "New Super Jumper",
        "appBar": {
          "title": "New Super Jumper",
          "centerTitle": true,
          "backgroundColor": "#0EA5E9",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {
                "call": "@flame_game_reset",
                "args": {}
