                      ],
                      "velocity": [
                        60,
                        0
                      ],
                      "priority": 14,
                      "state": {
                        "minX": 20,
                        "maxX": 330
                      }
                    }
                  },
                  {
                    "call": "@emit",
                    "args": {
                      "event": "status",
                      "data": {
                        "text": "Climb, wrap around, tap attack to shoot"
                      }
                    }
                  }
                ]
              },
              "input": {
                "move_axis": [
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars.move_x",
                      "value": {
                        "var": "event.x"
                      }
                    }
                  }
                ],
                "jump": [
                  {
                    "call": "@entity.set",
                    "args": {
                      "id": "hero",
                      "field": "vy",
                      "value": {
                        "var": "vars.jump_v"
                      }
                    }
                  }
                ],
                "attack": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "<=": [
                          {
                            "var": "vars.shoot_cd"
                          },
                          0
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.shoot_cd",
                            "value": 0.22
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars._id",
                            "value": {
                              "call": "@random_int",
                              "args": {
                                "min": 1000,
                                "max": 999999
                              }
                            }
                          }
                        },
                        {
                          "call": "@spawn",
                          "args": {
                            "id": "bullet_{{ vars._id }}",
                            "kind": "pixel",
                            "position": [
                              {
                                "+": [
                                  {
                                    "var": "entities.hero.x"
                                  },
                                  24
                                ]
                              },
                              {
                                "var": "entities.hero.y"
                              }
                            ],
                            "size": [
                              8,
                              18
                            ],
                            "velocity": [
                              0,
                              -520
                            ],
                            "priority": 30,
                            "render": {
                              "shape": "circle",
                              "color": "#111827"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "frame": {
                "logic": [
                  {
                    "call": "@entity.set",
                    "args": {
                      "id": "hero",
                      "field": "vx",
                      "value": {
                        "*": [
                          {
                            "var": "vars.move_x"
                          },
                          {
                            "var": "vars.speed"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "call": "@pixel.add_velocity",
                    "args": {
                      "id": "hero",
                      "dv": [
                        0,
                        {
                          "*": [
                            {
                              "var": "vars.gravity"
                            },
                            {
                              "var": "event.dt"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars.shoot_cd",
                      "value": {
                        "-": [
                          {
                            "var": "vars.shoot_cd"
                          },
                          {
                            "var": "event.dt"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        ">": [
                          {
                            "var": "entities.hero.x"
                          },
                          {
                            "var": "world.width"
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "hero",
                            "field": "x",
                            "value": -56
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "<": [
                          {
                            "var": "entities.hero.x"
                          },
                          -60
                        ]
                      },
                      "then": [
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "hero",
                            "field": "x",
                            "value": {
                              "var": "world.width"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@collision.first",
                    "args": {
                      "a": "hero",
                      "where_prefix": "platform_"
                    },
                    "assign": "vars._hit"
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "and": [
                          {
                            "!=": [
                              {
                                "var": "vars._hit"
                              },
                              null
                            ]
                          },
                          {
                            ">": [
                              {
                                "var": "entities.hero.vy"
                              },
                              0
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "hero",
                            "field": "vy",
                            "value": {
                              "var": "vars.jump_v"
                            }
                          }
                        },
                        {
                          "call": "@score.add",
                          "args": {
                            "n": 10
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars._hit",
                            "value": null
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "and": [
                          {
                            "call": "@collide.rect",
                            "args": {
                              "a": "hero",
                              "b": "floor"
                            }
                          },
                          {
                            ">": [
                              {
                                "var": "entities.hero.vy"
                              },
                              0
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "hero",
                            "field": "vy",
                            "value": {
                              "var": "vars.jump_v"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "<": [
                          {
                            "var": "entities.hero.y"
                          },
                          220
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.scroll",
                            "value": {
                              "-": [
                                220,
                                {
                                  "var": "entities.hero.y"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "hero",
                            "field": "y",
                            "value": 220
                          }
                        },
                        {
                          "call": "@for_each_entity",
                          "args": {
                            "where_prefix": "platform_",
                            "do": [
                              {
                                "call": "@entity.add",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "y",
                                  "by": {
                                    "var": "vars.scroll"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@for_each_entity",
                          "args": {
                            "where_prefix": "coin_",
                            "do": [
                              {
                                "call": "@entity.add",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "y",
                                  "by": {
                                    "var": "vars.scroll"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@for_each_entity",
                          "args": {
                            "where_prefix": "enemy_",
                            "do": [
                              {
                                "call": "@entity.add",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "y",
                                  "by": {
                                    "var": "vars.scroll"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@for_each_entity",
                    "args": {
                      "where_prefix": "platform_",
                      "do": [
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">": [
                                {
                                  "var": "loop.entity.y"
                                },
                                {
                                  "+": [
                                    {
                                      "var": "world.height"
                                    },
                                    80
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "y",
                                  "value": {
                                    "call": "@random_int",
                                    "args": {
                                      "min": -160,
                                      "max": -40
                                    }
                                  }
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "x",
                                  "value": {
                                    "call": "@random_int",
                                    "args": {
                                      "min": 18,
                                      "max": 300
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@for_each_entity",
                    "args": {
                      "where_prefix": "enemy_",
                      "do": [
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "loop.entity.x"
                                },
                                {
                                  "var": "loop.entity.state.minX"
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "vx",
                                  "value": 70
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">": [
                                {
                                  "var": "loop.entity.x"
                                },
                                {
                                  "var": "loop.entity.state.maxX"
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "vx",
                                  "value": -70
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@collision.first",
                    "args": {
                      "a": "hero",
                      "where_prefix": "coin_"
                    },
                    "assign": "vars._hit"
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!=": [
                          {
                            "var": "vars._hit"
                          },
                          null
                        ]
                      },
                      "then": [
                        {
                          "call": "@despawn",
                          "args": {
                            "id": "{{ vars._hit }}"
                          }
                        },
                        {
                          "call": "@score.add",
                          "args": {
                            "n": 25
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars._hit",
                            "value": null
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@collision.first",
                    "args": {
                      "a": "hero",
                      "where_prefix": "enemy_"
                    },
                    "assign": "vars._hit"
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!=": [
                          {
                            "var": "vars._hit"
                          },
                          null
                        ]
                      },
                      "then": [
                        {
                          "call": "@game_over",
                          "args": {}
                        }
                      ]
                    }
                  },
                  {
                    "call": "@for_each_entity",
                    "args": {
                      "where_prefix": "bullet_",
                      "do": [
                        {
                          "call": "@collision.first",
                          "args": {
                            "a": "{{ loop.id }}",
                            "where_prefix": "enemy_"
                          },
                          "assign": "vars._hit"
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "!=": [
                                {
                                  "var": "vars._hit"
                                },
                                null
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ loop.id }}"
                                }
                              },
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ vars._hit }}"
                                }
                              },
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 100
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "loop.entity.y"
                                },
                                -50
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ loop.id }}"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        ">": [
                          {
                            "var": "entities.hero.y"
                          },
                          {
                            "+": [
                              {
                                "var": "world.height"
                              },
                              80
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@game_over",
                          "args": {}
                        }
                      ]
                    }
                  }
                ]
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.scoreChanged",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_status": {
                "type": "call",
                "call": "@global.status",
                "args": {
                  "text": "{{ event.text }}"
                }
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.over",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_reset": {
                "type": "call",
                "call": "@global.reset",
                "args": {}
              }
            }
          },
          {
            "type": "ref",
            "from": "game-controls",
            "widget": "psJoystickGamepad",
            "props": {
              "moveInput": "move_axis",
              "moveEndInput": "move_axis",
              "jumpInput": "jump",
              "attackInput": "attack",
              "height": 176,
              "backgroundColor": "#0EA5E9"
            }
          }
        ]
      }
    ]
  }
}
