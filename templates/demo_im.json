{
  "dsl": "3.3",
  "appid": "a8e5f201-5d4c-4c2a-9f9b-7e26e3c8d1f4",
  "meta": {
    "name": "demo-im",
    "version": "1.0.0",
    "type": "app",
    "description": "lib_im 演示 — 搜好友 / 加好友 / 好友列表 / 单聊收发文本",
    "author": "demo"
  },
  "dependencies": {
    "lib_im": "^1.0.0",
    "lib_user": "^1.2.0",
    "common-ui": "^1.0.0"
  },
  "global": {
    "variables": {
      "myId": "",
      "myName": "",
      "friends": [],
      "applications": [],
      "conversations": [],
      "searchQ": "",
      "searchResults": [],
      "currentChatUserId": "",
      "currentChatName": "",
      "messages": [],
      "draft": "",
      "_im": null
    },
    "functions": {
      "loadHome": {
        "params": [],
        "logic": [
          {
            "call": "@lib_im.subscribeInbox",
            "args": {}
          },
          {
            "call": "@lib_im.currentUserId",
            "args": {"bind": "global.myId"}
          },
          {
            "call": "@lib_user.getUserName",
            "args": {"bind": "global.myName"}
          },
          {
            "call": "@lib_im.listFriends",
            "args": {"bind": "global.friends"}
          },
          {
            "call": "@lib_im.listFriendApplications",
            "args": {"bind": "global.applications"}
          },
          {
            "call": "@lib_im.listConversations",
            "args": {"bind": "global.conversations"}
          }
        ]
      },

      "search": {
        "params": [],
        "logic": [
          {
            "call": "@lib_im.searchUsers",
            "args": {
              "q": "{{ global.searchQ }}",
              "bind": "global.searchResults"
            }
          }
        ]
      },

      "addFriendByRow": {
        "params": ["userId"],
        "logic": [
          {
            "call": "@lib_im.sendFriendRequest",
            "args": {
              "userId": "{{ params.userId }}",
              "message": "你好，加个好友"
            }
          },
          {
            "call": "@common-ui.showSuccess",
            "args": {"message": "已发送申请"}
          }
        ]
      },

      "acceptFriend": {
        "params": ["userId"],
        "logic": [
          {
            "call": "@lib_im.acceptFriend",
            "args": {"userId": "{{ params.userId }}"}
          },
          {
            "call": "@global.loadHome",
            "args": {}
          },
          {
            "call": "@common-ui.showSuccess",
            "args": {"message": "已通过"}
          }
        ]
      },

      "rejectFriend": {
        "params": ["userId"],
        "logic": [
          {
            "call": "@lib_im.rejectFriend",
            "args": {"userId": "{{ params.userId }}"}
          },
          {
            "call": "@global.loadHome",
            "args": {}
          }
        ]
      },

      "openChat": {
        "params": ["userId", "name"],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentChatUserId",
              "value": "{{ params.userId }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentChatName",
              "value": "{{ params.name }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.draft",
              "value": ""
            }
          },
          {
            "call": "@lib_im.getMessages",
            "args": {
              "userId": "{{ params.userId }}",
              "count": 50,
              "bind": "global.messages"
            }
          },
          {
            "call": "@lib_im.markRead",
            "args": {"userId": "{{ params.userId }}"}
          },
          {
            "call": "@navigate",
            "args": {"screen": "chat"}
          }
        ]
      },

      "openChatFromConversation": {
        "params": ["userId", "name"],
        "logic": [
          {
            "call": "@global.openChat",
            "args": {
              "userId": "{{ params.userId }}",
              "name": "{{ params.name }}"
            }
          }
        ]
      },

      "refreshChat": {
        "params": [],
        "logic": [
          {
            "call": "@lib_im.getMessages",
            "args": {
              "userId": "{{ global.currentChatUserId }}",
              "count": 50,
              "bind": "global.messages"
            }
          }
        ]
      },

      "sendMessage": {
        "params": [],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "and": [
                  {"!!": [{"var": "global.draft"}]},
                  {"!=": [{"var": "global.draft"}, ""]}
                ]
              },
              "then": [
                {
                  "call": "@lib_im.sendText",
                  "args": {
                    "userId": "{{ global.currentChatUserId }}",
                    "text": "{{ global.draft }}"
                  }
                },
                {
                  "call": "@set",
                  "args": {"var": "global.draft", "value": ""}
                },
                {
                  "call": "@global.refreshChat",
                  "args": {}
                }
              ]
            }
          }
        ]
      }
    }
  },
  "steps": [
    {"call": "@global.loadHome", "args": {}}
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "私信",
        "layout": "column",
        "padding": 16,
        "children": [
          {
            "type": "container",
            "layout": "column",
            "color": "#F0F4FF",
            "borderRadius": 12,
            "padding": 12,
            "children": [
              {
                "type": "text",
                "value": "我: {{ global.myName }}",
                "style": {"fontSize": 14, "fontWeight": "bold"}
              },
              {
                "type": "text",
                "value": "ID: {{ global.myId }}",
                "style": {"fontSize": 11, "color": "#666666"}
              }
            ]
          },
          {"type": "spacer", "height": 12},
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "button",
                "label": "搜好友",
                "icon": "person_search",
                "variant": "filled",
                "position": {"type": "flex", "flex": 1},
                "action": {"type": "navigate", "screen": "add_friend"}
              },
              {"type": "spacer", "width": 8},
              {
                "type": "button",
                "label": "新申请",
                "icon": "person_add",
                "variant": "outlined",
                "position": {"type": "flex", "flex": 1},
                "action": {"type": "navigate", "screen": "applications"}
              }
            ]
          },
          {"type": "spacer", "height": 12},
          {
            "type": "button",
            "label": "刷新",
            "icon": "refresh",
            "variant": "text",
            "action": {
              "type": "call",
              "call": "@global.loadHome",
              "args": {}
            }
          },
          {"type": "spacer", "height": 12},
          {
            "type": "text",
            "value": "会话",
            "style": {"fontSize": 16, "fontWeight": "bold"}
          },
          {
            "type": "list",
            "source": "{{ global.conversations }}",
            "emptyText": "还没有会话",
            "item_template": {
              "type": "container",
              "layout": "row",
              "padding": 12,
              "margin": 4,
              "color": "#FFFFFF",
              "borderRadius": 10,
              "onTap": {
                "type": "call",
                "call": "@global.openChatFromConversation",
                "args": {
                  "userId": "{{ loop.item.user_id }}",
                  "name": "{{ loop.item.show_name }}"
                }
              },
              "children": [
                {
                  "type": "container",
                  "position": {"type": "flex", "flex": 1},
                  "layout": "column",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.show_name }}",
                      "style": {"fontSize": 15, "fontWeight": "bold"}
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.latest_text }}",
                      "style": {"fontSize": 13, "color": "#666666"}
                    }
                  ]
                },
                {
                  "type": "text",
                  "value": "未读 {{ loop.item.unread_count }}",
                  "style": {"fontSize": 11, "color": "#FF3B30"}
                }
              ]
            }
          },
          {"type": "spacer", "height": 8},
          {
            "type": "text",
            "value": "好友",
            "style": {"fontSize": 16, "fontWeight": "bold"}
          },
          {
            "type": "list",
            "source": "{{ global.friends }}",
            "emptyText": "还没有好友",
            "item_template": {
              "type": "container",
              "layout": "row",
              "padding": 10,
              "margin": 4,
              "color": "#FFFFFF",
              "borderRadius": 10,
              "onTap": {
                "type": "call",
                "call": "@global.openChat",
                "args": {
                  "userId": "{{ loop.item.user_id }}",
                  "name": "{{ loop.item.nickname }}"
                }
              },
              "children": [
                {
                  "type": "container",
                  "position": {"type": "flex", "flex": 1},
                  "layout": "column",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.nickname }}",
                      "style": {"fontSize": 15, "fontWeight": "bold"}
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.user_id }}",
                      "style": {"fontSize": 11, "color": "#999999"}
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "聊天",
                  "icon": "chat",
                  "variant": "text",
                  "action": {
                    "type": "call",
                    "call": "@global.openChat",
                    "args": {
                      "userId": "{{ loop.item.user_id }}",
                      "name": "{{ loop.item.nickname }}"
                    }
                  }
                }
              ]
            }
          }
        ]
      },

      {
        "id": "add_friend",
        "title": "搜好友",
        "layout": "column",
        "padding": 16,
        "children": [
          {
            "type": "input",
            "value": "{{ global.searchQ }}",
            "bind": "global.searchQ",
            "placeholder": "邮箱 / 昵称 / 用户ID（≥2 字符）"
          },
          {"type": "spacer", "height": 8},
          {
            "type": "button",
            "label": "搜索",
            "icon": "search",
            "variant": "filled",
            "action": {
              "type": "call",
              "call": "@global.search",
              "args": {}
            }
          },
          {"type": "spacer", "height": 12},
          {
            "type": "list",
            "source": "{{ global.searchResults }}",
            "emptyText": "暂无结果",
            "item_template": {
              "type": "container",
              "layout": "row",
              "padding": 12,
              "margin": 4,
              "color": "#FFFFFF",
              "borderRadius": 10,
              "children": [
                {
                  "type": "container",
                  "position": {"type": "flex", "flex": 1},
                  "layout": "column",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.nickname }}",
                      "style": {"fontSize": 15, "fontWeight": "bold"}
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.email }}",
                      "style": {"fontSize": 12, "color": "#666666"}
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "加好友",
                  "icon": "person_add",
                  "variant": "filled",
                  "action": {
                    "type": "call",
                    "call": "@global.addFriendByRow",
                    "args": {"userId": "{{ loop.item.im_user_id }}"}
                  }
                }
              ]
            }
          }
        ]
      },

      {
        "id": "applications",
        "title": "新申请",
        "layout": "column",
        "padding": 16,
        "children": [
          {
            "type": "button",
            "label": "刷新",
            "icon": "refresh",
            "variant": "text",
            "action": {
              "type": "call",
              "call": "@lib_im.listFriendApplications",
              "args": {"bind": "global.applications"}
            }
          },
          {
            "type": "list",
            "source": "{{ global.applications }}",
            "emptyText": "暂无申请",
            "item_template": {
              "type": "container",
              "layout": "row",
              "padding": 12,
              "margin": 4,
              "color": "#FFFFFF",
              "borderRadius": 10,
              "children": [
                {
                  "type": "container",
                  "position": {"type": "flex", "flex": 1},
                  "layout": "column",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.from_nickname }}",
                      "style": {"fontSize": 15, "fontWeight": "bold"}
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.req_msg }}",
                      "style": {"fontSize": 13, "color": "#666666"}
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "通过",
                  "variant": "filled",
                  "action": {
                    "type": "call",
                    "call": "@global.acceptFriend",
                    "args": {"userId": "{{ loop.item.from_user_id }}"}
                  }
                },
                {"type": "spacer", "width": 6},
                {
                  "type": "button",
                  "label": "拒绝",
                  "variant": "outlined",
                  "action": {
                    "type": "call",
                    "call": "@global.rejectFriend",
                    "args": {"userId": "{{ loop.item.from_user_id }}"}
                  }
                }
              ]
            }
          }
        ]
      },

      {
        "id": "chat",
        "title": "{{ global.currentChatName }}",
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "position": {"type": "flex", "flex": 1},
            "padding": 12,
            "children": [
              {
                "type": "list",
                "source": "{{ global.messages }}",
                "emptyText": "还没有消息，发条招呼吧",
                "item_template": {
                  "type": "container",
                  "layout": "row",
                  "padding": 6,
                  "children": [
                    {
                      "type": "container",
                      "padding": 10,
                      "color": "#FFFFFF",
                      "borderRadius": 10,
                      "children": [
                        {
                          "type": "text",
                          "value": "{{ loop.item.sender_nickname }}: {{ loop.item.text }}",
                          "style": {"fontSize": 14}
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "container",
            "layout": "row",
            "padding": 8,
            "color": "#F8F8F8",
            "children": [
              {
                "type": "input",
                "value": "{{ global.draft }}",
                "bind": "global.draft",
                "placeholder": "输入消息...",
                "position": {"type": "flex", "flex": 1}
              },
              {"type": "spacer", "width": 6},
              {
                "type": "button",
                "label": "发送",
                "icon": "send",
                "variant": "filled",
                "action": {
                  "type": "call",
                  "call": "@global.sendMessage",
                  "args": {}
                }
              }
            ]
          },
          {
            "type": "container",
            "layout": "row",
            "padding": 6,
            "children": [
              {
                "type": "text",
                "value": "新消息提示: tick={{ global._im.tick }} 最近 {{ global._im.last_message.text }}",
                "style": {"fontSize": 11, "color": "#888888"}
              }
            ]
          },
          {
            "type": "button",
            "label": "刷新历史",
            "icon": "refresh",
            "variant": "text",
            "action": {
              "type": "call",
              "call": "@global.refreshChat",
              "args": {}
            }
          }
        ]
      }
    ]
  }
}
