{
  "dsl": "3.3",
  "appid": "a8e5f201-5d4c-4c2a-9f9b-7e26e3c8d1f4",
  "meta": {
    "name": "demo-im",
    "version": "1.2.1",
    "type": "app",
    "description": "lib_im 演示 — 微信式双 tab（聊天 / 通讯录）+ 气泡聊天页",
    "author": "demo"
  },
  "dependencies": {
    "lib_im": "^1.2.0",
    "lib_user": "^1.2.0",
    "common-ui": "^1.0.0"
  },
  "global": {
    "variables": {
      "myId": "",
      "myName": "",
      "myAvatar": "",
      "friends": [],
      "applications": [],
      "appCount": 0,
      "conversations": [],
      "totalUnread": 0,
      "searchQ": "",
      "searchResults": [],
      "currentChatUserId": "",
      "currentChatName": "",
      "messages": [],
      "draft": "",
      "_im": null
    },
    "functions": {
      "loadHome": {
        "params": [],
        "logic": [
          {"call": "@lib_im.subscribeInbox", "args": {}},
          {"call": "@lib_im.currentUserId", "args": {"bind": "global.myId"}},
          {"call": "@lib_user.getUserName", "args": {"bind": "global.myName"}},
          {"call": "@lib_user.getUserAvatar", "args": {"bind": "global.myAvatar"}},
          {"call": "@lib_im.listFriends", "args": {"bind": "global.friends"}},
          {"call": "@lib_im.listFriendApplications", "args": {"bind": "global.applications"}},
          {"call": "@lib_im.listConversations", "args": {"bind": "global.conversations"}},
          {"call": "@lib_im.totalUnread", "args": {"bind": "global.totalUnread"}},
          {"call": "@list_length", "args": {"value": "{{ global.applications }}"}, "assign": "global.appCount"}
        ]
      },

      "search": {
        "params": [],
        "logic": [
          {
            "call": "@lib_im.searchUsers",
            "args": {"q": "{{ global.searchQ }}", "bind": "global.searchResults"}
          }
        ]
      },

      "addFriendByRow": {
        "params": ["userId"],
        "logic": [
          {
            "call": "@lib_im.sendFriendRequest",
            "args": {"userId": "{{ params.userId }}", "message": "你好，加个好友"}
          },
          {"call": "@common-ui.showSuccess", "args": {"message": "已发送申请"}}
        ]
      },

      "acceptFriend": {
        "params": ["userId"],
        "logic": [
          {"call": "@lib_im.acceptFriend", "args": {"userId": "{{ params.userId }}"}},
          {"call": "@global.loadHome", "args": {}},
          {"call": "@common-ui.showSuccess", "args": {"message": "已通过"}}
        ]
      },

      "rejectFriend": {
        "params": ["userId"],
        "logic": [
          {"call": "@lib_im.rejectFriend", "args": {"userId": "{{ params.userId }}"}},
          {"call": "@global.loadHome", "args": {}}
        ]
      },

      "openChat": {
        "params": ["userId", "name"],
        "logic": [
          {"call": "@set", "args": {"var": "global.currentChatUserId", "value": "{{ params.userId }}"}},
          {"call": "@set", "args": {"var": "global.currentChatName", "value": "{{ params.name }}"}},
          {"call": "@set", "args": {"var": "global.draft", "value": ""}},
          {
            "call": "@lib_im.getMessages",
            "args": {"userId": "{{ params.userId }}", "count": 50, "bind": "global.messages"}
          },
          {"call": "@lib_im.markRead", "args": {"userId": "{{ params.userId }}"}},
          {"call": "@lib_im.totalUnread", "args": {"bind": "global.totalUnread"}},
          {"call": "@navigate", "args": {"screen": "chat"}}
        ]
      },

      "openChatFromConversation": {
        "params": ["userId", "name"],
        "logic": [
          {
            "call": "@global.openChat",
            "args": {"userId": "{{ params.userId }}", "name": "{{ params.name }}"}
          }
        ]
      },

      "refreshChat": {
        "params": [],
        "logic": [
          {
            "call": "@lib_im.getMessages",
            "args": {"userId": "{{ global.currentChatUserId }}", "count": 50, "bind": "global.messages"}
          },
          {"call": "@lib_im.markRead", "args": {"userId": "{{ global.currentChatUserId }}"}},
          {"call": "@lib_im.totalUnread", "args": {"bind": "global.totalUnread"}}
        ]
      },

      "sendMessage": {
        "params": [],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "and": [
                  {"!!": [{"var": "global.draft"}]},
                  {"!=": [{"var": "global.draft"}, ""]}
                ]
              },
              "then": [
                {
                  "call": "@lib_im.sendText",
                  "args": {
                    "userId": "{{ global.currentChatUserId }}",
                    "text": "{{ global.draft }}"
                  }
                },
                {"call": "@set", "args": {"var": "global.draft", "value": ""}},
                {"call": "@global.refreshChat", "args": {}}
              ]
            }
          }
        ]
      }
    }
  },
  "steps": [
    {"call": "@global.loadHome", "args": {}}
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "微信",
        "tabs": [
          {
            "label": "微信",
            "title": "微信 ({{ global.totalUnread }})",
            "icon": "chat",
            "children": [
              {
                "type": "list",
                "source": "{{ global.conversations }}",
                "emptyText": "还没有会话，去通讯录找朋友聊聊吧",
                "onRefresh": {
                  "type": "call",
                  "call": "@global.loadHome",
                  "args": {}
                },
                "item_template": {
                  "type": "container",
                  "layout": "row",
                  "padding": 12,
                  "color": "#FFFFFF",
                  "crossAxisAlignment": "center",
                  "onTap": {
                    "type": "call",
                    "call": "@global.openChatFromConversation",
                    "args": {
                      "userId": "{{ loop.item.user_id }}",
                      "name": "{{ loop.item.show_name }}"
                    }
                  },
                  "children": [
                    {
                      "type": "avatar",
                      "url": "{{ loop.item.face_url }}",
                      "text": "{{ loop.item.show_name }}",
                      "size": 44
                    },
                    {"type": "spacer", "width": 12},
                    {
                      "type": "container",
                      "layout": "column",
                      "position": {"type": "flex", "flex": 1},
                      "crossAxisAlignment": "start",
                      "children": [
                        {
                          "type": "text",
                          "value": "{{ loop.item.show_name }}",
                          "style": {"fontSize": 16, "fontWeight": "bold"}
                        },
                        {"type": "spacer", "height": 4},
                        {
                          "type": "text",
                          "value": "{{ loop.item.latest_text }}",
                          "style": {"fontSize": 13, "color": "#888888"}
                        }
                      ]
                    },
                    {"type": "spacer", "width": 8},
                    {
                      "type": "container",
                      "layout": "column",
                      "crossAxisAlignment": "end",
                      "children": [
                        {
                          "type": "text",
                          "value": "{{ loop.item.display_time }}",
                          "style": {"fontSize": 11, "color": "#999999"}
                        },
                        {"type": "spacer", "height": 4},
                        {
                          "type": "container",
                          "visible": {">": [{"var": "loop.item.unread_count"}, 0]},
                          "color": "#FF3B30",
                          "borderRadius": 10,
                          "padding": 4,
                          "children": [
                            {
                              "type": "text",
                              "value": "{{ loop.item.display_unread }}",
                              "style": {"fontSize": 10, "color": "#FFFFFF", "fontWeight": "bold"}
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "label": "通讯录",
            "title": "通讯录",
            "icon": "contacts",
            "children": [
              {
                "type": "container",
                "layout": "row",
                "padding": 14,
                "color": "#FFFFFF",
                "crossAxisAlignment": "center",
                "onTap": {"type": "navigate", "screen": "applications"},
                "children": [
                  {
                    "type": "container",
                    "color": "#FF9500",
                    "borderRadius": 8,
                    "width": 36,
                    "height": 36,
                    "layout": "column",
                    "mainAxisAlignment": "center",
                    "crossAxisAlignment": "center",
                    "children": [
                      {"type": "icon", "name": "person_add", "size": 22, "color": "#FFFFFF"}
                    ]
                  },
                  {"type": "spacer", "width": 12},
                  {
                    "type": "text",
                    "value": "新的朋友",
                    "position": {"type": "flex", "flex": 1},
                    "style": {"fontSize": 15}
                  },
                  {
                    "type": "container",
                    "visible": {">": [{"var": "global.appCount"}, 0]},
                    "color": "#FF3B30",
                    "borderRadius": 10,
                    "padding": 4,
                    "children": [
                      {
                        "type": "text",
                        "value": "{{ global.appCount }}",
                        "style": {"fontSize": 11, "color": "#FFFFFF", "fontWeight": "bold"}
                      }
                    ]
                  }
                ]
              },
              {
                "type": "container",
                "layout": "row",
                "padding": 14,
                "color": "#FFFFFF",
                "crossAxisAlignment": "center",
                "onTap": {"type": "navigate", "screen": "add_friend"},
                "children": [
                  {
                    "type": "container",
                    "color": "#34C759",
                    "borderRadius": 8,
                    "width": 36,
                    "height": 36,
                    "layout": "column",
                    "mainAxisAlignment": "center",
                    "crossAxisAlignment": "center",
                    "children": [
                      {"type": "icon", "name": "person_search", "size": 22, "color": "#FFFFFF"}
                    ]
                  },
                  {"type": "spacer", "width": 12},
                  {
                    "type": "text",
                    "value": "搜好友",
                    "position": {"type": "flex", "flex": 1},
                    "style": {"fontSize": 15}
                  }
                ]
              },
              {"type": "spacer", "height": 8},
              {
                "type": "container",
                "layout": "row",
                "padding": 12,
                "color": "#F4F4F8",
                "children": [
                  {
                    "type": "text",
                    "value": "好友 ({{ global.totalUnread }} 条未读)",
                    "style": {"fontSize": 12, "color": "#666666"}
                  }
                ]
              },
              {
                "type": "list",
                "source": "{{ global.friends }}",
                "emptyText": "还没有好友，去搜好友加几个吧",
                "item_template": {
                  "type": "container",
                  "layout": "row",
                  "padding": 12,
                  "color": "#FFFFFF",
                  "crossAxisAlignment": "center",
                  "onTap": {
                    "type": "call",
                    "call": "@global.openChat",
                    "args": {
                      "userId": "{{ loop.item.user_id }}",
                      "name": "{{ loop.item.nickname }}"
                    }
                  },
                  "children": [
                    {
                      "type": "avatar",
                      "url": "{{ loop.item.face_url }}",
                      "text": "{{ loop.item.nickname }}",
                      "size": 40
                    },
                    {"type": "spacer", "width": 12},
                    {
                      "type": "container",
                      "layout": "column",
                      "position": {"type": "flex", "flex": 1},
                      "crossAxisAlignment": "start",
                      "children": [
                        {
                          "type": "text",
                          "value": "{{ loop.item.nickname }}",
                          "style": {"fontSize": 15, "fontWeight": "bold"}
                        },
                        {
                          "type": "text",
                          "value": "{{ loop.item.user_id }}",
                          "style": {"fontSize": 11, "color": "#999999"}
                        }
                      ]
                    },
                    {"type": "icon", "name": "chevron_right", "size": 20, "color": "#CCCCCC"}
                  ]
                }
              }
            ]
          }
        ]
      },

      {
        "id": "add_friend",
        "title": "搜好友",
        "layout": "column",
        "padding": 16,
        "children": [
          {
            "type": "input",
            "value": "{{ global.searchQ }}",
            "bind": "global.searchQ",
            "placeholder": "邮箱 / 昵称 / 用户ID（≥2 字符）",
            "prefixIcon": "search"
          },
          {"type": "spacer", "height": 8},
          {
            "type": "button",
            "label": "搜索",
            "icon": "search",
            "variant": "filled",
            "action": {"type": "call", "call": "@global.search", "args": {}}
          },
          {"type": "spacer", "height": 12},
          {
            "type": "list",
            "source": "{{ global.searchResults }}",
            "emptyText": "暂无结果",
            "item_template": {
              "type": "container",
              "layout": "row",
              "padding": 12,
              "margin": 4,
              "color": "#FFFFFF",
              "borderRadius": 10,
              "crossAxisAlignment": "center",
              "children": [
                {
                  "type": "avatar",
                  "url": "{{ loop.item.face_url }}",
                  "text": "{{ loop.item.nickname }}",
                  "size": 40
                },
                {"type": "spacer", "width": 12},
                {
                  "type": "container",
                  "layout": "column",
                  "position": {"type": "flex", "flex": 1},
                  "crossAxisAlignment": "start",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.nickname }}",
                      "style": {"fontSize": 15, "fontWeight": "bold"}
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.email }}",
                      "style": {"fontSize": 12, "color": "#666666"}
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "加好友",
                  "icon": "person_add",
                  "variant": "filled",
                  "action": {
                    "type": "call",
                    "call": "@global.addFriendByRow",
                    "args": {"userId": "{{ loop.item.im_user_id }}"}
                  }
                }
              ]
            }
          }
        ]
      },

      {
        "id": "applications",
        "title": "新的朋友",
        "layout": "column",
        "padding": 16,
        "children": [
          {
            "type": "list",
            "source": "{{ global.applications }}",
            "emptyText": "暂无申请",
            "onRefresh": {
              "type": "call",
              "call": "@global.loadHome",
              "args": {}
            },
            "item_template": {
              "type": "container",
              "layout": "row",
              "padding": 12,
              "margin": 4,
              "color": "#FFFFFF",
              "borderRadius": 10,
              "crossAxisAlignment": "center",
              "children": [
                {
                  "type": "avatar",
                  "url": "{{ loop.item.from_face_url }}",
                  "text": "{{ loop.item.from_nickname }}",
                  "size": 40
                },
                {"type": "spacer", "width": 12},
                {
                  "type": "container",
                  "layout": "column",
                  "position": {"type": "flex", "flex": 1},
                  "crossAxisAlignment": "start",
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item.from_nickname }}",
                      "style": {"fontSize": 15, "fontWeight": "bold"}
                    },
                    {
                      "type": "text",
                      "value": "{{ loop.item.req_msg }}",
                      "style": {"fontSize": 12, "color": "#666666"}
                    }
                  ]
                },
                {
                  "type": "button",
                  "label": "通过",
                  "variant": "filled",
                  "action": {
                    "type": "call",
                    "call": "@global.acceptFriend",
                    "args": {"userId": "{{ loop.item.from_user_id }}"}
                  }
                },
                {"type": "spacer", "width": 6},
                {
                  "type": "button",
                  "label": "拒绝",
                  "variant": "outlined",
                  "action": {
                    "type": "call",
                    "call": "@global.rejectFriend",
                    "args": {"userId": "{{ loop.item.from_user_id }}"}
                  }
                }
              ]
            }
          }
        ]
      },

      {
        "id": "chat",
        "title": "{{ global.currentChatName }}",
        "layout": "column",
        "padding": 0,
        "backgroundColor": "#EDEDED",
        "children": [
          {
            "type": "container",
            "layout": "column",
            "position": {"type": "flex", "flex": 1},
            "padding": 8,
            "children": [
              {
                "type": "list",
                "source": "{{ global.messages }}",
                "emptyText": "还没有消息，发条招呼吧",
                "onRefresh": {
                  "type": "call",
                  "call": "@global.refreshChat",
                  "args": {}
                },
                "item_template": {
                  "type": "container",
                  "layout": "column",
                  "padding": 4,
                  "children": [
                    {
                      "type": "container",
                      "visible": {"!": [{"var": "loop.item.is_me"}]},
                      "layout": "row",
                      "crossAxisAlignment": "start",
                      "children": [
                        {
                          "type": "avatar",
                          "url": "{{ loop.item.sender_face_url }}",
                          "text": "{{ loop.item.sender_nickname }}",
                          "size": 36
                        },
                        {"type": "spacer", "width": 8},
                        {
                          "type": "container",
                          "layout": "column",
                          "crossAxisAlignment": "start",
                          "children": [
                            {
                              "type": "text",
                              "value": "{{ loop.item.sender_nickname }}",
                              "style": {"fontSize": 11, "color": "#888888"}
                            },
                            {"type": "spacer", "height": 2},
                            {
                              "type": "container",
                              "color": "#FFFFFF",
                              "borderRadius": 8,
                              "padding": 10,
                              "children": [
                                {
                                  "type": "text",
                                  "value": "{{ loop.item.text }}",
                                  "style": {"fontSize": 15, "color": "#000000"}
                                }
                              ]
                            }
                          ]
                        },
                        {"type": "spacer", "position": {"type": "flex", "flex": 1}}
                      ]
                    },
                    {
                      "type": "container",
                      "visible": "{{ loop.item.is_me }}",
                      "layout": "row",
                      "crossAxisAlignment": "start",
                      "children": [
                        {"type": "spacer", "position": {"type": "flex", "flex": 1}},
                        {
                          "type": "container",
                          "layout": "column",
                          "crossAxisAlignment": "end",
                          "children": [
                            {
                              "type": "text",
                              "value": "我",
                              "style": {"fontSize": 11, "color": "#888888"}
                            },
                            {"type": "spacer", "height": 2},
                            {
                              "type": "container",
                              "color": "#95EC69",
                              "borderRadius": 8,
                              "padding": 10,
                              "children": [
                                {
                                  "type": "text",
                                  "value": "{{ loop.item.text }}",
                                  "style": {"fontSize": 15, "color": "#000000"}
                                }
                              ]
                            }
                          ]
                        },
                        {"type": "spacer", "width": 8},
                        {
                          "type": "avatar",
                          "url": "{{ global.myAvatar }}",
                          "text": "{{ global.myName }}",
                          "size": 36
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "container",
            "layout": "row",
            "padding": 8,
            "color": "#F7F7F7",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "input",
                "value": "{{ global.draft }}",
                "bind": "global.draft",
                "placeholder": "输入消息...",
                "position": {"type": "flex", "flex": 1}
              },
              {"type": "spacer", "width": 6},
              {
                "type": "button",
                "label": "发送",
                "icon": "send",
                "variant": "filled",
                "action": {"type": "call", "call": "@global.sendMessage", "args": {}}
              }
            ]
          }
        ]
      }
    ]
  }
}
