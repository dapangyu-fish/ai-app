{
  "dsl": "3.3",
  "meta": {
    "name": "native-quality-budget",
    "version": "1.0.0",
    "type": "app",
    "description": "高质量预算/记账类 JSON UI 模板：月度摘要、分类筛选、交易列表、详情、表单。",
    "author": "fish",
    "displayName": "Native Budget Template"
  },
  "dependencies": {},
  "global": {
    "variables": {
      "searchQuery": "",
      "selectedType": "全部",
      "transactions": [
        {
          "id": "b1",
          "title": "午餐",
          "amount": "-¥42",
          "category": "餐饮",
          "date": "今天 12:35",
          "note": "工作日套餐，计入日常支出。",
          "accent": "#DC2626",
          "tint": "#FEECEC"
        },
        {
          "id": "b2",
          "title": "项目尾款",
          "amount": "+¥4,800",
          "category": "收入",
          "date": "今天 09:10",
          "note": "五月第二阶段交付完成。",
          "accent": "#059669",
          "tint": "#E8F7F0"
        },
        {
          "id": "b3",
          "title": "地铁通勤",
          "amount": "-¥8",
          "category": "交通",
          "date": "昨天",
          "note": "往返客户现场。",
          "accent": "#2563EB",
          "tint": "#EAF1FF"
        }
      ],
      "currentTitle": "",
      "currentAmount": "",
      "currentCategory": "",
      "currentDate": "",
      "currentNote": "",
      "currentAccent": "#2563EB",
      "currentTint": "#EAF1FF",
      "formAmount": "",
      "formTitle": ""
    },
    "functions": {
      "startCreate": {
        "params": [],
        "logic": [
          {
            "call": "@navigate",
            "args": {
              "screen": "budget_form"
            }
          }
        ]
      },
      "viewTxn": {
        "params": [
          "txnTitle",
          "amount",
          "category",
          "date",
          "note",
          "accent",
          "tint"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentTitle",
              "value": "{{ params.txnTitle }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentAmount",
              "value": "{{ params.amount }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentCategory",
              "value": "{{ params.category }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentDate",
              "value": "{{ params.date }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentNote",
              "value": "{{ params.note }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentAccent",
              "value": "{{ params.accent }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentTint",
              "value": "{{ params.tint }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "budget_detail"
            }
          }
        ]
      },
      "saveTxn": {
        "params": [],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "模板示例：这里接入交易保存逻辑"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "home"
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "记账",
        "layout": "column",
        "children": [
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "receipt",
                          "size": 18,
                          "color": "#DC2626"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "本月支出",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "¥3,280",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "payment",
                          "size": 18,
                          "color": "#059669"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "本月收入",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "¥8,900",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "analytics",
                          "size": 18,
                          "color": "#0F766E"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "结余",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "¥5,620",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              }
            ],
            "margin": 8
          },
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "icon",
                "name": "search",
                "size": 18,
                "color": "#8E8E93"
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "input",
                "placeholder": "搜索备注、分类、金额",
                "bind": "global.searchQuery",
                "position": {
                  "type": "flex",
                  "flex": 1
                },
                "style": {
                  "fontSize": 15,
                  "borderRadius": 10
                }
              }
            ],
            "padding": 10,
            "margin": 12,
            "color": "#F7F8FA",
            "borderRadius": 14,
            "crossAxisAlignment": "center"
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "wrap",
                "spacing": 8,
                "runSpacing": 8,
                "children": [
                  {
                    "type": "chip",
                    "label": "全部",
                    "variant": "choice",
                    "bind": "global.selectedType",
                    "value": "全部",
                    "color": "#0F766E"
                  },
                  {
                    "type": "chip",
                    "label": "支出",
                    "variant": "choice",
                    "bind": "global.selectedType",
                    "value": "支出",
                    "color": "#0F766E"
                  },
                  {
                    "type": "chip",
                    "label": "收入",
                    "variant": "choice",
                    "bind": "global.selectedType",
                    "value": "收入",
                    "color": "#0F766E"
                  },
                  {
                    "type": "chip",
                    "label": "餐饮",
                    "variant": "choice",
                    "bind": "global.selectedType",
                    "value": "餐饮",
                    "color": "#0F766E"
                  }
                ]
              }
            ],
            "padding": 12,
            "margin": 8,
            "color": "#FFFFFF",
            "borderRadius": 14
          },
          {
            "type": "list",
            "source": "{{ global.transactions }}",
            "emptyText": "暂无交易，先记录第一笔收支",
            "item_template": {
              "type": "card",
              "layout": "column",
              "color": "#FFFFFF",
              "padding": 14,
              "margin": 8,
              "elevation": 0,
              "borderRadius": 16,
              "children": [
                {
                  "type": "container",
                  "layout": "row",
                  "children": [
                    {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "icon",
                          "name": "receipt",
                          "size": 20,
                          "color": "{{ loop.item.accent }}"
                        }
                      ],
                      "width": 42,
                      "height": 42,
                      "color": "{{ loop.item.tint }}",
                      "borderRadius": 12,
                      "mainAxisAlignment": "center",
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "width": 12
                    },
                    {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "container",
                          "layout": "row",
                          "children": [
                            {
                              "type": "text",
                              "value": "{{ loop.item.title }}",
                              "position": {
                                "type": "flex",
                                "flex": 1
                              },
                              "style": {
                                "fontSize": 16,
                                "fontWeight": "bold",
                                "color": "#111827",
                                "maxLines": 1,
                                "overflow": "ellipsis"
                              }
                            },
                            {
                              "type": "text",
                              "value": "{{ loop.item.amount }}",
                              "style": {
                                "fontSize": 17,
                                "fontWeight": "bold",
                                "color": "{{ loop.item.accent }}"
                              }
                            }
                          ],
                          "crossAxisAlignment": "center"
                        },
                        {
                          "type": "spacer",
                          "height": 5
                        },
                        {
                          "type": "text",
                          "value": "{{ loop.item.category }} · {{ loop.item.date }}",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        },
                        {
                          "type": "spacer",
                          "height": 8
                        },
                        {
                          "type": "text",
                          "value": "{{ loop.item.note }}",
                          "style": {
                            "fontSize": 13,
                            "color": "#9CA3AF",
                            "maxLines": 1,
                            "overflow": "ellipsis"
                          }
                        }
                      ],
                      "position": {
                        "type": "flex",
                        "flex": 1
                      }
                    }
                  ],
                  "crossAxisAlignment": "center"
                }
              ],
              "onTap": {
                "call": "@global.viewTxn",
                "args": {
                  "txnTitle": "{{ loop.item.title }}",
                  "amount": "{{ loop.item.amount }}",
                  "category": "{{ loop.item.category }}",
                  "date": "{{ loop.item.date }}",
                  "note": "{{ loop.item.note }}",
                  "accent": "{{ loop.item.accent }}",
                  "tint": "{{ loop.item.tint }}"
                }
              }
            }
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "button",
                "label": "记一笔",
                "variant": "filled",
                "action": {
                  "call": "@global.startCreate",
                  "args": {}
                },
                "icon": "add",
                "style": {
                  "backgroundColor": "#0F766E",
                  "textColor": "#FFFFFF",
                  "borderRadius": 16,
                  "fontSize": 15,
                  "paddingV": 12
                }
              }
            ],
            "padding": 12,
            "color": "#F3F7F6"
          }
        ],
        "backgroundColor": "#F3F7F6",
        "appBar": {
          "title": "记账",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.startCreate",
                "args": {}
              },
              "icon": "add",
              "style": {
                "textColor": "#0F766E",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        }
      },
      {
        "id": "budget_detail",
        "title": "交易详情",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 18,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "container",
                    "layout": "column",
                    "children": [
                      {
                        "type": "icon",
                        "name": "receipt",
                        "size": 24,
                        "color": "{{ global.currentAccent }}"
                      }
                    ],
                    "width": 52,
                    "height": 52,
                    "color": "{{ global.currentTint }}",
                    "borderRadius": 16,
                    "mainAxisAlignment": "center",
                    "crossAxisAlignment": "center"
                  },
                  {
                    "type": "spacer",
                    "width": 14
                  },
                  {
                    "type": "container",
                    "layout": "column",
                    "children": [
                      {
                        "type": "text",
                        "value": "{{ global.currentAmount }}",
                        "style": {
                          "fontSize": 28,
                          "fontWeight": "bold",
                          "color": "{{ global.currentAccent }}"
                        }
                      },
                      {
                        "type": "spacer",
                        "height": 4
                      },
                      {
                        "type": "text",
                        "value": "{{ global.currentTitle }} · {{ global.currentCategory }}",
                        "style": {
                          "fontSize": 14,
                          "color": "#6B7280"
                        }
                      }
                    ],
                    "position": {
                      "type": "flex",
                      "flex": 1
                    }
                  }
                ],
                "crossAxisAlignment": "center"
              },
              {
                "type": "spacer",
                "height": 18
              },
              {
                "type": "text",
                "value": "{{ global.currentDate }}",
                "style": {
                  "fontSize": 14,
                  "color": "#6B7280"
                }
              },
              {
                "type": "spacer",
                "height": 10
              },
              {
                "type": "text",
                "value": "{{ global.currentNote }}",
                "style": {
                  "fontSize": 15,
                  "color": "#374151",
                  "lineHeight": 1.5
                }
              }
            ]
          }
        ],
        "backgroundColor": "#F3F7F6",
        "appBar": {
          "title": "交易详情",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0
        }
      },
      {
        "id": "budget_form",
        "title": "记一笔",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 18,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "text",
                "value": "金额",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "600",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "input",
                "placeholder": "0.00",
                "bind": "global.formAmount",
                "prefixIcon": "payment"
              },
              {
                "type": "spacer",
                "height": 16
              },
              {
                "type": "text",
                "value": "说明",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "600",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "input",
                "placeholder": "例如 午餐、地铁、工资",
                "bind": "global.formTitle"
              },
              {
                "type": "spacer",
                "height": 18
              },
              {
                "type": "button",
                "label": "保存",
                "variant": "filled",
                "action": {
                  "call": "@global.saveTxn",
                  "args": {}
                },
                "icon": "save",
                "style": {
                  "backgroundColor": "#0F766E",
                  "textColor": "#FFFFFF",
                  "borderRadius": 14
                }
              }
            ]
          }
        ],
        "backgroundColor": "#F3F7F6",
        "appBar": {
          "title": "记一笔",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0
        }
      }
    ]
  },
  "appid": "008b3ccc-c8f3-4382-985c-e1de89621497"
}
