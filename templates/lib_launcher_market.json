{
  "dsl": "3.3",
  "appid": "5811ffa0-a901-4c6b-a0b7-ca1de1f16083",
  "meta": {
    "name": "launcher-market",
    "version": "1.0.0",
    "type": "library",
    "displayName": {
      "zh": "启动器组件 · 市场",
      "en": "Launcher Component · Market"
    },
    "description": "可嵌入的'市场'组件库——浏览 Registry 上的 JSON-APP / 组件库，一键启动。",
    "author": "framework",
    "exports": ["marketBrowser", "init", "refresh"]
  },

  "global": {
    "variables": {
      "_lm": {
        "apps": [],
        "loading": false,
        "type": "app",
        "search": ""
      }
    },
    "functions": {
      "init": {
        "params": [],
        "logic": [
          { "call": "@launcher-market.refresh", "args": {} }
        ]
      },

      "refresh": {
        "params": [],
        "logic": [
          { "call": "@set", "args": { "var": "global._lm.loading", "value": true } },
          {
            "call": "@market_list",
            "args": {
              "type": "{{ global._lm.type }}",
              "search": "{{ global._lm.search }}"
            },
            "assign": "global._lm.apps"
          },
          { "call": "@set", "args": { "var": "global._lm.loading", "value": false } }
        ]
      }
    }
  },

  "ui": {
    "templates": {
      "marketBrowser": {
        "props": ["emptyText"],
        "root": {
          "type": "container",
          "layout": "column",
          "children": [
            {
              "type": "padding",
              "paddingLeft": 12,
              "paddingRight": 12,
              "paddingTop": 8,
              "paddingBottom": 4,
              "child": {
                "type": "container",
                "layout": "row",
                "crossAxisAlignment": "center",
                "children": [
                  {
                    "type": "expanded",
                    "child": {
                      "type": "input",
                      "bind": "global._lm.search",
                      "placeholder": "搜索 APP / 组件",
                      "prefixIcon": "search"
                    }
                  },
                  { "type": "spacer", "width": 8 },
                  {
                    "type": "button",
                    "label": "搜索",
                    "variant": "filled",
                    "action": {
                      "call": "@launcher-market.refresh",
                      "args": {}
                    }
                  }
                ]
              }
            },
            {
              "type": "padding",
              "paddingLeft": 12,
              "paddingRight": 12,
              "paddingBottom": 4,
              "child": {
                "type": "dropdown",
                "bind": "global._lm.type",
                "options": [
                  { "label": "App", "value": "app" },
                  { "label": "Library", "value": "library" }
                ],
                "action": {
                  "call": "@launcher-market.refresh",
                  "args": {}
                }
              }
            },
            {
              "type": "expanded",
              "child": {
                "type": "list",
                "source": "{{ global._lm.apps }}",
                "emptyText": "{{ props.emptyText }}",
                "padding": 12,
                "separator": "none",
                "onRefresh": {
                  "call": "@launcher-market.refresh",
                  "args": {}
                },
                "item_template": {
                  "type": "card",
                  "elevation": 1,
                  "borderRadius": 12,
                  "margin": 6,
                  "padding": 14,
                  "layout": "row",
                  "crossAxisAlignment": "center",
                  "onTap": {
                    "call": "@launch_app",
                    "args": {
                      "kind": "market",
                      "name": "{{ loop.item.name }}",
                      "version": "{{ loop.item.version }}"
                    }
                  },
                  "children": [
                    {
                      "type": "container",
                      "width": 48,
                      "height": 48,
                      "borderRadius": 12,
                      "color": "#FFF3E0",
                      "children": [
                        {
                          "type": "center",
                          "child": {
                            "type": "icon",
                            "name": "store",
                            "size": 28,
                            "color": "#F57C00"
                          }
                        }
                      ]
                    },
                    { "type": "spacer", "width": 12 },
                    {
                      "type": "expanded",
                      "child": {
                        "type": "container",
                        "layout": "column",
                        "crossAxisAlignment": "start",
                        "children": [
                          {
                            "type": "text",
                            "value": "{{ loop.item.displayName }}",
                            "style": {
                              "fontSize": 16,
                              "fontWeight": "w600",
                              "maxLines": 1,
                              "overflow": "ellipsis"
                            }
                          },
                          { "type": "spacer", "height": 4 },
                          {
                            "type": "text",
                            "value": "{{ loop.item.description }}",
                            "visible": { "!=": [{ "var": "loop.item.description" }, ""] },
                            "style": {
                              "fontSize": 13,
                              "color": "#666666",
                              "maxLines": 2,
                              "overflow": "ellipsis"
                            }
                          },
                          { "type": "spacer", "height": 6 },
                          {
                            "type": "container",
                            "layout": "row",
                            "children": [
                              {
                                "type": "text",
                                "value": "v{{ loop.item.version }}",
                                "visible": { "!=": [{ "var": "loop.item.version" }, ""] },
                                "style": {
                                  "fontSize": 11,
                                  "color": "#999999"
                                }
                              },
                              {
                                "type": "text",
                                "value": "  ·  {{ loop.item.author }}",
                                "visible": { "!=": [{ "var": "loop.item.author" }, ""] },
                                "style": {
                                  "fontSize": 11,
                                  "color": "#999999"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
