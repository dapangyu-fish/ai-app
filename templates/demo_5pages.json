{
  "dsl": "3.3",
  "appid": "fc61e069-731e-42a6-83ab-f8b7105bf248",
  "meta": {
    "name": "demo-5pages",
    "version": "1.0.0",
    "description": "5页演示：首页导航 + 新建笔记 + 笔记列表 + 搜索 + 关于",
    "author": "fish",
    "type": "app"
  },
  "global": {
    "variables": {
      "noteTitle": "",
      "noteContent": "",
      "searchKeyword": "",
      "notes": [],
      "searchResults": [],
      "noteCount": "0"
    },
    "functions": {
      "addNote": {
        "params": [
          "title",
          "content"
        ],
        "return": "None",
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.notes",
              "value": {
                "merge": [
                  {
                    "var": "global.notes"
                  },
                  "{{ params.title }} | {{ params.content }}"
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.noteTitle",
              "value": ""
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.noteContent",
              "value": ""
            }
          },
          {
            "call": "@print",
            "args": {
              "value": "已添加笔记：{{ params.title }}"
            }
          }
        ]
      },
      "deleteNote": {
        "params": [
          "index"
        ],
        "return": "None",
        "logic": [
          {
            "call": "@list_remove_at",
            "args": {
              "var": "global.notes",
              "index": "{{ params.index }}"
            }
          },
          {
            "call": "@print",
            "args": {
              "value": "已删除第 {{ params.index }} 条笔记"
            }
          }
        ]
      },
      "clearAllNotes": {
        "params": [],
        "return": "None",
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.notes",
              "value": []
            }
          },
          {
            "call": "@print",
            "args": {
              "value": "已清空所有笔记"
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@print",
      "args": {
        "value": "个人记事本启动完成"
      }
    }
  ],
