{
  "dsl": "3.3",
  "meta": {
    "name": "native-quality-habits",
    "version": "1.0.0",
    "type": "app",
    "description": "高质量习惯打卡类 JSON UI 模板：今日进度、习惯列表、详情、表单。",
    "author": "fish",
    "displayName": "Native Habits Template"
  },
  "dependencies": {},
  "global": {
    "variables": {
      "searchQuery": "",
      "selectedStatus": "全部",
      "habits": [
        {
          "id": "h1",
          "title": "晨间拉伸",
          "status": "已完成",
          "streak": "18",
          "weekDone": "6",
          "progress": 0.86,
          "accent": "#059669",
          "tint": "#E8F7F0"
        },
        {
          "id": "h2",
          "title": "阅读 30 分钟",
          "status": "待打卡",
          "streak": "9",
          "weekDone": "4",
          "progress": 0.57,
          "accent": "#2563EB",
          "tint": "#EAF1FF"
        },
        {
          "id": "h3",
          "title": "晚上复盘",
          "status": "21:30",
          "streak": "12",
          "weekDone": "5",
          "progress": 0.71,
          "accent": "#7C3AED",
          "tint": "#F1EAFF"
        }
      ],
      "currentTitle": "",
      "currentStreak": "",
      "currentStatus": "",
      "currentAccent": "#059669",
      "currentTint": "#E8F7F0",
      "formTitle": ""
    },
    "functions": {
      "startCreate": {
        "params": [],
        "logic": [
          {
            "call": "@navigate",
            "args": {
              "screen": "habit_form"
            }
          }
        ]
      },
      "viewHabit": {
        "params": [
          "habitTitle",
          "streak",
          "status",
          "accent",
          "tint"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentTitle",
              "value": "{{ params.habitTitle }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentStreak",
              "value": "{{ params.streak }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentStatus",
              "value": "{{ params.status }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentAccent",
              "value": "{{ params.accent }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentTint",
              "value": "{{ params.tint }}"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "habit_detail"
            }
          }
        ]
      },
      "saveHabit": {
        "params": [],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "模板示例：这里接入习惯保存逻辑"
            }
          },
          {
            "call": "@navigate",
            "args": {
              "screen": "home"
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "习惯",
        "layout": "column",
        "children": [
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "check_circle",
                          "size": 18,
                          "color": "#059669"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "今日完成",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "5/7",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "timeline",
                          "size": 18,
                          "color": "#7C3AED"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "最长连续",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "18",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "expanded",
                "child": {
                  "type": "card",
                  "layout": "column",
                  "color": "#FFFFFF",
                  "padding": 14,
                  "margin": 6,
                  "elevation": 0,
                  "borderRadius": 14,
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "icon",
                          "name": "analytics",
                          "size": 18,
                          "color": "#2563EB"
                        },
                        {
                          "type": "spacer",
                          "width": 8
                        },
                        {
                          "type": "text",
                          "value": "本周完成率",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280"
                          }
                        }
                      ],
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "height": 8
                    },
                    {
                      "type": "text",
                      "value": "76%",
                      "style": {
                        "fontSize": 21,
                        "fontWeight": "bold",
                        "color": "#111827",
                        "maxLines": 1
                      }
                    }
                  ]
                }
              }
            ],
            "margin": 8
          },
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "icon",
                "name": "search",
                "size": 18,
                "color": "#8E8E93"
              },
              {
                "type": "spacer",
                "width": 8
              },
              {
                "type": "input",
                "placeholder": "搜索习惯",
                "bind": "global.searchQuery",
                "position": {
                  "type": "flex",
                  "flex": 1
                },
                "style": {
                  "fontSize": 15,
                  "borderRadius": 10
                }
              }
            ],
            "padding": 10,
            "margin": 12,
            "color": "#F7F8FA",
            "borderRadius": 14,
            "crossAxisAlignment": "center"
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "wrap",
                "spacing": 8,
                "runSpacing": 8,
                "children": [
                  {
                    "type": "chip",
                    "label": "全部",
                    "variant": "choice",
                    "bind": "global.selectedStatus",
                    "value": "全部",
                    "color": "#7C3AED"
                  },
                  {
                    "type": "chip",
                    "label": "待打卡",
                    "variant": "choice",
                    "bind": "global.selectedStatus",
                    "value": "待打卡",
                    "color": "#7C3AED"
                  },
                  {
                    "type": "chip",
                    "label": "已完成",
                    "variant": "choice",
                    "bind": "global.selectedStatus",
                    "value": "已完成",
                    "color": "#7C3AED"
                  },
                  {
                    "type": "chip",
                    "label": "晚间",
                    "variant": "choice",
                    "bind": "global.selectedStatus",
                    "value": "晚间",
                    "color": "#7C3AED"
                  }
                ]
              }
            ],
            "padding": 12,
            "margin": 8,
            "color": "#FFFFFF",
            "borderRadius": 14
          },
          {
            "type": "list",
            "source": "{{ global.habits }}",
            "emptyText": "暂无习惯，先创建一个可坚持的小目标",
            "item_template": {
              "type": "card",
              "layout": "column",
              "color": "#FFFFFF",
              "padding": 14,
              "margin": 8,
              "elevation": 0,
              "borderRadius": 16,
              "children": [
                {
                  "type": "container",
                  "layout": "row",
                  "children": [
                    {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "icon",
                          "name": "check_circle",
                          "size": 20,
                          "color": "{{ loop.item.accent }}"
                        }
                      ],
                      "width": 42,
                      "height": 42,
                      "color": "{{ loop.item.tint }}",
                      "borderRadius": 12,
                      "mainAxisAlignment": "center",
                      "crossAxisAlignment": "center"
                    },
                    {
                      "type": "spacer",
                      "width": 12
                    },
                    {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "text",
                          "value": "{{ loop.item.title }}",
                          "style": {
                            "fontSize": 16,
                            "fontWeight": "bold",
                            "color": "#111827",
                            "maxLines": 1,
                            "overflow": "ellipsis"
                          }
                        },
                        {
                          "type": "spacer",
                          "height": 6
                        },
                        {
                          "type": "text",
                          "value": "{{ loop.item.status }} · 连续 {{ loop.item.streak }} 天 · 本周 {{ loop.item.weekDone }}/7",
                          "style": {
                            "fontSize": 13,
                            "color": "#6B7280",
                            "maxLines": 1,
                            "overflow": "ellipsis"
                          }
                        },
                        {
                          "type": "spacer",
                          "height": 8
                        },
                        {
                          "type": "progress",
                          "value": "{{ loop.item.progress }}",
                          "color": "{{ loop.item.accent }}",
                          "backgroundColor": "#E5E7EB",
                          "height": 6
                        }
                      ],
                      "position": {
                        "type": "flex",
                        "flex": 1
                      }
                    }
                  ],
                  "crossAxisAlignment": "center"
                }
              ],
              "onTap": {
                "call": "@global.viewHabit",
                "args": {
                  "habitTitle": "{{ loop.item.title }}",
                  "streak": "{{ loop.item.streak }}",
                  "status": "{{ loop.item.status }}",
                  "accent": "{{ loop.item.accent }}",
                  "tint": "{{ loop.item.tint }}"
                }
              }
            }
          },
          {
            "type": "container",
            "layout": "column",
            "children": [
              {
                "type": "button",
                "label": "新增习惯",
                "variant": "filled",
                "action": {
                  "call": "@global.startCreate",
                  "args": {}
                },
                "icon": "add",
                "style": {
                  "backgroundColor": "#7C3AED",
                  "textColor": "#FFFFFF",
                  "borderRadius": 16,
                  "fontSize": 15,
                  "paddingV": 12
                }
              }
            ],
            "padding": 12,
            "color": "#F6F4FB"
          }
        ],
        "backgroundColor": "#F6F4FB",
        "appBar": {
          "title": "习惯",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.startCreate",
                "args": {}
              },
              "icon": "add",
              "style": {
                "textColor": "#7C3AED",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        }
      },
      {
        "id": "habit_detail",
        "title": "习惯详情",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 20,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "container",
                "layout": "column",
                "children": [
                  {
                    "type": "icon",
                    "name": "check_circle",
                    "size": 28,
                    "color": "{{ global.currentAccent }}"
                  }
                ],
                "width": 58,
                "height": 58,
                "color": "{{ global.currentTint }}",
                "borderRadius": 18,
                "mainAxisAlignment": "center",
                "crossAxisAlignment": "center"
              },
              {
                "type": "spacer",
                "height": 14
              },
              {
                "type": "text",
                "value": "{{ global.currentTitle }}",
                "style": {
                  "fontSize": 24,
                  "fontWeight": "bold",
                  "color": "#111827"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "text",
                "value": "当前状态：{{ global.currentStatus }}",
                "style": {
                  "fontSize": 14,
                  "color": "#6B7280"
                }
              },
              {
                "type": "spacer",
                "height": 14
              },
              {
                "type": "text",
                "value": "已连续坚持 {{ global.currentStreak }} 天",
                "style": {
                  "fontSize": 18,
                  "fontWeight": "bold",
                  "color": "{{ global.currentAccent }}"
                }
              }
            ],
            "crossAxisAlignment": "center"
          }
        ],
        "backgroundColor": "#F6F4FB",
        "appBar": {
          "title": "习惯详情",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0
        }
      },
      {
        "id": "habit_form",
        "title": "编辑习惯",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 18,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 18,
            "children": [
              {
                "type": "text",
                "value": "习惯名称",
                "style": {
                  "fontSize": 14,
                  "fontWeight": "600",
                  "color": "#374151"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "input",
                "placeholder": "例如 每天步行 20 分钟",
                "bind": "global.formTitle"
              },
              {
                "type": "spacer",
                "height": 18
              },
              {
                "type": "button",
                "label": "保存习惯",
                "variant": "filled",
                "action": {
                  "call": "@global.saveHabit",
                  "args": {}
                },
                "icon": "save",
                "style": {
                  "backgroundColor": "#7C3AED",
                  "textColor": "#FFFFFF",
                  "borderRadius": 14
                }
              }
            ]
          }
        ],
        "backgroundColor": "#F6F4FB",
        "appBar": {
          "title": "编辑习惯",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0
        }
      }
    ]
  },
  "appid": "e1c49e4f-ddf8-411c-b7f1-3f9cd8b784e5"
}
