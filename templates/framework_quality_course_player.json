{
  "dsl": "3.3",
  "meta": {
    "name": "framework-quality-course-player",
    "version": "1.0.0",
    "type": "app",
    "description": "框架能力模板：视频课程播放器，展示 video、tab_view、checkbox、progress。",
    "author": "fish",
    "displayName": "Framework Course Player"
  },
  "dependencies": {},
  "global": {
    "variables": {
      "lessons": [
        {
          "title": "01 需求拆解",
          "state": "已完成",
          "progress": 1.0
        },
        {
          "title": "02 交互草图",
          "state": "播放中",
          "progress": 0.46
        },
        {
          "title": "03 组件验收",
          "state": "待学习",
          "progress": 0.0
        }
      ],
      "notesEnabled": true,
      "downloadWifi": true
    },
    "functions": {
      "mark": {
        "params": [],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "已标记本节重点"
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "课程",
        "layout": "column",
        "children": [
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 14,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 20,
            "children": [
              {
                "type": "video",
                "url": "https://demo.unified-streaming.com/k8s/features/stable/video/tears-of-steel/tears-of-steel.ism/.m3u8",
                "aspectRatio": 1.78,
                "borderRadius": 16
              },
              {
                "type": "spacer",
                "height": 10
              },
              {
                "type": "text",
                "value": "产品原型课 · 第 2 节",
                "style": {
                  "fontSize": 13,
                  "color": "#6B7280"
                }
              },
              {
                "type": "spacer",
                "height": 4
              },
              {
                "type": "text",
                "value": "把交互草图变成可验证流程",
                "style": {
                  "fontSize": 20,
                  "fontWeight": "bold",
                  "color": "#111827"
                }
              },
              {
                "type": "spacer",
                "height": 10
              },
              {
                "type": "progress",
                "value": 0.46,
                "color": "#EA580C",
                "backgroundColor": "#E5E7EB",
                "height": 8
              }
            ]
          },
          {
            "type": "card",
            "layout": "column",
            "color": "#FFFFFF",
            "padding": 12,
            "margin": 12,
            "elevation": 0,
            "borderRadius": 20,
            "children": [
              {
                "type": "tab_view",
                "height": 360,
                "color": "#EA580C",
                "tabs": [
                  {
                    "label": "目录",
                    "icon": "list",
                    "content": {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "grid",
                          "source": "{{ global.lessons }}",
                          "crossAxisCount": 1,
                          "childAspectRatio": 4.4,
                          "spacing": 8,
                          "shrinkWrap": true,
                          "item_template": {
                            "type": "container",
                            "layout": "row",
                            "children": [
                              {
                                "type": "icon",
                                "name": "play",
                                "size": 20,
                                "color": "#EA580C"
                              },
                              {
                                "type": "spacer",
                                "width": 10
                              },
                              {
                                "type": "container",
                                "layout": "column",
                                "children": [
                                  {
                                    "type": "text",
                                    "value": "{{ loop.item.title }}",
                                    "style": {
                                      "fontSize": 15,
                                      "fontWeight": "bold",
                                      "color": "#111827"
                                    }
                                  },
                                  {
                                    "type": "spacer",
                                    "height": 5
                                  },
                                  {
                                    "type": "text",
                                    "value": "{{ loop.item.state }}",
                                    "style": {
                                      "fontSize": 12,
                                      "color": "#6B7280"
                                    }
                                  }
                                ],
                                "position": {
                                  "type": "flex",
                                  "flex": 1
                                }
                              },
                              {
                                "type": "text",
                                "value": "{{ loop.item.progress }}",
                                "style": {
                                  "fontSize": 12,
                                  "color": "#9CA3AF"
                                }
                              }
                            ],
                            "padding": 12,
                            "color": "#FFF7ED",
                            "borderRadius": 16,
                            "crossAxisAlignment": "center"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "label": "设置",
                    "icon": "settings",
                    "content": {
                      "type": "container",
                      "layout": "column",
                      "children": [
                        {
                          "type": "switch",
                          "label": "显示随堂笔记",
                          "bind": "global.notesEnabled"
                        },
                        {
                          "type": "switch",
                          "label": "仅 Wi-Fi 自动缓存",
                          "bind": "global.downloadWifi"
                        },
                        {
                          "type": "spacer",
                          "height": 10
                        },
                        {
                          "type": "text",
                          "value": "本页体现视频、标签页、开关和课程进度，不依赖记录列表结构。",
                          "style": {
                            "fontSize": 14,
                            "color": "#6B7280",
                            "lineHeight": 1.45
                          }
                        },
                        {
                          "type": "spacer",
                          "height": 12
                        },
                        {
                          "type": "button",
                          "label": "标记重点",
                          "variant": "filled",
                          "action": {
                            "call": "@global.mark",
                            "args": {}
                          },
                          "icon": "bookmark",
                          "style": {
                            "backgroundColor": "#EA580C",
                            "textColor": "#FFFFFF",
                            "borderRadius": 16
                          }
                        }
                      ],
                      "padding": 8
                    }
                  }
                ]
              }
            ]
          }
        ],
        "backgroundColor": "#F5F5F7",
        "appBar": {
          "title": "课程",
          "centerTitle": true,
          "backgroundColor": "#FFFFFF",
          "color": "#111827",
          "elevation": 0,
          "actions": [
            {
              "type": "button",
              "label": "",
              "variant": "text",
              "action": {
                "call": "@global.mark",
                "args": {}
              },
              "icon": "bookmark",
              "style": {
                "textColor": "#EA580C",
                "fontSize": 18,
                "paddingH": 10,
                "paddingV": 8
              }
            }
          ]
        }
      }
    ]
  },
  "appid": "e353f5db-5528-4369-a10c-5bb5be855404"
}
