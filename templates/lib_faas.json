{
  "dsl": "3.3",
  "appid": "5f3a1c20-9b6d-4e88-a1f2-0c7d9e4b6a01",
  "meta": {
    "name": "faas",
    "displayName": {"zh": "FaaS 调用库", "en": "FaaS invoke lib", "default": "FaaS invoke lib"},
    "version": "1.0.1",
    "type": "library",
    "description": "FaaS 调用助手：用 app.backendUrl 拼完整 invoke URL 再调用通用 http builtin。app.backendUrl 不可用时（旧客户端无 app 命名空间）自动回退为相对地址，由客户端 backendUrl 前缀——两种客户端都能跑。",
    "author": "claude",
    "exports": ["url", "get", "post", "put", "del", "sse"]
  },
  "global": {
    "variables": {
      "_r": null,
      "_base": null
    },
    "functions": {
      "url": {
        "params": ["serviceId", "route"],
        "description": "拼完整 invoke URL。base = app.backendUrl（新客户端）或 ''（旧客户端→相对地址）。route 以 / 开头，如 /ping。",
        "logic": [
          {"call": "@set", "args": {"var": "global._base", "value": {"or": [{"var": "app.backendUrl"}, ""]}}},
          {"call": "@set", "args": {"var": "global._r", "value": "{{ global._base }}/api/faas/invoke/{{ params.serviceId }}{{ params.route }}"}},
          {"expression": {"var": "global._r"}}
        ]
      },
      "get": {
        "params": ["serviceId", "route", "headers"],
        "description": "GET 一个 faas 路由。返回 http 信封 {status,data,headers,error}。",
        "logic": [
          {"call": "@set", "args": {"var": "global._base", "value": {"or": [{"var": "app.backendUrl"}, ""]}}},
          {
            "call": "@http_get",
            "args": {
              "url": "{{ global._base }}/api/faas/invoke/{{ params.serviceId }}{{ params.route }}",
              "headers": "{{ params.headers }}"
            },
            "assign": "global._r"
          },
          {"expression": {"var": "global._r"}}
        ]
      },
      "post": {
        "params": ["serviceId", "route", "body", "headers"],
        "description": "POST 一个 faas 路由（JSON body）。",
        "logic": [
          {"call": "@set", "args": {"var": "global._base", "value": {"or": [{"var": "app.backendUrl"}, ""]}}},
          {
            "call": "@http_post",
            "args": {
              "url": "{{ global._base }}/api/faas/invoke/{{ params.serviceId }}{{ params.route }}",
              "body": "{{ params.body }}",
              "headers": "{{ params.headers }}"
            },
            "assign": "global._r"
          },
          {"expression": {"var": "global._r"}}
        ]
      },
      "put": {
        "params": ["serviceId", "route", "body", "headers"],
        "description": "PUT 一个 faas 路由（JSON body）。",
        "logic": [
          {"call": "@set", "args": {"var": "global._base", "value": {"or": [{"var": "app.backendUrl"}, ""]}}},
          {
            "call": "@http_put",
            "args": {
              "url": "{{ global._base }}/api/faas/invoke/{{ params.serviceId }}{{ params.route }}",
              "body": "{{ params.body }}",
              "headers": "{{ params.headers }}"
            },
            "assign": "global._r"
          },
          {"expression": {"var": "global._r"}}
        ]
      },
      "del": {
        "params": ["serviceId", "route", "headers"],
        "description": "DELETE 一个 faas 路由。",
        "logic": [
          {"call": "@set", "args": {"var": "global._base", "value": {"or": [{"var": "app.backendUrl"}, ""]}}},
          {
            "call": "@http_delete",
            "args": {
              "url": "{{ global._base }}/api/faas/invoke/{{ params.serviceId }}{{ params.route }}",
              "headers": "{{ params.headers }}"
            },
            "assign": "global._r"
          },
          {"expression": {"var": "global._r"}}
        ]
      },
      "sse": {
        "params": ["serviceId", "route", "method", "bind"],
        "description": "SSE 调用一个 faas 路由。method 默认 GET；bind 是接收累加结果的变量路径。",
        "logic": [
          {"call": "@set", "args": {"var": "global._base", "value": {"or": [{"var": "app.backendUrl"}, ""]}}},
          {
            "call": "@http_sse",
            "args": {
              "url": "{{ global._base }}/api/faas/invoke/{{ params.serviceId }}{{ params.route }}",
              "method": "{{ params.method }}",
              "bind": "{{ params.bind }}"
            },
            "assign": "global._r"
          },
          {"expression": {"var": "global._r"}}
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": []
  }
}
