{
  "dsl": "3.3",
  "appid": "177e1bbe-5844-4390-85a3-5b0fd39022e7",
  "meta": {
    "name": "super-app-demo",
    "version": "1.0.0",
    "type": "app",
    "description": "P0 演示：Tab导航 + 下拉刷新 + 本地存储",
    "author": "fish"
  },
  "global": {
    "variables": {
      "notes": [],
      "noteInput": "",
      "savedName": "",
      "messageInput": "",
      "messages": []
    },
    "functions": {
      "loadSavedName": {
        "params": [],
        "logic": [
          {
            "call": "@storage_get",
            "args": {
              "key": "userName"
            },
            "assign": "global.savedName"
          },
          {
            "call": "@print",
            "args": {
              "value": "已从本地读取: {{ global.savedName }}"
            }
          }
        ]
      },
      "saveName": {
        "params": [],
        "logic": [
          {
            "call": "@storage_set",
            "args": {
              "key": "userName",
              "value": "{{ global.savedName }}"
            }
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "已保存到本地: {{ global.savedName }}"
            }
          }
        ]
      },
      "addNote": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.notes",
              "value": {
                "merge": [
                  {
                    "var": "global.notes"
                  },
                  {
                    "var": "global.noteInput"
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.noteInput",
              "value": ""
            }
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "已添加"
            }
          }
        ]
      },
      "deleteNote": {
        "params": [
          "index"
        ],
        "logic": [
          {
            "call": "@list_remove_at",
            "args": {
              "var": "global.notes",
              "index": "{{ params.index }}"
            }
          }
        ]
      },
      "refreshNotes": {
        "params": [],
        "logic": [
          {
            "call": "@show_toast",
            "args": {
              "message": "刷新完成"
            }
          },
          {
            "call": "@print",
            "args": {
              "value": "下拉刷新触发"
            }
          }
        ]
      },
      "sendMessage": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.messages",
              "value": {
                "merge": [
                  {
                    "var": "global.messages"
                  },
                  "{{ global.messageInput }}"
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.messageInput",
              "value": ""
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@print",
      "args": {
        "value": "Super App Demo 启动"
      }
    },
    {
      "call": "@global.loadSavedName",
      "args": {}
    }
  ],
  "ui": {
    "screens": [
      {
        "id": "main",
        "title": "Super App",
        "backgroundColor": "#F5F5F5",
        "tabs": [
          {
            "label": "首页",
            "icon": "home",
            "title": "首页",
            "backgroundColor": "#F8F9FE",
            "padding": 20,
            "children": [
              {
                "type": "text",
                "value": "欢迎回来, {{ global.savedName }}",
                "style": {
                  "fontSize": 22,
                  "fontWeight": "bold"
                }
              },
              {
                "type": "text",
                "value": "这是一个带 Tab 导航的 Super App 骨架",
                "style": {
                  "fontSize": 14,
                  "color": "#888888"
                }
              },
              {
                "type": "spacer",
                "height": 20
              },
              {
                "type": "container",
                "layout": "column",
                "padding": 16,
                "borderRadius": 12,
                "color": "#FFFFFF",
                "elevation": 1,
                "children": [
                  {
                    "type": "text",
                    "value": "本地存储",
                    "style": {
                      "fontSize": 16,
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "type": "input",
                    "placeholder": "输入你的名字...",
                    "bind": "global.savedName",
                    "prefixIcon": "person"
                  },
                  {
                    "type": "container",
                    "layout": "row",
                    "children": [
                      {
                        "type": "button",
                        "label": "保存到本地",
                        "icon": "save",
                        "variant": "filled",
                        "position": {
                          "type": "flex",
                          "flex": 1
                        },
                        "action": {
                          "type": "call",
                          "call": "@global.saveName",
                          "args": {}
                        }
                      },
                      {
                        "type": "button",
                        "label": "从本地读取",
                        "icon": "refresh",
                        "variant": "outlined",
                        "position": {
                          "type": "flex",
                          "flex": 1
                        },
                        "action": {
                          "type": "call",
                          "call": "@global.loadSavedName",
                          "args": {}
                        }
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": "提示: 退出 App 后重新打开，数据仍在",
                    "style": {
                      "fontSize": 12,
                      "color": "#999999"
                    }
                  }
                ]
              }
            ]
          },
          {
            "label": "笔记",
            "icon": "edit",
            "title": "我的笔记",
            "backgroundColor": "#FFFFF0",
            "padding": 16,
            "children": [
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "input",
                    "placeholder": "写点什么...",
                    "bind": "global.noteInput",
                    "position": {
                      "type": "flex",
                      "flex": 3
                    }
                  },
                  {
                    "type": "button",
                    "label": "添加",
                    "icon": "add",
                    "position": {
                      "type": "flex",
                      "flex": 1
                    },
                    "action": {
                      "type": "call",
                      "call": "@global.addNote",
                      "args": {}
                    }
                  }
                ]
              },
              {
                "type": "list",
                "source": "{{ global.notes }}",
                "emptyText": "还没有笔记，写一条吧",
                "onRefresh": {
                  "type": "call",
                  "call": "@global.refreshNotes",
                  "args": {}
                },
                "item_template": {
                  "type": "container",
                  "layout": "row",
                  "padding": 12,
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item }}",
                      "position": {
                        "type": "flex",
                        "flex": 4
                      },
                      "style": {
                        "fontSize": 15,
                        "color": "#333333"
                      }
                    },
                    {
                      "type": "button",
                      "label": "删除",
                      "variant": "text",
                      "icon": "delete",
                      "position": {
                        "type": "flex",
                        "flex": 1
                      },
                      "style": {
                        "textColor": "#FF4444"
                      },
                      "action": {
                        "type": "call",
                        "call": "@global.deleteNote",
                        "args": {
                          "index": "{{ loop.index }}"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "label": "消息",
            "icon": "chat",
            "title": "消息",
            "backgroundColor": "#F0F8FF",
            "padding": 16,
            "children": [
              {
                "type": "list",
                "source": "{{ global.messages }}",
                "emptyText": "暂无消息",
                "item_template": {
                  "type": "container",
                  "layout": "row",
                  "padding": 10,
                  "borderRadius": 8,
                  "color": "#FFFFFF",
                  "margin": 2,
                  "children": [
                    {
                      "type": "text",
                      "value": "{{ loop.item }}",
                      "style": {
                        "fontSize": 14,
                        "color": "#333333"
                      }
                    }
                  ]
                }
              },
              {
                "type": "container",
                "layout": "row",
                "children": [
                  {
                    "type": "input",
                    "placeholder": "输入消息...",
                    "bind": "global.messageInput",
                    "position": {
                      "type": "flex",
                      "flex": 3
                    }
                  },
                  {
                    "type": "button",
                    "label": "发送",
                    "icon": "send",
                    "position": {
                      "type": "flex",
                      "flex": 1
                    },
                    "action": {
                      "type": "call",
                      "call": "@global.sendMessage",
                      "args": {}
                    }
                  }
                ]
              }
            ]
          },
          {
            "label": "我的",
            "icon": "person",
            "title": "个人中心",
            "backgroundColor": "#F8F8F8",
            "padding": 20,
            "children": [
              {
                "type": "container",
                "layout": "column",
                "padding": 24,
                "borderRadius": 16,
                "color": "#FFFFFF",
                "elevation": 1,
                "children": [
                  {
                    "type": "text",
                    "value": "{{ global.savedName }}",
                    "style": {
                      "fontSize": 24,
                      "fontWeight": "bold",
                      "textAlign": "center"
                    }
                  },
                  {
                    "type": "text",
                    "value": "Super App 用户",
                    "style": {
                      "fontSize": 14,
                      "color": "#888888",
                      "textAlign": "center"
                    }
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 16
              },
              {
                "type": "button",
                "label": "清除本地数据",
                "icon": "delete",
                "variant": "outlined",
                "style": {
                  "textColor": "#FF4444"
                },
                "action": {
                  "type": "call",
                  "call": "@storage_clear",
                  "args": {}
                }
              }
            ]
          }
        ]
      }
    ]
  }
}