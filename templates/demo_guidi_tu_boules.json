{
  "dsl": "3.3",
  "appid": "0c1d35d8-b451-5a02-b3c6-7ace87207588",
  "meta": {
    "name": "demo-guidi-tu-boules",
    "displayName": "Guidi Tu Boules",
    "version": "1.1.0",
    "type": "app",
    "description": "JSON-only Boules port with drag projection, wall bounce, damping, jack collision, and distance scoring.",
    "author": "fish"
  },
  "dependencies": {
    "common-ui": "^1.3.0"
  },
  "global": {
    "variables": {
      "score": 0,
      "bestScore": 0,
      "status": "Drag above the bowl and release.",
      "_choice": null
    },
    "functions": {
      "scoreChanged": {
        "params": [
          "score",
          "best"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.bestScore",
              "value": "{{ params.best }}"
            }
          }
        ]
      },
      "status": {
        "params": [
          "text"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "{{ params.text }}"
            }
          }
        ]
      },
      "over": {
        "params": [
          "score",
          "best"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.bestScore",
              "value": "{{ params.best }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "Guidi Tu Boules finished"
            }
          },
          {
            "call": "@common-ui.choose",
            "args": {
              "title": "Guidi Tu Boules finished",
              "message": "Score: {{ params.score }}\nBest: {{ params.best }}",
              "buttons": [
                {
                  "label": "Close",
                  "value": "close",
                  "style": "text"
                },
                {
                  "label": "Restart",
                  "value": "restart"
                }
              ]
            },
            "assign": "global._choice"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "var": "global._choice"
                  },
                  "restart"
                ]
              },
              "then": [
                {
                  "call": "@flame_game_reset",
                  "args": {}
                }
              ]
            }
          }
        ]
      },
      "reset": {
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "Ready"
            }
          }
        ]
      }
    }
  },
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "Guidi Tu Boules",
        "appBar": {
          "title": "Guidi Tu Boules",
          "centerTitle": true,
          "backgroundColor": "#14532D",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {
                "call": "@flame_game_reset",
                "args": {}
              }
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 8,
            "color": "#14532D",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "{{ global.status }}",
                "style": {
                  "fontSize": 13,
                  "color": "#E5E7EB"
                },
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "Score {{ global.score }}",
                "style": {
                  "fontSize": 13,
                  "fontWeight": "bold",
                  "color": "#FFFFFF"
                }
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "viewport": {
                "width": 428,
                "height": 760,
                "fit": "contain"
              },
              "world": {
                "kind": "pixel",
                "bg": "#14532D"
              },
              "overlay": {
                "score": false,
                "game_over": false,
                "asset_loading_text": "Loading Boules assets..."
              },
              "vars": {
                "state": "aim",
                "friction": 0.986,
                "dx": 0,
                "dy": 0,
                "dist2": 0,
                "speed2": 0
              },
              "entities": {
                "jack": {
                  "kind": "sprite",
                  "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-guidi-tu/1.1/images/boules/target.png",
                  "position": [
                    190,
                    118
                  ],
                  "size": [
                    36,
                    36
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "priority": 8,
                  "state": {
                    "assetLoadingOverlay": true
                  }
                },
                "bowl": {
                  "kind": "sprite",
                  "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-guidi-tu/1.1/images/boules/bowl.png",
                  "position": [
                    190,
                    628
                  ],
                  "size": [
                    42,
                    42
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "priority": 12
                },
                "aim": {
                  "kind": "pixel",
                  "position": [
                    185,
                    460
                  ],
                  "size": [
                    52,
                    52
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "priority": 4,
                  "render": {
                    "shape": "circle",
                    "color": "#FFFFFF33"
                  }
                },
                "arrow": {
                  "kind": "pixel",
                  "position": [
                    205,
                    480
                  ],
                  "size": [
                    8,
                    150
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "priority": 3,
                  "render": {
                    "shape": "rect",
                    "color": "#E0F2FE88"
                  }
                }
              },
              "input": {
                "pan": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "==": [
                          {
                            "var": "vars.state"
                          },
                          "aim"
                        ]
                      },
                      "then": [
                        {
                          "call": "@entity.add",
                          "args": {
                            "id": "aim",
                            "field": "x",
                            "by": {
                              "var": "event.dx"
                            },
                            "min": 20,
                            "max": 356
                          }
                        },
                        {
                          "call": "@entity.add",
                          "args": {
                            "id": "aim",
                            "field": "y",
                            "by": {
                              "var": "event.dy"
                            },
                            "min": 60,
                            "max": 650
                          }
                        },
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "arrow",
                            "field": "x",
                            "value": {
                              "var": "entities.aim.x"
                            }
                          }
                        },
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "arrow",
                            "field": "y",
                            "value": {
                              "var": "entities.aim.y"
                            }
                          }
                        }
                      ]
                    }
                  }
                ],
                "swipe": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "==": [
                          {
                            "var": "vars.state"
                          },
                          "aim"
                        ]
                      },
                      "then": [
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "bowl",
                            "field": "vx",
                            "value": {
                              "*": [
                                {
                                  "var": "event.dx"
                                },
                                1.65
                              ]
                            }
                          }
                        },
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "bowl",
                            "field": "vy",
                            "value": {
                              "*": [
                                {
                                  "var": "event.dy"
                                },
                                1.65
                              ]
                            }
                          }
                        },
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "arrow",
                            "field": "render.color",
                            "value": "#FFFFFF00"
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.state",
                            "value": "rolling"
                          }
                        },
                        {
                          "call": "@emit",
                          "args": {
                            "event": "status",
                            "data": {
                              "text": "Rolling"
                            }
                          }
                        }
                      ]
                    }
                  }
                ],
                "tap": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "==": [
                          {
                            "var": "vars.state"
                          },
                          "done"
                        ]
                      },
                      "then": [
                        {
                          "call": "@game_reset",
                          "args": {}
                        }
                      ]
                    }
                  }
                ]
              },
              "frame": {
                "logic": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "==": [
                          {
                            "var": "vars.state"
                          },
                          "rolling"
                        ]
                      },
                      "then": [
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "bowl",
                            "field": "vx",
                            "value": {
                              "*": [
                                {
                                  "var": "entities.bowl.vx"
                                },
                                {
                                  "var": "vars.friction"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "bowl",
                            "field": "vy",
                            "value": {
                              "*": [
                                {
                                  "var": "entities.bowl.vy"
                                },
                                {
                                  "var": "vars.friction"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "entities.bowl.x"
                                },
                                0
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "x",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "vx",
                                  "value": {
                                    "*": [
                                      {
                                        "var": "entities.bowl.vx"
                                      },
                                      -0.72
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">": [
                                {
                                  "var": "entities.bowl.x"
                                },
                                386
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "x",
                                  "value": 386
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "vx",
                                  "value": {
                                    "*": [
                                      {
                                        "var": "entities.bowl.vx"
                                      },
                                      -0.72
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "entities.bowl.y"
                                },
                                0
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "y",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "vy",
                                  "value": {
                                    "*": [
                                      {
                                        "var": "entities.bowl.vy"
                                      },
                                      -0.72
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">": [
                                {
                                  "var": "entities.bowl.y"
                                },
                                718
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "y",
                                  "value": 718
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "vy",
                                  "value": {
                                    "*": [
                                      {
                                        "var": "entities.bowl.vy"
                                      },
                                      -0.72
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "call": "@collide.rect",
                              "args": {
                                "a": "bowl",
                                "b": "jack"
                              }
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "jack",
                                  "field": "vx",
                                  "value": {
                                    "*": [
                                      {
                                        "var": "entities.bowl.vx"
                                      },
                                      0.45
                                    ]
                                  }
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "jack",
                                  "field": "vy",
                                  "value": {
                                    "*": [
                                      {
                                        "var": "entities.bowl.vy"
                                      },
                                      0.45
                                    ]
                                  }
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "jack",
                            "field": "vx",
                            "value": {
                              "*": [
                                {
                                  "var": "entities.jack.vx"
                                },
                                0.965
                              ]
                            }
                          }
                        },
                        {
                          "call": "@entity.set",
                          "args": {
                            "id": "jack",
                            "field": "vy",
                            "value": {
                              "*": [
                                {
                                  "var": "entities.jack.vy"
                                },
                                0.965
                              ]
                            }
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.speed2",
                            "value": {
                              "+": [
                                {
                                  "*": [
                                    {
                                      "var": "entities.bowl.vx"
                                    },
                                    {
                                      "var": "entities.bowl.vx"
                                    }
                                  ]
                                },
                                {
                                  "*": [
                                    {
                                      "var": "entities.bowl.vy"
                                    },
                                    {
                                      "var": "entities.bowl.vy"
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "vars.speed2"
                                },
                                20
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "vx",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "bowl",
                                  "field": "vy",
                                  "value": 0
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.dx",
                                  "value": {
                                    "-": [
                                      {
                                        "+": [
                                          {
                                            "var": "entities.bowl.x"
                                          },
                                          21
                                        ]
                                      },
                                      {
                                        "+": [
                                          {
                                            "var": "entities.jack.x"
                                          },
                                          18
                                        ]
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.dy",
                                  "value": {
                                    "-": [
                                      {
                                        "+": [
                                          {
                                            "var": "entities.bowl.y"
                                          },
                                          21
                                        ]
                                      },
                                      {
                                        "+": [
                                          {
                                            "var": "entities.jack.y"
                                          },
                                          18
                                        ]
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.dist2",
                                  "value": {
                                    "+": [
                                      {
                                        "*": [
                                          {
                                            "var": "vars.dx"
                                          },
                                          {
                                            "var": "vars.dx"
                                          }
                                        ]
                                      },
                                      {
                                        "*": [
                                          {
                                            "var": "vars.dy"
                                          },
                                          {
                                            "var": "vars.dy"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "call": "@score.set",
                                "args": {
                                  "value": {
                                    "max": [
                                      0,
                                      {
                                        "-": [
                                          1000,
                                          {
                                            "*": [
                                              {
                                                "var": "vars.dist2"
                                              },
                                              0.08
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.state",
                                  "value": "done"
                                }
                              },
                              {
                                "call": "@emit",
                                "args": {
                                  "event": "status",
                                  "data": {
                                    "text": "Stopped. Tap field or restart."
                                  }
                                }
                              },
                              {
                                "call": "@game_over",
                                "args": {}
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.scoreChanged",
                "args": {
                  "score": "{{ event.score }}",
                  "best": "{{ event.best }}"
                }
              },
              "on_status": {
                "type": "call",
                "call": "@global.status",
                "args": {
                  "text": "{{ event.text }}"
                }
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.over",
                "args": {
                  "score": "{{ event.score }}",
                  "best": "{{ event.best }}"
                }
              },
              "on_reset": {
                "type": "call",
                "call": "@global.reset",
                "args": {}
              }
            }
          }
        ]
      }
    ]
  },
  "assets": {
    "bundles": {
      "source-guidi-tu": {
        "baseUrl": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-guidi-tu/1.1/",
        "manifest": "manifest.json",
        "license": "CC BY-NC-SA 4.0",
        "startupDownload": true,
        "description": "Guidi Tu Boules LFS assets"
      }
    }
  }
}
