{
  "dsl": "3.3",
  "appid": "f4ef2829-5944-43e3-96c1-9a2dc9dcc983",
  "meta": {
    "name": "camera-demo",
    "version": "1.0.0",
    "type": "app",
    "description": "拍照 Demo — 通过 common-ui 库演示拍照和图片选择功能",
    "author": "2501808198@qq.com"
  },
  "dependencies": {
    "common-ui": "^1.0.0"
  },
  "global": {
    "variables": {
      "photos": [],
      "currentPhoto": "",
      "caption": ""
    },
    "functions": {
      "takeAndSave": {
        "params": [],
        "logic": [
          {
            "call": "@common-ui.takePhoto",
            "args": {
              "bind": "global.currentPhoto"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "!!": [
                  {
                    "var": "global.currentPhoto"
                  }
                ]
              },
              "then": [
                {
                  "call": "@list_add",
                  "args": {
                    "var": "global.photos",
                    "item": {
                      "cat": [
                        {
                          "var": "global.currentPhoto"
                        }
                      ]
                    }
                  }
                },
                {
                  "call": "@common-ui.showSuccess",
                  "args": {
                    "message": "拍照成功！"
                  }
                }
              ]
            }
          }
        ]
      },
      "pickAndSave": {
        "params": [],
        "logic": [
          {
            "call": "@common-ui.pickImage",
            "args": {
              "bind": "global.currentPhoto"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "!!": [
                  {
                    "var": "global.currentPhoto"
                  }
                ]
              },
              "then": [
                {
                  "call": "@list_add",
                  "args": {
                    "var": "global.photos",
                    "item": {
                      "cat": [
                        {
                          "var": "global.currentPhoto"
                        }
                      ]
                    }
                  }
                },
                {
                  "call": "@common-ui.showSuccess",
                  "args": {
                    "message": "选取成功！"
                  }
                }
              ]
            }
          }
        ]
      },
      "clearPhotos": {
        "params": [],
        "logic": [
          {
            "call": "@common-ui.confirm",
            "args": {
              "title": "确认",
              "message": "确定要清空所有照片吗？"
            }
          },
          {
            "call": "@list_clear",
            "args": {
              "var": "global.photos"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.currentPhoto",
              "value": ""
            }
          },
          {
            "call": "@common-ui.showSuccess",
            "args": {
              "message": "已清空"
            }
          }
        ]
      }
    }
  },
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "拍照 Demo",
        "layout": "column",
        "padding": 20,
        "backgroundColor": "#F5F5F5",
        "children": [
          {
            "type": "text",
            "value": "拍照 Demo",
            "style": {
              "fontSize": 26,
              "fontWeight": "bold"
            }
          },
          {
            "type": "spacer",
            "height": 4
          },
          {
            "type": "text",
            "value": "通过 common-ui 库调用拍照和图片选择",
            "style": {
              "fontSize": 14,
              "color": "#888888"
            }
          },
          {
            "type": "spacer",
            "height": 20
          },
          {
            "type": "container",
            "padding": 16,
            "borderRadius": 16,
            "backgroundColor": "#FFFFFF",
            "children": [
              {
                "type": "text",
                "value": "获取照片",
                "style": {
                  "fontSize": 18,
                  "fontWeight": "bold"
                }
              },
              {
                "type": "spacer",
                "height": 12
              },
              {
                "type": "button",
                "text": "拍照",
                "icon": "camera_alt",
                "variant": "filled",
                "action": {
                  "call": "@global.takeAndSave"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "button",
                "text": "从相册选择",
                "icon": "photo_library",
                "variant": "outlined",
                "action": {
                  "call": "@global.pickAndSave"
                }
              }
            ]
          },
          {
            "type": "spacer",
            "height": 20
          },
          {
            "type": "container",
            "padding": 16,
            "borderRadius": 16,
            "backgroundColor": "#FFFFFF",
            "children": [
              {
                "type": "container",
                "layout": "row",
                "mainAxisAlignment": "spaceBetween",
                "crossAxisAlignment": "center",
                "children": [
                  {
                    "type": "text",
                    "value": "已拍摄照片",
                    "style": {
                      "fontSize": 18,
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "type": "button",
                    "text": "清空",
                    "icon": "delete_outline",
                    "variant": "text",
                    "action": {
                      "call": "@global.clearPhotos"
                    }
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 12
              },
              {
                "type": "list",
                "data": "{{ global.photos }}",
                "emptyText": "暂无照片，点击上方按钮拍照或选择",
                "itemBuilder": {
                  "type": "container",
                  "padding": 8,
                  "marginBottom": 12,
                  "borderRadius": 12,
                  "backgroundColor": "#F9F9F9",
                  "children": [
                    {
                      "type": "image",
                      "url": "{{ loop.item }}",
                      "width": "infinity",
                      "height": 220,
                      "fit": "cover",
                      "borderRadius": 10
                    },
                    {
                      "type": "spacer",
                      "height": 6
                    },
                    {
                      "type": "text",
                      "value": "照片 {{ loop.index }}",
                      "style": {
                        "fontSize": 12,
                        "color": "#AAAAAA"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}