{
  "dsl": "3.3",
  "appid": "d5f9e303-ae5c-4e3a-bf8b-7a26e3c8d4fb",
  "meta": {
    "name": "demo-2048",
    "version": "1.2.1",
    "type": "app",
    "description": "2048 — 纯 JSON 实现，最高纪录与历史记录通过 lib_database 持久化",
    "author": "demo"
  },
  "dependencies": {
    "lib_database": "^1.0.0",
    "common-ui": "^1.0.0"
  },
  "global": {
    "variables": {
      "currentScore": 0,
      "bestScore": 0,
      "lastResult": "尚未开始游戏",
      "history": [],
      "historyCount": 0,
      "_b": null,
      "_ts": 0,
      "_date": "",
      "_id": "",
      "_insertResult": null
    },
    "functions": {
      "initDB": {
        "logic": [
          {"call": "@lib_database.createTable", "args": {
            "table": "scores",
            "columns": [
              {"name": "id", "type": "TEXT", "primary": "true"},
              {"name": "score", "type": "INTEGER"},
              {"name": "ts", "type": "INTEGER"},
              {"name": "date", "type": "TEXT"}
            ]
          }}
        ]
      },
      "loadBest": {
        "logic": [
          {"call": "@lib_database.kvGet", "args": {"key": "best_score"}, "assign": "global._b"},
          {"call": "@if", "args": {
            "condition": {"!=": [{"var": "global._b"}, null]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ global._b }}"}}
            ]
          }}
        ]
      },
      "loadHistory": {
        "logic": [
          {"call": "@lib_database.query", "args": {
            "table": "scores",
            "orderBy": "ts DESC",
            "limit": 20
          }, "assign": "global.history"},
          {"call": "@lib_database.count", "args": {"table": "scores"}, "assign": "global.historyCount"}
        ]
      },
      "handleScoreChanged": {
        "params": ["score"],
        "logic": [
          {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
          {"call": "@if", "args": {
            "condition": {">": [{"var": "params.score"}, {"var": "global.bestScore"}]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.score }}"}}
            ]
          }}
        ]
      },
      "handleGameOver": {
        "params": ["score"],
        "logic": [
          {"call": "@common-ui.showSuccess", "args": {"message": "GameOver 触发: {{ params.score }} 分"}},
          {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
          {"call": "@if", "args": {
            "condition": {">": [{"var": "params.score"}, {"var": "global.bestScore"}]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.score }}"}}
            ]
          }},
          {"call": "@lib_database.kvSet", "args": {"key": "best_score", "value": "{{ global.bestScore }}"}},
          {"call": "@timestamp", "args": {}, "assign": "global._ts"},
          {"call": "@date_format", "args": {"timestamp": "{{ global._ts }}", "format": "MM-DD HH:mm"}, "assign": "global._date"},
          {"call": "@uuid", "args": {}, "assign": "global._id"},
          {"call": "@lib_database.insert", "args": {
            "table": "scores",
            "data": {
              "id": "{{ global._id }}",
              "score": "{{ params.score }}",
              "ts": "{{ global._ts }}",
              "date": "{{ global._date }}"
            }
          }, "assign": "global._insertResult"},
          {"call": "@common-ui.showSuccess", "args": {"message": "Insert: {{ global._insertResult }}"}},
          {"call": "@global.loadHistory", "args": {}},
          {"call": "@common-ui.showSuccess", "args": {"message": "Load 完成: {{ global.historyCount }} 局"}},
          {"call": "@set", "args": {"var": "global.lastResult", "value": "本局 {{ params.score }} 分 / 最佳 {{ global.bestScore }} 分（共 {{ global.historyCount }} 局）"}}
        ]
      },
      "showHistory": {
        "logic": [
          {"call": "@global.loadHistory", "args": {}},
          {"call": "@show_bottom_sheet", "args": {
            "content": {
              "type": "container",
              "height": 480,
              "layout": "column",
              "crossAxisAlignment": "stretch",
              "children": [
                {
                  "type": "container",
                  "padding": 12,
                  "layout": "row",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "value": "🏆 历史记录",
                      "style": {"fontSize": 18, "fontWeight": "bold"},
                      "position": {"type": "flex", "flex": 1}
                    },
                    {
                      "type": "text",
                      "value": "共 {{ global.historyCount }} 局",
                      "style": {"fontSize": 13, "color": "#888888"}
                    }
                  ]
                },
                {"type": "divider"},
                {
                  "type": "list",
                  "source": "{{ global.history }}",
                  "emptyText": "尚无历史记录 — 玩一局试试",
                  "item_template": {
                    "type": "container",
                    "padding": 12,
                    "layout": "row",
                    "crossAxisAlignment": "center",
                    "children": [
                      {
                        "type": "text",
                        "value": "{{ loop.item.date }}",
                        "style": {"fontSize": 13, "color": "#666666"},
                        "position": {"type": "flex", "flex": 1}
                      },
                      {
                        "type": "text",
                        "value": "{{ loop.item.score }} 分",
                        "style": {"fontSize": 15, "fontWeight": "bold", "color": "#776E65"}
                      }
                    ]
                  }
                }
              ]
            }
          }}
        ]
      }
    }
  },
  "steps": [
    {"call": "@global.initDB", "args": {}},
    {"call": "@global.loadBest", "args": {}},
    {"call": "@global.loadHistory", "args": {}}
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "2048",
        "appBar": {
          "title": "2048",
          "centerTitle": true,
          "backgroundColor": "#776E65",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "history",
              "action": {
                "type": "call",
                "call": "@global.showHistory",
                "args": {}
              }
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 12,
            "color": "#776E65",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "得分：{{ global.currentScore }}",
                "style": {"fontSize": 14, "color": "#FFFFFF", "fontWeight": "bold"},
                "position": {"type": "flex", "flex": 1}
              },
              {
                "type": "text",
                "value": "最佳：{{ global.bestScore }}",
                "style": {"fontSize": 13, "color": "#F0E0CF"}
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {
                "kind": "pixel",
                "bg": "#BBADA0"
              },
              "entities": {
                "board": {
                  "kind": "value_grid",
                  "cols": 4,
                  "rows": 4,
                  "render": {
                    "by_value": {
                      "0":    {"shape": "rect", "color": "#CDC1B4", "padding": 4, "radius": 6},
                      "2":    {"shape": "rect", "color": "#EEE4DA", "padding": 4, "radius": 6, "text": "2",    "text_color": "#776E65", "font_size": 36},
                      "4":    {"shape": "rect", "color": "#EDE0C8", "padding": 4, "radius": 6, "text": "4",    "text_color": "#776E65", "font_size": 36},
                      "8":    {"shape": "rect", "color": "#F2B179", "padding": 4, "radius": 6, "text": "8",    "text_color": "#FFFFFF", "font_size": 36},
                      "16":   {"shape": "rect", "color": "#F59563", "padding": 4, "radius": 6, "text": "16",   "text_color": "#FFFFFF", "font_size": 32},
                      "32":   {"shape": "rect", "color": "#F67C5F", "padding": 4, "radius": 6, "text": "32",   "text_color": "#FFFFFF", "font_size": 32},
                      "64":   {"shape": "rect", "color": "#F65E3B", "padding": 4, "radius": 6, "text": "64",   "text_color": "#FFFFFF", "font_size": 32},
                      "128":  {"shape": "rect", "color": "#EDCF72", "padding": 4, "radius": 6, "text": "128",  "text_color": "#FFFFFF", "font_size": 28},
                      "256":  {"shape": "rect", "color": "#EDCC61", "padding": 4, "radius": 6, "text": "256",  "text_color": "#FFFFFF", "font_size": 28},
                      "512":  {"shape": "rect", "color": "#EDC850", "padding": 4, "radius": 6, "text": "512",  "text_color": "#FFFFFF", "font_size": 28},
                      "1024": {"shape": "rect", "color": "#EDC53F", "padding": 4, "radius": 6, "text": "1024", "text_color": "#FFFFFF", "font_size": 24},
                      "2048": {"shape": "rect", "color": "#EDC22E", "padding": 4, "radius": 6, "text": "2048", "text_color": "#FFFFFF", "font_size": 24}
                    },
                    "default": {"shape": "rect", "color": "#3C3A32", "padding": 4, "radius": 6, "text": "{{ value }}", "text_color": "#F9F6F2", "font_size": 20}
                  }
                }
              },
              "init": {
                "logic": [
                  {"call": "@value_grid.spawn", "args": {"grid": "board"}},
                  {"call": "@value_grid.spawn", "args": {"grid": "board"}}
                ]
              },
              "input": {
                "swipe": [
                  {"call": "@set", "args": {
                    "var": "vars._move",
                    "value": {"call": "@value_grid.slide_merge", "args": {"grid": "board", "direction": "{{ event.direction }}"}}
                  }},
                  {"call": "@if", "args": {
                    "cond": {"var": "vars._move.moved"},
                    "then": [
                      {"call": "@score.add", "args": {"n": {"var": "vars._move.score"}}},
                      {"call": "@value_grid.spawn", "args": {"grid": "board"}},
                      {"call": "@set", "args": {
                        "var": "vars._can_continue",
                        "value": {"call": "@value_grid.can_move", "args": {"grid": "board"}}
                      }},
                      {"call": "@if", "args": {
                        "cond": {"call": "@not", "args": {"value": {"var": "vars._can_continue"}}},
                        "then": [{"call": "@game_over"}]
                      }}
                    ]
                  }}
                ]
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.handleGameOver",
                "args": {"score": "{{ event.score }}"}
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.handleScoreChanged",
                "args": {"score": "{{ event.score }}"}
              }
            }
          },
          {
            "type": "container",
            "padding": 8,
            "color": "#0A0A0A",
            "children": [
              {
                "type": "text",
                "value": "{{ global.lastResult }}",
                "style": {"fontSize": 12, "color": "#888888"}
              }
            ]
          }
        ]
      }
    ]
  }
}
