{
  "dsl": "3.3",
  "appid": "d5f9e303-ae5c-4e3a-bf8b-7a26e3c8d4fb",
  "meta": {
    "name": "demo-2048",
    "version": "1.0.0",
    "type": "app",
    "description": "2048 — 纯 JSON 实现（B 模式 atom 编排，含 value_grid 新原子）",
    "author": "demo"
  },
  "global": {
    "currentScore": 0,
    "bestScore": 0,
    "lastResult": ""
  },
  "functions": {
    "handleGameOver": {
      "params": ["score", "best"],
      "logic": [
        {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
        {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.best }}"}},
        {"call": "@set", "args": {"var": "global.lastResult", "value": "本局 {{ params.score }} 分 / 最佳 {{ params.best }} 分"}}
      ]
    }
  },
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "2048",
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 12,
            "color": "#776E65",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "得分：{{ global.currentScore }}",
                "style": {"fontSize": 14, "color": "#FFFFFF", "fontWeight": "bold"},
                "position": {"type": "flex", "flex": 1}
              },
              {
                "type": "text",
                "value": "最佳：{{ global.bestScore }}",
                "style": {"fontSize": 13, "color": "#F0E0CF"}
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {
                "kind": "pixel",
                "bg": "#BBADA0"
              },
              "entities": {
                "board": {
                  "kind": "value_grid",
                  "cols": 4,
                  "rows": 4,
                  "render": {
                    "by_value": {
                      "0":    {"shape": "rect", "color": "#CDC1B4", "padding": 4, "radius": 6},
                      "2":    {"shape": "rect", "color": "#EEE4DA", "padding": 4, "radius": 6, "text": "2",    "text_color": "#776E65", "font_size": 36},
                      "4":    {"shape": "rect", "color": "#EDE0C8", "padding": 4, "radius": 6, "text": "4",    "text_color": "#776E65", "font_size": 36},
                      "8":    {"shape": "rect", "color": "#F2B179", "padding": 4, "radius": 6, "text": "8",    "text_color": "#FFFFFF", "font_size": 36},
                      "16":   {"shape": "rect", "color": "#F59563", "padding": 4, "radius": 6, "text": "16",   "text_color": "#FFFFFF", "font_size": 32},
                      "32":   {"shape": "rect", "color": "#F67C5F", "padding": 4, "radius": 6, "text": "32",   "text_color": "#FFFFFF", "font_size": 32},
                      "64":   {"shape": "rect", "color": "#F65E3B", "padding": 4, "radius": 6, "text": "64",   "text_color": "#FFFFFF", "font_size": 32},
                      "128":  {"shape": "rect", "color": "#EDCF72", "padding": 4, "radius": 6, "text": "128",  "text_color": "#FFFFFF", "font_size": 28},
                      "256":  {"shape": "rect", "color": "#EDCC61", "padding": 4, "radius": 6, "text": "256",  "text_color": "#FFFFFF", "font_size": 28},
                      "512":  {"shape": "rect", "color": "#EDC850", "padding": 4, "radius": 6, "text": "512",  "text_color": "#FFFFFF", "font_size": 28},
                      "1024": {"shape": "rect", "color": "#EDC53F", "padding": 4, "radius": 6, "text": "1024", "text_color": "#FFFFFF", "font_size": 24},
                      "2048": {"shape": "rect", "color": "#EDC22E", "padding": 4, "radius": 6, "text": "2048", "text_color": "#FFFFFF", "font_size": 24}
                    },
                    "default": {"shape": "rect", "color": "#3C3A32", "padding": 4, "radius": 6, "text": "{{ value }}", "text_color": "#F9F6F2", "font_size": 20}
                  }
                }
              },
              "init": {
                "logic": [
                  {"call": "@value_grid.spawn", "args": {"grid": "board"}},
                  {"call": "@value_grid.spawn", "args": {"grid": "board"}}
                ]
              },
              "input": {
                "swipe": [
                  {"call": "@set", "args": {
                    "var": "vars._move",
                    "value": {"call": "@value_grid.slide_merge", "args": {"grid": "board", "direction": "{{ event.direction }}"}}
                  }},
                  {"call": "@if", "args": {
                    "cond": {"var": "vars._move.moved"},
                    "then": [
                      {"call": "@score.add", "args": {"n": {"var": "vars._move.score"}}},
                      {"call": "@value_grid.spawn", "args": {"grid": "board"}},
                      {"call": "@set", "args": {
                        "var": "vars._can_continue",
                        "value": {"call": "@value_grid.can_move", "args": {"grid": "board"}}
                      }},
                      {"call": "@if", "args": {
                        "cond": {"call": "@not", "args": {"value": {"var": "vars._can_continue"}}},
                        "then": [{"call": "@game_over"}]
                      }}
                    ]
                  }}
                ]
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.handleGameOver",
                "args": {"score": "{{ event.score }}", "best": "{{ event.best }}"}
              },
              "on_score_changed": {
                "type": "call",
                "call": "@set",
                "args": {"var": "global.currentScore", "value": "{{ event.score }}"}
              }
            }
          },
          {
            "type": "container",
            "padding": 8,
            "color": "#0A0A0A",
            "children": [
              {
                "type": "text",
                "value": "{{ global.lastResult }}",
                "style": {"fontSize": 12, "color": "#888888"}
              }
            ]
          }
        ]
      }
    ]
  }
}
