{
  "dsl": "3.3",
  "meta": {
    "name": "demo-user-profile",
    "version": "2.2.0",
    "type": "app",
    "description": "用户资料演示",
    "author": "demo"
  },
  "dependencies": {
    "lib_user": "^1.0.0"
  },
  "global": {
    "variables": {
      "userInfo": null,
      "avatarUrl": "",
      "userName": "",
      "userEmail": "",
      "authToken": "",
      "isLoggedIn": false,
      "statusText": "加载中..."
    },
    "functions": {
      "loadAll": {
        "params": [],
        "logic": [
          {
            "call": "@lib_user.checkLogin",
            "args": {
              "bind": "global.isLoggedIn"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "var": "global.isLoggedIn"
              },
              "then": [
                {
                  "call": "@lib_user.loadUserInfo",
                  "args": {
                    "bind": "global.userInfo"
                  }
                },
                {
                  "call": "@lib_user.getUserAvatar",
                  "args": {
                    "bind": "global.avatarUrl"
                  }
                },
                {
                  "call": "@lib_user.getUserName",
                  "args": {
                    "bind": "global.userName"
                  }
                },
                {
                  "call": "@lib_user.getUserEmail",
                  "args": {
                    "bind": "global.userEmail"
                  }
                },
                {
                  "call": "@set",
                  "args": {
                    "var": "global.statusText",
                    "value": "已登录"
                  }
                }
              ],
              "else": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.statusText",
                    "value": "未登录"
                  }
                }
              ]
            }
          }
        ]
      },
      "refreshInfo": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.statusText",
              "value": "刷新中..."
            }
          },
          {
            "call": "@global.loadAll",
            "args": {}
          },
          {
            "call": "@show_toast",
            "args": {
              "message": "已刷新"
            }
          }
        ]
      },
      "showToken": {
        "params": [],
        "logic": [
          {
            "call": "@lib_user.getAuthToken",
            "args": {
              "bind": "global.authToken"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "!!": [
                  {
                    "var": "global.authToken"
                  }
                ]
              },
              "then": [
                {
                  "call": "@show_dialog",
                  "args": {
                    "title": "Access Token",
                    "message": "{{ global.authToken }}"
                  }
                }
              ],
              "else": [
                {
                  "call": "@show_toast",
                  "args": {
                    "message": "无 Token"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "steps": [
    {
      "call": "@global.loadAll",
      "args": {}
    }
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "用户资料",
        "layout": "column",
        "padding": 20,
        "children": [
          {
            "type": "container",
            "layout": "column",
            "crossAxisAlignment": "center",
            "color": "#F0F4FF",
            "borderRadius": 16,
            "padding": 20,
            "children": [
              {
                "type": "image",
                "url": "{{ global.avatarUrl }}",
                "width": 72,
                "height": 72,
                "borderRadius": 36
              },
              {
                "type": "spacer",
                "height": 12
              },
              {
                "type": "text",
                "value": "{{ global.userName }}",
                "style": {
                  "fontSize": 20,
                  "fontWeight": "bold"
                }
              },
              {
                "type": "spacer",
                "height": 4
              },
              {
                "type": "text",
                "value": "{{ global.userEmail }}",
                "style": {
                  "fontSize": 14,
                  "color": "#666666"
                }
              }
            ]
          },
          {
            "type": "spacer",
            "height": 16
          },
          {
            "type": "container",
            "layout": "column",
            "color": "#FFFFFF",
            "borderRadius": 12,
            "padding": 16,
            "children": [
              {
                "type": "text",
                "value": "登录状态",
                "style": {
                  "fontSize": 12,
                  "color": "#999999"
                }
              },
              {
                "type": "spacer",
                "height": 2
              },
              {
                "type": "text",
                "value": "{{ global.statusText }}",
                "style": {
                  "fontSize": 15,
                  "fontWeight": "bold"
                }
              },
              {
                "type": "divider"
              },
              {
                "type": "text",
                "value": "用户 ID",
                "style": {
                  "fontSize": 12,
                  "color": "#999999"
                }
              },
              {
                "type": "spacer",
                "height": 2
              },
              {
                "type": "text",
                "value": "{{ global.userInfo.id }}",
                "style": {
                  "fontSize": 13,
                  "color": "#333333"
                }
              }
            ]
          },
          {
            "type": "spacer",
            "height": 20
          },
          {
            "type": "button",
            "label": "刷新信息",
            "variant": "filled",
            "icon": "refresh",
            "action": {
              "type": "call",
              "call": "@global.refreshInfo",
              "args": {}
            }
          },
          {
            "type": "spacer",
            "height": 10
          },
          {
            "type": "button",
            "label": "查看 Token",
            "variant": "outlined",
            "icon": "key",
            "action": {
              "type": "call",
              "call": "@global.showToken",
              "args": {}
            }
          }
        ]
      }
    ]
  }
}