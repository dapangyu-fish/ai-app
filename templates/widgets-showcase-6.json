{
  "dsl": "3.3",
  "appid": "847d798f-0ea7-45b0-a3fc-d2c05b9ec5f1",
  "meta": {
    "name": "widgets-showcase-6",
    "version": "1.0.0",
    "type": "app",
    "description": "第六批 Widget 演示 — inkwell / gesture_detector / dismissible / draggable / refresh",
    "author": "2501808198@qq.com"
  },
  "dependencies": {
    "common-ui": "^1.2.0"
  },
  "global": {
    "variables": {
      "swipeCount": 0,
      "tapLog": "(尚未操作)",
      "items": [
        { "id": "i1", "name": "可滑动删除项 1" },
        { "id": "i2", "name": "可滑动删除项 2" },
        { "id": "i3", "name": "可滑动删除项 3" },
        { "id": "i4", "name": "可滑动删除项 4" }
      ],
      "refreshSeed": 0
    },
    "functions": {
      "logAction": {
        "params": ["text"],
        "logic": [
          {
            "call": "@set",
            "args": { "var": "global.tapLog", "value": "{{ params.text }}" }
          }
        ]
      },
      "swipe": {
        "params": ["direction"],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.swipeCount",
              "value": { "+": [{ "var": "global.swipeCount" }, 1] }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.tapLog",
              "value": "swipe: {{ params.direction }}（共 {{ global.swipeCount }} 次）"
            }
          }
        ]
      },
      "removeAt": {
        "params": ["i"],
        "logic": [
          {
            "call": "@list_remove_at",
            "args": { "var": "global.items", "index": "{{ params.i }}" }
          },
          {
            "call": "@common-ui.showInfo",
            "args": { "message": "已删除第 {{ params.i }} 项" }
          }
        ]
      },
      "doRefresh": {
        "params": [],
        "logic": [
          { "call": "@delay", "args": { "ms": 1000 } },
          {
            "call": "@set",
            "args": {
              "var": "global.refreshSeed",
              "value": { "+": [{ "var": "global.refreshSeed" }, 1] }
            }
          },
          {
            "call": "@common-ui.showSuccess",
            "args": { "message": "刷新完成（第 {{ global.refreshSeed }} 次）" }
          }
        ]
      }
    }
  },
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "Widgets Showcase 6",
        "layout": "column",
        "padding": 12,
        "backgroundColor": "#F4F6FB",
        "scrollable": true,
        "children": [
          {
            "type": "text",
            "value": "第六批 — 交互",
            "style": { "fontSize": 26, "fontWeight": "bold", "paddingH": 12, "paddingV": 8 }
          },

          {
            "type": "card",
            "padding": 12,
            "margin": 12,
            "children": [
              { "type": "text", "value": "操作日志", "style": { "fontSize": 13, "color": "#888888" } },
              { "type": "text", "value": "{{ global.tapLog }}", "style": { "fontSize": 14, "fontWeight": "bold", "color": "#34495E" } }
            ]
          },

          {
            "type": "card",
            "padding": 12,
            "margin": 12,
            "children": [
              { "type": "text", "value": "1. InkWell — 水波纹点击", "style": { "fontSize": 17, "fontWeight": "bold" } },
              { "type": "spacer", "height": 8 },
              {
                "type": "inkwell",
                "borderRadius": 12,
                "splashColor": "#FFEAA7",
                "onTap": { "type": "call", "call": "@global.logAction", "args": { "text": "tap (inkwell)" } },
                "onLongPress": { "type": "call", "call": "@global.logAction", "args": { "text": "long press (inkwell)" } },
                "onDoubleTap": { "type": "call", "call": "@global.logAction", "args": { "text": "double tap (inkwell)" } },
                "child": {
                  "type": "container",
                  "color": "#FAB1A0",
                  "padding": 24,
                  "borderRadius": 12,
                  "children": [
                    { "type": "text", "value": "试试单击 / 双击 / 长按", "style": { "textAlign": "center", "fontSize": 14, "fontWeight": "bold" } }
                  ]
                }
              }
            ]
          },

          {
            "type": "card",
            "padding": 12,
            "margin": 12,
            "children": [
              { "type": "text", "value": "2. GestureDetector — 手势识别", "style": { "fontSize": 17, "fontWeight": "bold" } },
              { "type": "spacer", "height": 8 },
              {
                "type": "gesture_detector",
                "onSwipeLeft":  { "type": "call", "call": "@global.swipe", "args": { "direction": "left" } },
                "onSwipeRight": { "type": "call", "call": "@global.swipe", "args": { "direction": "right" } },
                "onSwipeUp":    { "type": "call", "call": "@global.swipe", "args": { "direction": "up" } },
                "onSwipeDown":  { "type": "call", "call": "@global.swipe", "args": { "direction": "down" } },
                "child": {
                  "type": "container",
                  "color": "#A29BFE",
                  "padding": 32,
                  "borderRadius": 12,
                  "children": [
                    { "type": "text", "value": "↕↔ 在我身上滑动", "style": { "textAlign": "center", "fontSize": 14, "fontWeight": "bold", "color": "#FFFFFF" } }
                  ]
                }
              }
            ]
          },

          {
            "type": "card",
            "padding": 12,
            "margin": 12,
            "children": [
              { "type": "text", "value": "3. Dismissible — 滑动删除", "style": { "fontSize": 17, "fontWeight": "bold" } },
              { "type": "text", "value": "← 向左滑动需要确认弹窗", "style": { "fontSize": 12, "color": "#888888" } },
              { "type": "spacer", "height": 8 },
              {
                "type": "list",
                "source": "{{ global.items }}",
                "item_template": {
                  "type": "dismissible",
                  "key": "{{ loop.item.id }}",
                  "direction": "rightToLeft",
                  "confirmAction": { "type": "call", "call": "@common-ui.confirmDelete", "args": { "itemName": "{{ loop.item.name }}" } },
                  "onDismissed": { "type": "call", "call": "@global.removeAt", "args": { "i": "{{ loop.index }}" } },
                  "child": {
                    "type": "container",
                    "padding": 16,
                    "color": "#FFFFFF",
                    "children": [
                      { "type": "text", "value": "{{ loop.item.name }}", "style": { "fontSize": 15 } }
                    ]
                  }
                }
              }
            ]
          },

          {
            "type": "card",
            "padding": 12,
            "margin": 12,
            "children": [
              { "type": "text", "value": "4. Draggable — 可拖拽", "style": { "fontSize": 17, "fontWeight": "bold" } },
              { "type": "text", "value": "（按住拖动，松手会触发 onDragCompleted）", "style": { "fontSize": 12, "color": "#888888" } },
              { "type": "spacer", "height": 8 },
              {
                "type": "draggable",
                "data": "demo",
                "onDragStarted":   { "type": "call", "call": "@global.logAction", "args": { "text": "drag started" } },
                "onDragCompleted": { "type": "call", "call": "@global.logAction", "args": { "text": "drag completed" } },
                "onDragCanceled":  { "type": "call", "call": "@global.logAction", "args": { "text": "drag canceled" } },
                "feedback": {
                  "type": "container",
                  "color": "#74B9FF",
                  "padding": 16,
                  "borderRadius": 8,
                  "children": [
                    { "type": "icon", "name": "expand", "size": 24, "color": "#FFFFFF" }
                  ]
                },
                "child": {
                  "type": "container",
                  "color": "#74B9FF",
                  "padding": 16,
                  "borderRadius": 8,
                  "children": [
                    { "type": "icon", "name": "expand", "size": 24, "color": "#FFFFFF" },
                    { "type": "spacer", "width": 8 },
                    { "type": "text", "value": "拖我", "style": { "color": "#FFFFFF", "fontWeight": "bold" } }
                  ],
                  "layout": "row"
                }
              }
            ]
          },

          {
            "type": "card",
            "padding": 12,
            "margin": 12,
            "children": [
              { "type": "text", "value": "5. Refresh — 下拉刷新", "style": { "fontSize": 17, "fontWeight": "bold" } },
              { "type": "text", "value": "刷新次数：{{ global.refreshSeed }}", "style": { "fontSize": 13, "color": "#888888" } },
              { "type": "spacer", "height": 8 },
              { "type": "text", "value": "→ 下拉刷新已直接挂在 list 上更常见，本卡片演示包裹 list 的写法", "style": { "fontSize": 12, "color": "#888888" } }
            ]
          },

          { "type": "spacer", "height": 24 }
        ]
      }
    ]
  },
  "steps": [
    { "call": "@print", "args": { "value": "[widgets-showcase-6] booted" } }
  ]
}
