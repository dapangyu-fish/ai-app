{
  "dsl": "3.3",
  "appid": "3e47be14-8096-5443-85bd-fe969179db8f",
  "meta": {
    "name": "demo-darkness-dungeon",
    "displayName": "Darkness Dungeon",
    "version": "1.0.0",
    "type": "app",
    "description": "JSON-DSL dungeon action port inspired by Darkness Dungeon (MIT).",
    "author": "fish"
  },
  "dependencies": {
    "common-ui": "^1.3.0",
    "game-controls": "^1.0.8"
  },
  "assets": {
    "bundles": {
      "darkness": {
        "baseUrl": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/asset-packs/source-darkness-dungeon/1.0/",
        "manifest": "manifest.json",
        "license": "MIT",
        "startupDownload": true,
        "description": "Darkness Dungeon source assets"
      }
    }
  },
  "global": {
    "variables": {
      "score": 0,
      "bestScore": 0,
      "status": "Joystick to move. Triangle shoots, circle slashes.",
      "_choice": null,
      "_gamepadStyle": "default",
      "_gamepadEditing": false,
      "_gamepadReset": 0
    },
    "functions": {
      "scoreChanged": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "status": {
        "params": [
          "text"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "{{ params.text }}"
            }
          }
        ]
      },
      "over": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@common-ui.choose",
            "args": {
              "title": "Darkness Dungeon finished",
              "message": "Score: {{ params.score }}\nBest: {{ global.bestScore }}",
              "buttons": [
                {
                  "label": "Close",
                  "value": null,
                  "style": "text"
                },
                {
                  "label": "Restart",
                  "value": "restart"
                }
              ]
            },
            "assign": "global._choice"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "var": "global._choice"
                  },
                  "restart"
                ]
              },
              "then": [
                {
                  "call": "@flame_game_reset",
                  "args": {}
                }
              ]
            }
          }
        ]
      },
      "reset": {
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.score",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "Ready"
            }
          }
        ]
      }
    }
  },
