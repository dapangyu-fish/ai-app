                      "field": "x",
                      "by": 0,
                      "min": 24,
                      "max": 740
                    }
                  },
                  {
                    "call": "@entity.add",
                    "args": {
                      "id": "player",
                      "field": "y",
                      "by": 0,
                      "min": 24,
                      "max": 740
                    }
                  },
                  {
                    "call": "@for_each_entity",
                    "args": {
                      "where_prefix": "enemy_",
                      "do": [
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "loop.entity.x"
                                },
                                {
                                  "-": [
                                    {
                                      "var": "entities.player.x"
                                    },
                                    12
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "vx",
                                  "value": 54
                                }
                              }
                            ],
                            "else": [
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    ">": [
                                      {
                                        "var": "loop.entity.x"
                                      },
                                      {
                                        "+": [
                                          {
                                            "var": "entities.player.x"
                                          },
                                          12
                                        ]
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@entity.set",
                                      "args": {
                                        "id": "{{ loop.id }}",
                                        "field": "vx",
                                        "value": -54
                                      }
                                    }
                                  ],
                                  "else": [
                                    {
                                      "call": "@entity.set",
                                      "args": {
                                        "id": "{{ loop.id }}",
                                        "field": "vx",
                                        "value": 0
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<": [
                                {
                                  "var": "loop.entity.y"
                                },
                                {
                                  "-": [
                                    {
                                      "var": "entities.player.y"
                                    },
                                    12
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "vy",
                                  "value": 54
                                }
                              }
                            ],
                            "else": [
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    ">": [
                                      {
                                        "var": "loop.entity.y"
                                      },
                                      {
                                        "+": [
                                          {
                                            "var": "entities.player.y"
                                          },
                                          12
                                        ]
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@entity.set",
                                      "args": {
                                        "id": "{{ loop.id }}",
                                        "field": "vy",
                                        "value": -54
                                      }
                                    }
                                  ],
                                  "else": [
                                    {
                                      "call": "@entity.set",
                                      "args": {
                                        "id": "{{ loop.id }}",
                                        "field": "vy",
                                        "value": 0
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@entity.flip_by_velocity",
                          "args": {
                            "id": "{{ loop.id }}",
                            "invert": true
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@collision.first",
                    "args": {
                      "a": "player",
                      "where_prefix": "key"
                    },
                    "assign": "vars._hit"
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!=": [
                          {
                            "var": "vars._hit"
                          },
                          null
                        ]
                      },
                      "then": [
                        {
                          "call": "@despawn",
                          "args": {
                            "id": "key"
                          }
                        },
                        {
                          "call": "@emit",
                          "args": {
                            "event": "status",
                            "data": {
                              "text": "Silver key found"
                            }
                          }
                        },
                        {
                          "call": "@score.add",
                          "args": {
                            "n": 100
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@collision.first",
                    "args": {
                      "a": "player",
                      "where_prefix": "potion"
                    },
                    "assign": "vars._hit"
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!=": [
                          {
                            "var": "vars._hit"
                          },
                          null
                        ]
                      },
                      "then": [
                        {
                          "call": "@despawn",
                          "args": {
                            "id": "potion"
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.hp",
                            "value": 200
                          }
                        },
                        {
                          "call": "@emit",
                          "args": {
                            "event": "status",
                            "data": {
                              "text": "Life restored"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@for_each_entity",
                    "args": {
                      "where_prefix": "bolt_",
                      "do": [
                        {
                          "call": "@collision.first",
                          "args": {
                            "a": "{{ loop.id }}",
                            "where_prefix": "enemy_"
                          },
                          "assign": "vars._hit"
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "!=": [
                                {
                                  "var": "vars._hit"
                                },
                                null
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ loop.id }}"
                                }
                              },
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ vars._hit }}"
                                }
                              },
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 150
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "or": [
                                {
                                  "<": [
                                    {
                                      "var": "loop.entity.x"
                                    },
                                    -100
                                  ]
                                },
                                {
                                  ">": [
                                    {
                                      "var": "loop.entity.x"
                                    },
                                    900
                                  ]
                                },
                                {
                                  "<": [
                                    {
                                      "var": "loop.entity.y"
                                    },
                                    -100
                                  ]
                                },
                                {
                                  ">": [
                                    {
                                      "var": "loop.entity.y"
                                    },
                                    900
                                  ]
                                }
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ loop.id }}"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "call": "@entity.exists",
                        "args": {
                          "id": "slash"
                        }
                      },
                      "then": [
                        {
                          "call": "@collision.first",
                          "args": {
                            "a": "slash",
                            "where_prefix": "enemy_"
                          },
                          "assign": "vars._hit"
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "!=": [
                                {
                                  "var": "vars._hit"
                                },
                                null
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "{{ vars._hit }}"
                                }
                              },
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 120
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@entity.add",
                          "args": {
                            "id": "slash",
                            "field": "state.ttl",
                            "by": {
                              "-": [
                                0,
                                {
                                  "var": "event.dt"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "<=": [
                                {
                                  "var": "entities.slash.state.ttl"
                                },
                                0
                              ]
                            },
                            "then": [
                              {
                                "call": "@despawn",
                                "args": {
                                  "id": "slash"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@collision.first",
                    "args": {
                      "a": "player",
                      "where_prefix": "enemy_"
                    },
                    "assign": "vars._hit"
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "and": [
                          {
                            "!=": [
                              {
                                "var": "vars._hit"
                              },
                              null
                            ]
                          },
                          {
                            "<=": [
                              {
                                "var": "vars.hurt_cd"
                              },
                              0
                            ]
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.hurt_cd",
                            "value": 0.8
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.hp",
                            "value": {
                              "-": [
                                {
                                  "var": "vars.hp"
                                },
                                20
                              ]
                            }
                          }
                        },
                        {
                          "call": "@emit",
                          "args": {
                            "event": "status",
                            "data": {
                              "text": "HP {{ vars.hp }}"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "<=": [
                          {
                            "var": "vars.hp"
                          },
                          0
                        ]
                      },
                      "then": [
                        {
                          "call": "@game_over",
                          "args": {}
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "and": [
                          {
                            "!": {
                              "call": "@entity.exists",
                              "args": {
                                "id": "enemy_goblin"
                              }
                            }
                          },
                          {
                            "!": {
                              "call": "@entity.exists",
                              "args": {
                                "id": "enemy_imp"
                              }
                            }
                          },
                          {
                            "!": {
                              "call": "@entity.exists",
                              "args": {
                                "id": "enemy_boss"
                              }
                            }
                          }
                        ]
                      },
                      "then": [
                        {
                          "call": "@score.add",
                          "args": {
                            "n": 500
                          }
                        },
                        {
                          "call": "@game_over",
                          "args": {}
                        }
                      ]
                    }
                  }
                ]
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.scoreChanged",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_status": {
                "type": "call",
                "call": "@global.status",
                "args": {
                  "text": "{{ event.text }}"
                }
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.over",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_reset": {
                "type": "call",
                "call": "@global.reset",
                "args": {}
              }
            }
          },
          {
            "type": "ref",
            "from": "game-controls",
            "widget": "psJoystickGamepad",
            "props": {
              "moveInput": "move_axis",
              "moveEndInput": "move_axis",
              "jumpInput": "jump",
              "attackInput": "attack",
              "height": 176,
              "backgroundColor": "#111827"
            }
          }
        ]
      }
    ]
  }
}
