        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.flight",
              "value": {
                "%": [
                  {
                    "+": [
                      {
                        "var": "global.flight"
                      },
                      1
                    ]
                  },
                  20
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.wing",
              "value": {
                "if": [
                  {
                    ">": [
                      {
                        "var": "global.flight"
                      },
                      10
                    ]
                  },
                  -18,
                  18
                ]
              }
            }
          }
        ]
      }
    }
