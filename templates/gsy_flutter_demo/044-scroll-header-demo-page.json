  "dependencies": {},
  "global": {
    "variables": {
      "upstreamTitle": "强大的自定义滑动与停靠结合展示",
      "upstreamSource": "lib/widget/scroll/custom_sliver/scroll_header_demo_page.dart",
      "upstreamWidget": "ScrollHeaderDemoPage",
      "portStatus": "ported_json",
      "portVersion": "json-dsl-primitives-v2",
      "pinned": true,
      "initHeight": 70,
      "pinnedLabel": "pinned",
      "heightLabel": "minHeight",
      "autoBackLabel": "non autoBack",
      "pullTall": false
    },
    "functions": {
      "togglePinned": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.pinned",
              "value": {
                "!": {
                  "var": "global.pinned"
                }
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.pinnedLabel",
              "value": {
                "if": [
                  {
                    "var": "global.pinned"
                  },
                  "pinned",
                  "scroll"
                ]
              }
            }
          }
        ]
      },
      "toggleHeight": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.initHeight",
              "value": {
                "if": [
                  {
                    ">": [
                      {
                        "var": "global.initHeight"
                      },
                      0
                    ]
                  },
                  0,
                  70
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.heightLabel",
              "value": {
                "if": [
                  {
                    ">": [
                      {
                        "var": "global.initHeight"
                      },
                      0
                    ]
                  },
                  "minHeight",
                  "non Height"
                ]
              }
            }
          }
        ]
      },
      "toggleAutoBack": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.pullTall",
              "value": {
                "!": {
                  "var": "global.pullTall"
                }
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.autoBackLabel",
              "value": {
                "if": [
                  {
                    "var": "global.pullTall"
                  },
                  "autoBack",
                  "non autoBack"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
