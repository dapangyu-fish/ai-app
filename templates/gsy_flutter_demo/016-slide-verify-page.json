    "functions": {
      "verify": {
        "params": [],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                ">=": [
                  {
                    "var": "global.value"
                  },
                  95
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.verified",
                    "value": true
                  }
                },
                {
                  "call": "@show_snackbar",
                  "args": {
                    "message": "验证成功"
                  }
                }
              ],
              "else": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.verified",
                    "value": false
                  }
                },
                {
                  "call": "@show_snackbar",
                  "args": {
                    "message": "继续向右滑动"
                  }
                }
              ]
            }
          }
        ]
      }
    }
