    "description": "gsy_flutter_demo JSON 移植子示例（纯 JSON DSL）：3D 透视卡片",
    "author": "fish",
    "upstream": {
      "repository": "https://github.com/CarGuo/gsy_flutter_demo",
      "routeTitle": "3D 透视卡片",
      "sourcePath": "lib/widget/visual/card_perspective_demo_page.dart",
      "deferredAlias": "card_perspective_demo_page",
      "widgetClass": "CardPerspectiveDemoPage",
      "category": "visual",
      "routeIndex": 81,
      "portStatus": "ported_json",
      "portVersion": "json-dsl-primitives-v4"
    }
  },
  "dependencies": {},
  "global": {
    "variables": {
      "upstreamTitle": "3D 透视卡片",
      "upstreamSource": "lib/widget/visual/card_perspective_demo_page.dart",
      "upstreamWidget": "CardPerspectiveDemoPage",
      "portStatus": "ported_json",
      "portVersion": "json-dsl-primitives-v4",
      "touchX": 0,
      "touchY": 0,
      "startTransform": false
    },
    "functions": {
      "updatePerspective": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.startTransform",
              "value": true
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.touchX",
              "value": {
                "/": [
                  {
                    "-": [
                      150,
                      {
                        "var": "event.localX"
                      }
                    ]
                  },
                  6
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.touchY",
              "value": {
                "/": [
                  {
                    "-": [
                      {
                        "var": "event.localY"
                      },
                      200
                    ]
                  },
                  8
                ]
              }
            }
          }
        ]
      },
      "resetPerspective": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.startTransform",
              "value": false
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.touchX",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.touchY",
              "value": 0
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "CardPerspectiveDemoPage",
        "layout": "stack",
        "backgroundColor": "#FFFFFF",
        "children": [
          {
            "type": "positioned",
            "child": {
              "type": "container",
              "children": [
                {
                  "type": "gesture_detector",
                  "onPanUpdate": {
                    "call": "@global.updatePerspective",
                    "args": {}
                  },
                  "onPanEnd": {
                    "call": "@global.resetPerspective",
                    "args": {}
                  },
                  "onPanCancel": {
                    "call": "@global.resetPerspective",
                    "args": {}
                  },
                  "onTapUp": {
                    "call": "@global.resetPerspective",
                    "args": {}
                  },
                  "child": {
                    "type": "transform",
                    "perspective": 0.001,
                    "rotateX": "{{ global.touchY }}",
                    "rotateY": "{{ global.touchX }}",
                    "child": {
                      "type": "container",
                      "children": [
                        {
                          "type": "transform",
                          "translateX": {
                            "*": [
                              {
                                "var": "global.touchX"
                              },
                              1.1
                            ]
                          },
                          "translateY": {
                            "*": [
                              {
                                "var": "global.touchY"
