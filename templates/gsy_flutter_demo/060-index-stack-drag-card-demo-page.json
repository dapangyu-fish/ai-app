    "functions": {
      "dismissTop": {
        "params": [],
        "logic": [
          {
            "call": "@list_remove_at",
            "args": {
              "var": "global.cards",
              "index": 0
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "length": [
                      {
                        "var": "global.cards"
                      }
                    ]
                  },
                  0
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.cards",
                    "value": "{{ global.initialCards }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "dismissByDrag": {
        "params": [
          "idx"
        ],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "or": [
                  {
                    ">": [
                      {
                        "abs": [
                          {
                            "var": "event.offsetX"
                          }
                        ]
                      },
                      195
                    ]
                  },
                  {
                    "<": [
                      {
                        "var": "event.offsetX"
                      },
                      -97
                    ]
                  },
                  {
                    ">": [
                      {
                        "abs": [
                          {
                            "var": "event.offsetY"
                          }
                        ]
                      },
                      422
                    ]
                  }
                ]
              },
              "then": [
                {
                  "call": "@list_remove_at",
                  "args": {
                    "var": "global.cards",
                    "index": {
                      "var": "params.idx"
                    }
                  }
                },
                {
                  "call": "@if",
                  "args": {
                    "condition": {
                      "==": [
                        {
                          "length": [
                            {
                              "var": "global.cards"
                            }
                          ]
                        },
                        0
                      ]
                    },
                    "then": [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.cards",
                          "value": {
                            "var": "global.initialCards"
                          }
                        }
                      }
                    ],
                    "else": []
                  }
                }
              ],
              "else": []
            }
          }
        ]
      }
    }
