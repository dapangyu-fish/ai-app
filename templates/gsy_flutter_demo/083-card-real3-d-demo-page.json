{
  "dsl": "3.3",
  "appid": "dbc7b48a-7734-5ada-aa23-aceb62a05d0a",
  "meta": {
    "name": "gsy_flutter_demo/083-card-real3-d-demo-page",
    "version": "0.1.1",
    "type": "app",
    "displayName": {
      "zh": "硬核 3D 卡片旋转",
      "en": "advanced 3D card rotation"
    },
    "description": "gsy_flutter_demo JSON 移植子示例（纯 JSON DSL）：硬核 3D 卡片旋转",
    "author": "fish",
    "upstream": {
      "repository": "https://github.com/CarGuo/gsy_flutter_demo",
      "routeTitle": "硬核 3D 卡片旋转",
      "sourcePath": "lib/widget/visual/card_real_3d_demo_page.dart",
      "deferredAlias": "card_real_3d_demo_page",
      "widgetClass": "CardReal3DDemoPage",
      "category": "visual",
      "routeIndex": 83,
      "portStatus": "ported_json",
      "portVersion": "json-dsl-primitives-v4"
    }
  },
  "dependencies": {},
  "global": {
    "variables": {
      "upstreamTitle": "硬核 3D 卡片旋转",
      "upstreamSource": "lib/widget/visual/card_real_3d_demo_page.dart",
      "upstreamWidget": "CardReal3DDemoPage",
      "portStatus": "ported_json",
      "portVersion": "json-dsl-primitives-v4",
      "angle": 0,
      "tiltX": 0,
      "autoSpin": true
    },
    "functions": {
      "tick": {
        "params": [],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "var": "global.autoSpin"
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.angle",
                    "value": {
                      "%": [
                        {
                          "+": [
                            {
                              "var": "global.angle"
                            },
                            2
                          ]
                        },
                        360
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "panStart": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.autoSpin",
              "value": false
            }
          }
        ]
      },
      "panUpdate": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.angle",
              "value": {
                "%": [
                  {
                    "+": [
                      {
                        "/": [
                          {
                            "-": [
                              140,
                              {
                                "var": "event.localX"
                              }
                            ]
                          },
                          1.4
                        ]
                      },
                      360
                    ]
                  },
                  360
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.tiltX",
              "value": {
                "/": [
                  {
                    "-": [
                      {
                        "var": "event.localY"
                      },
                      97
                    ]
                  },
                  5
                ]
              }
            }
          }
        ]
      },
      "reset": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.angle",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.tiltX",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.autoSpin",
              "value": true
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "CardReal3DDemoPage",
        "layout": "stack",
        "backgroundColor": "#FFFFFF",
        "children": [
          {
            "type": "positioned",
            "child": {
              "type": "interval_action",
              "intervalMs": 50,
              "action": {
                "call": "@global.tick",
                "args": {}
              },
              "child": {
                "type": "container",
                "children": [
                  {
                    "type": "gesture_detector",
                    "onPanStart": {
                      "call": "@global.panStart",
                      "args": {}
                    },
                    "onPanUpdate": {
                      "call": "@global.panUpdate",
                      "args": {}
                    },
                    "onPanEnd": {
                      "call": "@global.reset",
                      "args": {}
                    },
                    "onPanCancel": {
                      "call": "@global.reset",
                      "args": {}
                    },
                    "child": {
                      "type": "transform",
                      "perspective": 0.001,
                      "rotateY": "{{ global.angle }}",
                      "rotateX": "{{ global.tiltX }}",
                      "child": {
                        "type": "container",
                        "children": [
                          {
                            "type": "image",
                            "src": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/gsy_flutter_demo/static/card_up_2.png",
                            "fit": "contain",
                            "paddingV": 0,
                            "visible": {
                              "or": [
                                {
                                  "<": [
                                    {
                                      "var": "global.angle"
                                    },
                                    90
                                  ]
                                },
                                {
                                  ">": [
                                    {
                                      "var": "global.angle"
                                    },
                                    270
                                  ]
                                }
                              ]
                            }
                          },
                          {
                            "type": "image",
                            "src": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/gsy_flutter_demo/static/card_down_2.png",
                            "fit": "contain",
                            "paddingV": 0,
                            "visible": {
                              "and": [
                                {
                                  ">=": [
                                    {
                                      "var": "global.angle"
                                    },
                                    90
                                  ]
                                },
                                {
                                  "<=": [
                                    {
                                      "var": "global.angle"
                                    },
                                    270
                                  ]
                                }
                              ]
                            }
                          },
                          {
                            "type": "positioned",
                            "child": {
                              "type": "text",
                              "value": "G S Y",
                              "style": {
                                "fontSize": 23,
                                "color": "#111111",
                                "fontWeight": "bold",
                                "textAlign": "center",
                                "fontStyle": "italic"
                              }
                            },
                            "left": 110,
                            "right": 20,
                            "top": 82
                          },
                          {
                            "type": "positioned",
                            "child": {
                              "type": "text",
                              "value": "8888 8888 8888 8888",
                              "style": {
                                "fontSize": 17,
                                "color": "#FFFFFF",
                                "textAlign": "center"
                              }
                            },
                            "left": 24,
                            "right": 24,
                            "bottom": 28
                          }
                        ],
                        "layout": "stack",
                        "width": 300,
                        "height": 209,
                        "clipBehavior": "hardEdge"
                      }
                    }
                  }
                ],
                "layout": "column",
                "gradient": {
                  "colors": [
                    "#448AFF",
                    "#FFFF8D"
                  ],
                  "begin": "topCenter",
                  "end": "bottomCenter"
                },
                "alignment": "center",
                "mainAxisAlignment": "center"
              }
            },
            "left": 0,
            "top": 0,
            "right": 0,
            "bottom": 0
          }
        ],
        "appBar": {
          "title": "CardReal3DDemoPage"
        }
      }
    ]
  }
}
