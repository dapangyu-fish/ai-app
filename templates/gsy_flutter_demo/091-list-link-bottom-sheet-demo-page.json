    "functions": {
      "updateSheetDrag": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.sheetDirectionUp",
              "value": {
                "<=": [
                  {
                    "var": "event.deltaY"
                  },
                  0
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.sheetHeight",
              "value": {
                "clamp": [
                  {
                    "-": [
                      {
                        "var": "global.sheetHeight"
                      },
                      {
                        "var": "event.deltaY"
                      }
                    ]
                  },
                  0,
                  {
                    "var": "global.sheetMaxHeight"
                  }
                ]
              }
            }
          }
        ]
      },
      "snapSheet": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.sheetHeight",
              "value": {
                "if": [
                  {
                    "var": "global.sheetDirectionUp"
                  },
                  {
                    "var": "global.sheetMaxHeight"
                  },
                  0
                ]
              }
            }
          },
          {
            "call": "@scroll_to_offset",
            "args": {
              "controller": "listlink.page",
              "offset": 0,
              "durationMs": 0
            }
          }
        ]
      }
    }
  },
