                  "size": 20,
                  "color": "#FFFFFF"
                },
                {
                  "type": "spacer",
                  "width": 8
                },
                {
                  "type": "text",
                  "value": "{{ global.distributionLabel }}",
                  "style": {
                    "fontSize": 14,
