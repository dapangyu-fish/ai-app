  "dependencies": {},
  "global": {
    "variables": {
      "upstreamTitle": "类似QQ发送图片的动画",
      "upstreamSource": "lib/widget/animation/anim_progress_img_demo_page.dart",
      "upstreamWidget": "AnimProgressImgDemoPage",
      "portStatus": "ported_json",
      "portVersion": "json-dsl-primitives-v3",
      "progress": 0,
      "running": false,
      "finished": false
    },
    "functions": {
      "start": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.progress",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.finished",
              "value": false
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.running",
              "value": true
            }
          }
        ]
      },
      "tick": {
        "params": [],
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": {
                "var": "global.running"
              },
              "then": [
                {
                  "call": "@if",
                  "args": {
                    "condition": {
                      "<": [
                        {
                          "var": "global.progress"
                        },
                        100
                      ]
                    },
                    "then": [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.progress",
                          "value": {
                            "+": [
                              {
                                "var": "global.progress"
                              },
                              4
                            ]
                          }
                        }
                      }
                    ],
                    "else": [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.running",
                          "value": false
                        }
                      },
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.finished",
                          "value": true
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "steps": [],
