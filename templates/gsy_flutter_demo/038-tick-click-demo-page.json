    "variables": {
      "upstreamTitle": "时钟动画绘制展示",
      "upstreamSource": "lib/widget/canvas/tick_click_demo_page.dart",
      "upstreamWidget": "TickClickDemoPage",
      "portStatus": "ported_json",
      "portVersion": "json-dsl-primitives-v2",
      "clockTime": "--:--",
      "clockDate": "--.-- 星期-",
      "clockTick": 0
    },
    "functions": {
      "tickClock": {
        "params": [],
        "logic": [
          {
            "call": "@timestamp",
            "args": {},
            "assign": "global._clockTs"
          },
          {
            "call": "@date_format",
            "args": {
              "timestamp": "{{ global._clockTs }}",
              "format": "HH:mm"
            },
            "assign": "global.clockTime"
          },
          {
            "call": "@date_format",
            "args": {
              "timestamp": "{{ global._clockTs }}",
              "format": "MM.DD 星期DD"
            },
            "assign": "global.clockDate"
          },
          {
            "call": "@set",
            "args": {
              "var": "global.clockTick",
              "value": {
                "+": [
                  {
                    "var": "global.clockTick"
                  },
                  6
                ]
              }
            }
          }
        ]
      }
    }
  },
