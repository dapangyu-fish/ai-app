    "functions": {
      "togglePlay": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.playing",
              "value": {
                "!": [
                  {
                    "var": "global.playing"
                  }
                ]
              }
            }
          }
        ]
      },
      "nextLoading": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.loadingState",
              "value": {
                "%": [
                  {
                    "+": [
                      {
                        "var": "global.loadingState"
                      },
                      1
                    ]
                  },
                  4
                ]
              }
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "AnimButtonDemoPage",
        "layout": "column",
        "backgroundColor": "#448AFF",
        "children": [
          {
            "type": "expanded",
            "child": {
              "type": "container",
              "layout": "column",
              "children": [
                {
                  "type": "text",
