                          "size": 30,
                          "color": "#FFFFFF",
                          "visible": {
                            "var": "global.playing"
                          }
                        }
                      ],
                      "width": 50,
                      "height": 50,
                      "shape": "circle",
                      "border": {
                        "color": "#FFFFFF",
