                    "children": [
                      {
                        "type": "progress",
                        "value": {
                          "/": [
                            {
                              "+": [
                                {
                                  "var": "global.loadingState"
                                },
                                1
                              ]
                            },
                            4
                          ]
                        }
                      },
                      {
                        "type": "text",
                        "value": "{{ global.loadingState }}",
                        "style": {
                          "fontSize": 12,
                          "color": "#FFFFFF",
