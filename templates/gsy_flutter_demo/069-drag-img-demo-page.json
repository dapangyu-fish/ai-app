{
  "dsl": "3.3",
  "appid": "5a29c045-99c0-5d24-9c93-eb8a111a1bc4",
  "meta": {
    "name": "gsy_flutter_demo/069-drag-img-demo-page",
    "version": "0.1.2",
    "type": "app",
    "displayName": {
      "zh": "结合 Matrix 的拖拽",
      "en": "Matrix drag interaction"
    },
    "description": "gsy_flutter_demo JSON 移植子示例（纯 JSON DSL）：结合 Matrix 的拖拽",
    "author": "fish",
    "upstream": {
      "repository": "https://github.com/CarGuo/gsy_flutter_demo",
      "routeTitle": "结合 Matrix 的拖拽",
      "sourcePath": "lib/widget/canvas/drag_img_demo_page.dart",
      "deferredAlias": "drag_img_demo_page",
      "widgetClass": "DragImgDemoPage",
      "category": "canvas",
      "routeIndex": 69,
      "portStatus": "ported_json",
      "portVersion": "json-dsl-transform-gesture-v1"
    }
  },
  "dependencies": {},
  "global": {
    "variables": {
      "upstreamTitle": "结合 Matrix 的拖拽",
      "upstreamSource": "lib/widget/canvas/drag_img_demo_page.dart",
      "upstreamWidget": "DragImgDemoPage",
      "portStatus": "ported_json",
      "portVersion": "json-dsl-transform-gesture-v1",
      "tx": 0,
      "ty": 0,
      "scale": 1,
      "rotDeg": 0
    },
    "functions": {
      "updateTransform": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.tx",
              "value": {
                "+": [
                  {
                    "var": "global.tx"
                  },
                  {
                    "var": "event.translationDeltaX"
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.ty",
              "value": {
                "+": [
                  {
                    "var": "global.ty"
                  },
                  {
                    "var": "event.translationDeltaY"
                  }
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.scale",
              "value": {
                "clamp": [
                  {
                    "*": [
                      {
                        "var": "global.scale"
                      },
                      {
                        "var": "event.scaleDelta"
                      }
                    ]
                  },
                  0.4,
                  3.5
                ]
              }
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.rotDeg",
              "value": {
                "+": [
                  {
                    "var": "global.rotDeg"
                  },
                  {
                    "var": "event.rotationDeltaDegrees"
                  }
                ]
              }
            }
          }
        ]
      },
      "resetTransform": {
        "params": [],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.tx",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.ty",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.scale",
              "value": 1
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.rotDeg",
              "value": 0
            }
          }
        ]
      }
    }
  },
  "steps": [],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "DragImgDemoPage",
        "layout": "stack",
        "backgroundColor": "#FFFFFF",
        "children": [
          {
            "type": "positioned",
            "left": 0,
            "top": 0,
            "right": 0,
            "bottom": 0,
            "child": {
              "type": "transform_gesture",
              "onTransformUpdate": {
                "call": "@global.updateTransform",
                "args": {}
              },
              "onDoubleTap": {
                "call": "@global.resetTransform",
                "args": {}
              },
              "child": {
                "type": "transform",
                "translateX": {
                  "var": "global.tx"
                },
                "translateY": {
                  "var": "global.ty"
                },
                "scale": {
                  "var": "global.scale"
                },
                "rotateZ": {
                  "var": "global.rotDeg"
                },
                "child": {
                  "type": "image",
                  "src": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/gsy_flutter_demo/static/gsy_cat.png",
                  "fit": "fitWidth",
                  "width": 390,
                  "height": 844,
                  "paddingV": 0
                }
              }
            }
          }
        ]
      }
    ]
  }
}
