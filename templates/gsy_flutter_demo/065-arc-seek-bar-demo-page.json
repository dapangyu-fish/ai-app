                },
                {
                  "-": [
                    {
                      "var": "global.arcAngle360"
                    },
                    90
                  ]
                }
              ]
            },
            "assign": "global.arcDiff"
          },
          {
            "call": "@set",
            "args": {
              "var": "global.progress",
              "value": {
                "clamp": [
                  {
                    "/": [
                      {
                        "-": [
                          {
                            "var": "global.arcDiff"
                          },
                          60
                        ]
                      },
                      240
                    ]
                  },
                  0,
                  1
                ]
              }
            }
          }
        ]
      }
