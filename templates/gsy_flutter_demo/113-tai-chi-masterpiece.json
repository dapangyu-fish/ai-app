                                  0.5
                                ]
                              },
                              {
                                "-": [
                                  "yy",
                                  0.5
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    },
                    "bottom": {
                      "sqrt": {
                        "+": [
                          {
                            "*": [
                              "xx",
                              "xx"
                            ]
                          },
                          {
                            "*": [
                              {
                                "+": [
                                  "yy",
                                  0.5
                                ]
                              },
                              {
                                "+": [
                                  "yy",
                                  0.5
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    },
                    "bright0": {
                      "if": [
                        {
                          ">": [
                            "xx",
                            0
                          ]
                        },
                        1,
                        0.08
                      ]
                    },
                    "bright1": {
                      "if": [
                        {
                          "<": [
                            "top",
                            0.5
                          ]
                        },
                        1,
                        "bright0"
                      ]
                    },
                    "bright2": {
                      "if": [
                        {
                          "<": [
                            "bottom",
                            0.5
                          ]
                        },
                        0.08,
                        "bright1"
                      ]
                    },
                    "bright3": {
                      "if": [
                        {
                          "<": [
                            "top",
                            0.13
                          ]
                        },
                        0.06,
                        "bright2"
                      ]
                    },
                    "bright": {
                      "if": [
                        {
                          "<": [
                            "bottom",
                            0.13
                          ]
                        },
                        1,
                        "bright3"
                      ]
                    }
                  },
                  "skipWhen": {
                    "<=": [
                      "bright",
