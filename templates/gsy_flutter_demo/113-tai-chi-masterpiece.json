                          "cos": "angle"
                        },
                        "rr"
                      ]
                    },
                    "yy": {
                      "*": [
                        {
                          "sin": "angle"
                        },
                        "rr"
                      ]
                    },
                    "top": {
                      "sqrt": {
                        "+": [
                          {
                            "*": [
                              "xx",
                              "xx"
                            ]
                          },
                          {
