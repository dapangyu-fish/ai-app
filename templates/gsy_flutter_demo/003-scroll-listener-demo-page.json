    "functions": {
      "updateScroll": {
        "params": [],
        "logic": [
          {
            "call": "@to_int",
            "args": {
              "value": {
                "var": "event.offset"
              }
            },
            "assign": "global.offset"
          },
          {
            "call": "@set",
            "args": {
              "var": "global.isEnd",
              "value": {
