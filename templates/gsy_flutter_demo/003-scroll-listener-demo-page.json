  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "ScrollListenerDemoPage",
        "layout": "column",
        "backgroundColor": "#FFFFFF",
        "children": [
          {
            "type": "list",
            "controller": "scrollListener",
            "source": "{{ global.items }}",
            "separator": "none",
            "onScroll": {
              "call": "@global.updateScroll",
              "args": {}
            },
            "onScrollNotification": {
              "call": "@global.updateNotify",
              "args": {}
            },
            "item_template": {
              "type": "card",
              "layout": "column",
              "padding": 0,
              "margin": 4,
              "borderRadius": 4,
              "elevation": 1,
              "children": [
                {
                  "type": "container",
                  "layout": "column",
                  "height": 60,
                  "padding": 0,
                  "mainAxisAlignment": "center",
                  "crossAxisAlignment": "start",
                  "children": [
                    {
                      "type": "text",
                      "value": "Item {{ loop.item }}",
                      "style": {
                        "fontSize": 14,
                        "color": "#000000",
                        "paddingV": 0
                      }
                    }
                  ]
                }
              ]
            }
          }
        ],
        "footerButtons": [
          {
            "type": "button",
            "variant": "text",
            "label": "position: {{ global.offset }}",
            "style": {
              "paddingH": 8,
              "paddingV": 8,
              "fontSize": 14
            },
            "action": {
              "call": "@scroll_to_top",
              "args": {
                "controller": "scrollListener",
                "durationMs": 1000,
                "curve": "bounceInOut"
              }
            }
          },
          {
            "type": "spacer",
            "width": 0.3,
            "height": 30
          },
          {
            "type": "button",
            "variant": "text",
            "label": "{{ global.notify }}",
            "style": {
              "paddingH": 8,
              "paddingV": 8,
              "fontSize": 14
            },
            "action": {
              "call": "@print",
              "args": {
                "value": ""
              }
            }
          },
          {
            "type": "button",
            "variant": "text",
            "label": "到达底部",
            "visible": {
              "var": "global.isEnd"
            },
            "style": {
              "paddingH": 8,
              "paddingV": 8,
              "fontSize": 14
            },
            "action": {
