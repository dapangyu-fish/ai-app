{
  "dsl": "3.3",
  "appid": "7c9e6f10-2a3b-4c5d-8e9f-0a1b2c3d4e5f",
  "meta": {
    "name": "https_test_lab",
    "displayName": {
      "zh": "FaaS 测试台",
      "en": "FaaS Test Lab",
      "default": "FaaS Test Lab"
    },
    "version": "1.3.0",
    "type": "app",
    "description": "FaaS 端到端连通性测试台（i18n + faas lib）：GET/POST/PUT/DELETE/SSE/真实 Supabase 鉴权/任意状态码。",
    "author": "claude"
  },
  "dependencies": {
    "faas": "^1.0.1"
  },
  "global": {
    "variables": {
      "locale": "zh",
      "faasService": "svc-77be07ffad7b",
      "userToken": null,
      "_sseRet": null,
      "resPing": null,
      "resEchoGet": null,
      "resEchoPost": null,
      "resPut": null,
      "resDelete": null,
      "resHeaders": null,
      "resStream": null,
      "resAuth": null,
      "resStatus": null
    },
    "computed": {},
    "functions": {
      "run_ping": {
        "params": [],
        "description": "run ping (GET /ping)",
        "logic": [
          {
            "call": "@faas.get",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/ping"
            },
            "assign": "global.resPing"
          },
          {
            "expression": {
              "var": "global.resPing"
            }
          }
        ]
      },
      "run_echo_get": {
        "params": [],
        "description": "run echo_get (GET /echo?from=faas-test-lab&n=1)",
        "logic": [
          {
            "call": "@faas.get",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/echo?from=faas-test-lab&n=1"
            },
            "assign": "global.resEchoGet"
          },
          {
            "expression": {
              "var": "global.resEchoGet"
            }
          }
        ]
      },
      "run_echo_post": {
        "params": [],
        "description": "run echo_post (POST /echo)",
        "logic": [
          {
            "call": "@faas.post",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/echo",
              "body": {
                "hello": "world",
                "n": 42
              }
            },
            "assign": "global.resEchoPost"
          },
          {
            "expression": {
              "var": "global.resEchoPost"
            }
          }
        ]
      },
      "run_put": {
        "params": [],
        "description": "run put (PUT /items/42)",
        "logic": [
          {
            "call": "@faas.put",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/items/42",
              "body": {
                "name": "updated",
                "price": 9.9
              }
            },
            "assign": "global.resPut"
          },
          {
            "expression": {
              "var": "global.resPut"
            }
          }
        ]
      },
      "run_delete": {
        "params": [],
        "description": "run delete (DELETE /items/42)",
        "logic": [
          {
            "call": "@faas.del",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/items/42"
            },
            "assign": "global.resDelete"
          },
          {
            "expression": {
              "var": "global.resDelete"
            }
          }
        ]
      },
      "run_headers": {
        "params": [],
        "description": "run headers (GET /headers)",
        "logic": [
          {
            "call": "@faas.get",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/headers",
              "headers": {
                "X-User-Token": "demo-token-123",
                "X-Demo": "hello",
                "Authorization": "Bearer should-be-stripped"
              }
            },
            "assign": "global.resHeaders"
          },
          {
            "expression": {
              "var": "global.resHeaders"
            }
          }
        ]
      },
      "run_stream": {
        "params": [],
        "description": "run stream (GET /stream)",
        "logic": [
          {
            "call": "@faas.sse",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/stream",
              "method": "GET",
              "bind": "global.resStream"
            },
            "assign": "global._sseRet"
          },
          {
            "expression": {
              "var": "global.resStream"
            }
          }
        ]
      },
      "run_auth": {
        "params": [],
        "description": "run auth (POST /auth/verify)",
        "logic": [
          {
            "call": "@get_auth_token",
            "args": {
              "bind": "global.userToken"
            }
          },
          {
            "call": "@faas.post",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/auth/verify",
              "body": {},
              "headers": {
                "X-User-Token": "{{ global.userToken }}"
              }
            },
            "assign": "global.resAuth"
          },
          {
            "expression": {
              "var": "global.resAuth"
            }
          }
        ]
      },
      "run_status": {
        "params": [],
        "description": "run status (GET /status/418)",
        "logic": [
          {
            "call": "@faas.get",
            "args": {
              "serviceId": "{{ global.faasService }}",
              "route": "/status/418"
            },
            "assign": "global.resStatus"
          },
          {
            "expression": {
              "var": "global.resStatus"
            }
          }
        ]
      }
    },
    "i18n": {
      "zh": {
        "case": {
          "ping": {
            "title": "GET /ping",
            "desc": "最基础的存活探针：GET 一个 FaaS 路由，期望 200 + {ok:true, message:'pong'}。",
            "row0": "HTTP 状态码",
            "row1": "响应体",
            "row2": "错误"
          },
          "echo_get": {
            "title": "GET /echo?from=…",
            "desc": "GET + query 参数透传：后端把收到的 query 原样回显。",
            "row0": "HTTP 状态码",
            "row1": "回显 query",
            "row2": "错误"
          },
          "echo_post": {
            "title": "POST /echo",
            "desc": "POST + JSON body 透传：后端回显请求体并返回 201。",
            "row0": "HTTP 状态码",
            "row1": "回显 body",
            "row2": "错误"
          },
          "put": {
            "title": "PUT /items/42",
            "desc": "PUT + 动态路径段 + body：更新一条 mock 资源。",
            "row0": "HTTP 状态码",
            "row1": "更新结果",
            "row2": "错误"
          },
          "delete": {
            "title": "DELETE /items/42",
            "desc": "DELETE + 动态路径段：删除一条 mock 资源。",
            "row0": "HTTP 状态码",
            "row1": "删除结果",
            "row2": "错误"
          },
          "headers": {
            "title": "GET /headers（看代理剥头）",
            "desc": "后端回显它实际收到的请求头。可看到 invoke 代理剥掉了 Authorization/Cookie，自定义头 X-User-Token / X-Demo 能透传。",
            "row0": "HTTP 状态码",
            "row1": "后端收到的头",
            "row2": "错误"
          },
          "stream": {
            "title": "GET /stream（SSE）",
            "desc": "text/event-stream 流式响应：后端推 5 个 tick + 1 个 done，客户端经 @faas.sse 累加 events。",
            "row0": "SSE 状态",
            "row1": "收到的事件",
            "row2": "错误"
          },
          "auth": {
            "title": "POST /auth/verify（真实 Supabase 鉴权）",
            "desc": "客户端用 @get_auth_token 拿当前用户 token，放进自定义头 X-User-Token 传给后端；后端真实调用 Supabase /auth/v1/user 验证并回传裁决。",
            "row0": "HTTP 状态码",
            "row1": "鉴权结果",
            "row2": "错误"
          },
          "status": {
            "title": "GET /status/418",
            "desc": "让后端返回任意状态码（418），验证客户端对非 2xx 响应的处理。",
            "row0": "HTTP 状态码",
            "row1": "响应体",
            "row2": "错误"
          }
        },
        "app": {
          "title": "FaaS 测试台",
          "subtitle": "每个入口 = 一个 FaaS 端到端用例。点进去运行，看真实 HTTP 状态码与响应体。",
          "backend_label": "后端服务"
        },
        "action": {
          "run": "▶ 运行测试",
          "back": "← 返回列表",
          "call": "调用"
        }
      },
      "en": {
        "case": {
          "ping": {
            "title": "GET /ping",
            "desc": "Basic liveness probe: GET a FaaS route, expect 200 + {ok:true, message:'pong'}.",
            "row0": "HTTP status",
            "row1": "Response body",
            "row2": "Error"
          },
          "echo_get": {
            "title": "GET /echo?from=…",
            "desc": "GET with query passthrough: the backend echoes the received query.",
            "row0": "HTTP status",
            "row1": "Echoed query",
            "row2": "Error"
          },
          "echo_post": {
            "title": "POST /echo",
            "desc": "POST with JSON body: the backend echoes the body and returns 201.",
            "row0": "HTTP status",
            "row1": "Echoed body",
            "row2": "Error"
          },
          "put": {
            "title": "PUT /items/42",
            "desc": "PUT with a dynamic path segment + body: update a mock resource.",
            "row0": "HTTP status",
            "row1": "Update result",
            "row2": "Error"
          },
          "delete": {
            "title": "DELETE /items/42",
            "desc": "DELETE with a dynamic path segment: delete a mock resource.",
            "row0": "HTTP status",
            "row1": "Delete result",
            "row2": "Error"
          },
          "headers": {
            "title": "GET /headers (proxy header strip)",
            "desc": "The backend echoes the headers it received. The invoke proxy strips Authorization/Cookie; custom headers (X-User-Token / X-Demo) pass through.",
            "row0": "HTTP status",
            "row1": "Received headers",
            "row2": "Error"
          },
          "stream": {
            "title": "GET /stream (SSE)",
            "desc": "text/event-stream streaming: the backend pushes 5 ticks + 1 done; the client accumulates events via @faas.sse.",
            "row0": "SSE status",
            "row1": "Received events",
            "row2": "Error"
          },
          "auth": {
            "title": "POST /auth/verify (real Supabase auth)",
            "desc": "The client gets the user token via @get_auth_token and passes it in the X-User-Token header; the backend really calls Supabase /auth/v1/user and returns the verdict.",
            "row0": "HTTP status",
            "row1": "Auth result",
            "row2": "Error"
          },
          "status": {
            "title": "GET /status/418",
            "desc": "Make the backend return an arbitrary status (418) to test client handling of non-2xx responses.",
            "row0": "HTTP status",
            "row1": "Response body",
            "row2": "Error"
          }
        },
        "app": {
          "title": "FaaS Test Lab",
          "subtitle": "Each entry is one FaaS end-to-end test case. Tap to run and see the real HTTP status and response.",
          "backend_label": "Backend"
        },
        "action": {
          "run": "▶ Run test",
          "back": "← Back",
          "call": "Call"
        }
      }
    }
  },
