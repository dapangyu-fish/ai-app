{
  "dsl": "3.3",
  "appid": "7c9e6f10-2a3b-4c5d-8e9f-0a1b2c3d4e5f",
  "meta": {
    "name": "https_test_lab",
    "displayName": {
      "zh": "HTTPS 测试台",
      "en": "HTTPS Test Lab",
      "default": "HTTPS Test Lab"
    },
    "version": "1.0.0",
    "type": "app",
    "description": "FaaS HTTPS 连通性端到端测试台：GET/POST/PUT/DELETE/SSE/真实 Supabase 鉴权/任意状态码。",
    "author": "claude"
  },
  "global": {
    "variables": {
      "faasBase": "/api/faas/invoke/svc-77be07ffad7b",
      "userToken": null,
      "_sseRet": null,
      "resPing": null,
      "resEchoGet": null,
      "resEchoPost": null,
      "resPut": null,
      "resDelete": null,
      "resHeaders": null,
      "resStream": null,
      "resAuth": null,
      "resStatus": null
    },
    "computed": {},
    "functions": {
      "runPing": {
        "params": [],
        "description": "运行测试用例 ping (GET /ping)",
        "logic": [
          {
            "call": "@http_get",
            "args": {
              "url": "{{ global.faasBase }}/ping"
            },
            "assign": "global.resPing"
          },
          {
            "expression": {
              "var": "global.resPing"
            }
          }
        ]
      },
      "runEchoGet": {
        "params": [],
        "description": "运行测试用例 echo_get (GET /echo)",
        "logic": [
          {
            "call": "@http_get",
            "args": {
              "url": "{{ global.faasBase }}/echo",
              "query": {
                "from": "https-test-lab",
                "n": "1"
              }
            },
            "assign": "global.resEchoGet"
          },
          {
            "expression": {
              "var": "global.resEchoGet"
            }
          }
        ]
      },
      "runEchoPost": {
        "params": [],
        "description": "运行测试用例 echo_post (POST /echo)",
        "logic": [
          {
            "call": "@http_post",
            "args": {
              "url": "{{ global.faasBase }}/echo",
              "body": {
                "hello": "world",
                "n": 42
              }
            },
            "assign": "global.resEchoPost"
          },
          {
            "expression": {
              "var": "global.resEchoPost"
            }
          }
        ]
      },
      "runPut": {
        "params": [],
        "description": "运行测试用例 put (PUT /items/<id>)",
        "logic": [
          {
            "call": "@http_put",
            "args": {
              "url": "{{ global.faasBase }}/items/42",
              "body": {
                "name": "updated",
                "price": 9.9
              }
            },
            "assign": "global.resPut"
          },
          {
            "expression": {
              "var": "global.resPut"
            }
          }
        ]
      },
      "runDelete": {
        "params": [],
        "description": "运行测试用例 delete (DELETE /items/<id>)",
        "logic": [
          {
            "call": "@http_delete",
            "args": {
              "url": "{{ global.faasBase }}/items/42"
            },
            "assign": "global.resDelete"
          },
          {
            "expression": {
              "var": "global.resDelete"
            }
          }
        ]
      },
      "runHeaders": {
        "params": [],
        "description": "运行测试用例 headers (GET /headers)",
        "logic": [
          {
            "call": "@http_get",
            "args": {
              "url": "{{ global.faasBase }}/headers",
              "headers": {
                "X-User-Token": "demo-token-123",
                "X-Demo": "hello",
                "Authorization": "Bearer should-be-stripped"
              }
            },
            "assign": "global.resHeaders"
          },
          {
            "expression": {
              "var": "global.resHeaders"
            }
          }
        ]
      },
      "runStream": {
        "params": [],
        "description": "运行测试用例 stream (GET(SSE) /stream)",
        "logic": [
          {
            "call": "@http_sse",
            "args": {
              "url": "{{ global.faasBase }}/stream",
              "method": "GET",
              "bind": "global.resStream"
            },
            "assign": "global._sseRet"
          },
          {
            "expression": {
              "var": "global.resStream"
            }
          }
        ]
      },
      "runAuth": {
        "params": [],
        "description": "运行测试用例 auth (POST /auth/verify)",
        "logic": [
          {
            "call": "@get_auth_token",
            "args": {
              "bind": "global.userToken"
            }
          },
          {
            "call": "@http_post",
            "args": {
              "url": "{{ global.faasBase }}/auth/verify",
              "headers": {
                "X-User-Token": "{{ global.userToken }}"
              },
              "body": {}
            },
            "assign": "global.resAuth"
          },
          {
            "expression": {
              "var": "global.resAuth"
            }
          }
        ]
      },
      "runStatus": {
        "params": [],
        "description": "运行测试用例 status (GET /status/<code>)",
        "logic": [
          {
            "call": "@http_get",
            "args": {
              "url": "{{ global.faasBase }}/status/418"
            },
            "assign": "global.resStatus"
          },
          {
            "expression": {
              "var": "global.resStatus"
            }
          }
        ]
      }
    },
    "i18n": {}
  },
