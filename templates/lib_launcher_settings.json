{
  "dsl": "3.3",
  "appid": "e20ac2b9-11f7-4d51-8f03-d5372b9678e2",
  "meta": {
    "name": "launcher-settings",
    "version": "1.1.0",
    "type": "library",
    "displayName": {
      "zh": "启动器组件 · 设置",
      "en": "Launcher Component · Settings",
      "de": "Launcher-Komponente · Einstellungen",
      "es": "Componente launcher · Ajustes"
    },
    "description": "可嵌入的'设置'组件库——主题/语言/默认启动 App/缓存/账号管理。所有 UI 字符串走消费方的 global.i18n（t('settings.xxx')），加语言只改消费方 JSON。",
    "author": "framework",
    "exports": [
      "settingsPanel",
      "init",
      "refresh",
      "clearStartup",
      "clearCache",
      "logout",
      "editProfile",
      "_editName",
      "_editAvatar",
      "_setTheme",
      "_setLocale"
    ]
  },

  "dependencies": {
    "lib_user": "^1.3.0"
  },

  "global": {
    "variables": {
      "_ls": {
        "theme": "system",
        "locale": "zh",
        "user": { "username": "", "email": "", "avatar_url": "" },
        "startup": { "kind": "none", "hasTarget": false, "displayName": "" }
      }
    },
    "functions": {
      "init": {
        "params": [],
        "logic": [
          { "call": "@launcher-settings.refresh", "args": {} }
        ]
      },

      "refresh": {
        "params": [],
        "logic": [
          { "call": "@get_theme", "args": {}, "assign": "global._ls.theme" },
          { "call": "@get_framework_locale", "args": {}, "assign": "global._ls.locale" },
          { "call": "@get_user_info", "args": { "bind": "global._ls.user" } },
          { "call": "@startup_default_get", "args": {}, "assign": "global._ls.startup" }
        ]
      },

      "editProfile": {
        "params": [],
        "logic": [
          {
            "call": "@show_choice_dialog",
            "args": {
              "title": "{{ t('settings.profile_edit') }}",
              "message": "{{ t('settings.profile_edit_msg') }}",
              "buttons": [
                { "label": "{{ t('settings.profile_edit_name') }}",   "value": "name" },
                { "label": "{{ t('settings.profile_edit_avatar') }}", "value": "avatar" },
                { "label": "{{ t('common.cancel') }}",                "value": null, "style": "text" }
              ]
            },
            "assign": "global._ls._editChoice"
          },
          {
            "call": "@if",
            "args": {
              "condition": { "==": [{ "var": "global._ls._editChoice" }, "name"] },
              "then": [ { "call": "@launcher-settings._editName", "args": {} } ]
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": { "==": [{ "var": "global._ls._editChoice" }, "avatar"] },
              "then": [ { "call": "@launcher-settings._editAvatar", "args": {} } ]
            }
          }
        ]
      },

      "_editName": {
        "params": [],
        "logic": [
          {
            "call": "@show_input_dialog",
            "args": {
              "title": "{{ t('settings.name_dialog_title') }}",
              "hint": "{{ t('settings.name_dialog_hint') }}",
              "defaultValue": "{{ global._ls.user.username }}"
            },
            "assign": "global._ls._newName"
          },
          {
            "call": "@if",
            "args": {
              "condition": { "!=": [{ "var": "global._ls._newName" }, null] },
              "then": [
                { "call": "@lib_user.updateName", "args": { "newName": "{{ global._ls._newName }}" } },
                { "call": "@launcher-settings.refresh", "args": {} },
                { "call": "@show_toast", "args": { "message": "{{ t('settings.name_toast') }}" } }
              ]
            }
          }
        ]
      },

      "_editAvatar": {
        "params": [],
        "logic": [
          { "call": "@pick_image", "args": {}, "assign": "global._ls._imgPath" },
          {
            "call": "@if",
            "args": {
              "condition": { "!=": [{ "var": "global._ls._imgPath" }, null] },
              "then": [
                { "call": "@lib_user.updateAvatar", "args": { "imagePath": "{{ global._ls._imgPath }}" } },
                { "call": "@launcher-settings.refresh", "args": {} },
                { "call": "@show_toast", "args": { "message": "{{ t('settings.avatar_toast') }}" } }
              ]
            }
          }
        ]
      },

      "clearStartup": {
        "params": [],
        "logic": [
          {
            "call": "@show_dialog",
            "args": {
              "title": "{{ t('settings.startup_reset_title') }}",
              "message": "{{ t('settings.startup_reset_msg') }}"
            },
            "assign": "global._ls._confirm"
          },
          {
            "call": "@if",
            "args": {
              "condition": { "==": [{ "var": "global._ls._confirm" }, true] },
              "then": [
                { "call": "@startup_default_clear", "args": {} },
                { "call": "@launcher-settings.refresh", "args": {} },
                { "call": "@show_toast", "args": { "message": "{{ t('settings.startup_reset_toast') }}" } }
              ]
            }
          }
        ]
      },

      "clearCache": {
        "params": [],
        "logic": [
          {
            "call": "@show_dialog",
            "args": {
              "title": "{{ t('settings.cache') }}",
              "message": "{{ t('settings.cache_msg') }}"
            },
            "assign": "global._ls._confirm"
          },
          {
            "call": "@if",
            "args": {
              "condition": { "==": [{ "var": "global._ls._confirm" }, true] },
              "then": [
                { "call": "@cache_clear", "args": {} },
                { "call": "@show_toast", "args": { "message": "{{ t('settings.cache_toast') }}" } }
              ]
            }
          }
        ]
      },

      "logout": {
        "params": [],
        "logic": [
          {
            "call": "@show_dialog",
            "args": {
              "title": "{{ t('settings.logout') }}",
              "message": "{{ t('settings.logout_msg') }}"
            },
            "assign": "global._ls._confirm"
          },
          {
            "call": "@if",
            "args": {
              "condition": { "==": [{ "var": "global._ls._confirm" }, true] },
              "then": [ { "call": "@auth_logout", "args": {} } ]
            }
          }
        ]
      },

      "_setTheme": {
        "params": ["mode"],
        "logic": [
          { "call": "@set_theme", "args": { "mode": "{{ params.mode }}" } },
          { "call": "@launcher-settings.refresh", "args": {} }
        ]
      },

      "_setLocale": {
        "params": ["code"],
        "logic": [
          { "call": "@set_framework_locale", "args": { "value": "{{ params.code }}" } },
          { "call": "@launcher-settings.refresh", "args": {} }
        ]
      }
    }
  },

  "ui": {
    "templates": {
      "settingsPanel": {
        "props": [],
        "root": {
          "type": "container",
          "layout": "column",
          "padding": 12,
          "children": [
            {
              "type": "card",
              "elevation": 1,
              "borderRadius": 12,
              "margin": 4,
              "padding": 16,
              "layout": "row",
              "crossAxisAlignment": "center",
              "onTap": { "call": "@launcher-settings.editProfile", "args": {} },
              "children": [
                {
                  "type": "container",
                  "width": 56,
                  "height": 56,
                  "borderRadius": 28,
                  "color": "#E8EAF6",
                  "children": [
                    {
                      "type": "image",
                      "url": "{{ global._ls.user.avatar_url }}",
                      "visible": "{{ global._ls.user.avatar_url }}",
                      "width": 56,
                      "height": 56,
                      "borderRadius": 28,
                      "fit": "cover"
                    },
                    {
                      "type": "center",
                      "visible": { "!": [{ "var": "global._ls.user.avatar_url" }] },
                      "child": {
                        "type": "icon",
                        "name": "person",
                        "size": 32,
                        "color": "#3F51B5"
                      }
                    }
                  ]
                },
                { "type": "spacer", "width": 14 },
                {
                  "type": "expanded",
                  "child": {
                    "type": "container",
                    "layout": "column",
                    "crossAxisAlignment": "start",
                    "children": [
                      {
                        "type": "text",
                        "value": "{{ global._ls.user.username }}",
                        "style": { "fontSize": 16, "fontWeight": "w600" }
                      },
                      { "type": "spacer", "height": 4 },
                      {
                        "type": "text",
                        "value": "{{ global._ls.user.email }}",
                        "style": { "fontSize": 12, "color": "#888888" }
                      }
                    ]
                  }
                },
                { "type": "icon", "name": "right", "size": 20, "color": "#888888" }
              ]
            },

            {
              "type": "card",
              "elevation": 1,
              "borderRadius": 12,
              "margin": 4,
              "padding": 16,
              "layout": "column",
              "children": [
                {
                  "type": "container",
                  "layout": "row",
                  "crossAxisAlignment": "center",
                  "children": [
                    { "type": "icon", "name": "settings", "size": 22, "color": "#666666" },
                    { "type": "spacer", "width": 10 },
                    {
                      "type": "text",
                      "value": "{{ t('settings.theme') }}",
                      "style": { "fontSize": 15, "fontWeight": "w600" }
                    }
                  ]
                },
                { "type": "spacer", "height": 8 },
                {
                  "type": "dropdown",
                  "bind": "global._ls.theme",
                  "options": [
                    { "label": "{{ t('settings.theme_system') }}", "value": "system" },
                    { "label": "{{ t('settings.theme_light') }}",  "value": "light"  },
                    { "label": "{{ t('settings.theme_dark') }}",   "value": "dark"   }
                  ],
                  "action": {
                    "call": "@launcher-settings._setTheme",
                    "args": { "mode": "{{ global._ls.theme }}" }
                  }
                }
              ]
            },

            {
              "type": "card",
              "elevation": 1,
              "borderRadius": 12,
              "margin": 4,
              "padding": 16,
              "layout": "column",
              "children": [
                {
                  "type": "container",
                  "layout": "row",
                  "crossAxisAlignment": "center",
                  "children": [
                    { "type": "icon", "name": "globe", "size": 22, "color": "#666666" },
                    { "type": "spacer", "width": 10 },
                    {
                      "type": "text",
                      "value": "{{ t('settings.locale') }}",
                      "style": { "fontSize": 15, "fontWeight": "w600" }
                    }
                  ]
                },
                { "type": "spacer", "height": 8 },
                {
                  "type": "dropdown",
                  "bind": "global._ls.locale",
                  "options": [
                    { "label": "中文",     "value": "zh" },
                    { "label": "English",  "value": "en" },
                    { "label": "Deutsch",  "value": "de" },
                    { "label": "Español",  "value": "es" }
                  ],
                  "action": {
                    "call": "@launcher-settings._setLocale",
                    "args": { "code": "{{ global._ls.locale }}" }
                  }
                }
              ]
            },

            {
              "type": "card",
              "elevation": 1,
              "borderRadius": 12,
              "margin": 4,
              "padding": 16,
              "layout": "row",
              "crossAxisAlignment": "center",
              "children": [
                { "type": "icon", "name": "play", "size": 22, "color": "#666666" },
                { "type": "spacer", "width": 10 },
                {
                  "type": "expanded",
                  "child": {
                    "type": "container",
                    "layout": "column",
                    "crossAxisAlignment": "start",
                    "children": [
                      {
                        "type": "text",
                        "value": "{{ t('settings.startup') }}",
                        "style": { "fontSize": 15, "fontWeight": "w600" }
                      },
                      { "type": "spacer", "height": 4 },
                      {
                        "type": "text",
                        "value": "{{ global._ls.startup.displayName }}",
                        "visible": "{{ global._ls.startup.hasTarget }}",
                        "style": { "fontSize": 12, "color": "#888888", "maxLines": 1, "overflow": "ellipsis" }
                      },
                      {
                        "type": "text",
                        "value": "{{ t('settings.startup_none') }}",
                        "visible": { "!": [{ "var": "global._ls.startup.hasTarget" }] },
                        "style": { "fontSize": 12, "color": "#888888" }
                      }
                    ]
                  }
                },
                { "type": "spacer", "width": 8 },
                {
                  "type": "button",
                  "label": "{{ t('settings.startup_reset') }}",
                  "variant": "outlined",
                  "visible": "{{ global._ls.startup.hasTarget }}",
                  "action": { "call": "@launcher-settings.clearStartup", "args": {} }
                }
              ]
            },

            {
              "type": "card",
              "elevation": 1,
              "borderRadius": 12,
              "margin": 4,
              "padding": 16,
              "layout": "row",
              "crossAxisAlignment": "center",
              "onTap": { "call": "@launcher-settings.clearCache", "args": {} },
              "children": [
                { "type": "icon", "name": "folder", "size": 22, "color": "#666666" },
                { "type": "spacer", "width": 10 },
                {
                  "type": "expanded",
                  "child": {
                    "type": "text",
                    "value": "{{ t('settings.cache') }}",
                    "style": { "fontSize": 15, "fontWeight": "w600" }
                  }
                },
                { "type": "icon", "name": "right", "size": 20, "color": "#888888" }
              ]
            },

            {
              "type": "card",
              "elevation": 1,
              "borderRadius": 12,
              "margin": 4,
              "padding": 16,
              "layout": "row",
              "crossAxisAlignment": "center",
              "onTap": { "call": "@launcher-settings.logout", "args": {} },
              "children": [
                { "type": "icon", "name": "logout", "size": 22, "color": "#D32F2F" },
                { "type": "spacer", "width": 10 },
                {
                  "type": "expanded",
                  "child": {
                    "type": "text",
                    "value": "{{ t('settings.logout') }}",
                    "style": { "fontSize": 15, "fontWeight": "w600", "color": "#D32F2F" }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}
