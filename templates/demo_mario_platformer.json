{
  "dsl": "3.3",
  "appid": "5b871359-b8e7-4f09-96a0-9b62ccafcdd1",
  "meta": {
    "name": "demo-mario-platformer",
    "version": "1.0.0",
    "type": "app",
    "description": "Landscape platformer inspired by the flutter_game Mario demo. Gameplay is implemented in JSON; assets are hosted in json-app-assets.",
    "author": "fish"
  },
  "dependencies": {
    "common-ui": "^1.3.0",
    "game-controls": "^1.0.0"
  },
  "assets": {
    "bundles": {
      "flutter_game_mario": {
        "baseUrl": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/",
        "manifest": "manifest.json",
        "entry": "tiles/mario.tmx",
        "startupDownload": true,
        "source": "https://github.com/DaQinShgy/flutter_game"
      }
    }
  },
  "global": {
    "variables": {
      "currentScore": 0,
      "bestScore": 0,
      "lives": 3,
      "status": "Loading",
      "_choice": null
    },
    "functions": {
      "scoreChanged": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentScore",
              "value": "{{ params.score }}"
            }
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                ">": [
                  {
                    "var": "params.score"
                  },
                  {
                    "var": "global.bestScore"
                  }
                ]
              },
              "then": [
                {
                  "call": "@set",
                  "args": {
                    "var": "global.bestScore",
                    "value": "{{ params.score }}"
                  }
                }
              ]
            }
          }
        ]
      },
      "status": {
        "params": [
          "text",
          "lives"
        ],
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "{{ params.text }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.lives",
              "value": "{{ params.lives }}"
            }
          }
        ]
      },
      "reset": {
        "logic": [
          {
            "call": "@set",
            "args": {
              "var": "global.currentScore",
              "value": 0
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.lives",
              "value": 3
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "Move and jump"
            }
          }
        ]
      },
      "over": {
        "params": [
          "score"
        ],
        "logic": [
          {
            "call": "@global.scoreChanged",
            "args": {
              "score": "{{ params.score }}"
            }
          },
          {
            "call": "@set",
            "args": {
              "var": "global.status",
              "value": "Game Over"
            }
          },
          {
            "call": "@common-ui.choose",
            "args": {
              "title": "Platformer",
              "message": "Score: {{ params.score }}\nBest: {{ global.bestScore }}",
              "buttons": [
                {
                  "label": "Close",
                  "value": null,
                  "style": "text"
                },
                {
                  "label": "Restart",
                  "value": "restart"
                }
              ]
            },
            "assign": "global._choice"
          },
          {
            "call": "@if",
            "args": {
              "condition": {
                "==": [
                  {
                    "var": "global._choice"
                  },
                  "restart"
                ]
              },
              "then": [
                {
                  "call": "@flame_game_reset",
                  "args": {}
                }
              ]
            }
          }
        ]
      }
    }
  },
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "Mario Platformer",
        "appBar": {
          "title": "Mario Platformer",
          "centerTitle": true,
          "backgroundColor": "#5C94FC",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {
                "call": "@flame_game_reset",
                "args": {}
              }
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 10,
            "color": "#5C94FC",
            "layout": "row",
            "children": [
              {
                "type": "text",
                "value": "Score {{ global.currentScore }}",
                "style": {
                  "fontSize": 14,
                  "color": "#FFFFFF",
                  "fontWeight": "bold"
                },
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "Lives {{ global.lives }}",
                "style": {
                  "fontSize": 14,
                  "color": "#FFFFFF"
                },
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
                "type": "text",
                "value": "{{ global.status }}",
                "style": {
                  "fontSize": 13,
                  "color": "#FFF3B0"
                }
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {
                "kind": "pixel",
                "bg": "#5C94FC"
              },
              "viewport": {
                "width": 960,
                "height": 540,
                "fit": "contain"
              },
              "physics": {
                "engine": "leap_platformer",
                "fallback": "aabb_platformer"
              },
              "camera": {
                "follow": "player",
                "map": "map",
                "offset_x": 220,
                "offset_y": -48,
                "deadzone_y": 20,
                "smooth_y": 0.25
              },
              "overlay": {
                "score": false,
                "game_over": false,
                "asset_loading": true,
                "asset_loading_text": "Loading platform assets..."
              },
              "vars": {
                "state": "loading",
                "lives": 3,
                "move_axis": 0,
                "facing": 1,
                "jump_pressed": false,
                "gravity": 1700,
                "jump_vy": -620,
                "speed": 260,
                "hit_enemy": null,
                "hit_fireball_enemy": null,
                "won": false
              },
              "entities": {
                "background": {
                  "kind": "sprite",
                  "priority": -50,
                  "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/images/mario/level_1.png",
                  "position": [
                    0,
                    0
                  ],
                  "size": [
                    6784,
                    448
                  ],
                  "auto_update": false
                },
                "map": {
                  "kind": "tiled_map",
                  "priority": -40,
                  "source": "tiles/mario.tmx",
                  "base_url": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/",
                  "scale": 2,
                  "solid_layers": [
                    "grounds",
                    "collider",
                    "brick blocks",
                    "question blocks"
                  ],
                  "collidable": true,
                  "render": {
                    "shape": "text",
                    "value": "Loading map",
                    "color": "#FFFFFF"
                  }
                },
                "player": {
                  "kind": "animated_sprite",
                  "priority": 40,
                  "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/images/mario/mario_bros.png",
                  "animation": "idle",
                  "position": [
                    64,
                    368
                  ],
                  "size": [
                    28,
                    32
                  ],
                  "velocity": [
                    0,
                    0
                  ],
                  "auto_update": false,
                  "state": {
                    "spriteW": 32,
                    "spriteH": 32,
                    "spriteOffsetX": -2,
                    "spriteOffsetY": 0
                  },
                  "frame_size": [
                    16,
                    16
                  ],
                  "src_origin": [
                    176,
                    32
                  ],
                  "frames": 1,
                  "animations": {
                    "idle": {
                      "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/images/mario/mario_bros.png",
                      "src_origin": [
                        176,
                        32
                      ],
                      "frame_size": [
                        16,
                        16
                      ],
                      "frames": 1,
                      "frames_per_row": 1,
                      "step_time": 0.12
                    },
                    "run": {
                      "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/images/mario/mario_bros.png",
                      "src_origin": [
                        80,
                        32
                      ],
                      "frame_size": [
                        16,
                        16
                      ],
                      "frames": 3,
                      "frames_per_row": 3,
                      "step_time": 0.08
                    },
                    "jump": {
                      "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/images/mario/mario_bros.png",
                      "src_origin": [
                        144,
                        32
                      ],
                      "frame_size": [
                        16,
                        16
                      ],
                      "frames": 1,
                      "frames_per_row": 1,
                      "step_time": 0.12
                    },
                    "dead": {
                      "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/images/mario/mario_bros.png",
                      "src_origin": [
                        160,
                        32
                      ],
                      "frame_size": [
                        16,
                        16
                      ],
                      "frames": 1,
                      "frames_per_row": 1,
                      "step_time": 0.12
                    }
                  }
                }
              },
              "input": {
                "move_axis": [
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars.move_axis",
                      "value": "{{ event.x }}"
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        ">": [
                          {
                            "var": "event.x"
                          },
                          0.08
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.facing",
                            "value": 1
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "<": [
                          {
                            "var": "event.x"
                          },
                          -0.08
                        ]
                      },
                      "then": [
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.facing",
                            "value": -1
                          }
                        }
                      ]
                    }
                  }
                ],
                "jump": [
                  {
                    "call": "@set",
                    "args": {
                      "var": "vars.jump_pressed",
                      "value": true
                    }
                  }
                ],
                "attack": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!": {
                          "call": "@entity.exists",
                          "args": {
                            "id": "fireball"
                          }
                        }
                      },
                      "then": [
                        {
                          "call": "@spawn",
                          "args": {
                            "id": "fireball",
                            "kind": "pixel",
                            "priority": 45,
                            "position": [
                              {
                                "+": [
                                  {
                                    "var": "entities.player.x"
                                  },
                                  {
                                    "if": [
                                      {
                                        "==": [
                                          {
                                            "var": "vars.facing"
                                          },
                                          1
                                        ]
                                      },
                                      28,
                                      -12
                                    ]
                                  }
                                ]
                              },
                              {
                                "+": [
                                  {
                                    "var": "entities.player.y"
                                  },
                                  12
                                ]
                              }
                            ],
                            "size": [
                              10,
                              10
                            ],
                            "velocity": [
                              {
                                "*": [
                                  {
                                    "var": "vars.facing"
                                  },
                                  520
                                ]
                              },
                              0
                            ],
                            "auto_update": true,
                            "render": {
                              "shape": "circle",
                              "color": "#FFB000"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "frame": {
                "logic": [
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "==": [
                          {
                            "var": "vars.state"
                          },
                          "loading"
                        ]
                      },
                      "then": [
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "call": "@tiled.loaded",
                              "args": {
                                "map": "map"
                              }
                            },
                            "then": [
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.state",
                                  "value": "running"
                                }
                              },
                              {
                                "call": "@emit",
                                "args": {
                                  "event": "status",
                                  "data": {
                                    "text": "Move and jump",
                                    "lives": "{{ vars.lives }}"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "call": "@if",
                    "args": {
                      "cond": {
                        "!=": [
                          {
                            "var": "vars.state"
                          },
                          "running"
                        ]
                      },
                      "then": [],
                      "else": [
                        {
                          "call": "@tiled.spawn_objects_near",
                          "args": {
                            "map": "map",
                            "layer": "enemies",
                            "reference": "player",
                            "proximity": 1200,
                            "despawn_distance": 1500,
                            "templates": {
                              "goomba": {
                                "id_prefix": "enemy_",
                                "kind": "sprite",
                                "priority": 30,
                                "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/images/mario/smb_enemies_sheet.png",
                                "src": [
                                  0,
                                  4,
                                  16,
                                  16
                                ],
                                "position": [
                                  "{{ object.x }}",
                                  "{{ object.y }}"
                                ],
                                "size": [
                                  32,
                                  32
                                ],
                                "velocity": [
                                  -70,
                                  0
                                ],
                                "auto_update": false,
                                "state": {
                                  "kind": "goomba",
                                  "assetLoadingOverlay": false
                                }
                              },
                              "koopa": {
                                "id_prefix": "enemy_",
                                "kind": "sprite",
                                "priority": 30,
                                "asset": "https://myapp-oss-endpoint.dapangyu.work/json-app-assets/demo-mario-platformer/1.0.0/images/mario/smb_enemies_sheet.png",
                                "src": [
                                  150,
                                  0,
                                  16,
                                  24
                                ],
                                "position": [
                                  "{{ object.x }}",
                                  352
                                ],
                                "size": [
                                  32,
                                  48
                                ],
                                "velocity": [
                                  -60,
                                  0
                                ],
                                "auto_update": false,
                                "state": {
                                  "kind": "koopa",
                                  "assetLoadingOverlay": false
                                }
                              }
                            }
                          }
                        },
                        {
                          "call": "@for_each_entity",
                          "args": {
                            "where_prefix": "enemy_",
                            "do": [
                              {
                                "call": "@entity.set",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "field": "vx",
                                  "value": -70
                                }
                              },
                              {
                                "call": "@platformer.step",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "map": "map",
                                  "dt": "{{ event.dt }}",
                                  "gravity": 1500,
                                  "max_fall": 900
                                }
                              },
                              {
                                "call": "@entity.flip_by_velocity",
                                "args": {
                                  "id": "{{ loop.id }}",
                                  "axis": "x",
                                  "invert": false
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@platformer.step",
                          "args": {
                            "id": "player",
                            "map": "map",
                            "dt": "{{ event.dt }}",
                            "gravity": "{{ vars.gravity }}",
                            "jump_velocity": "{{ vars.jump_vy }}",
                            "jump": "{{ vars.jump_pressed }}",
                            "move": "{{ vars.move_axis }}",
                            "speed": "{{ vars.speed }}",
                            "max_fall": 1100
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.jump_pressed",
                            "value": false
                          }
                        },
                        {
                          "call": "@set",
                          "args": {
                            "var": "vars.on_ground",
                            "value": "{{ entities.player.onGround }}"
                          }
                        },
                        {
                          "call": "@entity.flip_by_velocity",
                          "args": {
                            "id": "player",
                            "axis": "x",
                            "invert": false
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "!": {
                                "var": "vars.on_ground"
                              }
                            },
                            "then": [
                              {
                                "call": "@animated_sprite.set_animation",
                                "args": {
                                  "id": "player",
                                  "animation": "jump"
                                }
                              }
                            ],
                            "else": [
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "or": [
                                      {
                                        ">": [
                                          {
                                            "var": "entities.player.vx"
                                          },
                                          10
                                        ]
                                      },
                                      {
                                        "<": [
                                          {
                                            "var": "entities.player.vx"
                                          },
                                          -10
                                        ]
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@animated_sprite.set_animation",
                                      "args": {
                                        "id": "player",
                                        "animation": "run"
                                      }
                                    }
                                  ],
                                  "else": [
                                    {
                                      "call": "@animated_sprite.set_animation",
                                      "args": {
                                        "id": "player",
                                        "animation": "idle"
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@collision.first",
                          "args": {
                            "a": "player",
                            "where_prefix": "enemy_"
                          },
                          "assign": "vars.hit_enemy"
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "!=": [
                                {
                                  "var": "vars.hit_enemy"
                                },
                                null
                              ]
                            },
                            "then": [
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "and": [
                                      {
                                        ">": [
                                          {
                                            "var": "entities.player.vy"
                                          },
                                          0
                                        ]
                                      },
                                      {
                                        "<": [
                                          {
                                            "+": [
                                              {
                                                "var": "entities.player.y"
                                              },
                                              {
                                                "var": "entities.player.h"
                                              }
                                            ]
                                          },
                                          {
                                            "+": [
                                              {
                                                "var": "entities.{{ vars.hit_enemy }}.y"
                                              },
                                              22
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@despawn",
                                      "args": {
                                        "id": "{{ vars.hit_enemy }}"
                                      }
                                    },
                                    {
                                      "call": "@entity.set",
                                      "args": {
                                        "id": "player",
                                        "field": "vy",
                                        "value": -360
                                      }
                                    },
                                    {
                                      "call": "@score.add",
                                      "args": {
                                        "n": 100
                                      }
                                    }
                                  ],
                                  "else": [
                                    {
                                      "call": "@set",
                                      "args": {
                                        "var": "vars.lives",
                                        "value": {
                                          "-": [
                                            {
                                              "var": "vars.lives"
                                            },
                                            1
                                          ]
                                        }
                                      }
                                    },
                                    {
                                      "call": "@if",
                                      "args": {
                                        "cond": {
                                          "<=": [
                                            {
                                              "var": "vars.lives"
                                            },
                                            0
                                          ]
                                        },
                                        "then": [
                                          {
                                            "call": "@animated_sprite.set_animation",
                                            "args": {
                                              "id": "player",
                                              "animation": "dead"
                                            }
                                          },
                                          {
                                            "call": "@game_over",
                                            "args": {}
                                          }
                                        ],
                                        "else": [
                                          {
                                            "call": "@platformer.respawn",
                                            "args": {
                                              "id": "player",
                                              "map": "map",
                                              "layer": "grounds"
                                            }
                                          },
                                          {
                                            "call": "@emit",
                                            "args": {
                                              "event": "status",
                                              "data": {
                                                "text": "Try again",
                                                "lives": "{{ vars.lives }}"
                                              }
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.hit_enemy",
                                  "value": null
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "call": "@entity.exists",
                              "args": {
                                "id": "fireball"
                              }
                            },
                            "then": [
                              {
                                "call": "@collision.first",
                                "args": {
                                  "a": "fireball",
                                  "where_prefix": "enemy_"
                                },
                                "assign": "vars.hit_fireball_enemy"
                              },
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "!=": [
                                      {
                                        "var": "vars.hit_fireball_enemy"
                                      },
                                      null
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@despawn",
                                      "args": {
                                        "id": "{{ vars.hit_fireball_enemy }}"
                                      }
                                    },
                                    {
                                      "call": "@despawn",
                                      "args": {
                                        "id": "fireball"
                                      }
                                    },
                                    {
                                      "call": "@score.add",
                                      "args": {
                                        "n": 100
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    ">": [
                                      {
                                        "var": "entities.fireball.x"
                                      },
                                      {
                                        "+": [
                                          {
                                            "var": "entities.player.x"
                                          },
                                          900
                                        ]
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@despawn",
                                      "args": {
                                        "id": "fireball"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "<": [
                                      {
                                        "var": "entities.fireball.x"
                                      },
                                      {
                                        "-": [
                                          {
                                            "var": "entities.player.x"
                                          },
                                          260
                                        ]
                                      }
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@despawn",
                                      "args": {
                                        "id": "fireball"
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              "var": "entities.player.hazard"
                            },
                            "then": [
                              {
                                "call": "@set",
                                "args": {
                                  "var": "vars.lives",
                                  "value": {
                                    "-": [
                                      {
                                        "var": "vars.lives"
                                      },
                                      1
                                    ]
                                  }
                                }
                              },
                              {
                                "call": "@if",
                                "args": {
                                  "cond": {
                                    "<=": [
                                      {
                                        "var": "vars.lives"
                                      },
                                      0
                                    ]
                                  },
                                  "then": [
                                    {
                                      "call": "@animated_sprite.set_animation",
                                      "args": {
                                        "id": "player",
                                        "animation": "dead"
                                      }
                                    },
                                    {
                                      "call": "@game_over",
                                      "args": {}
                                    }
                                  ],
                                  "else": [
                                    {
                                      "call": "@platformer.respawn",
                                      "args": {
                                        "id": "player",
                                        "map": "map",
                                        "layer": "grounds"
                                      }
                                    },
                                    {
                                      "call": "@emit",
                                      "args": {
                                        "event": "status",
                                        "data": {
                                          "text": "Watch the gap",
                                          "lives": "{{ vars.lives }}"
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "call": "@if",
                          "args": {
                            "cond": {
                              ">": [
                                {
                                  "var": "entities.player.x"
                                },
                                6320
                              ]
                            },
                            "then": [
                              {
                                "call": "@score.add",
                                "args": {
                                  "n": 1000
                                }
                              },
                              {
                                "call": "@emit",
                                "args": {
                                  "event": "status",
                                  "data": {
                                    "text": "Course clear",
                                    "lives": "{{ vars.lives }}"
                                  }
                                }
                              },
                              {
                                "call": "@game_over",
                                "args": {}
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.scoreChanged",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_status": {
                "type": "call",
                "call": "@global.status",
                "args": {
                  "text": "{{ event.text }}",
                  "lives": "{{ event.lives }}"
                }
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.over",
                "args": {
                  "score": "{{ event.score }}"
                }
              },
              "on_reset": {
                "type": "call",
                "call": "@global.reset",
                "args": {}
              }
            }
          },
          {
            "type": "ref",
            "from": "game-controls",
            "widget": "psJoystickGamepad",
            "props": {
              "moveInput": "move_axis",
              "moveEndInput": "move_axis",
              "jumpInput": "jump",
              "attackInput": "attack",
              "height": 176,
              "backgroundColor": "#193C78"
            }
          }
        ]
      }
    ]
  }
}