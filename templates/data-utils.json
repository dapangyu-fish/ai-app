        "params": [
          "phone"
        ],
        "logic": [
          {
            "call": "@str_mask",
            "args": {
              "value": "{{ params.phone }}",
              "start": 3,
              "end": 7,
              "mask": "*"
            },
            "assign": "global._result"
          },
          {
            "expression": {
              "var": "global._result"
            }
          }
        ]
      },
      "strMaskEmail": {
        "params": [
          "email"
        ],
        "logic": [
          {
            "call": "@str_between",
            "args": {
              "value": "{{ params.email }}",
              "start": "",
              "end": "@"
            },
            "assign": "global._localPart"
          },
          {
            "call": "@str_between",
            "args": {
              "value": "{{ params.email }}",
              "start": "@",
              "end": ""
            },
            "assign": "global._domain"
          },
          {
            "call": "@str_mask",
            "args": {
              "value": "{{ global._localPart }}",
              "start": 1,
              "end": 99,
              "mask": "*"
            },
            "assign": "global._maskedLocal"
          },
          {
            "expression": {
              "cat": [
                "{{ global._maskedLocal }}",
                "@",
                "{{ global._domain }}"
              ]
            },
            "assign": "global._result"
          },
          {
            "expression": {
              "var": "global._result"
            }
          }
        ]
      },
