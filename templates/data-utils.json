      "generateOrderNo": {
        "params": [],
        "logic": [
          {
            "call": "@date_format",
            "args": {
              "format": "YYYYMMDDHHmmss"
            },
            "assign": "global._datePart"
          },
          {
            "call": "@random_chars",
            "args": {
              "length": 6,
              "charset": "numeric"
            },
            "assign": "global._randPart"
          },
          {
            "expression": {
              "cat": [
                "ORD",
                "{{ global._datePart }}",
                "{{ global._randPart }}"
              ]
            },
            "assign": "global._result"
          },
          {
            "expression": {
              "var": "global._result"
