                    "action": {
                      "type": "call",
                      "call": "@global.startEdit",
                      "args": {
                        "id": "{{ global.viewContact.id }}",
                        "name": "{{ global.viewContact.name }}",
                        "phone": "{{ global.viewContact.phone }}",
                        "email": "{{ global.viewContact.email }}",
                        "company": "{{ global.viewContact.company }}",
                        "notes": "{{ global.viewContact.notes }}"
                      }
                    },
                    "style": {
                      "textColor": "#BDC3C7"
                    }
                  }
                ]
              },
              {
                "type": "spacer",
                "height": 16
              },
              {
                "type": "text",
                "value": "👤",
                "style": {
                  "fontSize": 48,
                  "textAlign": "center"
                }
              },
              {
                "type": "spacer",
                "height": 8
              },
              {
                "type": "text",
                "value": "{{ global.viewContact.name }}",
                "style": {
                  "fontSize": 24,
                  "fontWeight": "bold",
                  "color": "#ECF0F1",
                  "textAlign": "center"
                }
              }
            ]
          },
          {
            "type": "container",
            "padding": 20,
            "children": [
              {
                "type": "container",
                "padding": 16,
                "color": "#FFFFFF",
                "borderRadius": 12,
                "shadow": 1,
                "children": [
                  {
                    "type": "text",
                    "value": "📱 电话",
                    "style": {
                      "fontSize": 12,
                      "color": "#7F8C8D"
                    }
                  },
                  {
                    "type": "text",
                    "value": "{{ global.viewContact.phone }}",
                    "style": {
                      "fontSize": 18,
                      "fontWeight": "bold",
                      "color": "#2C3E50"
                    }
                  },
                  {
                    "type": "spacer",
                    "height": 16
                  },
                  {
                    "type": "text",
                    "value": "📧 邮箱",
                    "style": {
                      "fontSize": 12,
                      "color": "#7F8C8D"
                    }
                  },
                  {
                    "type": "text",
                    "value": "{{ global.viewContact.email }}",
                    "style": {
                      "fontSize": 16,
                      "color": "#2C3E50"
                    }
                  },
                  {
                    "type": "spacer",
                    "height": 16
                  },
                  {
                    "type": "text",
                    "value": "🏢 公司",
                    "style": {
                      "fontSize": 12,
                      "color": "#7F8C8D"
                    }
                  },
                  {
                    "type": "text",
                    "value": "{{ global.viewContact.company }}",
                    "style": {
                      "fontSize": 16,
                      "color": "#2C3E50"
                    }
                  },
                  {
                    "type": "spacer",
                    "height": 16
                  },
                  {
                    "type": "text",
                    "value": "📝 备注",
                    "style": {
                      "fontSize": 12,
                      "color": "#7F8C8D"
                    }
                  },
                  {
                    "type": "text",
                    "value": "{{ global.viewContact.notes }}",
                    "style": {
                      "fontSize": 16,
                      "color": "#2C3E50",
                      "height": 1.6
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "edit",
        "title": "编辑联系人",
        "layout": "column",
        "padding": 20,
        "backgroundColor": "#EEF2F7",
        "children": [
          {
            "type": "container",
            "layout": "row",
            "children": [
              {
                "type": "button",
                "label": "← 取消",
                "variant": "text",
                "action": {
                  "type": "navigate",
                  "screen": "home"
                },
                "style": {
                  "textColor": "#2980B9"
                }
              },
              {
                "type": "spacer",
                "width": 1,
                "position": {
                  "type": "flex",
                  "flex": 1
                }
              },
              {
