{
  "dsl": "3.3",
  "appid": "e1f9d404-4e7c-4e7a-b8a2-e3c8d5f9e304",
  "meta": {
    "name": "demo-flappy-bird",
    "version": "1.0.1",
    "type": "app",
    "description": "Flappy 🐦 — 纯 JSON 实现，物理 + spawn/despawn + 碰撞全部由 JSON 编排",
    "author": "demo"
  },
  "dependencies": {
    "lib_database": "^1.0.0",
    "common-ui": "^1.3.0"
  },
  "global": {
    "variables": {
      "currentScore": 0,
      "bestScore": 0,
      "history": [],
      "historyCount": 0,
      "_b": null,
      "_ts": 0,
      "_date": "",
      "_id": "",
      "_choice": null
    },
    "functions": {
      "initDB": {
        "logic": [
          {"call": "@lib_database.createTable", "args": {
            "table": "scores",
            "columns": [
              {"name": "id", "type": "TEXT", "primary": "true"},
              {"name": "score", "type": "INTEGER"},
              {"name": "ts", "type": "INTEGER"},
              {"name": "date", "type": "TEXT"}
            ]
          }}
        ]
      },
      "loadBest": {
        "logic": [
          {"call": "@lib_database.kvGet", "args": {"key": "best_score"}, "assign": "global._b"},
          {"call": "@if", "args": {
            "condition": {"!=": [{"var": "global._b"}, null]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ global._b }}"}}
            ]
          }}
        ]
      },
      "loadHistory": {
        "logic": [
          {"call": "@lib_database.query", "args": {
            "table": "scores",
            "orderBy": "ts DESC",
            "limit": 20
          }, "assign": "global.history"},
          {"call": "@lib_database.count", "args": {"table": "scores"}, "assign": "global.historyCount"}
        ]
      },
      "handleScoreChanged": {
        "params": ["score"],
        "logic": [
          {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
          {"call": "@if", "args": {
            "condition": {">": [{"var": "params.score"}, {"var": "global.bestScore"}]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.score }}"}}
            ]
          }}
        ]
      },
      "handleGameOver": {
        "params": ["score"],
        "logic": [
          {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
          {"call": "@if", "args": {
            "condition": {">": [{"var": "params.score"}, {"var": "global.bestScore"}]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.score }}"}}
            ]
          }},
          {"call": "@lib_database.kvSet", "args": {"key": "best_score", "value": "{{ global.bestScore }}"}},
          {"call": "@timestamp", "args": {}, "assign": "global._ts"},
          {"call": "@date_format", "args": {"timestamp": "{{ global._ts }}", "format": "MM-DD HH:mm"}, "assign": "global._date"},
          {"call": "@uuid", "args": {}, "assign": "global._id"},
          {"call": "@lib_database.insert", "args": {
            "table": "scores",
            "data": {
              "id": "{{ global._id }}",
              "score": "{{ params.score }}",
              "ts": "{{ global._ts }}",
              "date": "{{ global._date }}"
            }
          }},
          {"call": "@global.loadHistory", "args": {}},
          {"call": "@common-ui.choose", "args": {
            "title": "🐦 本局结束",
            "message": "得分：{{ params.score }}\n最佳：{{ global.bestScore }}",
            "buttons": [
              {"label": "关闭", "value": null, "style": "text"},
              {"label": "再来一局", "value": "restart"}
            ]
          }, "assign": "global._choice"},
          {"call": "@if", "args": {
            "condition": {"==": [{"var": "global._choice"}, "restart"]},
            "then": [{"call": "@flame_game_reset", "args": {}}]
          }}
        ]
      },
      "showHistory": {
        "logic": [
          {"call": "@global.loadHistory", "args": {}},
          {"call": "@common-ui.showSheet", "args": {
            "title": "🐦 历史记录",
            "subtitle": "共 {{ global.historyCount }} 局",
            "content": {
              "type": "list",
              "source": "{{ global.history }}",
              "emptyText": "尚无历史记录 — 玩一局试试",
              "item_template": {
                "type": "container",
                "padding": 12,
                "layout": "row",
                "crossAxisAlignment": "center",
                "children": [
                  {
                    "type": "text",
                    "value": "{{ loop.item.date }}",
                    "style": {"fontSize": 13, "color": "#666666"},
                    "position": {"type": "flex", "flex": 1}
                  },
                  {
                    "type": "text",
                    "value": "{{ loop.item.score }} 分",
                    "style": {"fontSize": 15, "fontWeight": "bold", "color": "#FFA500"}
                  }
                ]
              }
            }
          }}
        ]
      }
    }
  },
  "steps": [
    {"call": "@global.initDB", "args": {}},
    {"call": "@global.loadBest", "args": {}},
    {"call": "@global.loadHistory", "args": {}}
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "Flappy",
        "appBar": {
          "title": "Flappy 🐦",
          "centerTitle": true,
          "backgroundColor": "#70C5CE",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {"type": "call", "call": "@flame_game_reset", "args": {}}
            },
            {
              "icon": "history",
              "action": {"type": "call", "call": "@global.showHistory", "args": {}}
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 12,
            "color": "#70C5CE",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "得分：{{ global.currentScore }}",
                "style": {"fontSize": 14, "color": "#FFFFFF", "fontWeight": "bold"},
                "position": {"type": "flex", "flex": 1}
              },
              {
                "type": "text",
                "value": "最佳：{{ global.bestScore }}",
                "style": {"fontSize": 13, "color": "#FFF8DC"}
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {"kind": "pixel", "bg": "#70C5CE"},
              "overlay": {"game_over": false},
              "vars": {
                "gravity": 1400,
                "jump_v": -400,
                "pipe_speed": -160,
                "gap_h": 160,
                "pipe_w": 60,
                "spawn_interval": 1.6,
                "spawn_timer": 99,
                "_gap_y": 200,
                "_pid": 0
              },
              "entities": {
                "bird": {
                  "kind": "pixel",
                  "position": [80, 200],
                  "size": [40, 40],
                  "velocity": [0, 0],
                  "render": {
                    "shape": "text",
                    "value": "🐦",
                    "fontSize": 32
                  }
                }
              },
              "init": {
                "logic": [
                  {"call": "@spawn", "args": {
                    "kind": "pixel",
                    "id": "floor",
                    "position": [0, {"-": [{"var": "world.height"}, 20]}],
                    "size": [{"var": "world.width"}, 20],
                    "velocity": [0, 0],
                    "render": {"shape": "rect", "color": "#DEB887"}
                  }}
                ]
              },
              "input": {
                "tap": [
                  {"call": "@pixel.set_velocity", "args": {
                    "id": "bird",
                    "v": [0, {"var": "vars.jump_v"}]
                  }}
                ]
              },
              "frame": {
                "logic": [
                  {"call": "@pixel.add_velocity", "args": {
                    "id": "bird",
                    "dv": [0, {"*": [{"var": "vars.gravity"}, {"var": "event.dt"}]}]
                  }},
                  {"call": "@if", "args": {
                    "cond": {"<": [{"var": "entities.bird.y"}, -40]},
                    "then": [{"call": "@game_over"}]
                  }},
                  {"call": "@if", "args": {
                    "cond": {"call": "@collide.rect", "args": {"a": "bird", "b": "floor"}},
                    "then": [{"call": "@game_over"}]
                  }},
                  {"call": "@set", "args": {
                    "var": "vars.spawn_timer",
                    "value": {"+": [{"var": "vars.spawn_timer"}, {"var": "event.dt"}]}
                  }},
                  {"call": "@if", "args": {
                    "cond": {">=": [{"var": "vars.spawn_timer"}, {"var": "vars.spawn_interval"}]},
                    "then": [
                      {"call": "@set", "args": {"var": "vars.spawn_timer", "value": 0}},
                      {"call": "@set", "args": {
                        "var": "vars._gap_y",
                        "value": {"call": "@random_int", "args": {"min": 80, "max": 380}}
                      }},
                      {"call": "@set", "args": {
                        "var": "vars._pid",
                        "value": {"call": "@random_int", "args": {"min": 1000, "max": 999999}}
                      }},
                      {"call": "@spawn", "args": {
                        "kind": "pixel",
                        "id": "pipe_top_{{ vars._pid }}",
                        "position": [{"var": "world.width"}, 0],
                        "size": [{"var": "vars.pipe_w"}, {"var": "vars._gap_y"}],
                        "velocity": [{"var": "vars.pipe_speed"}, 0],
                        "render": {"shape": "rect", "color": "#2A9D45"}
                      }},
                      {"call": "@spawn", "args": {
                        "kind": "pixel",
                        "id": "pipe_bot_{{ vars._pid }}",
                        "position": [
                          {"var": "world.width"},
                          {"+": [{"var": "vars._gap_y"}, {"var": "vars.gap_h"}]}
                        ],
                        "size": [{"var": "vars.pipe_w"}, {"var": "world.height"}],
                        "velocity": [{"var": "vars.pipe_speed"}, 0],
                        "render": {"shape": "rect", "color": "#2A9D45"}
                      }}
                    ]
                  }},
                  {"call": "@for_each_entity", "args": {
                    "where_prefix": "pipe_top_",
                    "do": [
                      {"comment": "PROBE: 每次迭代 +1，验证 for_each 是否在跑"},
                      {"call": "@score.add", "args": {"n": 1}},
                      {"call": "@if", "args": {
                        "cond": {"call": "@collide.rect", "args": {"a": "bird", "b": "{{ loop.id }}"}},
                        "then": [
                          {"comment": "PROBE: 检测到碰撞 → 分数暴涨 999"},
                          {"call": "@score.add", "args": {"n": 999}},
                          {"call": "@game_over"}
                        ]
                      }},
                      {"call": "@if", "args": {
                        "cond": {"<": [
                          {"+": [{"var": "loop.entity.x"}, {"var": "vars.pipe_w"}]},
                          0
                        ]},
                        "then": [
                          {"call": "@despawn", "args": {"id": "{{ loop.id }}"}}
                        ]
                      }}
                    ]
                  }},
                  {"call": "@for_each_entity", "args": {
                    "where_prefix": "pipe_bot_",
                    "do": [
                      {"call": "@if", "args": {
                        "cond": {"call": "@collide.rect", "args": {"a": "bird", "b": "{{ loop.id }}"}},
                        "then": [{"call": "@game_over"}]
                      }},
                      {"call": "@if", "args": {
                        "cond": {"<": [
                          {"+": [{"var": "loop.entity.x"}, {"var": "vars.pipe_w"}]},
                          0
                        ]},
                        "then": [{"call": "@despawn", "args": {"id": "{{ loop.id }}"}}]
                      }}
                    ]
                  }}
                ]
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.handleScoreChanged",
                "args": {"score": "{{ event.score }}"}
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.handleGameOver",
                "args": {"score": "{{ event.score }}"}
              }
            }
          }
        ]
      }
    ]
  }
}
