                "action": { "call": "@global.openCamera", "args": {} }
              },
              {
                "type": "button",
                "label": "消息",
                "icon": "inbox",
                "variant": "text",
                "style": { "textColor": "#888888", "fontSize": 11, "paddingH": 4, "paddingV": 4 },
                "position": { "type": "flex", "flex": 1 },
                "action": { "call": "@show_toast", "args": { "message": "消息页开发中 💬" } }
              },
              {
                "type": "button",
                "label": "我",
                "icon": "person",
                "variant": "text",
                "style": { "textColor": "#FFFFFF", "fontSize": 11, "paddingH": 4, "paddingV": 4 },
                "position": { "type": "flex", "flex": 1 },
                "action": { "type": "navigate", "screen": "profile" }
              }
            ]
          }
        ]
      },
      {
        "id": "detail",
