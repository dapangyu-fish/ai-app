                      { "type": "spacer", "width": 16 },
                      {
                        "type": "button",
                        "label": " 3456",
                        "icon": "chat",
                        "variant": "text",
                        "style": { "textColor": "#FFFFFF", "fontSize": 12, "paddingH": 4, "paddingV": 2 }
                      },
                      { "type": "spacer", "width": 16 },
                      {
                        "type": "button",
                        "label": " 892",
                        "icon": "share",
                        "variant": "text",
                        "style": { "textColor": "#FFFFFF", "fontSize": 12, "paddingH": 4, "paddingV": 2 }
                      }
                    ]
                  }
                ]
              }
