              },
              {
                "type": "text",
                "value": "最新",
                "style": { "fontSize": 13, "color": "#888888" }
              }
            ]
          },
          {
            "type": "list",
            "source": "{{ global.comments }}",
            "emptyText": "暂无评论",
            "item_template": {
              "type": "container",
              "layout": "row",
              "padding": 12,
              "color": "#0A0A0A",
              "margin": 7,
              "borderRadius": 8,
              "children": [
                {
                  "type": "image",
                  "url": "{{ loop.item.avatar }}",
                  "width": 36,
                  "height": 36,
                  "borderRadius": 18
                },
                { "type": "spacer", "width": 10 },
                {
                  "type": "container",
                  "layout": "column",
                  "position": { "type": "flex", "flex": 1 },
                  "children": [
                    {
                      "type": "container",
                      "layout": "row",
                      "children": [
                        {
                          "type": "text",
                          "value": "{{ loop.item.user }}",
                          "style": { "fontSize": 13, "fontWeight": "bold", "color": "#FFFFFF" },
                          "position": { "type": "flex", "flex": 1 }
                        },
                        {
                          "type": "text",
