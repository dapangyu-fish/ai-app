                "action": { "type": "navigate", "screen": "home" }
              },
              {
                "type": "text",
                "value": "评论",
                "style": { "fontSize": 18, "fontWeight": "bold", "color": "#FFFFFF" },
                "position": { "type": "flex", "flex": 1 }
