    "functions": {
      "toggleLike": {
        "params": ["id"],
        "return": "None",
        "logic": [
          {
            "call": "@if",
            "args": {
              "condition": { "in": [{ "var": "params.id" }, { "var": "$.global.likedIds" }] },
              "then": [
                { "call": "@set", "args": { "var": "$.global.likedIds", "value": { "filter": [{ "var": "$.global.likedIds" }, { "!=": [{ "var": "" }, { "var": "params.id" }] }] } } },
                { "call": "@show_toast", "args": { "message": "已取消点赞" } }
              ],
              "else": [
                { "call": "@set", "args": { "var": "$.global.likedIds", "value": { "merge": [{ "var": "$.global.likedIds" }, [{ "var": "params.id" }]] } } },
                { "call": "@show_toast", "args": { "message": "已点赞 ❤️" } }
              ]
            }
          }
        ]
      },
      "changeAvatar": {
        "params": [],
        "return": "None",
        "logic": [
          { "call": "@pick_image", "args": { "bind": "$.global.avatarUrl" } },
          { "call": "@show_toast", "args": { "message": "头像已更新 ✨" } }
        ]
      },
      "openCamera": {
        "params": [],
        "return": "None",
        "logic": [
          { "call": "@take_photo", "args": { "bind": "$.global.lastPhoto" } },
          { "call": "@show_toast", "args": { "message": "已拍摄 📸" } }
        ]
      }
    }
  },
  "steps": [
    { "call": "@print", "args": { "value": "TikTok v3 启动成功！" } }
