{
  "dsl": "3.3",
  "appid": "f3e8a505-5b8d-4a8b-b9c3-d4e9f5a8b9c5",
  "meta": {
    "name": "demo-jump",
    "version": "1.0.1",
    "type": "app",
    "description": "跳一跳 — 纯 JSON 实现，蓄力 / 抛物线 / 平台滚动全部由 JSON 编排",
    "author": "fish"
  },
  "dependencies": {
    "lib_database": "^1.0.0",
    "common-ui": "^1.3.0"
  },
  "global": {
    "variables": {
      "currentScore": 0,
      "bestScore": 0,
      "history": [],
      "historyCount": 0,
      "_b": null,
      "_ts": 0,
      "_date": "",
      "_id": "",
      "_choice": null
    },
    "functions": {
      "initDB": {
        "logic": [
          {"call": "@lib_database.createTable", "args": {
            "table": "scores",
            "columns": [
              {"name": "id", "type": "TEXT", "primary": "true"},
              {"name": "score", "type": "INTEGER"},
              {"name": "ts", "type": "INTEGER"},
              {"name": "date", "type": "TEXT"}
            ]
          }}
        ]
      },
      "loadBest": {
        "logic": [
          {"call": "@lib_database.kvGet", "args": {"key": "best_score"}, "assign": "global._b"},
          {"call": "@if", "args": {
            "condition": {"!=": [{"var": "global._b"}, null]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ global._b }}"}}
            ]
          }}
        ]
      },
      "loadHistory": {
        "logic": [
          {"call": "@lib_database.query", "args": {
            "table": "scores",
            "orderBy": "ts DESC",
            "limit": 20
          }, "assign": "global.history"},
          {"call": "@lib_database.count", "args": {"table": "scores"}, "assign": "global.historyCount"}
        ]
      },
      "handleScoreChanged": {
        "params": ["score"],
        "logic": [
          {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
          {"call": "@if", "args": {
            "condition": {">": [{"var": "params.score"}, {"var": "global.bestScore"}]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.score }}"}}
            ]
          }}
        ]
      },
      "handleGameOver": {
        "params": ["score"],
        "logic": [
          {"call": "@set", "args": {"var": "global.currentScore", "value": "{{ params.score }}"}},
          {"call": "@if", "args": {
            "condition": {">": [{"var": "params.score"}, {"var": "global.bestScore"}]},
            "then": [
              {"call": "@set", "args": {"var": "global.bestScore", "value": "{{ params.score }}"}}
            ]
          }},
          {"call": "@lib_database.kvSet", "args": {"key": "best_score", "value": "{{ global.bestScore }}"}},
          {"call": "@timestamp", "args": {}, "assign": "global._ts"},
          {"call": "@date_format", "args": {"timestamp": "{{ global._ts }}", "format": "MM-DD HH:mm"}, "assign": "global._date"},
          {"call": "@uuid", "args": {}, "assign": "global._id"},
          {"call": "@lib_database.insert", "args": {
            "table": "scores",
            "data": {
              "id": "{{ global._id }}",
              "score": "{{ params.score }}",
              "ts": "{{ global._ts }}",
              "date": "{{ global._date }}"
            }
          }},
          {"call": "@global.loadHistory", "args": {}},
          {"call": "@common-ui.choose", "args": {
            "title": "🦘 本局结束",
            "message": "得分：{{ params.score }}\n最佳：{{ global.bestScore }}",
            "buttons": [
              {"label": "关闭", "value": null, "style": "text"},
              {"label": "再来一局", "value": "restart"}
            ]
          }, "assign": "global._choice"},
          {"call": "@if", "args": {
            "condition": {"==": [{"var": "global._choice"}, "restart"]},
            "then": [{"call": "@flame_game_reset", "args": {}}]
          }}
        ]
      },
      "showHistory": {
        "logic": [
          {"call": "@global.loadHistory", "args": {}},
          {"call": "@common-ui.showSheet", "args": {
            "title": "🦘 历史记录",
            "subtitle": "共 {{ global.historyCount }} 局",
            "content": {
              "type": "list",
              "source": "{{ global.history }}",
              "emptyText": "尚无历史记录 — 玩一局试试",
              "item_template": {
                "type": "container",
                "padding": 12,
                "layout": "row",
                "crossAxisAlignment": "center",
                "children": [
                  {
                    "type": "text",
                    "value": "{{ loop.item.date }}",
                    "style": {"fontSize": 13, "color": "#666666"},
                    "position": {"type": "flex", "flex": 1}
                  },
                  {
                    "type": "text",
                    "value": "{{ loop.item.score }} 分",
                    "style": {"fontSize": 15, "fontWeight": "bold", "color": "#FF7F50"}
                  }
                ]
              }
            }
          }}
        ]
      }
    }
  },
  "steps": [
    {"call": "@global.initDB", "args": {}},
    {"call": "@global.loadBest", "args": {}},
    {"call": "@global.loadHistory", "args": {}}
  ],
  "ui": {
    "screens": [
      {
        "id": "home",
        "title": "Jump",
        "appBar": {
          "title": "Jump 🦘",
          "centerTitle": true,
          "backgroundColor": "#FF7F50",
          "color": "#FFFFFF",
          "actions": [
            {
              "icon": "replay",
              "action": {"type": "call", "call": "@flame_game_reset", "args": {}}
            },
            {
              "icon": "history",
              "action": {"type": "call", "call": "@global.showHistory", "args": {}}
            }
          ]
        },
        "layout": "column",
        "padding": 0,
        "children": [
          {
            "type": "container",
            "padding": 12,
            "color": "#FF7F50",
            "layout": "row",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "value": "得分：{{ global.currentScore }}",
                "style": {"fontSize": 14, "color": "#FFFFFF", "fontWeight": "bold"},
                "position": {"type": "flex", "flex": 1}
              },
              {
                "type": "text",
                "value": "最佳：{{ global.bestScore }}",
                "style": {"fontSize": 13, "color": "#FFE4D5"}
              }
            ]
          },
          {
            "type": "expanded",
            "child": {
              "type": "flame_game",
              "world": {"kind": "pixel", "bg": "#FFE4D5"},
              "overlay": {"game_over": false},
              "vars": {
                "state": "ready",
                "gravity": 1500,
                "jump_vy": -650,
                "vx_per_ms": 0.32,
                "max_held_ms": 1300,
                "roll_speed": 220,
                "anchor_x": 60,
                "platform_w": 80,
                "player_size": 36,
                "platform_y": 380,
                "_held": 0,
                "_vx": 0,
                "_next_x": 240
              },
              "entities": {
                "player": {
                  "kind": "pixel",
                  "position": [80, 320],
                  "size": [36, 36],
                  "velocity": [0, 0],
                  "render": {
                    "shape": "text",
                    "value": "🦘",
                    "fontSize": 30
                  }
                }
              },
              "init": {
                "logic": [
                  {"call": "@set", "args": {
                    "var": "vars.platform_y",
                    "value": {"-": [{"var": "world.height"}, 80]}
                  }},
                  {"call": "@spawn", "args": {
                    "kind": "pixel",
                    "id": "current_platform",
                    "position": [{"var": "vars.anchor_x"}, {"var": "vars.platform_y"}],
                    "size": [{"var": "vars.platform_w"}, 30],
                    "velocity": [0, 0],
                    "render": {"shape": "rect", "color": "#8B4513"}
                  }},
                  {"call": "@set", "args": {
                    "var": "vars._next_x",
                    "value": {"call": "@random_int", "args": {"min": 200, "max": 320}}
                  }},
                  {"call": "@spawn", "args": {
                    "kind": "pixel",
                    "id": "next_platform",
                    "position": [{"var": "vars._next_x"}, {"var": "vars.platform_y"}],
                    "size": [{"var": "vars.platform_w"}, 30],
                    "velocity": [0, 0],
                    "render": {"shape": "rect", "color": "#8B4513"}
                  }},
                  {"call": "@pixel.set_position", "args": {
                    "id": "player",
                    "p": [
                      {"+": [{"var": "vars.anchor_x"}, 22]},
                      {"-": [{"var": "vars.platform_y"}, {"var": "vars.player_size"}]}
                    ]
                  }}
                ]
              },
              "input": {
                "press_end": [
                  {"call": "@if", "args": {
                    "cond": {"==": [{"var": "vars.state"}, "ready"]},
                    "then": [
                      {"call": "@set", "args": {
                        "var": "vars._held",
                        "value": {"min": [{"var": "event.held_ms"}, {"var": "vars.max_held_ms"}]}
                      }},
                      {"call": "@set", "args": {
                        "var": "vars._vx",
                        "value": {"*": [{"var": "vars._held"}, {"var": "vars.vx_per_ms"}]}
                      }},
                      {"call": "@pixel.set_velocity", "args": {
                        "id": "player",
                        "v": [{"var": "vars._vx"}, {"var": "vars.jump_vy"}]
                      }},
                      {"call": "@set", "args": {"var": "vars.state", "value": "jumping"}}
                    ]
                  }}
                ]
              },
              "frame": {
                "logic": [
                  {"call": "@if", "args": {
                    "cond": {"==": [{"var": "vars.state"}, "jumping"]},
                    "then": [
                      {"call": "@pixel.add_velocity", "args": {
                        "id": "player",
                        "dv": [0, {"*": [{"var": "vars.gravity"}, {"var": "event.dt"}]}]
                      }},
                      {"call": "@if", "args": {
                        "cond": {">": [{"var": "entities.player.y"}, {"var": "world.height"}]},
                        "then": [{"call": "@game_over"}]
                      }},
                      {"call": "@if", "args": {
                        "cond": {"and": [
                          {">=": [
                            {"+": [{"var": "entities.player.y"}, {"var": "vars.player_size"}]},
                            {"var": "vars.platform_y"}
                          ]},
                          {">=": [{"var": "entities.player.vy"}, 0]}
                        ]},
                        "then": [
                          {"call": "@if", "args": {
                            "cond": {"call": "@collide.rect", "args": {"a": "player", "b": "next_platform"}},
                            "then": [
                              {"call": "@score.add", "args": {"n": 1}},
                              {"call": "@pixel.set_velocity", "args": {"id": "player", "v": [{"-": [0, {"var": "vars.roll_speed"}]}, 0]}},
                              {"call": "@pixel.set_velocity", "args": {"id": "current_platform", "v": [{"-": [0, {"var": "vars.roll_speed"}]}, 0]}},
                              {"call": "@pixel.set_velocity", "args": {"id": "next_platform", "v": [{"-": [0, {"var": "vars.roll_speed"}]}, 0]}},
                              {"call": "@pixel.set_position", "args": {
                                "id": "player",
                                "p": [
                                  {"var": "entities.player.x"},
                                  {"-": [{"var": "vars.platform_y"}, {"var": "vars.player_size"}]}
                                ]
                              }},
                              {"call": "@set", "args": {"var": "vars.state", "value": "rolling"}}
                            ],
                            "else": [
                              {"call": "@game_over"}
                            ]
                          }}
                        ]
                      }}
                    ]
                  }},
                  {"call": "@if", "args": {
                    "cond": {"==": [{"var": "vars.state"}, "rolling"]},
                    "then": [
                      {"call": "@if", "args": {
                        "cond": {"<=": [{"var": "entities.next_platform.x"}, {"var": "vars.anchor_x"}]},
                        "then": [
                          {"call": "@pixel.set_velocity", "args": {"id": "player", "v": [0, 0]}},
                          {"call": "@despawn", "args": {"id": "current_platform"}},
                          {"call": "@despawn", "args": {"id": "next_platform"}},
                          {"call": "@spawn", "args": {
                            "kind": "pixel",
                            "id": "current_platform",
                            "position": [{"var": "vars.anchor_x"}, {"var": "vars.platform_y"}],
                            "size": [{"var": "vars.platform_w"}, 30],
                            "velocity": [0, 0],
                            "render": {"shape": "rect", "color": "#8B4513"}
                          }},
                          {"call": "@pixel.set_position", "args": {
                            "id": "player",
                            "p": [
                              {"+": [{"var": "vars.anchor_x"}, 22]},
                              {"-": [{"var": "vars.platform_y"}, {"var": "vars.player_size"}]}
                            ]
                          }},
                          {"call": "@set", "args": {
                            "var": "vars._next_x",
                            "value": {"call": "@random_int", "args": {
                              "min": {"+": [{"var": "vars.anchor_x"}, 160]},
                              "max": {"+": [{"var": "vars.anchor_x"}, 280]}
                            }}
                          }},
                          {"call": "@spawn", "args": {
                            "kind": "pixel",
                            "id": "next_platform",
                            "position": [{"var": "vars._next_x"}, {"var": "vars.platform_y"}],
                            "size": [{"var": "vars.platform_w"}, 30],
                            "velocity": [0, 0],
                            "render": {"shape": "rect", "color": "#8B4513"}
                          }},
                          {"call": "@set", "args": {"var": "vars.state", "value": "ready"}}
                        ]
                      }}
                    ]
                  }}
                ]
              },
              "on_score_changed": {
                "type": "call",
                "call": "@global.handleScoreChanged",
                "args": {"score": "{{ event.score }}"}
              },
              "on_game_over": {
                "type": "call",
                "call": "@global.handleGameOver",
                "args": {"score": "{{ event.score }}"}
              }
            }
          }
        ]
      }
    ]
  }
}
