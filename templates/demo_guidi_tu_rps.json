                          "var": "global.p1Count"
                        },
                        4
                      ]
                    },
                    "then": [
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.p1.{{ global.p1Count }}",
                          "value": "{{ params.gesture }}"
                        }
                      },
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.p1Url{{ global.p1Count }}",
                          "value": "{{ params.url }}"
                        }
                      },
                      {
                        "call": "@set",
                        "args": {
                          "var": "global.p1Count",
                          "value": {
                            "+": [
                              {
                                "var": "global.p1Count"
                              },
                              1
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "call": "@if",
                  "args": {
                    "condition": {
                      "==": [
                        {
