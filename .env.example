# 环境配置文件示例
#
# 使用方式：
# 1. 复制此文件为 .env.development、.env.staging、.env.production
# 2. 根据不同环境修改对应的配置
# 3. 在运行时通过 --dart-define 传递环境变量
#
# 示例：
# flutter run --dart-define=BACKEND_URL=http://localhost:5566 --dart-define=DEBUG=true

# ==================== 开发环境配置 ====================
# BACKEND_URL=http://localhost:5566
# SUPABASE_URL=https://myapp-auth.dapangyu.work
# MINIO_URL=https://myapp-oss-endpoint.dapangyu.work
# DEBUG=true
# ENABLE_LOGGING=true

# ==================== 测试环境配置 ====================
# BACKEND_URL=https://test-backend.dapangyu.work
# SUPABASE_URL=https://test-auth.dapangyu.work
# MINIO_URL=https://test-oss.dapangyu.work
# DEBUG=true
# ENABLE_LOGGING=true

# ==================== 生产环境配置 ====================
# BACKEND_URL=https://myapp-backend.dapangyu.work
# SUPABASE_URL=https://myapp-auth.dapangyu.work
# MINIO_URL=https://myapp-oss-endpoint.dapangyu.work
# DEBUG=false
# ENABLE_LOGGING=false
