{
  "version": 1,
  "node": {
    "id": "myapp-local",
    "role": "single-node-lab",
    "public_ip": "127.0.0.1"
  },
  "paths": {
    "root": "/opt/myapp",
    "source": "/opt/myapp/current-agent-control-plane",
    "data_root": "/mnt/myapp",
    "data_root_prompted": false,
    "state": "/mnt/myapp/state",
    "logs": "/mnt/myapp/logs",
    "secrets_dir": "/etc/myapp/secrets.d",
    "agent_log_dir": "/mnt/myapp/agent-node/logs",
    "config_bundle": "/mnt/myapp/myapp-config.json"
  },
  "registries": {
    "docker_hub": {
      "namespace": "dapangyufish"
    }
  },
  "images": {
    "backend": "dapangyufish/myapp-backend:agent-control-plane",
    "agent_node": "dapangyufish/myapp-agent-node:agent-control-plane",
    "agent_runtime": "dapangyufish/myapp-agent-runtime:agent-control-plane"
  },
  "domains": {
    "backend": "http://127.0.0.1:5566",
    "registry": "http://127.0.0.1:3254",
    "oss": "http://127.0.0.1:9000",
    "config_center": "http://127.0.0.1:5000",
    "agent_node": "http://agent-node:5590"
  }
}
