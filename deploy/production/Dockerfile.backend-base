FROM python:3.11-slim@sha256:506f2951c04925a2a98fc0604e0e0a3ffd2788cc4aed0eb77c3517c98ac651c0

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        procps \
        gcc \
        build-essential \
        libpq5 \
        portaudio19-dev \
        libasound2-dev \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code opencode-ai \
    && ln -sf "$(command -v claude)" /usr/local/bin/claude \
    && ln -sf "$(command -v opencode)" /usr/local/bin/opencode \
    && claude --version \
    && opencode --version \
    && mkdir -p /var/lib/ai-app/codex-npm-cache /var/lib/ai-app/codex-home /var/lib/ai-app/opencode-home \
    && npm_config_cache=/var/lib/ai-app/codex-npm-cache npx -y @openai/codex@0.136.0 --version \
    && rm -rf /var/lib/apt/lists/* /root/.npm

ENV CLAUDE_BIN=/usr/local/bin/claude \
    CODEX_BIN=npx \
    OPENCODE_BIN=/usr/local/bin/opencode \
    CODEX_NPX_PACKAGE=@openai/codex@0.136.0 \
    CODEX_NODE_BIN_DIR=/usr/bin \
    CODEX_NPM_CACHE=/var/lib/ai-app/codex-npm-cache \
    CODEX_HOME=/var/lib/ai-app/codex-home \
    OPENCODE_HOME=/var/lib/ai-app/opencode-home

# 锁定安装：uv 编出的 requirements.lock（全量传递依赖 + hash），pip --require-hashes 强校验。
# 改依赖：编辑 backend/requirements.txt 后 `uv pip compile backend/requirements.txt
#   -o backend/requirements.lock --generate-hashes --python-version 3.11` 重新生成。
COPY backend/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock
