FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        wget \
        git \
        openssh-client \
        coreutils \
        findutils \
        grep \
        sed \
        gawk \
        ripgrep \
        jq \
        procps \
        psmisc \
        lsof \
        file \
        tree \
        unzip \
        zip \
        tar \
        gzip \
        xz-utils \
        uuid-runtime \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        build-essential \
        libpq5 \
        portaudio19-dev \
        libasound2-dev \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code @openai/codex@0.136.0 \
    && ln -sf "$(command -v claude)" /usr/local/bin/claude \
    && ln -sf "$(command -v codex)" /usr/local/bin/codex \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && npm_config_cache=/tmp/codex-npm-cache npx -y @openai/codex@0.136.0 --version \
    && rm -rf /var/lib/apt/lists/* /root/.npm /tmp/codex-npm-cache

ENV PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CLAUDE_BIN=/usr/local/bin/claude \
    CODEX_BIN=/usr/local/bin/codex \
    CODEX_NPX_PACKAGE=@openai/codex@0.136.0 \
    CODEX_NODE_BIN_DIR=/usr/bin \
    CODEX_NPM_CACHE=/home/agent/.npm \
    CODEX_HOME=/home/agent/.codex \
    AI_APP_PROJECT_ROOT=/app

WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend/ /app/backend/
COPY lib/ /app/lib/
COPY assets/ /app/assets/
COPY test/ /app/test/
COPY templates/ /app/templates/
COPY docs/ /app/docs/
COPY scripts/ /app/scripts/
COPY JSON-DSL.md /app/JSON-DSL.md
COPY pubspec.yaml pubspec.lock analysis_options.yaml /app/
COPY deploy/production/agent_runner.py /opt/myapp/agent_runner.py

RUN useradd -m -u 10001 -s /bin/bash agent \
    && mkdir -p /workspace /home/agent/.claude /home/agent/.codex /home/agent/.npm /run/myapp-agent \
    && touch /run/myapp-agent/payload.json \
    && chown -R agent:agent /workspace /home/agent /opt/myapp /run/myapp-agent \
    && chmod 755 /opt/myapp/agent_runner.py

USER 10001:10001
WORKDIR /app

CMD ["bash", "-lc", "python3 --version && node --version && claude --version && codex --version"]
