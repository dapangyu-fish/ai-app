# 由 myapp-ctl 生成的 /etc/myapp/secrets.d/supabase.env 提供变量。
# ${...} 占位会被 Docker Compose 环境变量填充。
# 这份模板覆盖 Supabase 官方 self-hosted .env.example 的所有字段，对应版本
# v2026.04 的 docker-compose.yml。

############
# Secrets
############
POSTGRES_PASSWORD=${SUPABASE_DB_PASSWORD}
JWT_SECRET=${JWT_SECRET}
ANON_KEY=${SUPABASE_ANON_KEY}
SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY}
SUPABASE_PUBLISHABLE_KEY=${SUPABASE_ANON_KEY}
SUPABASE_SECRET_KEY=${SUPABASE_SERVICE_ROLE_KEY}
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=${SUPABASE_DASHBOARD_PASSWORD}
SECRET_KEY_BASE=${SUPABASE_SECRET_KEY_BASE}
VAULT_ENC_KEY=${SUPABASE_VAULT_ENC_KEY}
PG_META_CRYPTO_KEY=${SUPABASE_PG_META_CRYPTO_KEY}
LOGFLARE_PUBLIC_ACCESS_TOKEN=${SUPABASE_LOGFLARE_PUBLIC}
LOGFLARE_PRIVATE_ACCESS_TOKEN=${SUPABASE_LOGFLARE_PRIVATE}

############
# Asymmetric / JWKS（v2026 新增，留空走默认对称 HS256）
############
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_KEYS=
JWT_JWKS=

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=${SUPABASE_DB_PORT}

############
# Supavisor pooler
############
POOLER_TENANT_ID=${SUPABASE_POOLER_TENANT_ID}
POOLER_PROXY_PORT_TRANSACTION=${SUPABASE_POOLER_PORT}
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

############
# API Proxy (Kong)
############
KONG_HTTP_PORT=${KONG_HTTP_PORT}
KONG_HTTPS_PORT=${KONG_HTTPS_PORT}

############
# External URLs
############
API_EXTERNAL_URL=http://${HOST_IP}:${KONG_HTTP_PORT}
SUPABASE_PUBLIC_URL=http://${HOST_IP}:${KONG_HTTP_PORT}
SITE_URL=http://${HOST_IP}:${KONG_HTTP_PORT}
SAML_EXTERNAL_URL=
ADDITIONAL_REDIRECT_URLS=

############
# Auth - 测试环境关键开关
############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
JWT_EXPIRY=3600

############
# Mailer paths（测试环境 autoconfirm=true 用不到，留默认）
############
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify

############
# SMTP（测试环境不发邮件；但 SMTP_PORT 必须给数字，否则 GoTrue 启动 envconfig
# 报 "converting '' to type int" 直接 fatal）
############
SMTP_ADMIN_EMAIL=noreply@example.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=test-env

############
# OAuth providers（全部禁用）
############
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_SECRET=

############
# MFA（全部禁用）
############
MFA_PHONE_ENROLL_ENABLED=false
MFA_PHONE_VERIFY_ENABLED=false
MFA_TOTP_ENROLL_ENABLED=false
MFA_TOTP_VERIFY_ENABLED=false
MFA_MAX_ENROLLED_FACTORS=10

############
# SAML（禁用）
############
SAML_ENABLED=false
SAML_PRIVATE_KEY=
SAML_ALLOW_ENCRYPTED_ASSERTIONS=false
SAML_RELAY_STATE_VALIDITY_PERIOD=300

############
# SMS（禁用）
############
SMS_PROVIDER=
SMS_OTP_EXP=60
SMS_OTP_LENGTH=6
SMS_MAX_FREQUENCY=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGE_SERVICE_SID=
SMS_TEMPLATE=
SMS_TEST_OTP=

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000

############
# Edge Functions
############
FUNCTIONS_VERIFY_JWT=false

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
OPENAI_API_KEY=

############
# Storage（测试环境用默认本地 stub，应用走外部 app-minio）
############
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true

############
# Analytics / Logflare
############
SAML_RATE_LIMIT_ASSERTION=
REGION=local

############
# Misc
############
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
