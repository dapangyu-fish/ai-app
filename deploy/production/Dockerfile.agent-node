ARG BASE_IMAGE=dapangyu/myapp-agent-node-base:agent-control-plane
FROM ${BASE_IMAGE}

ARG MYAPP_BUILD_COMMIT=unknown
ARG MYAPP_BUILD_VERSION=unknown

ENV MYAPP_BUILD_COMMIT=${MYAPP_BUILD_COMMIT} \
    MYAPP_BUILD_VERSION=${MYAPP_BUILD_VERSION}

WORKDIR /app/backend

COPY backend/agent_node_service.py /app/backend/agent_node_service.py
COPY backend/providers/ /app/backend/providers/

ENV AGENT_NODE_HOST=0.0.0.0 \
    AGENT_NODE_PORT=5590 \
    AGENT_NODE_STATE_ROOT=/var/lib/myapp/agent-node/state \
    AGENT_NODE_WORKSPACE_ROOT=/var/lib/myapp/agent-node/workspaces \
    AGENT_NODE_LOG_DIR=/var/log/myapp/agent-node \
    AGENT_NODE_RUNTIME_IMAGE=dapangyu/myapp-agent-runtime:latest

EXPOSE 5590

CMD ["gunicorn", "-k", "gthread", "-w", "1", "--threads", "16", "-b", "0.0.0.0:5590", "agent_node_service:APP"]
