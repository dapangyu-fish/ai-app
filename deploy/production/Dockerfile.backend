FROM python:3.11-slim

ARG MYAPP_BUILD_COMMIT=unknown
ARG MYAPP_BUILD_VERSION=unknown

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MYAPP_BUILD_COMMIT=${MYAPP_BUILD_COMMIT} \
    MYAPP_BUILD_VERSION=${MYAPP_BUILD_VERSION}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        procps \
        gcc \
        build-essential \
        libpq5 \
        portaudio19-dev \
        libasound2-dev \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code \
    && ln -sf "$(command -v claude)" /usr/local/bin/claude \
    && claude --version \
    && mkdir -p /var/lib/ai-app/codex-npm-cache /var/lib/ai-app/codex-home \
    && npm_config_cache=/var/lib/ai-app/codex-npm-cache npx -y @openai/codex@0.136.0 --version \
    && rm -rf /var/lib/apt/lists/* /root/.npm

ENV CLAUDE_BIN=/usr/local/bin/claude \
    CODEX_BIN=npx \
    CODEX_NPX_PACKAGE=@openai/codex@0.136.0 \
    CODEX_NODE_BIN_DIR=/usr/bin \
    CODEX_NPM_CACHE=/var/lib/ai-app/codex-npm-cache \
    CODEX_HOME=/var/lib/ai-app/codex-home

COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && \
    pip install --no-cache-dir "pyjwt>=2.8.0" "httpx>=0.27.0" "flask-caching>=2.1.0"

COPY backend/ /app/backend/
COPY lib/json_ui/widgets/icon_registry.dart /app/lib/json_ui/widgets/icon_registry.dart
COPY config_center/ /app/config_center/
COPY user_center/ /app/user_center/

EXPOSE 5566 3254 5000 5567

CMD ["python", "/app/backend/app.py"]
