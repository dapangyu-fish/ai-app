# 后端 + AI worker + Registry + Config center + User center 共用镜像。
# 通过 compose 的 command 字段区分入口（python app.py / ai_worker_daemon.py / registry_server.py / config_center/app.py / user_center/app.py）。
#
# 跟生产保持一致：Python 3.11 (生产 supervisor 跑的也是 3.11)，pip 装 requirements.txt
FROM python:3.11-slim

WORKDIR /app

# 系统依赖：
# - libpq5      给 psycopg2-binary 运行时
# - curl + ca-certificates  给 healthcheck + node 装包
# - gcc + portaudio19-dev + libasound2-dev  给 pyaudio 编译
# - build-essential 给其他 C-extension
# - nodejs + npm  给装 claude CLI（backend/claude_chat.py 调用它转发 LLM 请求）
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
        ca-certificates \
        gcc \
        build-essential \
        portaudio19-dev \
        libasound2-dev \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code \
    && ln -sf "$(which claude)" /usr/local/bin/claude \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# 让 backend/config.py 默认 CLAUDE_BIN 路径能命中
ENV CLAUDE_BIN=/usr/local/bin/claude

# 依赖先装，命中缓存
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && \
    pip install --no-cache-dir \
        pyjwt>=2.8.0 \
        httpx>=0.27.0 \
        flask-caching>=2.1.0
# 以下 3 个 repo 的 requirements.txt 里都没收，prod 上是单独 venv 装的：
# - pyjwt:        backend/push/apns_provider.py: import jwt
# - httpx:        backend/claude_chat.py 等用
# - flask-caching: config_center/app.py 用

# 拷代码
COPY backend/ /app/backend/
COPY config_center/ /app/config_center/
COPY user_center/ /app/user_center/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 5566 3254 5567

# 默认命令（compose 会覆盖）
CMD ["python", "/app/backend/app.py"]
