# 由 bootstrap.sh 渲染生成 .env；不要手改 .env，改这个模板再重跑 bootstrap
# bootstrap.sh 会用 openssl rand 生成所有密钥，并把用户输入的 DeepSeek key
# / 测试账号信息也写到这里

# ───── 客户端访问 IP / 端口 ─────
HOST_IP=                          # bootstrap 自动检测，可手动改
PORT_OFFSET=0                     # 所有端口的偏移量（同机并行多 env 用）

# ───── AI 供应商 ─────
DEEPSEEK_API_KEY=                 # 必填
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GLM_API_KEY=
DOUBAO_API_KEY=

# ───── 测试账号（bootstrap 交互输入） ─────
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_USERNAME=

# ───── jsonapp Postgres ─────
JSONAPP_DB_USER=jsonapp
JSONAPP_DB_PASSWORD=              # bootstrap 生成
JSONAPP_DB_NAME=jsonapp

# ───── App MinIO（独立于 OpenIM 内部 minio） ─────
APP_MINIO_ROOT_USER=
APP_MINIO_ROOT_PASSWORD=
APP_MINIO_ACCESS_KEY=             # 应用使用的次级 key
APP_MINIO_SECRET_KEY=

# ───── Flask backend / Registry ─────
FLASK_SECRET_KEY=
REGISTRY_ADMIN_TOKEN=
REGISTRY_ADMIN_AUTHOR_EMAIL=2501808198@qq.com
REGISTRY_ADMIN_AUTHOR_NAME=fish
REGISTRY_ADMIN_AUTHOR_ID=
OPENIM_WEBHOOK_SECRET=             # 即便 push 关了也要塞，避免 backend 启动时 KeyError

# ───── ByteDance ASR（测试环境一般用不到，留空跳过） ─────
BYTEDANCE_ASR_APP_KEY=
BYTEDANCE_ASR_ACCESS_KEY=
BYTEDANCE_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
