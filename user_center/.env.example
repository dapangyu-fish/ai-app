# 实际部署在 /etc/user-center/.env (root, chmod 600)
# 不要 commit 真实凭据进 repo

ADMIN_USERNAME=admin
ADMIN_PASSWORD=换成强密码
SESSION_SECRET=用 openssl rand -hex 32 生成

DB_PATH=/var/lib/user-center/audit.db
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8089

# Supabase Admin API：service_role key 必须保密
SUPABASE_URL=https://myapp-auth.dapangyu.work
SUPABASE_SERVICE_KEY=<service_role JWT>
