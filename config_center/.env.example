# Config Center 环境变量
# 真 .env 部署在服务器 /etc/config-center/.env，root 600，不入库

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# openssl rand -hex 32
SESSION_SECRET=replace-with-32-byte-random-hex

DB_PATH=/var/lib/config-center/config.db
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8088

# APK 发布上传。生产密钥只放服务器 /etc/config-center/.env，不入库。
MINIO_PUBLIC_URL=https://myapp-oss-endpoint.dapangyu.work
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
APK_RELEASE_BUCKET=myapp-releases
APK_LATEST_OBJECT=android/apk/latest.apk
APK_METADATA_OBJECT=android/apk/latest.json
APK_SHA256_OBJECT=android/apk/latest.apk.sha256
APK_MAX_BYTES=524288000
